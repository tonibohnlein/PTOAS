// RUN: not ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-analysis-only --emit-pto-ir %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @reject_ambiguous_mte(%source: !pto.ptr<f32, gm>,
                                  %destination: !pto.ptr<f32, ub>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %c1 = arith.constant 1 : i64
    %false = arith.constant false
    pto.copy_gm_to_ubuf %source, %destination, %c0, %c1, %c1, %c0, %c0,
      %false, %c0, %c1, %c1 : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64,
      i64, i64, i64, i64, i1, i64, i64, i64
    return
  }
}

// CHECK: error: canonical sync normalized scheduling semantics do not identify a concrete physical pipe
