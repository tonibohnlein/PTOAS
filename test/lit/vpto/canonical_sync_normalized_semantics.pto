// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-dump --emit-pto-ir %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @normalized_simt_unknown_space(%source: memref<4xi32>,
                                           %destination: memref<4xi32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %value = pto.load %source[%c0] : memref<4xi32> -> i32
    pto.store %value, %destination[%c0] : memref<4xi32>, i32
    return
  }

  func.func @normalized_volatile_reads(%source: memref<4xi32>,
                                       %destination: memref<4xi32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %first = pto.load %source[%c0] {volatile} : memref<4xi32> -> i32
    %second = pto.load %destination[%c0] : memref<4xi32> -> i32
    %sum = arith.addi %first, %second : i32
    pto.store %sum, %source[%c0] : memref<4xi32>, i32
    return
  }

  func.func @normalized_generic_view_alias(
      %source: memref<4xi32, #pto.address_space<vec>>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %view = memref.subview %source[1] [2] [1]
        : memref<4xi32, #pto.address_space<vec>> to
          memref<2xi32, strided<[1], offset: 1>, #pto.address_space<vec>>
    %value = pto.load %source[%c1]
        : memref<4xi32, #pto.address_space<vec>> -> i32
    pto.store %value, %view[%c0]
        : memref<2xi32, strided<[1], offset: 1>, #pto.address_space<vec>>, i32
    return
  }

  func.func @normalized_wrapped_postupdate(
      %value: !pto.vreg<64xf32>, %dst: !pto.ptr<f32, ub>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
    %next = pto.vsts %value, %dst[%c0], %mask {dist = "NORM_B32"}
        : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
          -> !pto.ptr<f32, ub>
    %wrapped = pto.addptr %next, %c0
        : !pto.ptr<f32, ub> -> !pto.ptr<f32, ub>
    pto.vsts %value, %wrapped[%c0], %mask {dist = "NORM_B32"}
        : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    return
  }

  func.func @normalized_tile_descriptor_updates()
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %address = arith.constant 0 : i64
    %c16 = arith.constant 16 : index
    %c32 = arith.constant 32 : index
    %tile = pto.alloc_tile addr = %address valid_row = %c32 valid_col = %c32
      : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=?, v_col=?,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.set_validshape %tile, %c16, %c16
      : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=?, v_col=?,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %row, %col = pto.get_validshape %tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=?, v_col=?,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    return
  }

  func.func @normalized_aic_pipe_descriptor(%slots: !pto.ptr<f32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %view = pto.make_tensor_view %slots, shape = [%c16, %c16],
      strides = [%c16, %c1] : !pto.tensor_view<16x16xf32>
    pto.aic_initialize_pipe {id = 0, dir_mask = 1, slot_size = 1024}
      (gm_slot_tensor = %view : !pto.tensor_view<16x16xf32>)
    return
  }

  func.func @normalized_aiv_pipe_descriptor(%slots: !pto.ptr<f32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %view = pto.make_tensor_view %slots, shape = [%c16, %c16],
      strides = [%c16, %c1] : !pto.tensor_view<16x16xf32>
    pto.aiv_initialize_pipe {id = 0, dir_mask = 1, slot_size = 1024}
      (gm_slot_tensor = %view : !pto.tensor_view<16x16xf32>)
    return
  }

  func.func @normalized_tile_pipe_push(
      %slots: memref<256xf32, #pto.address_space<gm>>, %local: i32,
      %tile: !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16,
                           v_row=16, v_col=16, blayout=col_major,
                           slayout=row_major, fractal=1024, pad=0>)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %pipe = pto.initialize_l2g2l_pipe {
      dir_mask = 1, slot_size = 1024, slot_num = 2, local_slot_num = 2,
      flag_base = 0
    }(%slots : memref<256xf32, #pto.address_space<gm>>, %local : i32)
      -> !pto.pipe
    pto.tpush(%tile, %pipe
      : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16,
                      v_row=16, v_col=16, blayout=col_major,
                      slayout=row_major, fractal=1024, pad=0>, !pto.pipe)
      {split = 0}
    return
  }

  func.func @normalized_tile_pipe_pop(
      %slots: memref<256xf32, #pto.address_space<gm>>, %local: i32)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %pipe = pto.initialize_l2g2l_pipe {
      dir_mask = 1, slot_size = 1024, slot_num = 2, local_slot_num = 2,
      flag_base = 0
    }(%slots : memref<256xf32, #pto.address_space<gm>>, %local : i32)
      -> !pto.pipe
    %tile = pto.declare_tile
      -> !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16,
                       v_row=16, v_col=16, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>
    pto.tpop(%tile, %pipe
      : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16,
                      v_row=16, v_col=16, blayout=row_major,
                      slayout=none_box, fractal=512, pad=0>, !pto.pipe)
      {split = 0}
    pto.tfree(%pipe : !pto.pipe) {split = 0}
    return
  }

  func.func @normalized_global_pipe_protocol()
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %slots = pto.declare_global -> !pto.tensor_view<16x16xf32>
    %pipe = "pto.initialize_l2g2l_pipe"(%slots) <{
      dir_mask = 1 : i8, slot_size = 1024 : i32, slot_num = 2 : i32,
      flag_base = 0 : i32, operandSegmentSizes = array<i32: 1, 0, 0>
    }> : (!pto.tensor_view<16x16xf32>) -> !pto.pipe
    %entry = pto.declare_global -> !pto.tensor_view<16x16xf32>
    pto.talloc(%entry, %pipe : !pto.tensor_view<16x16xf32>, !pto.pipe)
      {split = 0}
    pto.tpush(%entry, %pipe : !pto.tensor_view<16x16xf32>, !pto.pipe)
      {split = 0}
    return
  }

  func.func @normalized_cube_scalar_address(
      %indices: !pto.ptr<i32>, %source: !pto.ptr<bf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %address = arith.constant 0 : i64
    %loaded = pto.load_scalar %indices[%c0] : !pto.ptr<i32> -> i32
    %offset = arith.index_cast %loaded : i32 to index
    %view = pto.make_tensor_view %source, shape = [%c16, %c16],
      strides = [%c16, %c1] : !pto.tensor_view<16x16xbf16>
    %partition = pto.partition_view %view, offsets = [%offset, %c0],
      sizes = [%c16, %c16] : !pto.tensor_view<16x16xbf16> ->
      !pto.partition_tensor_view<16x16xbf16>
    %tile = pto.alloc_tile addr = %address :
      !pto.tile_buf<loc=mat, dtype=bf16, rows=16, cols=16, v_row=16,
                    v_col=16, blayout=col_major, slayout=row_major,
                    fractal=512, pad=0>
    pto.tload ins(%partition : !pto.partition_tensor_view<16x16xbf16>)
              outs(%tile : !pto.tile_buf<loc=mat, dtype=bf16, rows=16,
                     cols=16, v_row=16, v_col=16, blayout=col_major,
                     slayout=row_major, fractal=512, pad=0>)
    return
  }
}

// CHECK-LABEL: CANONICAL-SYNC function=normalized_simt_unknown_space
// CHECK: PHASES 2
// CHECK: p0 op=pto.load resource=AIV:PIPE_S
// CHECK: p1 op=pto.store resource=AIV:PIPE_S
// CHECK: a0 phase=p0 mode=R space=unknown
// CHECK: a1 phase=p1 mode=W space=unknown
// CHECK: DEMANDS 0
// CHECK: VERIFY ok
// CHECK-LABEL: CANONICAL-SYNC function=normalized_volatile_reads
// CHECK: a0 phase=p0 mode=R space=unknown{{.*}}ordered=yes
// CHECK: a1 phase=p1 mode=R space=unknown{{.*}}ordered=no
// CHECK: DEMANDS 0
// CHECK: VERIFY ok
// CHECK-LABEL: CANONICAL-SYNC function=normalized_generic_view_alias
// CHECK: a0 phase=p0 mode=R space=vec range=[4,8)
// CHECK: a1 phase=p1 mode=W space=vec range=unknown
// CHECK: DEMANDS 0
// CHECK: VERIFY ok
// CHECK-LABEL: CANONICAL-SYNC function=normalized_wrapped_postupdate
// CHECK: kind=SSA
// CHECK: VERIFY ok
// CHECK-LABEL: CANONICAL-SYNC function=normalized_tile_descriptor_updates
// CHECK: PHASES 0
// CHECK: DEMANDS 0
// CHECK: VERIFY ok
// CHECK-LABEL: CANONICAL-SYNC function=normalized_aic_pipe_descriptor
// CHECK: PHASES 0
// CHECK: DEMANDS 0
// CHECK: VERIFY ok
// CHECK-LABEL: CANONICAL-SYNC function=normalized_aiv_pipe_descriptor
// CHECK: PHASES 0
// CHECK: DEMANDS 0
// CHECK: VERIFY ok
// CHECK-LABEL: CANONICAL-SYNC function=normalized_tile_pipe_push
// CHECK: PHASES 1
// CHECK: p0 op=pto.tpush resource=AIC:PIPE_FIX
// CHECK: a0 phase=p0 mode=R space=acc
// CHECK: a1 phase=p0 mode=W space=gm
// CHECK: VERIFY ok
// CHECK-LABEL: CANONICAL-SYNC function=normalized_tile_pipe_pop
// CHECK: PHASES 1
// CHECK: p0 op=pto.tpop resource=AIV:PIPE_MTE2
// CHECK: a0 phase=p0 mode=W space=vec
// CHECK: a1 phase=p0 mode=R space=gm
// CHECK: VERIFY ok
// CHECK-LABEL: CANONICAL-SYNC function=normalized_global_pipe_protocol
// CHECK: PHASES 0
// CHECK: DEMANDS 0
// CHECK: VERIFY ok
// CHECK-LABEL: CANONICAL-SYNC function=normalized_cube_scalar_address
// CHECK: p0 op=pto.load_scalar resource=AIC:PIPE_S
// CHECK: p1 op=pto.tload resource=AIC:PIPE_MTE2
// CHECK: DEMANDS 0
// CHECK: VERIFY ok
