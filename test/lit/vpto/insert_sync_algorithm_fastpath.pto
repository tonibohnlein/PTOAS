// RUN: not ptoas --pto-arch=a5 --pto-backend=vpto --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch --emit-vpto %s -o - 2>&1 | FileCheck %s
// A helper call has shared effects but no OpPipeInterface TileOp to expand.
// Requested InsertSync must still execute in the no-expansion VPTO path.
// CHECK: frontier-synch physical event-ID realization is pending
module {
  func.func private @write_ub(!pto.ptr<f32, ub>)
      attributes {pto.ptodsl.subkernel_helper = "cube", pto.tileop.effects = ["write"]}
  func.func private @read_ub(!pto.ptr<f32, ub>)
      attributes {pto.ptodsl.subkernel_helper = "simd", pto.tileop.effects = ["read"]}
  func.func @fast_path(%arg: !pto.ptr<f32, ub>) {
    func.call @write_ub(%arg) : (!pto.ptr<f32, ub>) -> ()
    func.call @read_ub(%arg) : (!pto.ptr<f32, ub>) -> ()
    return
  }
}
