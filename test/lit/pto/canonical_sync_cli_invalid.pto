// RUN: not ptoas --pto-arch=a5 --enable-canonical-sync %s 2>&1 \
// RUN:   | FileCheck %s --check-prefix=A5
// RUN: not ptoas --pto-arch=a3 --canonical-sync-dump %s 2>&1 \
// RUN:   | FileCheck %s --check-prefix=DEPENDENT
// RUN: not ptoas --pto-arch=a3 --canonical-sync-stats %s 2>&1 \
// RUN:   | FileCheck %s --check-prefix=STATS-DEPENDENT
// RUN: not ptoas --pto-arch=a3 \
// RUN:   --canonical-sync-gm-alias-policy=distinct-roots-unsafe %s 2>&1 \
// RUN:   | FileCheck %s --check-prefix=POLICY-DEPENDENT
// RUN: not ptoas --pto-arch=a3 --enable-canonical-sync \
// RUN:   --canonical-sync-gm-alias-policy=guess %s 2>&1 \
// RUN:   | FileCheck %s --check-prefix=POLICY-INVALID
// RUN: not ptoas --pto-arch=a3 --enable-canonical-sync \
// RUN:   --enable-insert-sync %s 2>&1 | FileCheck %s --check-prefix=EXCLUSIVE

module {
  func.func @empty() {
    return
  }
}

// A5: --enable-canonical-sync requires --pto-arch=a2 or a3
// DEPENDENT: canonical sync diagnostic/policy flags require --enable-canonical-sync
// STATS-DEPENDENT: canonical sync diagnostic/policy flags require --enable-canonical-sync
// POLICY-DEPENDENT: canonical sync diagnostic/policy flags require --enable-canonical-sync
// POLICY-INVALID: unsupported --canonical-sync-gm-alias-policy='guess'
// EXCLUSIVE: --enable-insert-sync, --enable-canonical-sync
// EXCLUSIVE-SAME: mutually exclusive
