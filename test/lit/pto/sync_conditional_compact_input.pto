// RUN: pto-sync-input-test --conditional-compact-input-checks %s
!tile = !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module {
  func.func @alternative_rmw(%n: index, %condition: i1) attributes {
      test.compact_classes = 1 : i64, test.compact_rmw} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %zero : !tile
    scf.for %i = %c0 to %n step %c1 {
      scf.if %condition {
        pto.tadds ins(%tile, %one : !tile, f32) outs(%tile : !tile)
      } else {
        pto.texpands ins(%one : f32) outs(%tile : !tile)
      }
    }
    return
  }
  func.func @shifted_alternatives(%p: !pto.ptr<f32, gm>, %n: index, %condition: i1)
      attributes {test.compact_classes = 1 : i64} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %one = arith.constant 1.0 : f32
    scf.for %i = %c0 to %n step %c1 {
      %j = arith.addi %i, %c1 : index
      scf.if %condition {
        pto.store %one, %p[%i] : !pto.ptr<f32, gm>, f32
      } else {
        pto.store %one, %p[%j] : !pto.ptr<f32, gm>, f32
      }
      %value = pto.load %p[%j] : !pto.ptr<f32, gm> -> f32
    }
    return
  }
  func.func @universal_native(%n: index, %condition: i1) attributes {
      test.compact_classes = 1 : i64, test.compact_native = 1 : i64, test.compact_additional = 0 : i64} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %zero = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %zero : !tile
    scf.for %i = %c0 to %n step %c1 {
      %value = scf.if %condition -> (f32) {
        %a = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
        scf.yield %a : f32
      } else {
        %b = pto.tgetval ins(%tile, %c1 : !tile, index) outs : f32
        scf.yield %b : f32
      }
      pto.texpands ins(%value : f32) outs(%tile : !tile)
    }
    return
  }
  func.func @arm_specific_native(%n: index, %condition: i1) attributes {
      test.compact_classes = 1 : i64, test.compact_native = 0 : i64, test.compact_additional = 1 : i64} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %zero : !tile
    scf.for %i = %c0 to %n step %c1 {
      scf.if %condition {
        %a = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
        pto.texpands ins(%a : f32) outs(%tile : !tile)
      } else {
        %b = pto.tgetval ins(%tile, %c1 : !tile, index) outs : f32
        pto.texpands ins(%one : f32) outs(%tile : !tile)
      }
    }
    return
  }
}
