// RUN: ptoas --pto-arch=a3 --emit-pto-ir --protocol-sync-analysis-only \
// RUN:   --protocol-sync-dump=schedule %s -o /dev/null 2>&1 | FileCheck %s

module {
  func.func @while_is_rejected(%limit : index) -> index {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %result = scf.while (%value = %c0) : (index) -> index {
      %condition = arith.cmpi slt, %value, %limit : index
      scf.condition(%condition) %value : index
    } do {
    ^bb0(%value : index):
      %next = arith.addi %value, %c1 : index
      scf.yield %next : index
    }
    return %result : index
  }
}

// CHECK: PROTOCOL-SYNC schedule function=@while_is_rejected frozen=yes
// CHECK: rejected reason=unsupported-region op=scf.while
// CHECK-SAME: detail="scf.while requires distinct condition and body execution semantics"
// CHECK: PROTOCOL-SYNC schedule-end function=@while_is_rejected
