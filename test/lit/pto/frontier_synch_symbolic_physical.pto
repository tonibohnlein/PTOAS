// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch --emit-pto-ir %s -o %t.ir
// RUN: FileCheck %s --check-prefix=IR < %t.ir
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch --emit-pto-ir --dump-frontier-demands --report-frontier-costs %s -o %t.report.ir 2> %t.report
// RUN: pto-frontier-analysis-test --structured-counter-check %s
// RUN: pto-frontier-analysis-test --symbolic-allocation-check %s
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch %s -o %t.cpp
// RUN: FileCheck %s --check-prefix=CPP < %t.cpp
// RUN: %python %S/Inputs/minimum_demand/check_symbolic_cpp.py %t.ir %t.cpp %t.constants
// RUN: %python %S/Inputs/minimum_demand/check_symbolic_physical.py %s %t.ir %t.report
!vec = !pto.tile_buf<loc=vec, dtype=i32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!gm = !pto.partition_tensor_view<16x128xi32>
module attributes {pto.target_arch = "a3"} {
  func.func @symbolic_nested(%src: !gm, %dst: !gm, %n: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %address0 = arith.constant 0 : i64
    %tile0 = pto.alloc_tile addr = %address0 : !vec
    %address1 = arith.constant 8192 : i64
    %tile1 = pto.alloc_tile addr = %address1 : !vec
    %address2 = arith.constant 16384 : i64
    %tile2 = pto.alloc_tile addr = %address2 : !vec
    %lb = arith.constant 0 : index
    %step = arith.constant 1 : index
    pto.tload ins(%src : !gm) outs(%tile0 : !vec)
    scf.for %outer = %lb to %n step %step {
      scf.for %i = %lb to %n step %step {
      pto.tload ins(%src : !gm) outs(%tile0 : !vec)
      pto.txor ins(%tile0, %tile0, %tile2 : !vec, !vec, !vec) outs(%tile1 : !vec)
      pto.tstore ins(%tile1 : !vec) outs(%dst : !gm)
      }
    }
    pto.tstore ins(%tile1 : !vec) outs(%dst : !gm)
    return
  }
  func.func @symbolic_guarded(%src: !gm, %dst: !gm, %active: i1) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %address0 = arith.constant 0 : i64
    %tile0 = pto.alloc_tile addr = %address0 : !vec
    %address1 = arith.constant 8192 : i64
    %tile1 = pto.alloc_tile addr = %address1 : !vec
    %address2 = arith.constant 16384 : i64
    %tile2 = pto.alloc_tile addr = %address2 : !vec
    pto.tload ins(%src : !gm) outs(%tile0 : !vec)
    scf.if %active {
      pto.txor ins(%tile0, %tile0, %tile2 : !vec, !vec, !vec) outs(%tile1 : !vec)
      pto.tstore ins(%tile1 : !vec) outs(%dst : !gm)
    }
    return
  }
  func.func @symbolic_opaque_guarded(%src: !gm, %dst: !gm, %n: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %address0 = arith.constant 0 : i64
    %tile0 = pto.alloc_tile addr = %address0 : !vec
    %address1 = arith.constant 8192 : i64
    %tile1 = pto.alloc_tile addr = %address1 : !vec
    %address2 = arith.constant 16384 : i64
    %tile2 = pto.alloc_tile addr = %address2 : !vec
    %zero = arith.constant 0 : index
    %square = arith.muli %n, %n : index
    %active = arith.cmpi sgt, %square, %zero : index
    pto.tload ins(%src : !gm) outs(%tile0 : !vec)
    scf.if %active {
      pto.txor ins(%tile0, %tile0, %tile2 : !vec, !vec, !vec) outs(%tile1 : !vec)
      pto.tstore ins(%tile1 : !vec) outs(%dst : !gm)
    }
    return
  }
}
// IR: pto.frontier.physical_status = "certified-symbolic-pools"
// IR: iter_args
// IR: pto.set_flag_dyn
// IR: pto.wait_flag_dyn
// IR: pto.frontier.physical_status = "certified-symbolic-pools"
// IR: pto.frontier.physical_status = "certified-finite-guarded-pools"
// IR-NOT: sync.logical_
// CPP: __int128
// CPP: set_flag(
// CPP: wait_flag(
