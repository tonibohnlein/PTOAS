// RUN: pto-test-opt --split-input-file --pto-insert-sync="buffer-generations=true" %s | FileCheck %s

// An outstanding last store still requires return-time completion.
// CHECK-LABEL: func.func @undrained
// CHECK: pto.tstore
// CHECK: pto.barrier <PIPE_ALL> {pto.auto_sync_tail_barrier}
module attributes {pto.target_arch = "a3"} {
 func.func @undrained(%input: !pto.partition_tensor_view<16x16xf16>, %out: !pto.partition_tensor_view<16x16xf16>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
 %base = arith.constant 0 : i64
 %a = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 16x16xf16>
 pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
 pto.tstore ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%out : !pto.partition_tensor_view<16x16xf16>)
 return
 }
}

// -----
// Fixed input barriers remain owned by the user.
// CHECK-LABEL: func.func @fixed_barrier
// CHECK: pto.barrier <PIPE_MTE2>
// CHECK: pto.tstore
// CHECK: pto.barrier <PIPE_ALL> {pto.auto_sync_tail_barrier}
module attributes {pto.target_arch = "a3"} {
 func.func @fixed_barrier(%input: !pto.partition_tensor_view<16x16xf16>, %out: !pto.partition_tensor_view<16x16xf16>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
 %base = arith.constant 0 : i64
 %a = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 16x16xf16>
 pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
 pto.barrier <PIPE_MTE2>
 pto.tstore ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%out : !pto.partition_tensor_view<16x16xf16>)
 return
 }
}
