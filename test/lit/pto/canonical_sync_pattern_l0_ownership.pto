// RUN: pto-test-opt %s '-pto-canonical-sync=event-id-num-max=8' \
// RUN:   | tee %t.events \
// RUN:   | FileCheck %s --check-prefix=EVENTS
// RUN: grep 'pto.set_flag' %t.events | count 8
// RUN: grep 'pto.wait_flag' %t.events | count 8
// RUN: not grep 'pto.barrier <PIPE_ALL> {pto.canonical_sync}' %t.events
// RUN: pto-test-opt %s '-pto-canonical-sync=event-id-num-max=2' \
// RUN:   | tee %t.budget2 \
// RUN:   | FileCheck %s --check-prefix=PARTIAL
// RUN: grep 'pto.set_flag' %t.budget2 | count 4
// RUN: grep 'pto.wait_flag' %t.budget2 | count 4
// RUN: grep 'pto.barrier <PIPE_ALL> {pto.canonical_sync}' %t.budget2 \
// RUN:   | count 4
// RUN: pto-test-opt %s '-pto-canonical-sync=event-id-num-max=3' \
// RUN:   | tee %t.budget3 \
// RUN:   | FileCheck %s --check-prefix=PARTIAL
// RUN: grep 'pto.set_flag' %t.budget3 | count 4
// RUN: grep 'pto.wait_flag' %t.budget3 | count 4
// RUN: grep 'pto.barrier <PIPE_ALL> {pto.canonical_sync}' %t.budget3 \
// RUN:   | count 4
// RUN: pto-test-opt %s '-pto-canonical-sync=event-id-num-max=1' \
// RUN:   | FileCheck %s --check-prefix=SCARCE

module attributes {pto.target_arch = "a2a3"} {
  func.func @two_slot_l0_ownership(%limit: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c64 = arith.constant 64 : index
    %addr0 = arith.constant 0 : i64
    %addr16384 = arith.constant 16384 : i64
    %addr32768 = arith.constant 32768 : i64

    %left_source = pto.alloc_tile addr = %addr0 :
      !pto.tile_buf<mat, 128x128xf16, slayout=row_major>
    %right_source = pto.alloc_tile addr = %addr0 :
      !pto.tile_buf<mat, 128x256xf16, slayout=col_major>
    %left0 = pto.alloc_tile addr = %addr0 :
      !pto.tile_buf<left, 128x64xf16, slayout=row_major>
    %left1 = pto.alloc_tile addr = %addr16384 :
      !pto.tile_buf<left, 128x64xf16, slayout=row_major>
    %right0 = pto.alloc_tile addr = %addr0 :
      !pto.tile_buf<right, 64x256xf16, slayout=col_major>
    %right1 = pto.alloc_tile addr = %addr32768 :
      !pto.tile_buf<right, 64x256xf16, slayout=col_major>
    %acc = pto.alloc_tile addr = %addr0 :
      !pto.tile_buf<acc, 128x256xf32, blayout=col_major,
                    slayout=row_major, fractal=1024>

    scf.for %i = %c0 to %limit step %c1 {
      pto.textract ins(%left_source, %c0, %c0 :
        !pto.tile_buf<mat, 128x128xf16, slayout=row_major>, index, index)
        outs(%left0 : !pto.tile_buf<left, 128x64xf16, slayout=row_major>)
      pto.textract ins(%right_source, %c0, %c0 :
        !pto.tile_buf<mat, 128x256xf16, slayout=col_major>, index, index)
        outs(%right0 : !pto.tile_buf<right, 64x256xf16, slayout=col_major>)
      pto.tmatmul.acc ins(%acc, %left0, %right0 :
        !pto.tile_buf<acc, 128x256xf32, blayout=col_major,
                      slayout=row_major, fractal=1024>,
        !pto.tile_buf<left, 128x64xf16, slayout=row_major>,
        !pto.tile_buf<right, 64x256xf16, slayout=col_major>)
        outs(%acc : !pto.tile_buf<acc, 128x256xf32, blayout=col_major,
                                  slayout=row_major, fractal=1024>)
      pto.textract ins(%left_source, %c0, %c64 :
        !pto.tile_buf<mat, 128x128xf16, slayout=row_major>, index, index)
        outs(%left1 : !pto.tile_buf<left, 128x64xf16, slayout=row_major>)
      pto.textract ins(%right_source, %c64, %c0 :
        !pto.tile_buf<mat, 128x256xf16, slayout=col_major>, index, index)
        outs(%right1 : !pto.tile_buf<right, 64x256xf16, slayout=col_major>)
      pto.tmatmul.acc ins(%acc, %left1, %right1 :
        !pto.tile_buf<acc, 128x256xf32, blayout=col_major,
                      slayout=row_major, fractal=1024>,
        !pto.tile_buf<left, 128x64xf16, slayout=row_major>,
        !pto.tile_buf<right, 64x256xf16, slayout=col_major>)
        outs(%acc : !pto.tile_buf<acc, 128x256xf32, blayout=col_major,
                                  slayout=row_major, fractal=1024>)
    }
    return
  }
}

// EVENTS-LABEL: func.func @two_slot_l0_ownership
// EVENTS: pto.set_flag[<PIPE_M>, <PIPE_MTE1>, <EVENT_ID0>]
// EVENTS-NEXT: pto.set_flag[<PIPE_M>, <PIPE_MTE1>, <EVENT_ID1>]
// EVENTS: scf.for
// EVENTS: pto.wait_flag[<PIPE_M>, <PIPE_MTE1>, <EVENT_ID0>]
// EVENTS: pto.textract
// EVENTS-NEXT: pto.set_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID0>]
// EVENTS: pto.textract
// EVENTS-NEXT: pto.set_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID2>]
// EVENTS-NEXT: pto.wait_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID0>]
// EVENTS-NEXT: pto.wait_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID2>]
// EVENTS-NEXT: pto.tmatmul.acc
// EVENTS-NEXT: pto.set_flag[<PIPE_M>, <PIPE_MTE1>, <EVENT_ID0>]
// EVENTS: pto.wait_flag[<PIPE_M>, <PIPE_MTE1>, <EVENT_ID1>]
// EVENTS: pto.set_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID1>]
// EVENTS: pto.set_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID3>]
// EVENTS: pto.wait_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID1>]
// EVENTS-NEXT: pto.wait_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID3>]
// EVENTS-NEXT: pto.tmatmul.acc
// EVENTS-NEXT: pto.set_flag[<PIPE_M>, <PIPE_MTE1>, <EVENT_ID1>]
// EVENTS: pto.wait_flag[<PIPE_M>, <PIPE_MTE1>, <EVENT_ID0>]
// EVENTS-NEXT: pto.wait_flag[<PIPE_M>, <PIPE_MTE1>, <EVENT_ID1>]
// EVENTS-NEXT: pto.barrier <PIPE_ALL> {pto.auto_sync_tail_barrier,

// PARTIAL-LABEL: func.func @two_slot_l0_ownership
// PARTIAL-NOT: pto.set_flag[<PIPE_M>, <PIPE_MTE1>
// PARTIAL: pto.set_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID0>]
// PARTIAL: pto.barrier <PIPE_ALL> {pto.canonical_sync}
// PARTIAL: pto.barrier <PIPE_ALL> {pto.auto_sync_tail_barrier,

// SCARCE-LABEL: func.func @two_slot_l0_ownership
// SCARCE-NOT: pto.set_flag
// SCARCE: scf.for
// SCARCE: pto.barrier <PIPE_ALL> {pto.canonical_sync}
// SCARCE: pto.tmatmul.acc
// SCARCE: pto.barrier <PIPE_ALL> {pto.canonical_sync}
// SCARCE: pto.barrier <PIPE_ALL> {pto.auto_sync_tail_barrier,
