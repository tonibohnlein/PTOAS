// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch --emit-pto-ir %s -o %t.ir
// RUN: FileCheck %s --check-prefix=IR < %t.ir
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch %s -o %t.cpp
// RUN: FileCheck %s --check-prefix=CPP < %t.cpp
// RUN: pto-frontier-analysis-test --single-stream-check %s
// RUN: %python %S/Inputs/minimum_demand/check_banked_xor.py pto-test-opt %s
!packed = !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=128, v_row=32, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!coeff = !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=1, v_row=16, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>
!scratch = !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=2048, v_row=1, v_col=2048, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!vec = !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module attributes {pto.target_arch = "a3"} {
  func.func @row_expand_2(%gm0: !pto.partition_tensor_view<32x128xf32>,
                        %gm1: !pto.partition_tensor_view<16x128xf32>, %n: index)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %a0 = arith.constant 0 : i64
    %a1 = arith.constant 65536 : i64
    %a2 = arith.constant 131072 : i64
    %ac = arith.constant 8192 : i64
    %input = pto.alloc_tile addr = %a0 : !packed
    %data = pto.alloc_tile addr = %a0 : !vec
    %coeff = pto.alloc_tile addr = %ac : !coeff
    %tmp = pto.alloc_tile addr = %a2 : !scratch
    %banks = pto.alloc_multi_tile addr = %a1 : !pto.multi_tile_buf<!vec, count=2>
    pto.tload ins(%gm0 : !pto.partition_tensor_view<32x128xf32>) outs(%input : !packed)
    // These constants deliberately follow the entry payload.
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %count = arith.constant 2 : index
    scf.for %i = %zero to %n step %one {
      %slot = arith.remui %i, %count : index
      %output = pto.multi_tile_get %banks[%slot] : !pto.multi_tile_buf<!vec, count=2> -> !vec
      pto.trowexpandmul ins(%data, %coeff, %tmp : !vec, !coeff, !scratch) outs(%output : !vec)
    }
    %nonempty = arith.cmpi sgt, %n, %zero : index
    scf.if %nonempty {
      %last = arith.subi %n, %one : index
      %slot = arith.remui %last, %count : index
      %output = pto.multi_tile_get %banks[%slot] : !pto.multi_tile_buf<!vec, count=2> -> !vec
      pto.tstore ins(%output : !vec) outs(%gm1 : !pto.partition_tensor_view<16x128xf32>)
    }
    return
  }
}
// IR: pto.frontier.physical_status = "certified-single-generation-boundaries"
// IR: pto.tload
// IR: pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// IR: scf.for
// IR: pto.barrier <PIPE_V>
// IR: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// IR: pto.trowexpandmul
// IR: pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
// IR: pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
// IR: pto.tstore
// IR: pto.barrier <PIPE_ALL>
// IR-NOT: sync.logical_
// CPP: TLOAD(
// CPP: TROWEXPANDMUL({{[_A-Za-z][_A-Za-z0-9]*}}, {{[_A-Za-z][_A-Za-z0-9]*}}, {{[_A-Za-z][_A-Za-z0-9]*}}, {{[_A-Za-z][_A-Za-z0-9]*}});
// CPP: TSTORE(
