// RUN: not pto-test-opt --pto-insert-sync="effect-coverage=maybe" %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=BAD
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-effect-coverage=report --insert-sync-prune-completed-barriers --emit-pto-ir %s -o %t.pto
// RUN: FileCheck %s --check-prefix=OK < %t.pto
// BAD: InsertSync effect-coverage must be report or strict
// OK: pto.insert_sync.effect_coverage = "complete"
module {
  func.func @empty() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    return
  }
}
