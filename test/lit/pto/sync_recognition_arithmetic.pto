// CHECK-LABEL: three-coordinates: applicable class=bounded-coefficients
// CHECK-LABEL: bounded: applicable class=bounded-coefficients dimensions=4 coefficient=7
// CHECK-LABEL: positive-round: applicable class=differences
// CHECK: row -1, 0, 0, 0 constant=1 equality=0
// CHECK-LABEL: negative-round: applicable class=differences
// CHECK: row -1, 0, 0, 0 constant=-2 equality=0
// CHECK-LABEL: impossible-equality: applicable class=differences
// CHECK-NEXT: piece empty=1 rows=0
// CHECK-LABEL: cancellation: applicable class=differences
// CHECK: row 0, 1, 0, 0 constant=0 equality=0
// CHECK-LABEL: constant-false: applicable class=differences
// CHECK-NEXT: piece empty=1 rows=0
// CHECK-LABEL: constant-true: applicable class=differences
// CHECK-NEXT: piece empty=0 rows=1
// CHECK-LABEL: too-large: not-applicable
// CHECK-NEXT: issue coefficient-limit
// CHECK-LABEL: division: not-applicable
// CHECK-NEXT: issue unsupported-expression
// CHECK-LABEL: modulo: not-applicable
// CHECK-NEXT: issue unsupported-expression
// CHECK-LABEL: nonlinear: not-applicable
// CHECK-NEXT: issue unsupported-expression
// CHECK-LABEL: dimension-limit: not-applicable
// CHECK: issue dimension-limit
// CHECK-LABEL: pipe-limit: not-applicable
// CHECK-NEXT: issue pipe-limit
// CHECK-LABEL: missing-role: missing-premise
// CHECK-NEXT: issue missing-role
// CHECK-LABEL: missing-primitives: missing-premise
// CHECK-NEXT: issue missing-primitives
// CHECK-LABEL: period-mismatch: not-applicable
// CHECK-NEXT: issue period-mismatch
// CHECK-LABEL: residue-valid: applicable class=differences
// CHECK-LABEL: residue-invalid: missing-premise
// CHECK-NEXT: issue invalid-residue
// CHECK-LABEL: missing-parameter: missing-premise
// CHECK: issue invalid-coordinate
// CHECK-LABEL: coefficient-overflow: missing-premise
// CHECK-NEXT: issue coefficient-overflow

