// RUN: pto-test-opt --mlir-disable-threading --pto-frontier-analysis=gm-alias=may-not-alias %s > %t.logical
// RUN: FileCheck %s --check-prefix=LOGICAL < %t.logical
// RUN: pto-test-opt --mlir-disable-threading --pto-frontier-allocate=eligible-ids=0,1,2,3,4,5 %t.logical > %t.physical
// RUN: FileCheck %s --check-prefix=PHYSICAL < %t.physical
// First-visit and remaining-visit cube branches leave conservative rank records
// whose guards are impossible in their original legal source-ordinal domains.
// Allocation must prove those records inactive without changing logical demands
// or increasing the six-ID capacity. Opaque function parameters remain free.
// LOGICAL: pto.finite_allocation
// LOGICAL-SAME: strategy = "regional-palettes"
// LOGICAL: pto.logical_
// PHYSICAL-NOT: pto.logical_
// PHYSICAL: pto.set_flag
// PHYSICAL: pto.wait_flag
// PHYSICAL-NOT: pto.logical_
module attributes {pto.backend = "emitc", pto.kernel_kind = #pto.kernel_kind<cube>, pto.target_arch = "a3"} {
  func.func @bounded_first_tail(%arg0: !pto.ptr<bf16, gm>, %arg1: !pto.ptr<bf16, gm>, %arg2: !pto.ptr<f32, gm>, %arg3: i32, %arg4: i32) attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %c0_i64 = arith.constant 0 : i64
    %c4096_i64 = arith.constant 4096 : i64
    %c69632_i64 = arith.constant 69632 : i64
    %c73728_i64 = arith.constant 73728 : i64
    %c6144_i64 = arith.constant 6144 : i64
    %c32768_i64 = arith.constant 32768 : i64
    %c2048_i64 = arith.constant 2048 : i64
    %c16 = arith.constant 16 : index
    %c8192 = arith.constant 8192 : index
    %c1 = arith.constant 1 : index
    %c256 = arith.constant 256 : index
    %c0 = arith.constant 0 : index
    %c64 = arith.constant 64 : index
    %c2 = arith.constant 2 : index
    %c128 = arith.constant 128 : index
    %0 = pto.make_tensor_view %arg0, shape = [%c16, %c8192], strides = [%c8192, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xbf16>
    %1 = pto.make_tensor_view %arg1, shape = [%c8192, %c8192], strides = [%c8192, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xbf16>
    %2 = pto.make_tensor_view %arg2, shape = [%c16, %c8192], strides = [%c8192, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf32>
    %3 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c256 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
    %4 = arith.index_cast %arg3 : i32 to index
    %5 = arith.muli %4, %c256 : index
    %6 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c256 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
    scf.for %arg5 = %c0 to %c64 step %c2 {
      %9 = arith.muli %arg5, %c128 : index
      %10 = arith.muli %arg5, %c128 : index
      %11 = arith.addi %10, %c128 : index
      %12 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c128 : !pto.tile_buf<mat, 16x128xbf16, valid=?x?, blayout=col_major, slayout=row_major>
      %13 = arith.maxsi %9, %c0 : index
      %14 = pto.partition_view %0, offsets = [%c0, %13], sizes = [%c16, %c128] : !pto.tensor_view<?x?xbf16>
      pto.tload ins(%14 : !pto.partition_tensor_view<16x128xbf16>) outs(%12 : !pto.tile_buf<mat, 16x128xbf16, valid=?x?, blayout=col_major, slayout=row_major>) {layout = #pto.layout<nd>}
      %15 = pto.alloc_tile addr = %c4096_i64 valid_row = %c128 valid_col = %c256 : !pto.tile_buf<mat, 128x256xbf16, valid=?x?, blayout=col_major, slayout=row_major>
      %16 = arith.maxsi %9, %c0 : index
      %17 = arith.maxsi %5, %c0 : index
      %18 = pto.partition_view %1, offsets = [%16, %17], sizes = [%c128, %c256] : !pto.tensor_view<?x?xbf16>
      pto.tload ins(%18 : !pto.partition_tensor_view<128x256xbf16>) outs(%15 : !pto.tile_buf<mat, 128x256xbf16, valid=?x?, blayout=col_major, slayout=row_major>) {layout = #pto.layout<nd>}
      %19 = pto.alloc_tile addr = %c69632_i64 valid_row = %c16 valid_col = %c128 : !pto.tile_buf<mat, 16x128xbf16, valid=?x?, blayout=col_major, slayout=row_major>
      %20 = arith.maxsi %11, %c0 : index
      %21 = pto.partition_view %0, offsets = [%c0, %20], sizes = [%c16, %c128] : !pto.tensor_view<?x?xbf16>
      pto.tload ins(%21 : !pto.partition_tensor_view<16x128xbf16>) outs(%19 : !pto.tile_buf<mat, 16x128xbf16, valid=?x?, blayout=col_major, slayout=row_major>) {layout = #pto.layout<nd>}
      %22 = pto.alloc_tile addr = %c73728_i64 valid_row = %c128 valid_col = %c256 : !pto.tile_buf<mat, 128x256xbf16, valid=?x?, blayout=col_major, slayout=row_major>
      %23 = arith.maxsi %11, %c0 : index
      %24 = arith.maxsi %5, %c0 : index
      %25 = pto.partition_view %1, offsets = [%23, %24], sizes = [%c128, %c256] : !pto.tensor_view<?x?xbf16>
      pto.tload ins(%25 : !pto.partition_tensor_view<128x256xbf16>) outs(%22 : !pto.tile_buf<mat, 128x256xbf16, valid=?x?, blayout=col_major, slayout=row_major>) {layout = #pto.layout<nd>}
      %26 = arith.cmpi eq, %9, %c0 : index
      scf.if %26 {
        %33 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c256 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
        %34 = pto.alloc_tile addr = %c6144_i64 valid_row = %c16 valid_col = %c64 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>
        pto.textract ins(%12, %c0, %c0 : !pto.tile_buf<mat, 16x128xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%34 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>)
        %35 = pto.alloc_tile addr = %c0_i64 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>
        pto.textract ins(%15, %c0, %c0 : !pto.tile_buf<mat, 128x256xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%35 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>)
        %36 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c64 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>
        pto.textract ins(%12, %c0, %c64 : !pto.tile_buf<mat, 16x128xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%36 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>)
        %37 = pto.alloc_tile addr = %c32768_i64 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>
        pto.textract ins(%15, %c64, %c0 : !pto.tile_buf<mat, 128x256xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%37 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>)
        %38 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c256 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
        pto.tmatmul ins(%34, %35 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>, !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>) outs(%38 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>)
        %39 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c256 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
        pto.tmatmul.acc ins(%39, %36, %37 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>, !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>) outs(%39 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>)
      } else {
        %33 = pto.alloc_tile addr = %c6144_i64 valid_row = %c16 valid_col = %c64 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>
        pto.textract ins(%12, %c0, %c0 : !pto.tile_buf<mat, 16x128xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%33 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>)
        %34 = pto.alloc_tile addr = %c0_i64 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>
        pto.textract ins(%15, %c0, %c0 : !pto.tile_buf<mat, 128x256xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%34 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>)
        %35 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c64 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>
        pto.textract ins(%12, %c0, %c64 : !pto.tile_buf<mat, 16x128xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%35 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>)
        %36 = pto.alloc_tile addr = %c32768_i64 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>
        pto.textract ins(%15, %c64, %c0 : !pto.tile_buf<mat, 128x256xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%36 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>)
        %37 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c256 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
        pto.tmatmul.acc ins(%37, %33, %34 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>, !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>) outs(%37 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>)
        %38 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c256 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
        pto.tmatmul.acc ins(%38, %35, %36 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>, !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>) outs(%38 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>)
      }
      %27 = pto.alloc_tile addr = %c2048_i64 valid_row = %c16 valid_col = %c64 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>
      pto.textract ins(%19, %c0, %c0 : !pto.tile_buf<mat, 16x128xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%27 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>)
      %28 = pto.alloc_tile addr = %c0_i64 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>
      pto.textract ins(%22, %c0, %c0 : !pto.tile_buf<mat, 128x256xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%28 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>)
      %29 = pto.alloc_tile addr = %c4096_i64 valid_row = %c16 valid_col = %c64 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>
      pto.textract ins(%19, %c0, %c64 : !pto.tile_buf<mat, 16x128xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%29 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>)
      %30 = pto.alloc_tile addr = %c32768_i64 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>
      pto.textract ins(%22, %c64, %c0 : !pto.tile_buf<mat, 128x256xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%30 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>)
      %31 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c256 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
      pto.tmatmul.acc ins(%31, %27, %28 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>, !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>) outs(%31 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>)
      %32 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c256 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
      pto.tmatmul.acc ins(%32, %29, %30 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>, !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>) outs(%32 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>)
    }
    %7 = arith.maxsi %5, %c0 : index
    %8 = pto.partition_view %2, offsets = [%c0, %7], sizes = [%c16, %c256] : !pto.tensor_view<?x?xf32>
    pto.tstore ins(%6 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>) outs(%8 : !pto.partition_tensor_view<16x256xf32>) {layout = #pto.layout<nd>}
    return
  }
}
