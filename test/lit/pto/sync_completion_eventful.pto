// RUN: %python %S/Inputs/check_completion_eventful.py pto-test-opt pto-sync-input-test %s
!tile = !pto.tile_buf<vec, 1x8xf32>
module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @pending_children(%n: index, %take: i1) attributes {test.trace_arguments = array<i64: 2, 1>} {
    %zero = arith.constant 0 : index
    %one_i = arith.constant 1 : index
    %a = arith.constant 0 : i64
    %b = arith.constant 64 : i64
    %one = arith.constant 1.0 : f32
    %false = arith.constant false
    %x = pto.alloc_tile addr = %a : !tile
    %y = pto.alloc_tile addr = %b : !tile
    scf.for %i = %zero to %n step %one_i {
      scf.if %take {
        pto.texpands ins(%one : f32) outs(%x : !tile) {test.label = "WX"}
        pto.texpands ins(%one : f32) outs(%y : !tile) {test.label = "WY"}
        %rx = "pto.tgetval"(%x, %zero) {test.label = "RX"} : (!tile, index) -> f32
        %ry = "pto.tgetval"(%y, %zero) {test.label = "RY"} : (!tile, index) -> f32
      }
    }
    pto.texpands ins(%one : f32) outs(%x : !tile) {test.label = "WX"}
    %last = "pto.tgetval"(%x, %zero) {test.label = "RX"} : (!tile, index) -> f32
    scf.while : () -> () {
      %final = "pto.tgetval"(%x, %zero) {test.label = "FINAL"} : (!tile, index) -> f32
      scf.condition(%false)
    } do {
      scf.yield
    }
    return
  }
}
