// RUN: %python %S/Inputs/check_composed_phases.py pto-sync-input-test %s
!cell = !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!ring = !pto.multi_tile_buf<!pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>, count=2>
module attributes {pto.target_arch = "a3"} {
  func.func @composed_phase(%n: index, %m: index) attributes {test.trace_arguments = array<i64: 3, 2>} {
    %base = arith.constant 512 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %scalar = arith.constant 1.0 : f32
    %ring = pto.alloc_multi_tile addr = %base : !ring
    scf.for %visit = %zero to %n step %one {
      %slot = arith.remui %visit, %two : index
      %selected = pto.multi_tile_get %ring[%slot] : !ring -> !cell
      %value = pto.tgetval ins(%selected, %zero : !cell, index) outs : f32 {test.label = "prologue"}
      scf.for %i = %zero to %m step %one {
        pto.tadds ins(%selected, %value : !cell, f32) outs(%selected : !cell) {test.label = "compute"}
        %unused = pto.tgetval ins(%selected, %zero : !cell, index) outs : f32 {test.label = "read"}
      }
      pto.tsetval ins(%zero, %value : index, f32) outs(%selected : !cell) {test.label = "epilogue"}
    }
    return
  }
}
