// RUN: pto-test-opt --pto-insert-sync="gm-alias=may-alias" %s | FileCheck %s --check-prefix=MAY
// RUN: pto-test-opt --pto-insert-sync="gm-alias=assume-disjoint-arguments" %s | FileCheck %s --check-prefix=DISJOINT
// RUN: not pto-test-opt --pto-insert-sync="gm-alias=invalid" %s 2>&1 | FileCheck %s --check-prefix=INVALID
// INVALID: GM mode must be may-alias or assume-disjoint-arguments
//
// The store's GM destination may be the following load's source. Unequal
// function arguments do not themselves establish noalias.
// MAY-LABEL: func.func @gm_contract
// MAY: pto.tstore
// MAY: pto.set_flag[<PIPE_MTE3>, <PIPE_MTE2>
// MAY: pto.wait_flag[<PIPE_MTE3>, <PIPE_MTE2>
// MAY: pto.tload
// DISJOINT-LABEL: func.func @gm_contract
// DISJOINT: pto.tstore
// DISJOINT-NOT: pto.set_flag[<PIPE_MTE3>, <PIPE_MTE2>
// DISJOINT-NOT: pto.wait_flag[<PIPE_MTE3>, <PIPE_MTE2>
// DISJOINT: pto.tload
module attributes {pto.target_arch = "a3"} {
  func.func @gm_contract(%out: !pto.partition_tensor_view<16x16xf16>,
                         %input: !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %zero = arith.constant 0 : i64
    %offset = arith.constant 512 : i64
    %source = pto.alloc_tile addr = %zero : !pto.tile_buf<vec, 16x16xf16>
    %target = pto.alloc_tile addr = %offset : !pto.tile_buf<vec, 16x16xf16>
    pto.tstore ins(%source : !pto.tile_buf<vec, 16x16xf16>) outs(%out : !pto.partition_tensor_view<16x16xf16>)
    pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>) outs(%target : !pto.tile_buf<vec, 16x16xf16>)
    return
  }
}
