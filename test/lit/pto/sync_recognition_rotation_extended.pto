// RUN: %python %S/Inputs/check_rotation_extended.py pto-sync-input-test %s
!tile = !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!ring = !pto.multi_tile_buf<!pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, count=2>
!ring3 = !pto.multi_tile_buf<!pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, count=3>
!partial = !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=16, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!gap = !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=16, v_row=2, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!prefill_tile = !pto.tile_buf<loc=vec, dtype=f16, rows=1, cols=128, v_row=1, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module {
  func.func @parameter_rotation(%n: index, %offset: index) {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i2 = arith.constant 2 : index
    %i3 = arith.constant 3 : index
    %i4 = arith.constant 4 : index
    %one = arith.constant 1.0 : f32
    %ring = pto.alloc_multi_tile addr = %zero : !ring
    scf.for %i = %i0 to %n step %i1 {
      %sum = arith.addi %i, %offset : index
      %slot = arith.remui %sum, %i2 : index
      %tile = pto.multi_tile_get %ring[%slot] : !ring -> !tile
      %v = pto.tgetval ins(%tile, %i0 : !tile, index) outs : f32
    }
    return
  }
  func.func @masked_parameter_rotation(%n: index, %offset: index) {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i2 = arith.constant 2 : index
    %i3 = arith.constant 3 : index
    %i4 = arith.constant 4 : index
    %one = arith.constant 1.0 : f32
    %ring = pto.alloc_multi_tile addr = %zero : !ring
    scf.for %i = %i0 to %n step %i1 {
      %sum = arith.addi %i, %offset : index
      %slot = arith.andi %i1, %sum : index
      %tile = pto.multi_tile_get %ring[%slot] : !ring -> !tile
      %v = pto.tgetval ins(%tile, %i0 : !tile, index) outs : f32
    }
    return
  }
  func.func @noncontiguous_mask(%n: index, %offset: index) {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i2 = arith.constant 2 : index
    %i3 = arith.constant 3 : index
    %i4 = arith.constant 4 : index
    %one = arith.constant 1.0 : f32
    %ring = pto.alloc_multi_tile addr = %zero : !ring3
    scf.for %i = %i0 to %n step %i1 {
      %sum = arith.addi %i, %offset : index
      %slot = arith.andi %sum, %i2 : index
      %tile = pto.multi_tile_get %ring[%slot] : !ring3 -> !tile
      %v = pto.tgetval ins(%tile, %i0 : !tile, index) outs : f32
    }
    return
  }
  func.func @recomputed_invariant_guard(%n: index, %flag: index) {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i2 = arith.constant 2 : index
    %i3 = arith.constant 3 : index
    %i4 = arith.constant 4 : index
    %one = arith.constant 1.0 : f32
    %ring = pto.alloc_multi_tile addr = %zero : !ring
    scf.for %i = %i0 to %n step %i1 {
      %slot = arith.remui %i, %i2 : index
      %tile = pto.multi_tile_get %ring[%slot] : !ring -> !tile
      %enabled = arith.cmpi sgt, %flag, %i0 : index
      scf.if %enabled {
        pto.tsetval ins(%i0, %one : index, f32) outs(%tile : !tile)
      }
    }
    return
  }
  func.func @varying_guard(%n: index) {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i2 = arith.constant 2 : index
    %i3 = arith.constant 3 : index
    %i4 = arith.constant 4 : index
    %one = arith.constant 1.0 : f32
    %ring = pto.alloc_multi_tile addr = %zero : !ring
    scf.for %i = %i0 to %n step %i1 {
      %slot = arith.remui %i, %i2 : index
      %tile = pto.multi_tile_get %ring[%slot] : !ring -> !tile
      %enabled = arith.cmpi eq, %i, %i0 : index
      scf.if %enabled {
        pto.tsetval ins(%i0, %one : index, f32) outs(%tile : !tile)
      }
    }
    return
  }
  func.func @signed_unknown_selector(%n: index, %offset: index) {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i2 = arith.constant 2 : index
    %i3 = arith.constant 3 : index
    %i4 = arith.constant 4 : index
    %one = arith.constant 1.0 : f32
    %ring = pto.alloc_multi_tile addr = %zero : !ring
    scf.for %i = %i0 to %n step %i1 {
      %sum = arith.addi %i, %offset : index
      %slot = arith.remsi %sum, %i2 : index
      %tile = pto.multi_tile_get %ring[%slot] : !ring -> !tile
      %v = pto.tgetval ins(%tile, %i0 : !tile, index) outs : f32
    }
    return
  }
  func.func @nonpower_wrapping_selector(%n: index) {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i2 = arith.constant 2 : index
    %i3 = arith.constant 3 : index
    %i4 = arith.constant 4 : index
    %one = arith.constant 1.0 : f32
    %ring = pto.alloc_multi_tile addr = %zero : !ring3
    scf.for %i = %i0 to %n step %i1 {
      // iv+1 cannot overflow on this loop domain; iv+4 can.
      %sum = arith.addi %i, %i4 : index
      %slot = arith.remui %sum, %i3 : index
      %tile = pto.multi_tile_get %ring[%slot] : !ring3 -> !tile
      %v = pto.tgetval ins(%tile, %i0 : !tile, index) outs : f32
    }
    return
  }
  func.func @partial_overlap_ranges(%n: index) {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %tile = pto.alloc_tile addr = %zero : !partial
    scf.for %i = %i0 to %n step %i1 {
      pto.tinsert ins(%tile, %i1, %i0 : !partial, index, index) outs(%tile : !partial)
    }
    return
  }
  func.func @gap_ranges(%n: index) {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %tile = pto.alloc_tile addr = %zero : !gap
    scf.for %i = %i0 to %n step %i1 {
      pto.tinsert ins(%tile, %i1, %i0 : !gap, index, index) outs(%tile : !gap)
    }
    return
  }
  func.func @yielded_payload_result(%flag: i1) {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i2 = arith.constant 2 : index
    %i3 = arith.constant 3 : index
    %i4 = arith.constant 4 : index
    %one = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %zero : !tile
    %selected = scf.if %flag -> (f32) {
      %v = pto.tgetval ins(%tile, %i0 : !tile, index) outs : f32
      scf.yield %v : f32
    } else {
      scf.yield %one : f32
    }
    pto.tsetval ins(%i0, %selected : index, f32) outs(%tile : !tile)
    %enabled = arith.cmpf ogt, %selected, %one : f32
    scf.if %enabled {
      pto.tsetval ins(%i0, %one : index, f32) outs(%tile : !tile)
    }
    return
  }
  // Reduced from causal_conv1d_prefill: the same bank address is written as
  // (bank*4 + 1)*256 and bank*1024 + 256. Both denote one slot family.
  func.func @factored_physical_rotation(%n: index) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %four = arith.constant 4 : index
    %bytes = arith.constant 256 : index
    %stride = arith.constant 1024 : index
    scf.for %i = %zero to %n step %one {
      %bank = arith.remui %i, %two : index
      %scaled = arith.muli %bank, %four : index
      %slot = arith.addi %scaled, %one : index
      %factored = arith.muli %slot, %bytes : index
      %factored64 = arith.index_cast %factored : index to i64
      %left = pto.alloc_tile addr = %factored64 : !prefill_tile
      %shift = arith.muli %bank, %stride : index
      %flat = arith.addi %shift, %bytes : index
      %flat64 = arith.index_cast %flat : index to i64
      %right = pto.alloc_tile addr = %flat64 : !prefill_tile
      pto.tmov ins(%left : !prefill_tile) outs(%right : !prefill_tile)
    }
    return
  }

}
