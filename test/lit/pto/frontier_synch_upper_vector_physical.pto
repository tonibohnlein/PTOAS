// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch --emit-pto-ir %s -o %t.ir
// RUN: FileCheck %s --check-prefix=IR < %t.ir
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch %s -o %t.cpp
// RUN: FileCheck %s --check-prefix=CPP < %t.cpp
// RUN: pto-frontier-analysis-test --one-way-repair-check %s
// RUN: %python %S/Inputs/minimum_demand/check_upper_physical.py %s %t.ir
!vec = !pto.tile_buf<loc=vec, dtype=i32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module attributes {pto.target_arch = "a3"} {
  func.func @upper_vector(%n: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %addr_src = arith.constant 0 : i64
    %src = pto.alloc_tile addr = %addr_src : !vec
    %addr_a = arith.constant 8192 : i64
    %a = pto.alloc_tile addr = %addr_a : !vec
    %addr_ta = arith.constant 16384 : i64
    %ta = pto.alloc_tile addr = %addr_ta : !vec
    %addr_other = arith.constant 32768 : i64
    %other = pto.alloc_tile addr = %addr_other : !vec
    %addr_x = arith.constant 40960 : i64
    %x = pto.alloc_tile addr = %addr_x : !vec
    %addr_tx = arith.constant 49152 : i64
    %tx = pto.alloc_tile addr = %addr_tx : !vec
    %addr_b = arith.constant 57344 : i64
    %b = pto.alloc_tile addr = %addr_b : !vec
    %addr_tb = arith.constant 65536 : i64
    %tb = pto.alloc_tile addr = %addr_tb : !vec
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    scf.for %i = %zero to %n step %one {
      pto.txor ins(%src, %src, %ta : !vec, !vec, !vec) outs(%a : !vec)
      pto.txor ins(%other, %other, %tx : !vec, !vec, !vec) outs(%x : !vec)
      pto.txor ins(%a, %a, %tb : !vec, !vec, !vec) outs(%b : !vec)
    }
    return
  }
}
// IR-DAG: pto.frontier.physical_status = "certified-periodic-locals"
// IR-DAG: selected_closure = "sound-upper"
// IR: scf.for
// IR: pto.barrier <PIPE_V>
// IR: pto.txor
// IR: pto.barrier <PIPE_ALL>
// IR-NOT: sync.logical_
// CPP: TXOR(
// CPP: pipe_barrier(PIPE_V);
// CPP: pipe_barrier(PIPE_ALL);
