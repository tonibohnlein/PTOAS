// The two RAW demands have different logical sources but the same physical
// cut. The event after the choice captures either arm; its meaning must not
// depend on which demand first caused the cut to be interned.
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-dump --emit-pto-ir \
// RUN:   --mlir-print-ir-after=pto-canonical-sync %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @two_arm_producers_one_physical_cut(
      %condition: i1, %src: !pto.partition_tensor_view<16x128xf32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %input_addr = arith.constant 0 : i64
    %output_addr = arith.constant 8192 : i64
    %one = arith.constant 1.000000e+00 : f32
    %input = pto.alloc_tile addr = %input_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %output = pto.alloc_tile addr = %output_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    scf.if %condition {
      pto.tload ins(%src : !pto.partition_tensor_view<16x128xf32>)
                outs(%input : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
    } else {
      pto.tload ins(%src : !pto.partition_tensor_view<16x128xf32>)
                outs(%input : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
    }
    pto.tmuls ins(%input, %one : !pto.tile_buf<loc=vec, dtype=f32,
                    rows=16, cols=128, v_row=16, v_col=128,
                    blayout=row_major, slayout=none_box, fractal=512,
                    pad=0>, f32)
              outs(%output : !pto.tile_buf<loc=vec, dtype=f32,
                     rows=16, cols=128, v_row=16, v_col=128,
                     blayout=row_major, slayout=none_box, fractal=512,
                     pad=0>)
    return
  }
}

// CHECK-LABEL: CANONICAL-SYNC function=two_arm_producers_one_physical_cut
// CHECK: d0 kind=RAW p0->p2
// CHECK: d1 kind=RAW p1->p2
// CHECK: m0 kind=event resource=AIV:PIPE_MTE2->AIV:PIPE_V
// CHECK-SAME: points=after(scf.if)->before(pto.tmuls)
// CHECK-SAME: origins=[d0, d1]
// CHECK: world=singleton-m0 mechanisms=[m0, m1] covered=[d0, d1, d2, d3, d4]
// CHECK-SAME: oracle=match
// CHECK: PLAN selected=[m0, m1] events=[m0=e0]
// CHECK: VERIFY ok
// CHECK-LABEL: func.func @two_arm_producers_one_physical_cut
// CHECK: scf.if
// CHECK: } else {
// CHECK: }
// CHECK-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// CHECK-NEXT: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// CHECK-NEXT: pto.tmuls
