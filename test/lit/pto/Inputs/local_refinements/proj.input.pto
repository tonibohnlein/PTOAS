module attributes {pto.target_arch = "a3"} {
func.func @proj(%arg0: !pto.ptr<bf16, gm>, %arg1: !pto.ptr<bf16, gm>, %arg2: !pto.ptr<f32, gm>, %arg3: index) attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
  %c0_i64 = arith.constant 0 : i64
  %c4096_i64 = arith.constant 4096 : i64
  %c32768_i64 = arith.constant 32768 : i64
  %c2048_i64 = arith.constant 2048 : i64
  %c16 = arith.constant 16 : index
  %c8192 = arith.constant 8192 : index
  %c1 = arith.constant 1 : index
  %c256 = arith.constant 256 : index
  %c0 = arith.constant 0 : index
  %c64 = arith.constant 64 : index
  %c128 = arith.constant 128 : index
  %0 = pto.make_tensor_view %arg0, shape = [%c16, %c8192], strides = [%c8192, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xbf16>
  %1 = pto.make_tensor_view %arg1, shape = [%c8192, %c8192], strides = [%c8192, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xbf16>
  %2 = pto.make_tensor_view %arg2, shape = [%c16, %c8192], strides = [%c8192, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf32>
  %3 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c256 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
  %4 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c256 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
  scf.for %arg4 = %c0 to %c64 step %c1 {
    %7 = arith.muli %arg4, %c128 : index
    %8 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c128 : !pto.tile_buf<mat, 16x128xbf16, valid=?x?, blayout=col_major, slayout=row_major>
    %9 = arith.maxsi %7, %c0 : index
    %10 = pto.partition_view %0, offsets = [%c0, %9], sizes = [%c16, %c128] : !pto.tensor_view<?x?xbf16>
    pto.tload ins(%10 : !pto.partition_tensor_view<16x128xbf16>) outs(%8 : !pto.tile_buf<mat, 16x128xbf16, valid=?x?, blayout=col_major, slayout=row_major>) {layout = #pto.layout<nd>}
    %11 = pto.alloc_tile addr = %c4096_i64 valid_row = %c128 valid_col = %c256 : !pto.tile_buf<mat, 128x256xbf16, valid=?x?, blayout=col_major, slayout=row_major>
    %12 = arith.maxsi %7, %c0 : index
    %13 = arith.maxsi %arg3, %c0 : index
    %14 = pto.partition_view %1, offsets = [%12, %13], sizes = [%c128, %c256] : !pto.tensor_view<?x?xbf16>
    pto.tload ins(%14 : !pto.partition_tensor_view<128x256xbf16>) outs(%11 : !pto.tile_buf<mat, 128x256xbf16, valid=?x?, blayout=col_major, slayout=row_major>) {layout = #pto.layout<nd>}
    %15 = arith.cmpi eq, %arg4, %c0 : index
    scf.if %15 {
      %16 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c256 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
      %17 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c64 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>
      pto.textract ins(%8, %c0, %c0 : !pto.tile_buf<mat, 16x128xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%17 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>)
      %18 = pto.alloc_tile addr = %c32768_i64 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>
      pto.textract ins(%11, %c0, %c0 : !pto.tile_buf<mat, 128x256xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%18 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>)
      %19 = pto.alloc_tile addr = %c2048_i64 valid_row = %c16 valid_col = %c64 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>
      pto.textract ins(%8, %c0, %c64 : !pto.tile_buf<mat, 16x128xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%19 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>)
      %20 = pto.alloc_tile addr = %c0_i64 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>
      pto.textract ins(%11, %c64, %c0 : !pto.tile_buf<mat, 128x256xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%20 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>)
      pto.tmatmul ins(%17, %18 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>, !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>) outs(%16 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>)
      pto.tmatmul.acc ins(%16, %19, %20 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>, !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>) outs(%16 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>)
    } else {
      %16 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c64 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>
      pto.textract ins(%8, %c0, %c0 : !pto.tile_buf<mat, 16x128xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%16 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>)
      %17 = pto.alloc_tile addr = %c32768_i64 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>
      pto.textract ins(%11, %c0, %c0 : !pto.tile_buf<mat, 128x256xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%17 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>)
      %18 = pto.alloc_tile addr = %c2048_i64 valid_row = %c16 valid_col = %c64 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>
      pto.textract ins(%8, %c0, %c64 : !pto.tile_buf<mat, 16x128xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%18 : !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>)
      %19 = pto.alloc_tile addr = %c0_i64 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>
      pto.textract ins(%11, %c64, %c0 : !pto.tile_buf<mat, 128x256xbf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%19 : !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>)
      pto.tmatmul.acc ins(%4, %16, %17 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>, !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>) outs(%4 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>)
      pto.tmatmul.acc ins(%4, %18, %19 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 16x64xbf16, valid=?x?, slayout=row_major>, !pto.tile_buf<right, 64x256xbf16, valid=?x?, slayout=col_major>) outs(%4 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>)
    }
  }
  %5 = arith.maxsi %arg3, %c0 : index
  %6 = pto.partition_view %2, offsets = [%c0, %5], sizes = [%c16, %c256] : !pto.tensor_view<?x?xf32>
  pto.tstore ins(%4 : !pto.tile_buf<acc, 16x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>) outs(%6 : !pto.partition_tensor_view<16x256xf32>) {layout = #pto.layout<nd>}
  return
}
}
