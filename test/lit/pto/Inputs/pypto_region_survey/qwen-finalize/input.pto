      %33 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c128 : !pto.tile_buf<vec, 16x128xf32, valid=?x?>
      pto.trowexpanddiv ins(%27, %30 : !pto.tile_buf<vec, 16x128xf32, valid=?x?>, !pto.tile_buf<vec, 16x1xf32, valid=?x?, blayout=col_major>) outs(%33 : !pto.tile_buf<vec, 16x128xf32, valid=?x?>) {precisionType = #pto<div_precision default>}
