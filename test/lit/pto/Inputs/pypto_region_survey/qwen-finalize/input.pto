      %38 = arith.muli %16, %c128 : index
      %39 = arith.maxsi %38, %c0 : index
      %40 = pto.partition_view %0, offsets = [%37, %39], sizes = [%c1, %c640] : !pto.tensor_view<?x?xbf16>
      pto.tstore ins(%36 : !pto.tile_buf<vec, 1x640xbf16, valid=?x?>) outs(%40 : !pto.partition_tensor_view<1x640xbf16>) {layout = #pto.layout<nd>}
