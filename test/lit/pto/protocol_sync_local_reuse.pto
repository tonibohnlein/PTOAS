// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir \
// RUN:   --protocol-sync-direct-repair --protocol-sync-fallback=fail \
// RUN:   --protocol-sync-dump=residuals %s -o %t.ir 2> %t.log
// RUN: FileCheck %s --input-file=%t.ir --check-prefix=IR
// RUN: FileCheck %s --input-file=%t.log --check-prefix=WORLD
// RUN: ptoas --pto-arch=a2 --pto-level=level3 --emit-pto-ir \
// RUN:   --protocol-sync-direct-repair --protocol-sync-fallback=fail %s -o %t.a2.ir
// RUN: FileCheck %s --input-file=%t.a2.ir --check-prefix=IR
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir \
// RUN:   --protocol-sync-analysis-only --protocol-sync-dump=concrete-verification \
// RUN:   %t.ir -o /dev/null 2> %t.verify
// RUN: FileCheck %s --input-file=%t.verify --check-prefix=VERIFY
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir \
// RUN:   --protocol-sync-direct-repair --protocol-sync-fallback=fail \
// RUN:   %t.ir -o %t.again.ir
// RUN: diff %t.ir %t.again.ir
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir \
// RUN:   --protocol-sync-mixed --protocol-sync-fallback=fail %s -o %t.mixed.ir
// RUN: ptoas --pto-arch=a2 --pto-level=level3 --emit-pto-ir \
// RUN:   --protocol-sync-mixed --protocol-sync-fallback=fail \
// RUN:   --protocol-sync-gm-alias=assume-disjoint-arguments %s -o %t.a2-mixed.ir
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir \
// RUN:   --protocol-sync-analysis-only --protocol-sync-dump=concrete-verification \
// RUN:   %t.mixed.ir -o /dev/null 2> %t.mixed.verify
// RUN: FileCheck %s --input-file=%t.mixed.verify --check-prefix=VERIFY

// WORLD: PROTOCOL-SYNC selected-world function=@reuse status=complete
// WORLD: canonical-local atoms=4 requirements=7 covered=7 boundary=""
// VERIFY: concrete-verification function=@reuse status=accepted first-failed-stage=none
// IR-LABEL: func.func @reuse
// IR: pto.tload
// IR: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>,
// IR: pto.tabs
// IR: pto.set_flag[<PIPE_V>, <PIPE_MTE2>,
// IR: pto.wait_flag[<PIPE_V>, <PIPE_MTE2>,
// IR: pto.tload
// IR: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>,
// IR: pto.tabs
// IR: pto.barrier <PIPE_V>
// IR: pto.tabs
// IR: pto.tstore
// IR: pto.barrier <PIPE_ALL>

module {
  func.func @reuse(
      %input0: !pto.partition_tensor_view<16x16xf16>,
      %input1: !pto.partition_tensor_view<16x16xf16>,
      %output: !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %c256 = arith.constant 256 : i64
    %c1024 = arith.constant 1024 : i64
    %a = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    %b = pto.alloc_tile addr = %c256 : !pto.tile_buf<vec, 16x16xf16>
    %scratch = pto.alloc_tile addr = %c1024 : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%input0 : !pto.partition_tensor_view<16x16xf16>)
              outs(%a : !pto.tile_buf<vec, 16x16xf16>)
    pto.tabs ins(%a : !pto.tile_buf<vec, 16x16xf16>)
             outs(%scratch : !pto.tile_buf<vec, 16x16xf16>)
    pto.tload ins(%input1 : !pto.partition_tensor_view<16x16xf16>)
              outs(%b : !pto.tile_buf<vec, 16x16xf16>)
    pto.tabs ins(%b : !pto.tile_buf<vec, 16x16xf16>)
             outs(%scratch : !pto.tile_buf<vec, 16x16xf16>)
    pto.tabs ins(%scratch : !pto.tile_buf<vec, 16x16xf16>)
             outs(%scratch : !pto.tile_buf<vec, 16x16xf16>)
    pto.tstore ins(%scratch : !pto.tile_buf<vec, 16x16xf16>)
               outs(%output : !pto.partition_tensor_view<16x16xf16>)
    return
  }
}
