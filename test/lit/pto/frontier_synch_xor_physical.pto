// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch --emit-pto-ir %s -o %t.ir
// RUN: FileCheck %s --check-prefix=IR < %t.ir
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch %s -o %t.cpp
// RUN: FileCheck %s --check-prefix=CPP < %t.cpp
// RUN: pto-test-opt --mlir-disable-threading --pto-insert-sync='algorithm=frontier-synch' %s | FileCheck %s --check-prefix=IR
!vec = !pto.tile_buf<loc=vec, dtype=i32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module attributes {pto.target_arch = "a3"} {
  func.func @repeated_xor_physical(%src: !pto.partition_tensor_view<16x128xi32>,
                                   %dst: !pto.partition_tensor_view<16x128xi32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %a0 = arith.constant 0 : i64
    %a1 = arith.constant 8192 : i64
    %a2 = arith.constant 16384 : i64
    %a3 = arith.constant 24576 : i64
    %input = pto.alloc_tile addr = %a0 : !vec
    %middle = pto.alloc_tile addr = %a1 : !vec
    %output = pto.alloc_tile addr = %a2 : !vec
    %tmp = pto.alloc_tile addr = %a3 : !vec
    pto.tload ins(%src : !pto.partition_tensor_view<16x128xi32>) outs(%input : !vec)
    pto.txor ins(%input, %input, %tmp : !vec, !vec, !vec) outs(%middle : !vec)
    pto.txor ins(%middle, %middle, %tmp : !vec, !vec, !vec) outs(%output : !vec)
    pto.tstore ins(%output : !vec) outs(%dst : !pto.partition_tensor_view<16x128xi32>)
    return
  }
}
// IR-DAG: pto.frontier.physical_status = "certified-finite"
// IR: pto.tload
// IR: pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// IR: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// IR: pto.txor
// IR: pto.barrier <PIPE_V>
// IR: pto.txor
// IR: pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
// IR: pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
// IR: pto.tstore
// IR-NOT: sync.logical_
// CPP: TLOAD(
// CPP: TXOR(
// CPP: pipe_barrier(PIPE_V);
// CPP: TXOR(
// CPP: TSTORE(
