// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch --emit-pto-ir %s -o %t.ir
// RUN: FileCheck %s --check-prefix=IR < %t.ir
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch --emit-pto-ir --report-frontier-costs %s -o %t.cost.ir 2> %t.cost
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch %s -o %t.cpp 2> %t.cpp.log
// RUN: FileCheck %s --check-prefix=CPP < %t.cpp
// RUN: FileCheck %s --check-prefix=LOWERING --allow-empty < %t.cpp.log
// RUN: %python %S/Inputs/minimum_demand/check_periodic_cpp.py %t.cpp %t.guards
// RUN: pto-frontier-analysis-test --periodic-allocation-check %s
// RUN: %python %S/Inputs/minimum_demand/check_periodic_physical.py %s %t.ir %t.cost
!vec = !pto.tile_buf<loc=vec, dtype=i32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!gm = !pto.partition_tensor_view<16x128xi32>
module attributes {pto.target_arch = "a3"} {
  func.func @periodic_pipeline(%src: !gm, %dst: !gm, %n: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>, test.periodic_physical} {
    %address0 = arith.constant 0 : i64
    %tile0 = pto.alloc_tile addr = %address0 : !vec
    %address1 = arith.constant 8192 : i64
    %tile1 = pto.alloc_tile addr = %address1 : !vec
    %address2 = arith.constant 16384 : i64
    %tile2 = pto.alloc_tile addr = %address2 : !vec
    %lb = arith.constant 0 : index
    %step = arith.constant 1 : index
    scf.for %i = %lb to %n step %step {
      pto.tload ins(%src : !gm) outs(%tile0 : !vec)
      pto.txor ins(%tile0, %tile0, %tile2 : !vec, !vec, !vec) outs(%tile1 : !vec)
      pto.tstore ins(%tile1 : !vec) outs(%dst : !gm)
    }
    return
  }
  func.func @periodic_two_phases(%src: !gm, %dst: !gm, %n: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>, test.periodic_physical} {
    %address0 = arith.constant 0 : i64
    %tile0 = pto.alloc_tile addr = %address0 : !vec
    %address1 = arith.constant 8192 : i64
    %tile1 = pto.alloc_tile addr = %address1 : !vec
    %address2 = arith.constant 16384 : i64
    %tile2 = pto.alloc_tile addr = %address2 : !vec
    %address3 = arith.constant 24576 : i64
    %tile3 = pto.alloc_tile addr = %address3 : !vec
    %address4 = arith.constant 32768 : i64
    %tile4 = pto.alloc_tile addr = %address4 : !vec
    %address5 = arith.constant 40960 : i64
    %tile5 = pto.alloc_tile addr = %address5 : !vec
    %lb = arith.constant 0 : index
    %step = arith.constant 1 : index
    scf.for %i = %lb to %n step %step {
      pto.tload ins(%src : !gm) outs(%tile0 : !vec)
      pto.tload ins(%src : !gm) outs(%tile1 : !vec)
      pto.txor ins(%tile0, %tile0, %tile4 : !vec, !vec, !vec) outs(%tile2 : !vec)
      pto.txor ins(%tile1, %tile1, %tile5 : !vec, !vec, !vec) outs(%tile3 : !vec)
      pto.tstore ins(%tile2 : !vec) outs(%dst : !gm)
      pto.tstore ins(%tile3 : !vec) outs(%dst : !gm)
    }
    return
  }
  func.func @periodic_shifted(%src: !gm, %dst: !gm, %n: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>, test.periodic_physical} {
    %address0 = arith.constant 0 : i64
    %tile0 = pto.alloc_tile addr = %address0 : !vec
    %address1 = arith.constant 8192 : i64
    %tile1 = pto.alloc_tile addr = %address1 : !vec
    %address2 = arith.constant 16384 : i64
    %tile2 = pto.alloc_tile addr = %address2 : !vec
    %lb = arith.constant -5 : index
    %step = arith.constant 2 : index
    scf.for %i = %lb to %n step %step {
      pto.tload ins(%src : !gm) outs(%tile0 : !vec)
      pto.txor ins(%tile0, %tile0, %tile2 : !vec, !vec, !vec) outs(%tile1 : !vec)
      pto.tstore ins(%tile1 : !vec) outs(%dst : !gm)
    }
    return
  }
  func.func @periodic_zero(%src: !gm, %dst: !gm, %n: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>, test.periodic_physical} {
    %address0 = arith.constant 0 : i64
    %tile0 = pto.alloc_tile addr = %address0 : !vec
    %address1 = arith.constant 8192 : i64
    %tile1 = pto.alloc_tile addr = %address1 : !vec
    %address2 = arith.constant 16384 : i64
    %tile2 = pto.alloc_tile addr = %address2 : !vec
    %lb = arith.constant 0 : index
    %step = arith.constant 1 : index
    %constant_bound = arith.constant 0 : index
    scf.for %i = %lb to %constant_bound step %step {
      pto.tload ins(%src : !gm) outs(%tile0 : !vec)
      pto.txor ins(%tile0, %tile0, %tile2 : !vec, !vec, !vec) outs(%tile1 : !vec)
      pto.tstore ins(%tile1 : !vec) outs(%dst : !gm)
    }
    return
  }
  func.func @periodic_one(%src: !gm, %dst: !gm, %n: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>, test.periodic_physical} {
    %address0 = arith.constant 0 : i64
    %tile0 = pto.alloc_tile addr = %address0 : !vec
    %address1 = arith.constant 8192 : i64
    %tile1 = pto.alloc_tile addr = %address1 : !vec
    %address2 = arith.constant 16384 : i64
    %tile2 = pto.alloc_tile addr = %address2 : !vec
    %lb = arith.constant 0 : index
    %step = arith.constant 1 : index
    %constant_bound = arith.constant 1 : index
    scf.for %i = %lb to %constant_bound step %step {
      pto.tload ins(%src : !gm) outs(%tile0 : !vec)
      pto.txor ins(%tile0, %tile0, %tile2 : !vec, !vec, !vec) outs(%tile1 : !vec)
      pto.tstore ins(%tile1 : !vec) outs(%dst : !gm)
    }
    return
  }
}
// IR-COUNT-3: pto.frontier.physical_status = "certified-periodic-pools"
// IR-NOT: sync.logical_
// LOWERING-NOT: Unsupported IntegerType width
// CPP: __int128
// CPP: TLOAD(
// CPP: TXOR(
// CPP: TSTORE(
// CPP: pipe_barrier(PIPE_ALL);
