// RUN: pto-test-opt --pto-protocol-sync='execution-mode=analysis dump=schedule' \
// RUN:   %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=SUMMARY
// RUN: not pto-test-opt \
// RUN:   --pto-protocol-sync='execution-mode=direct-repair fallback-mode=fail' \
// RUN:   %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=REJECT

module attributes {pto.target_arch = "a3"} {
  func.func private @unknown_effect(%tile: !pto.tile_buf<vec, 16x16xf16>)
      attributes {pto.tileop.effects = ["consume"], pto.tileop.helper,
                  pto.tileop.kind = "vector"} {
    return
  }

  func.func private @wrong_length(%tile: !pto.tile_buf<vec, 16x16xf16>)
      attributes {pto.tileop.effects = [], pto.tileop.helper,
                  pto.tileop.kind = "vector"} {
    return
  }

  func.func private @non_string_effect(%tile: !pto.tile_buf<vec, 16x16xf16>)
      attributes {pto.tileop.effects = [7 : i64], pto.tileop.helper,
                  pto.tileop.kind = "vector"} {
    return
  }

  func.func private @non_array_effects(%tile: !pto.tile_buf<vec, 16x16xf16>)
      attributes {pto.tileop.effects = "read", pto.tileop.helper,
                  pto.tileop.kind = "vector"} {
    return
  }

  func.func @malformed_helper_effects()
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    func.call @unknown_effect(%tile) : (!pto.tile_buf<vec, 16x16xf16>) -> ()
    func.call @wrong_length(%tile) : (!pto.tile_buf<vec, 16x16xf16>) -> ()
    func.call @non_string_effect(%tile) : (!pto.tile_buf<vec, 16x16xf16>) -> ()
    func.call @non_array_effects(%tile) : (!pto.tile_buf<vec, 16x16xf16>) -> ()
    return
  }
}

// SUMMARY: rejected reason=unsupported-memory-effect-kind
// SUMMARY-SAME: helper effect entry #0 is not a recognized string
// SUMMARY: rejected reason=unsupported-memory-effect-kind
// SUMMARY-SAME: helper effect array length does not match the call operand count
// SUMMARY: rejected reason=unsupported-memory-effect-kind
// SUMMARY-SAME: helper effect entry #0 is not a recognized string
// SUMMARY: rejected reason=unsupported-memory-effect-kind
// SUMMARY-SAME: helper effect metadata must be an array
// REJECT: ProtocolSync direct-repair mode found no complete supported plan
