// RUN: pto-sync-input-test --storage-effects %s | FileCheck %s

// Strided, nested and dynamic descriptor views retain their geometry.
// They do not by themselves specify which bytes an operation accesses.
// CHECK-LABEL: storage views: cells=4 all-materialized=1
// CHECK: effect 0 pto.texpands write intervals cells=
// CHECK: effect 1 pto.texpands write intervals cells=
// CHECK: effect 2 pto.texpands write intervals cells=
// CHECK: effect 3 pto.texpands write intervals cells=
// CHECK: effect 4 pto.texpands write intervals cells=
// CHECK: overlap 1,2=0
// CHECK: overlap 3,2=0
// CHECK: overlap 4,2=1
// CHECK-LABEL: storage unknown: cells=0 all-materialized=0
// CHECK: effect 0 pto.texpands write unresolved cells=
// CHECK: effect 1 pto.tgetval read symbolic cells=
// CHECK: overlap 0,1=1
// CHECK: source-unchanged; dependency-analysis-not-run

!root = !pto.tile_buf<loc=vec, dtype=f32, rows=2, cols=16, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!view = !pto.tile_buf<loc=vec, dtype=f32, rows=2, cols=8, v_row=2, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!row = !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module {
  func.func @views(%r: index) attributes {test.overlap = array<i64: 1, 2, 3, 2, 4, 2>} {
    %zero = arith.constant 0 : i64
    %hole = arith.constant 32 : i64
    %i0 = arith.constant 0 : index
    %one = arith.constant 1.0 : f32
    %root = pto.alloc_tile addr = %zero : !root
    %view = pto.subview %root[%i0, %i0] sizes [2, 8] : !root -> !view
    %nested = pto.subview %view[%i0, %i0] sizes [1, 8] : !view -> !row
    %dynamic = pto.subview %root[%r, %i0] sizes [1, 8] : !root -> !row
    %other = pto.alloc_tile addr = %hole : !row
    pto.texpands ins(%one : f32) outs(%root : !root)
    pto.texpands ins(%one : f32) outs(%view : !view)
    pto.texpands ins(%one : f32) outs(%other : !row)
    pto.texpands ins(%one : f32) outs(%nested : !row)
    pto.texpands ins(%one : f32) outs(%dynamic : !row)
    return
  }
  func.func @unknown(%addr: i64, %i: index) attributes {test.overlap = array<i64: 0, 1>} {
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %unknown = pto.alloc_tile addr = %addr : !root
    %known = pto.alloc_tile addr = %zero : !root
    pto.texpands ins(%one : f32) outs(%unknown : !root)
    %v = pto.tgetval ins(%known, %i : !root, index) outs : f32
    return
  }
}
