// RUN: pto-test-opt --pto-insert-sync --verify-diagnostics %s
// RUN: pto-test-opt --pto-insert-sync="effect-coverage=strict" --verify-diagnostics %s
// Report mode must not turn a malformed authored effect into a promise.
module {
  func.func private @broken(!pto.tile_buf<vec, 16x16xf16>)
      attributes {pto.tileop.kind = "vector", pto.tileop.effects = ["reed"]}
  func.func @caller(%tile: !pto.tile_buf<vec, 16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    // expected-error @+1 {{InsertSync unsupported helper: invalid operand effect}}
    func.call @broken(%tile) : (!pto.tile_buf<vec, 16x16xf16>) -> ()
    return
  }
}
