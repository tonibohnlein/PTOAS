// RUN: pto-sync-input-test --certify-regions %s | FileCheck %s
// CHECK: crossing-costs: both preferences both retries exact-graphs unknown overflow cached-ids reused-indices failed-retention poisoned-export
module {
  func.func @crossing_cost_selection() attributes {test.crossing_costs} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %sixteen = arith.constant 16 : index
    scf.for %i = %zero to %sixteen step %one {
    }
    return
  }
}
