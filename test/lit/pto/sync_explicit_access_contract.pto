// RUN: pto-sync-input-test --region-contract-checks %s | FileCheck %s
// CHECK: synthetic-region-contract explicit_access_contract: 1 passed
// CHECK: synthetic-region-contract explicit_view_contract: 1 passed
// CHECK: synthetic-region-contract pointer_contract: 0 passed
module attributes {pto.target_arch = "a3"} {
  func.func @explicit_access_contract(%offset: index) attributes {test.access_v2} {
    %base = arith.constant 1024 : i64
    %tile = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 2x8xf32>
    %v = pto.tgetval ins(%tile, %offset : !pto.tile_buf<vec, 2x8xf32>, index) outs : f32
    return
  }
  func.func @explicit_view_contract(%offset: index) attributes {test.access_v2} {
    %base = arith.constant 992 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %tile = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 4x8xf32>
    %view = pto.subview %tile[%i1, %i0] sizes [2, 8] : !pto.tile_buf<vec, 4x8xf32> -> !pto.tile_buf<vec, 2x8xf32>
    %v = pto.tgetval ins(%view, %offset : !pto.tile_buf<vec, 2x8xf32>, index) outs : f32
    return
  }
  func.func @pointer_contract(%ptr: !pto.ptr<f32, gm>, %offset: index) attributes {test.pointer_v2, test.no_region} {
    %v = pto.load %ptr[%offset] : !pto.ptr<f32, gm> -> f32
    return
  }
}
