// RUN: %python %S/Inputs/check_physical_refresh.py pto-sync-input-test %s
!mat = !pto.tile_buf<mat, 16x32xf16, blayout=col_major, slayout=row_major>
!left = !pto.tile_buf<left, 16x32xf16, slayout=row_major>
!right = !pto.tile_buf<right, 32x16xf16, slayout=col_major>
!acc = !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>
!ring = !pto.multi_tile_buf<!pto.tile_buf<left, 16x32xf16, slayout=row_major>, count=2>
module attributes {pto.target_arch = "a3"} {
  func.func @overlapping(%n: index, %m: index) attributes {
      test.bounded_lifetime_insertion, test.trace_arguments = array<i64: 3, 2>} {
    %base = arith.constant 0 : i64
    %middle = arith.constant 512 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %mat = pto.alloc_tile addr = %base : !mat
    %ring = pto.alloc_multi_tile addr = %base : !ring
    %overlap = pto.alloc_tile addr = %middle : !left
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    scf.for %i = %zero to %n step %one {
      %slot = arith.remui %i, %two : index
      %left = pto.multi_tile_get %ring[%slot] : !ring -> !left
      %take = arith.cmpi slt, %i, %m : index
      pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left) {test.label = "rotating"}
      scf.if %take {
        pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%overlap : !left) {test.label = "then"}
      } else {
        pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%overlap : !left) {test.label = "else"}
      }
      pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc) {test.label = "compute"}
    }
    return
  }
}
