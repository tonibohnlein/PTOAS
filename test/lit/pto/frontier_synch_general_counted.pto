// RUN: pto-frontier-analysis-test --general-counted-check %s | FileCheck %s
// CHECK: verified general affine counted queries, negative rows, uniform selectors and parent crossings
!acc = !pto.tile_buf<acc, 32x32xf32, blayout=col_major, slayout=row_major, fractal=1024>
module attributes {pto.target_arch = "a3"} {
  func.func @affine(%f: !pto.ptr<f32>, %n: index, %c: i8) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %limit = arith.minsi %n, %c4 : index
    %offset = arith.index_cast %c : i8 to index
    %c32 = arith.constant 32 : index
    %addr = arith.constant 0 : i64
    %view = pto.make_tensor_view %f, shape = [%c32, %c32], strides = [%c32, %c1]
      : !pto.tensor_view<?x?xf32>
    %dst = pto.partition_view %view, offsets = [%c0, %c0], sizes = [%c32, %c32]
      : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<32x32xf32>
    %src = pto.alloc_tile addr = %addr : !acc
    scf.for %i = %c0 to %limit step %c1 {
      pto.tstore ins(%src : !acc) outs(%dst : !pto.partition_tensor_view<32x32xf32>)
      %scaled = arith.muli %i, %c2 : index
      %row = arith.addi %scaled, %offset : index
      scf.for %j = %c0 to %row step %c1 {
        %value = pto.load %f[%c0] : !pto.ptr<f32> -> f32
      }
    }
    return
  }
  func.func @parent(%f: !pto.ptr<f32>, %n: index, %c: i8) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %limit = arith.minsi %n, %c4 : index
    %offset = arith.index_cast %c : i8 to index
    %c32 = arith.constant 32 : index
    %addr = arith.constant 0 : i64
    %view = pto.make_tensor_view %f, shape = [%c32, %c32], strides = [%c32, %c1]
      : !pto.tensor_view<?x?xf32>
    %dst = pto.partition_view %view, offsets = [%c0, %c0], sizes = [%c32, %c32]
      : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<32x32xf32>
    %src = pto.alloc_tile addr = %addr : !acc
    %before = pto.load %f[%c0] : !pto.ptr<f32> -> f32
    %left = pto.alloc_tile addr = %addr
      : !pto.tile_buf<left, 32x32xf16, blayout=row_major, slayout=row_major, fractal=512>
    %right = pto.alloc_tile addr = %addr
      : !pto.tile_buf<right, 32x32xf16, blayout=row_major, slayout=col_major, fractal=512>
    pto.tmatmul ins(%left, %right
      : !pto.tile_buf<left, 32x32xf16, blayout=row_major, slayout=row_major, fractal=512>,
        !pto.tile_buf<right, 32x32xf16, blayout=row_major, slayout=col_major, fractal=512>) outs(%src : !acc)

    scf.for %i = %c0 to %limit step %c1 {
      pto.tstore ins(%src : !acc) outs(%dst : !pto.partition_tensor_view<32x32xf32>)
      %scaled = arith.muli %i, %c2 : index
      %row = arith.addi %scaled, %offset : index
      scf.for %j = %c0 to %row step %c1 {
        %value = pto.load %f[%c0] : !pto.ptr<f32> -> f32
      }
    }
    %after = pto.load %f[%c0] : !pto.ptr<f32> -> f32
    return
  }
  func.func @repeated(%f: !pto.ptr<f32>, %n: index, %c: i8) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %limit = arith.minsi %n, %c4 : index
    %offset = arith.index_cast %c : i8 to index
    %c32 = arith.constant 32 : index
    %addr = arith.constant 0 : i64
    %view = pto.make_tensor_view %f, shape = [%c32, %c32], strides = [%c32, %c1]
      : !pto.tensor_view<?x?xf32>
    %dst = pto.partition_view %view, offsets = [%c0, %c0], sizes = [%c32, %c32]
      : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<32x32xf32>
    %src = pto.alloc_tile addr = %addr : !acc
    scf.for %i = %c0 to %limit step %c1 {
      pto.tstore ins(%src : !acc) outs(%dst : !pto.partition_tensor_view<32x32xf32>)
        {atomicType = #pto<atomic_type atomic_add>}
      %value = pto.load %f[%c0] : !pto.ptr<f32> -> f32
    }
    return
  }
  func.func @cut_order(%f: !pto.ptr<f32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %addr = arith.constant 0 : i64
    %other = arith.constant 4096 : i64
    %view = pto.make_tensor_view %f, shape = [%c32, %c32], strides = [%c32, %c1]
      : !pto.tensor_view<?x?xf32>
    %dst = pto.partition_view %view, offsets = [%c0, %c0], sizes = [%c32, %c32]
      : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<32x32xf32>
    %src = pto.alloc_tile addr = %addr : !acc
    %result = pto.alloc_tile addr = %other : !acc
    %left = pto.alloc_tile addr = %addr
      : !pto.tile_buf<left, 32x32xf16, blayout=row_major, slayout=row_major, fractal=512>
    %right = pto.alloc_tile addr = %addr
      : !pto.tile_buf<right, 32x32xf16, blayout=row_major, slayout=col_major, fractal=512>
    pto.tmatmul ins(%left, %right
      : !pto.tile_buf<left, 32x32xf16, blayout=row_major, slayout=row_major, fractal=512>,
        !pto.tile_buf<right, 32x32xf16, blayout=row_major, slayout=col_major, fractal=512>) outs(%result : !acc)
    pto.tstore ins(%src : !acc) outs(%dst : !pto.partition_tensor_view<32x32xf32>)
    pto.tstore ins(%result : !acc) outs(%dst : !pto.partition_tensor_view<32x32xf32>)
    return
  }
}
