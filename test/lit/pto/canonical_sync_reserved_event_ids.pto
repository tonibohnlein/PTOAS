// RUN: pto-test-opt %s \
// RUN:   '-pto-print-canonical-sync-plan=format=text view=events event-id-num-max=2' \
// RUN:   | FileCheck %s --check-prefix=PLAN
// RUN: pto-test-opt %s '-pto-canonical-sync=event-id-num-max=2' \
// RUN:   | FileCheck %s --check-prefix=IR
// RUN: pto-test-opt %s \
// RUN:   '-pto-print-canonical-sync-plan=format=text view=selection event-id-num-max=2 evict-event-bundle-ids=0' \
// RUN:   | FileCheck %s --check-prefix=SELECTION
// RUN: pto-test-opt %s \
// RUN:   '-pto-print-canonical-sync-plan=format=text view=covering event-id-num-max=2' \
// RUN:   | FileCheck %s --check-prefix=COVERING

module attributes {pto.target_arch = "a2a3"} {
  func.func @reserved_scalar_to_vector_id() {
    %addr0 = arith.constant 0 : i64
    %addr128 = arith.constant 128 : i64
    %addr256 = arith.constant 256 : i64
    %addr384 = arith.constant 384 : i64
    %compare = arith.constant 0.000000e+00 : f16
    %scale = arith.constant 2 : i32
    %src = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 1x32xf16>
    %tmp = pto.alloc_tile addr = %addr128 : !pto.tile_buf<vec, 1x32xui8>
    %dst = pto.alloc_tile addr = %addr256 : !pto.tile_buf<vec, 1x32xi32>
    %count = pto.alloc_tile addr = %addr384 : !pto.tile_buf<vec, 1x32xi32>

    pto.tgather ins(%src, %compare, %tmp :
      !pto.tile_buf<vec, 1x32xf16>, f16, !pto.tile_buf<vec, 1x32xui8>)
      outs(%dst, %count : !pto.tile_buf<vec, 1x32xi32>,
                           !pto.tile_buf<vec, 1x32xi32>)
    pto.tmuls ins(%count, %scale : !pto.tile_buf<vec, 1x32xi32>, i32)
      outs(%count : !pto.tile_buf<vec, 1x32xi32>)
    pto.tmuls ins(%count, %scale : !pto.tile_buf<vec, 1x32xi32>, i32)
      outs(%count : !pto.tile_buf<vec, 1x32xi32>)
    return
  }
}

// PLAN-LABEL: PTOCanonicalSyncPlan @reserved_scalar_to_vector_id
// PLAN: event{{.*}} PIPE_S -> PIPE_V {{.*}}ids=[1]
// PLAN: domain PIPE_S -> PIPE_V {{.*}}available=1 {{.*}}colors=1
// PLAN-SAME: reserved=[0]

// IR-LABEL: func.func @reserved_scalar_to_vector_id
// IR: pto.set_flag[<PIPE_S>, <PIPE_V>, <EVENT_ID1>]
// IR: pto.wait_flag[<PIPE_S>, <PIPE_V>, <EVENT_ID1>]
// IR-NOT: pto.set_flag[<PIPE_S>, <PIPE_V>, <EVENT_ID0>]

// SELECTION-LABEL: PTOCanonicalSyncPlan @reserved_scalar_to_vector_id
// SELECTION: eviction mechanisms=[event-bundle[0]]
// SELECTION: color PIPE_S -> PIPE_V before=1 after=0 available=1
// SELECTION: uncovered requirement[0] 3 -> 4 pipes=PIPE_S->PIPE_V kind=memory-raw
// SELECTION-NEXT: uncovered requirement[1] 3 -> 4 pipes=PIPE_S->PIPE_V kind=memory-waw

// COVERING-LABEL: PTOCanonicalSyncPlan @reserved_scalar_to_vector_id
// COVERING: covering-selection status=ready error=none
// COVERING-SAME: providers=[mechanism[0]=barrier[0], mechanism[1]=event-bundle[0]]
// COVERING: covering-allocation mechanism[1]=event-bundle[0]
// COVERING-SAME: use=0 domain={{[0-9]+}} kind=event-id resources=PIPE_S->PIPE_V ids=[1]
