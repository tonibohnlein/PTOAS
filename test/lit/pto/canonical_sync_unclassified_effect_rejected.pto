// RUN: not ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-analysis-only --emit-pto-ir %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func private @opaque_effect() {
    return
  }

  func.func @reject_unclassified_call()
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    func.call @opaque_effect() : () -> ()
    return
  }
}

// CHECK: error: canonical sync rejects an unclassified physical or effectful operation
