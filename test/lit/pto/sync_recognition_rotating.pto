// Rotating recognition uses the shared exact scalar access maps.
// RUN: pto-sync-input-test --recognize %s | FileCheck %s

// A parameter trip count is retained. The same recognition applies to zero,
// short and large trips; only two static accesses are inspected.
// CHECK-LABEL: recognition rotating
// CHECK: recognize arithmetic: applicable backend=available
// CHECK: recognize explicit: not-applicable
// CHECK: recognize rotating: applicable backend=available
// CHECK: rotation family=0 slots=2 stride=1 offset=0 refresh=2 atom=[0,4)
// CHECK: rotation family=0 slots=2 stride=1 offset=0 refresh=2 atom=[0,4)
// CHECK-LABEL: recognition tile_write
// CHECK: recognize rotating: applicable backend=available
// CHECK: rotation family=0 slots=2 stride=1 offset=0 refresh=2 atom=[0,1024)
// CHECK-LABEL: recognition shifted
// CHECK: recognize rotating: applicable backend=available
// CHECK: rotation family=0 slots=2 stride=1 offset=1 refresh=2 atom=[0,4)
// CHECK-LABEL: recognition nested
// CHECK: recognize arithmetic: applicable backend=available
// CHECK: recognize rotating: not-applicable backend=available
// CHECK-NEXT: issue structured-body
// CHECK: recognize rotating: applicable backend=available
// CHECK: rotation family=0 slots=2 stride=1 offset=0 refresh=2 atom=[0,4)
// CHECK-LABEL: recognition unknown_geometry
// CHECK: recognize rotating: missing-premise backend=available
// CHECK: issue unknown-geometry
// CHECK: rotation family=0 slots=1 stride=0 offset=0 refresh=1 atom=unknown
// CHECK-LABEL: recognition three_slots
// CHECK: recognize arithmetic: missing-premise backend=available
// CHECK: issue index-arithmetic
// CHECK: recognize rotating: applicable backend=available
// CHECK: rotation family=0 slots=3 stride=1 offset=0 refresh=3 atom=[0,4)
// CHECK-LABEL: recognition billion_trips
// CHECK: recognize rotating: applicable backend=available
// CHECK: rotation family=0 slots=2 stride=1 offset=0 refresh=2 atom=[0,4)
// CHECK-LABEL: recognition zero_trips
// CHECK: recognize rotating: applicable backend=available
// CHECK: rotation family=0 slots=2 stride=1 offset=0 refresh=2 atom=[0,4)
// CHECK: source-unchanged; synchronization-insertion-not-run

!tile = !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!ring = !pto.multi_tile_buf<!pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, count=2>
!ring3 = !pto.multi_tile_buf<!pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, count=3>
module {
  func.func @rotating(%n: index) {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i2 = arith.constant 2 : index
    %one = arith.constant 1.0 : f32
    %ring = pto.alloc_multi_tile addr = %zero : !ring
    scf.for %i = %i0 to %n step %i1 {
      %slot = arith.remui %i, %i2 : index
      %tile = pto.multi_tile_get %ring[%slot] : !ring -> !tile
      pto.tsetval ins(%i0, %one : index, f32) outs(%tile : !tile)
      %v = pto.tgetval ins(%tile, %i0 : !tile, index) outs : f32
    }
    return
  }
  func.func @tile_write(%n: index) {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i2 = arith.constant 2 : index
    %one = arith.constant 1.0 : f32
    %ring = pto.alloc_multi_tile addr = %zero : !ring
    scf.for %i = %i0 to %n step %i1 {
      %slot = arith.remui %i, %i2 : index
      %tile = pto.multi_tile_get %ring[%slot] : !ring -> !tile
      pto.texpands ins(%one : f32) outs(%tile : !tile)
    }
    return
  }
  func.func @shifted(%n: index) {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i2 = arith.constant 2 : index
    %one = arith.constant 1.0 : f32
    %ring = pto.alloc_multi_tile addr = %zero : !ring
    scf.for %i = %i0 to %n step %i1 {
      %shift = arith.addi %i, %i1 : index
      %slot = arith.remui %shift, %i2 : index
      %tile = pto.multi_tile_get %ring[%slot] : !ring -> !tile
      pto.tsetval ins(%i0, %one : index, f32) outs(%tile : !tile)
      %v = pto.tgetval ins(%tile, %i0 : !tile, index) outs : f32
    }
    return
  }
  func.func @nested(%n: index) {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i2 = arith.constant 2 : index
    %one = arith.constant 1.0 : f32
    %ring = pto.alloc_multi_tile addr = %zero : !ring
    scf.for %outer = %i0 to %n step %i1 {
    scf.for %i = %i0 to %n step %i1 {
      %slot = arith.remui %i, %i2 : index
      %tile = pto.multi_tile_get %ring[%slot] : !ring -> !tile
      pto.tsetval ins(%i0, %one : index, f32) outs(%tile : !tile)
      %v = pto.tgetval ins(%tile, %i0 : !tile, index) outs : f32
    }
    }
    return
  }
  func.func @unknown_geometry(%n: index, %addr: i64) {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i2 = arith.constant 2 : index
    %one = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %addr : !tile
    scf.for %i = %i0 to %n step %i1 {
      %slot = arith.remui %i, %i2 : index
      pto.tsetval ins(%i0, %one : index, f32) outs(%tile : !tile)
      %v = pto.tgetval ins(%tile, %i0 : !tile, index) outs : f32
    }
    return
  }
  func.func @three_slots(%n: index) {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i2 = arith.constant 3 : index
    %one = arith.constant 1.0 : f32
    %ring = pto.alloc_multi_tile addr = %zero : !ring3
    scf.for %i = %i0 to %n step %i1 {
      %slot = arith.remui %i, %i2 : index
      %tile = pto.multi_tile_get %ring[%slot] : !ring3 -> !tile
      pto.tsetval ins(%i0, %one : index, f32) outs(%tile : !tile)
      %v = pto.tgetval ins(%tile, %i0 : !tile, index) outs : f32
    }
    return
  }
  func.func @billion_trips() {
    %n = arith.constant 1000000000 : index
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i2 = arith.constant 2 : index
    %one = arith.constant 1.0 : f32
    %ring = pto.alloc_multi_tile addr = %zero : !ring
    scf.for %i = %i0 to %n step %i1 {
      %slot = arith.remui %i, %i2 : index
      %tile = pto.multi_tile_get %ring[%slot] : !ring -> !tile
      pto.tsetval ins(%i0, %one : index, f32) outs(%tile : !tile)
      %v = pto.tgetval ins(%tile, %i0 : !tile, index) outs : f32
    }
    return
  }
  func.func @zero_trips() {
    %n = arith.constant 0 : index
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i2 = arith.constant 2 : index
    %one = arith.constant 1.0 : f32
    %ring = pto.alloc_multi_tile addr = %zero : !ring
    scf.for %i = %i0 to %n step %i1 {
      %slot = arith.remui %i, %i2 : index
      %tile = pto.multi_tile_get %ring[%slot] : !ring -> !tile
      pto.tsetval ins(%i0, %one : index, f32) outs(%tile : !tile)
      %v = pto.tgetval ins(%tile, %i0 : !tile, index) outs : f32
    }
    return
  }
}
