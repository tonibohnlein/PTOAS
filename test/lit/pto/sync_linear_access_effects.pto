// RUN: pto-sync-input-test --storage-effects %s | FileCheck %s
// RUN: pto-sync-input-test --phase-copy-checks %s | FileCheck %s --check-prefix=COPY
// COPY: phase-copy-check {{.*}}: passed
// CHECK-LABEL: storage tile_scalar: cells=2 all-exact=1
// CHECK: cell 0 space=6 [1024,1028)
// CHECK: cell 1 space=6 [1028,1032)
// CHECK: effect 0 pto.tsetval write exact definite-write=1 cells=0
// CHECK: effect 1 pto.tgetval read exact definite-write=0 cells=1
// CHECK: effect 2 pto.tgetval read exact definite-write=0 cells=0
// CHECK: access base=absolute bytes=4 map=()[s0] -> ((s0 mod 4294967296) * 4 + 1024)
// CHECK: overlap 0,1=0
// CHECK: overlap 0,2=1
// CHECK: overlap 0,3=1
// CHECK-LABEL: storage tile_view: cells=1 all-exact=1
// CHECK: cell 0 space=6 [1060,1064)
// CHECK-LABEL: storage pointer_scalar: cells=2 all-exact=1
// CHECK: access base=pointer bytes=4 map=() -> (4)
// CHECK: access base=pointer bytes=4 map=() -> (8)
// CHECK: access base=pointer bytes=4 map=()[s0] -> (s0 * 4)
// CHECK: overlap 0,1=0
// CHECK: overlap 0,2=1
// CHECK-LABEL: storage pointer_vector: cells=1 all-exact=1
// CHECK: access base=pointer bytes=16 map=() -> (32)
// CHECK: access base=pointer bytes=16 map=() -> (32)
// CHECK: overlap 0,1=1
// CHECK-LABEL: storage padded_vector: cells=0 all-exact=0
// CHECK: effect 0 pto.load read unknown definite-write=0
// CHECK-LABEL: storage loop_offset: cells=0 all-exact=1
// CHECK: access base=absolute bytes=4 map=()[s0] -> ((s0 mod 4294967296) * 4 + 1024) extents= loops=1
!tile = !pto.tile_buf<vec, 4x8xf32>
!view = !pto.tile_buf<vec, 2x8xf32>
module attributes {pto.target_arch = "a3"} {
  func.func @tile_scalar(%offset: index) attributes {test.overlap = array<i64: 0, 1, 0, 2, 0, 3>} {
    %base = arith.constant 1024 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %wrap = arith.constant 4294967296 : index
    %value = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %base : !tile
    pto.tsetval ins(%zero, %value : index, f32) outs(%tile : !tile)
    %a = pto.tgetval ins(%tile, %one : !tile, index) outs : f32
    %b = pto.tgetval ins(%tile, %wrap : !tile, index) outs : f32
    %c = pto.tgetval ins(%tile, %offset : !tile, index) outs : f32
    return
  }
  func.func @tile_view() {
    %base = arith.constant 1024 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %tile = pto.alloc_tile addr = %base : !tile
    %view = pto.subview %tile[%one, %zero] sizes [2, 8] : !tile -> !view
    %v = pto.tgetval ins(%view, %one : !view, index) outs : f32
    return
  }
  func.func @pointer_scalar(%p: !pto.ptr<f32, gm>, %offset: index) attributes {test.overlap = array<i64: 0, 1, 0, 2>} {
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %v = pto.load %p[%one] : !pto.ptr<f32, gm> -> f32
    pto.store %v, %p[%two] : !pto.ptr<f32, gm>, f32
    pto.store %v, %p[%offset] : !pto.ptr<f32, gm>, f32
    return
  }
  func.func @pointer_vector(%p: !pto.ptr<vector<4xf32>, gm>) attributes {test.overlap = array<i64: 0, 1>} {
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %next = pto.addptr %p, %one : !pto.ptr<vector<4xf32>, gm> -> !pto.ptr<vector<4xf32>, gm>
    %v = pto.load %next[%one] : !pto.ptr<vector<4xf32>, gm> -> vector<4xf32>
    pto.store %v, %p[%two] : !pto.ptr<vector<4xf32>, gm>, vector<4xf32>
    return
  }
  func.func @padded_vector(%p: !pto.ptr<vector<3xf32>, gm>) {
    %one = arith.constant 1 : index
    %v = pto.load %p[%one] : !pto.ptr<vector<3xf32>, gm> -> vector<3xf32>
    return
  }
  func.func @loop_offset(%n: index) {
    %base = arith.constant 1024 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %tile = pto.alloc_tile addr = %base : !tile
    scf.for %i = %zero to %n step %one {
      %v = pto.tgetval ins(%tile, %i : !tile, index) outs : f32
    }
    return
  }
}
