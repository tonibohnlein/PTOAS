// Seven top-level boundary handshakes exhaust the compiler event pool.
// Boundary handshakes have two primed directions and do not implement the
// forward-handoff chain required by the release-pool proof, so scarcity repair
// must reject rather than pool their release lanes.
// RUN: not ptoas --pto-arch=a3 --pto-level=level3 \
// RUN:   --enable-canonical-sync --emit-pto-ir %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @boundary_release_pool_rejected(
      %src: !pto.partition_tensor_view<16x128xf32>, %condition: i1)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %input_addr = arith.constant 0 : i64
    %output_addr = arith.constant 8192 : i64
    %zero = arith.constant 0 : index
    %one_index = arith.constant 1 : index
    %two = arith.constant 2 : index
    %one = arith.constant 1.000000e+00 : f32
    %input = pto.alloc_tile addr = %input_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %output = pto.alloc_tile addr = %output_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    scf.for %i0 = %zero to %two step %one_index {
      scf.if %condition {
        pto.tload ins(%src : !pto.partition_tensor_view<16x128xf32>)
                  outs(%input : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                         cols=128, v_row=16, v_col=128, blayout=row_major,
                         slayout=none_box, fractal=512, pad=0>)
      } else {
        pto.tmuls ins(%input, %one : !pto.tile_buf<loc=vec, dtype=f32,
                        rows=16, cols=128, v_row=16, v_col=128,
                        blayout=row_major, slayout=none_box, fractal=512,
                        pad=0>, f32)
                  outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                         cols=128, v_row=16, v_col=128, blayout=row_major,
                         slayout=none_box, fractal=512, pad=0>)
      }
    }
    scf.for %i1 = %zero to %two step %one_index {
      scf.if %condition {
        pto.tload ins(%src : !pto.partition_tensor_view<16x128xf32>)
                  outs(%input : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                         cols=128, v_row=16, v_col=128, blayout=row_major,
                         slayout=none_box, fractal=512, pad=0>)
      } else {
        pto.tmuls ins(%input, %one : !pto.tile_buf<loc=vec, dtype=f32,
                        rows=16, cols=128, v_row=16, v_col=128,
                        blayout=row_major, slayout=none_box, fractal=512,
                        pad=0>, f32)
                  outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                         cols=128, v_row=16, v_col=128, blayout=row_major,
                         slayout=none_box, fractal=512, pad=0>)
      }
    }
    scf.for %i2 = %zero to %two step %one_index {
      scf.if %condition {
        pto.tload ins(%src : !pto.partition_tensor_view<16x128xf32>)
                  outs(%input : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                         cols=128, v_row=16, v_col=128, blayout=row_major,
                         slayout=none_box, fractal=512, pad=0>)
      } else {
        pto.tmuls ins(%input, %one : !pto.tile_buf<loc=vec, dtype=f32,
                        rows=16, cols=128, v_row=16, v_col=128,
                        blayout=row_major, slayout=none_box, fractal=512,
                        pad=0>, f32)
                  outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                         cols=128, v_row=16, v_col=128, blayout=row_major,
                         slayout=none_box, fractal=512, pad=0>)
      }
    }
    scf.for %i3 = %zero to %two step %one_index {
      scf.if %condition {
        pto.tload ins(%src : !pto.partition_tensor_view<16x128xf32>)
                  outs(%input : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                         cols=128, v_row=16, v_col=128, blayout=row_major,
                         slayout=none_box, fractal=512, pad=0>)
      } else {
        pto.tmuls ins(%input, %one : !pto.tile_buf<loc=vec, dtype=f32,
                        rows=16, cols=128, v_row=16, v_col=128,
                        blayout=row_major, slayout=none_box, fractal=512,
                        pad=0>, f32)
                  outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                         cols=128, v_row=16, v_col=128, blayout=row_major,
                         slayout=none_box, fractal=512, pad=0>)
      }
    }
    scf.for %i4 = %zero to %two step %one_index {
      scf.if %condition {
        pto.tload ins(%src : !pto.partition_tensor_view<16x128xf32>)
                  outs(%input : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                         cols=128, v_row=16, v_col=128, blayout=row_major,
                         slayout=none_box, fractal=512, pad=0>)
      } else {
        pto.tmuls ins(%input, %one : !pto.tile_buf<loc=vec, dtype=f32,
                        rows=16, cols=128, v_row=16, v_col=128,
                        blayout=row_major, slayout=none_box, fractal=512,
                        pad=0>, f32)
                  outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                         cols=128, v_row=16, v_col=128, blayout=row_major,
                         slayout=none_box, fractal=512, pad=0>)
      }
    }
    scf.for %i5 = %zero to %two step %one_index {
      scf.if %condition {
        pto.tload ins(%src : !pto.partition_tensor_view<16x128xf32>)
                  outs(%input : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                         cols=128, v_row=16, v_col=128, blayout=row_major,
                         slayout=none_box, fractal=512, pad=0>)
      } else {
        pto.tmuls ins(%input, %one : !pto.tile_buf<loc=vec, dtype=f32,
                        rows=16, cols=128, v_row=16, v_col=128,
                        blayout=row_major, slayout=none_box, fractal=512,
                        pad=0>, f32)
                  outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                         cols=128, v_row=16, v_col=128, blayout=row_major,
                         slayout=none_box, fractal=512, pad=0>)
      }
    }
    scf.for %i6 = %zero to %two step %one_index {
      scf.if %condition {
        pto.tload ins(%src : !pto.partition_tensor_view<16x128xf32>)
                  outs(%input : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                         cols=128, v_row=16, v_col=128, blayout=row_major,
                         slayout=none_box, fractal=512, pad=0>)
      } else {
        pto.tmuls ins(%input, %one : !pto.tile_buf<loc=vec, dtype=f32,
                        rows=16, cols=128, v_row=16, v_col=128,
                        blayout=row_major, slayout=none_box, fractal=512,
                        pad=0>, f32)
                  outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                         cols=128, v_row=16, v_col=128, blayout=row_major,
                         slayout=none_box, fractal=512, pad=0>)
      }
    }
    return
  }
}

// CHECK: error: canonical sync exhausted compiler event IDs
// CHECK-SAME: domain AIV:PIPE_MTE2 -> PIPE_V
