// RUN: split-file %s %t
// RUN: not pto-test-opt \
// RUN:   --pto-protocol-sync='execution-mode=ready-release fallback-mode=fail dump=plan statistics=1' \
// RUN:   --mlir-print-ir-after-failure %t/module-atomicity.pto -o /dev/null 2>&1 | \
// RUN:   FileCheck %s --check-prefix=ATOMIC
// RUN: not pto-test-opt \
// RUN:   --pto-protocol-sync='execution-mode=ready-release fallback-mode=fail dump=plan' \
// RUN:   %t/constant-slot-two.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=CONSTANT-SLOT
// RUN: not pto-test-opt \
// RUN:   --pto-protocol-sync='execution-mode=ready-release fallback-mode=fail' \
// RUN:   %t/existing-sync.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=EXISTING
// RUN: pto-test-opt \
// RUN:   --pto-protocol-sync='execution-mode=ready-release fallback-mode=legacy statistics=1' \
// RUN:   %t/existing-sync.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=FALLBACK
// RUN: sed 's/pto.target_arch = "a3"/pto.target_arch = "a2"/' \
// RUN:   %t/existing-sync.pto > %t/existing-sync-a2.pto
// RUN: not pto-test-opt \
// RUN:   --pto-protocol-sync='execution-mode=ready-release fallback-mode=legacy dump=plan statistics=1' \
// RUN:   %t/existing-sync-a2.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=A2-FALLBACK
// RUN: not pto-test-opt \
// RUN:   --pto-protocol-sync='execution-mode=ready-release fallback-mode=fail dump=plan' \
// RUN:   %t/intervening-structural.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=INTERVENING

// ATOMIC: "failure_stage":"module-transaction"
// ATOMIC-SAME: "function":"would_be_supported"
// ATOMIC-SAME: "planner_result":"rolled-back"
// ATOMIC-SAME: "producer":"protocol-plan"
// ATOMIC-SAME: "status":"rolled-back"
// ATOMIC: IR Dump After PTOProtocolSync
// ATOMIC-LABEL: func.func @would_be_supported
// ATOMIC: scf.for
// ATOMIC-NOT: pto.protocol_sync.generated
// ATOMIC: return
// ATOMIC-LABEL: func.func @later_rejection
// ATOMIC-NOT: pto.protocol_sync.generated
// ATOMIC: return

// CONSTANT-SLOT: PROTOCOL-SYNC ready-release-plan function=@constant_slot_two status=unsupported
// CONSTANT-SLOT: reason=non-ready-release-channel
// CONSTANT-SLOT: ProtocolSync ready-release mode found no complete supported plan

// EXISTING: ProtocolSync ready-release mode found no complete supported plan

// FALLBACK: "fallback":"unsupported"
// FALLBACK-SAME: "planner_result":"legacy-fallback-unsupported"
// FALLBACK-SAME: "producer":"legacy-fallback-unsupported"
// FALLBACK-SAME: "status":"ok"

// A2-FALLBACK: PROTOCOL-SYNC ready-release-plan function=@existing_sync status=unsupported
// A2-FALLBACK: reason=unsupported-target
// A2-FALLBACK-SAME: target profile 'npu2201-a2-protocol-sync-v1' has no ProtocolSync ReadyRelease qualification record
// A2-FALLBACK-NOT: legacy-fallback
// A2-FALLBACK: "producer":"fail-closed-policy"

// INTERVENING: PROTOCOL-SYNC ready-release-plan function=@intervening_structural status=unsupported
// INTERVENING: reason=unsupported-function-shape
// INTERVENING: ProtocolSync ready-release mode found no complete supported plan

//--- module-atomicity.pto
module attributes {pto.target_arch = "a3"} {
  func.func @would_be_supported(
      %input: !pto.partition_tensor_view<16x16xf16>,
      %trip_count: index)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0_index = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c0 = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    scf.for %index = %c0_index to %trip_count step %c1 {
      pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>)
                outs(%tile : !pto.tile_buf<vec, 16x16xf16>)
      %value = pto.tgetval ins(%tile, %c0_index : !pto.tile_buf<vec, 16x16xf16>, index) outs : f16
    }
    return
  }

  func.func @later_rejection() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    pto.tabs ins(%tile : !pto.tile_buf<vec, 16x16xf16>)
             outs(%tile : !pto.tile_buf<vec, 16x16xf16>)
    return
  }
}

//--- constant-slot-two.pto
module attributes {pto.target_arch = "a3"} {
  func.func @constant_slot_two(
      %input: !pto.partition_tensor_view<16x16xf16>,
      %trip_count: index)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0_index = arith.constant 0 : index
    %c1_index = arith.constant 1 : index
    %c0 = arith.constant 0 : i64
    %buffers = pto.alloc_multi_tile addr = %c0
        : !pto.multi_tile_buf<vec, 16x16xf16, count=2>
    scf.for %index = %c0_index to %trip_count step %c1_index {
      %slot = pto.multi_tile_get %buffers[%c0_index]
          : !pto.multi_tile_buf<vec, 16x16xf16, count=2>
         -> !pto.tile_buf<vec, 16x16xf16>
      pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>)
                outs(%slot : !pto.tile_buf<vec, 16x16xf16>)
      %value = pto.tgetval ins(%slot, %c0_index : !pto.tile_buf<vec, 16x16xf16>, index) outs : f16
    }
    return
  }
}

//--- existing-sync.pto
module attributes {pto.target_arch = "a3"} {
  func.func @existing_sync(
      %input: !pto.partition_tensor_view<16x16xf16>,
      %output: !pto.partition_tensor_view<16x16xf16>,
      %trip_count: index)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0_index = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c0 = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    scf.for %index = %c0_index to %trip_count step %c1 {
      pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>)
                outs(%tile : !pto.tile_buf<vec, 16x16xf16>)
      pto.set_flag[<PIPE_MTE2>, <PIPE_MTE3>, <EVENT_ID0>]
      pto.wait_flag[<PIPE_MTE2>, <PIPE_MTE3>, <EVENT_ID0>]
      pto.tstore ins(%tile : !pto.tile_buf<vec, 16x16xf16>)
                 outs(%output : !pto.partition_tensor_view<16x16xf16>)
    }
    return
  }
}

//--- intervening-structural.pto
module attributes {pto.target_arch = "a3"} {
  func.func @intervening_structural(
      %input: !pto.partition_tensor_view<16x16xf16>,
      %trip_count: index)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0_index = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c0 = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    scf.for %index = %c0_index to %trip_count step %c1 {
      pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>)
                outs(%tile : !pto.tile_buf<vec, 16x16xf16>)
      %unused = arith.constant 7 : index
      %value = pto.tgetval ins(%tile, %c0_index : !pto.tile_buf<vec, 16x16xf16>, index) outs : f16
    }
    return
  }
}
