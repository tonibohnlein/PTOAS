// Completion of a prefix store does not establish GM publication to a loop
// load. Disjoint-arguments mode cannot remove overlap on the very same argument.
// RUN: not ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-fallback=fail --protocol-sync-gm-alias=may-alias %s -o %t.safe.ir 2>&1 | FileCheck %s
// RUN: not ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-fallback=fail --protocol-sync-gm-alias=assume-disjoint-arguments %s -o %t.disjoint.ir 2>&1 | FileCheck %s
// CHECK: ProtocolSync mixed mode found no complete supported plan

module {
  func.func @unqualified_loop_publication(%n: index,
      %gm: !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %a = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%gm : !pto.partition_tensor_view<16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
    pto.tstore ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%gm : !pto.partition_tensor_view<16x16xf16>)
    scf.for %i = %zero to %n step %one {
      pto.tload ins(%gm : !pto.partition_tensor_view<16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
      pto.tabs ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
    }
    pto.tstore ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%gm : !pto.partition_tensor_view<16x16xf16>)
    return
  }
}
