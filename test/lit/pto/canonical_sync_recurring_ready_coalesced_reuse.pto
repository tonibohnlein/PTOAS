// Each loop requires seven recurring S-to-V ready generations.  The six-ID
// compiler pool therefore coalesces each loop's compatible physical cuts.
// Because the two complete loop lifetimes are sequential and each coalesced
// ready lane retains its reverse release drain, the two scarcity groups may
// then share one ready ID without sharing their release IDs.
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-dump --emit-pto-ir %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @coalesced_recurring_ready_lanes_share()
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %scalar_addr = arith.constant 0 : i64
    %input_addr = arith.constant 4096 : i64
    %output_addr = arith.constant 12288 : i64
    %zero = arith.constant 0 : index
    %one_index = arith.constant 1 : index
    %two = arith.constant 2 : index
    %scalar = pto.alloc_tile addr = %scalar_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1,
                    v_col=8, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %input = pto.alloc_tile addr = %input_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %output = pto.alloc_tile addr = %output_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    scf.for %iteration = %zero to %two step %one_index {
      %value0 = pto.tgetval ins(%scalar, %zero :
                      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                        v_row=1, v_col=8, blayout=row_major,
                        slayout=none_box, fractal=512, pad=0>, index)
                outs : f32
      %value1 = pto.tgetval ins(%scalar, %zero :
                      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                        v_row=1, v_col=8, blayout=row_major,
                        slayout=none_box, fractal=512, pad=0>, index)
                outs : f32
      %value2 = pto.tgetval ins(%scalar, %zero :
                      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                        v_row=1, v_col=8, blayout=row_major,
                        slayout=none_box, fractal=512, pad=0>, index)
                outs : f32
      %value3 = pto.tgetval ins(%scalar, %zero :
                      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                        v_row=1, v_col=8, blayout=row_major,
                        slayout=none_box, fractal=512, pad=0>, index)
                outs : f32
      %value4 = pto.tgetval ins(%scalar, %zero :
                      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                        v_row=1, v_col=8, blayout=row_major,
                        slayout=none_box, fractal=512, pad=0>, index)
                outs : f32
      %value5 = pto.tgetval ins(%scalar, %zero :
                      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                        v_row=1, v_col=8, blayout=row_major,
                        slayout=none_box, fractal=512, pad=0>, index)
                outs : f32
      %value6 = pto.tgetval ins(%scalar, %zero :
                      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                        v_row=1, v_col=8, blayout=row_major,
                        slayout=none_box, fractal=512, pad=0>, index)
                outs : f32
      pto.tmuls ins(%input, %value0 : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
      pto.tmuls ins(%input, %value1 : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
      pto.tmuls ins(%input, %value2 : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
      pto.tmuls ins(%input, %value3 : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
      pto.tmuls ins(%input, %value4 : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
      pto.tmuls ins(%input, %value5 : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
      pto.tmuls ins(%input, %value6 : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
    }
    scf.for %iteration = %zero to %two step %one_index {
      %value0 = pto.tgetval ins(%scalar, %zero :
                      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                        v_row=1, v_col=8, blayout=row_major,
                        slayout=none_box, fractal=512, pad=0>, index)
                outs : f32
      %value1 = pto.tgetval ins(%scalar, %zero :
                      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                        v_row=1, v_col=8, blayout=row_major,
                        slayout=none_box, fractal=512, pad=0>, index)
                outs : f32
      %value2 = pto.tgetval ins(%scalar, %zero :
                      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                        v_row=1, v_col=8, blayout=row_major,
                        slayout=none_box, fractal=512, pad=0>, index)
                outs : f32
      %value3 = pto.tgetval ins(%scalar, %zero :
                      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                        v_row=1, v_col=8, blayout=row_major,
                        slayout=none_box, fractal=512, pad=0>, index)
                outs : f32
      %value4 = pto.tgetval ins(%scalar, %zero :
                      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                        v_row=1, v_col=8, blayout=row_major,
                        slayout=none_box, fractal=512, pad=0>, index)
                outs : f32
      %value5 = pto.tgetval ins(%scalar, %zero :
                      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                        v_row=1, v_col=8, blayout=row_major,
                        slayout=none_box, fractal=512, pad=0>, index)
                outs : f32
      %value6 = pto.tgetval ins(%scalar, %zero :
                      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8,
                        v_row=1, v_col=8, blayout=row_major,
                        slayout=none_box, fractal=512, pad=0>, index)
                outs : f32
      pto.tmuls ins(%input, %value0 : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
      pto.tmuls ins(%input, %value1 : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
      pto.tmuls ins(%input, %value2 : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
      pto.tmuls ins(%input, %value3 : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
      pto.tmuls ins(%input, %value4 : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
      pto.tmuls ins(%input, %value5 : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
      pto.tmuls ins(%input, %value6 : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
    }
    return
  }
}

// CHECK-LABEL: CANONICAL-SYNC function=coalesced_recurring_ready_lanes_share
// CHECK: PLAN selected=[
// CHECK-SAME: events=[] scarcity=[coalesced{{.*}}:e0/release-e0, coalesced{{.*}}:e0/release-e1]
// CHECK: VERIFY ok
