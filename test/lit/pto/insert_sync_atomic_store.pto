// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %s -o - | FileCheck %s --check-prefix=EMIT
// RUN: pto-frontier-analysis-test --atomic-store-check %s | FileCheck %s --check-prefix=MODEL
// RUN: %python %S/Inputs/minimum_demand/check_shared_admission.py pto-test-opt %s
// Supported plain ACC f32/int32 atomic subset. No native/configuration certificate.

!af = !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=1024, pad=0>
!ai = !pto.tile_buf<loc=acc, dtype=i32, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=1024, pad=0>
module attributes {pto.target_arch = "a3"} {
  func.func @atomic_store_effects(%f: !pto.ptr<f32>, %i: !pto.ptr<i32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %addr0 = arith.constant 0 : i64
    %addr1 = arith.constant 4096 : i64
    %fv = pto.make_tensor_view %f, shape = [%c32, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xf32>
    %fd = pto.partition_view %fv, offsets = [%c0, %c0], sizes = [%c32, %c32]
      : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<32x32xf32>
    %iv = pto.make_tensor_view %i, shape = [%c32, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xi32>
    %id = pto.partition_view %iv, offsets = [%c0, %c0], sizes = [%c32, %c32]
      : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<32x32xi32>
    %fa = pto.alloc_tile addr = %addr0 : !af
    %ia = pto.alloc_tile addr = %addr1 : !ai
    pto.tstore ins(%fa : !af) outs(%fd : !pto.partition_tensor_view<32x32xf32>)
    pto.tstore ins(%fa : !af) outs(%fd : !pto.partition_tensor_view<32x32xf32>) {atomicType = #pto<atomic_type atomic_add>}
    pto.tstore ins(%fa : !af) outs(%fd : !pto.partition_tensor_view<32x32xf32>)
    pto.tstore ins(%ia : !ai) outs(%id : !pto.partition_tensor_view<32x32xi32>)
    pto.tstore ins(%ia : !ai) outs(%id : !pto.partition_tensor_view<32x32xi32>) {atomicType = #pto<atomic_type atomic_add>}
    return
  }
}

// EMIT-LABEL: AICORE void atomic_store_effects(
// EMIT: TSTORE(
// EMIT: TSTORE<{{.*}}AtomicType::AtomicAdd>
// EMIT: TSTORE(
// EMIT: TSTORE(
// EMIT: TSTORE<{{.*}}AtomicType::AtomicAdd>
// MODEL: verified AtomicAdd destination read, shared RMW identity/incidence and modeled old-state graph
