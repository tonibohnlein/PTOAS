// RUN: pto-frontier-analysis-test --adjacent-local-upper-check %s
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch --emit-pto-ir %s -o %t.ir
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch %s -o %t.cpp
// RUN: FileCheck %s --check-prefix=IR < %t.ir
// RUN: FileCheck %s --check-prefix=CPP < %t.cpp
// RUN: %python %S/Inputs/minimum_demand/check_local_upper.py %s %t.ir
!vec = !pto.tile_buf<loc=vec, dtype=i32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!gm = !pto.partition_tensor_view<16x128xi32>
module attributes {pto.target_arch = "a3"} {
  func.func @nested_local(%src: !gm, %dst: !gm, %n: index, %active: i1) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %addr0 = arith.constant 0 : i64
    %a = pto.alloc_tile addr = %addr0 : !vec
    %addr1 = arith.constant 8192 : i64
    %b = pto.alloc_tile addr = %addr1 : !vec
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    scf.for %outer = %zero to %n step %one {
      scf.for %i = %zero to %n step %one {
        pto.tload ins(%src : !gm) outs(%a : !vec)
        scf.if %active {
          pto.tload ins(%src : !gm) outs(%b : !vec)
        }
        pto.tload ins(%src : !gm) outs(%a : !vec)
        pto.tstore ins(%a : !vec) outs(%dst : !gm)
      }
    }
    return
  }
  func.func @finite_local(%src: !gm, %dst: !gm, %n: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %addr0 = arith.constant 0 : i64
    %a = pto.alloc_tile addr = %addr0 : !vec
    %addr1 = arith.constant 8192 : i64
    %b = pto.alloc_tile addr = %addr1 : !vec
    pto.tload ins(%src : !gm) outs(%a : !vec)
    pto.tload ins(%src : !gm) outs(%b : !vec)
    pto.tload ins(%src : !gm) outs(%a : !vec)
    pto.tstore ins(%a : !vec) outs(%dst : !gm)
    return
  }
  func.func @opaque_local(%src: !gm, %dst: !gm, %n: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %addr0 = arith.constant 0 : i64
    %a = pto.alloc_tile addr = %addr0 : !vec
    %addr1 = arith.constant 8192 : i64
    %b = pto.alloc_tile addr = %addr1 : !vec
    %zero = arith.constant 0 : index
    %square = arith.muli %n, %n : index
    %active = arith.cmpi sgt, %square, %zero : index
    scf.if %active {
      pto.tload ins(%src : !gm) outs(%a : !vec)
    }
    pto.tload ins(%src : !gm) outs(%b : !vec)
    scf.if %active {
      pto.tload ins(%src : !gm) outs(%a : !vec)
      pto.tstore ins(%a : !vec) outs(%dst : !gm)
    }
    return
  }
}
// IR-DAG: selected_closure = "sound-upper"
// IR-DAG: local_replacement_base
// IR-DAG: local_replacement_generators
// IR-DAG: local_replacement_guarded_covers
// IR: pto.barrier <PIPE_MTE2>
// IR: pto.tload
// IR: pto.barrier <PIPE_ALL>
// IR-NOT: sync.logical_
// CPP: pipe_barrier(PIPE_MTE2);
// CPP: pipe_barrier(PIPE_ALL);
