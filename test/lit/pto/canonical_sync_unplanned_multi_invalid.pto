// RUN: not pto-test-opt %s '-pto-canonical-sync' 2>&1 | FileCheck %s

module {
  func.func @unplanned_multi_buffer() {
    %buffer = pto.alloc_multi_tile
      : !pto.multi_tile_buf<vec, 16x16xf16, count=2>
    return
  }
}

// CHECK: error: PTOCanonicalSync requires planner-assigned slot addresses or a constant level3 base
