// RUN: ptoas --pto-arch=a2 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail --protocol-sync-gm-alias=may-alias %s -o %t.a2.pto
// RUN: FileCheck %s --input-file=%t.a2.pto
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail --protocol-sync-gm-alias=may-alias %s -o %t.a3.pto
// RUN: FileCheck %s --input-file=%t.a3.pto
// RUN: ptoas --pto-arch=a2 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail --protocol-sync-gm-alias=assume-disjoint-arguments %s -o %t.disjoint.a2.pto
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail --protocol-sync-gm-alias=assume-disjoint-arguments %s -o %t.disjoint.a3.pto
// RUN: ptoas --pto-arch=a2 --pto-level=level3 --emit-pto-ir --protocol-sync-analysis-only --protocol-sync-dump=concrete-verification %t.a2.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=VERIFY
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir --protocol-sync-analysis-only --protocol-sync-dump=concrete-verification %t.a3.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=VERIFY
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail %s -o %t.cpp
// VERIFY: concrete-verification function=@cube_local_reuse status=accepted
// CHECK-LABEL: func.func @cube_local_reuse
// CHECK: pto.tload
// CHECK-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_MTE1>,
// CHECK: pto.tmov
// CHECK: pto.set_flag[<PIPE_MTE1>, <PIPE_MTE2>,
// CHECK: pto.wait_flag[<PIPE_MTE1>, <PIPE_MTE2>,
// CHECK-NEXT: pto.tload
// CHECK-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_MTE1>,
// CHECK: pto.tmov
// CHECK: pto.tmatmul
// CHECK: pto.tstore
// CHECK-NEXT: pto.barrier <PIPE_ALL>
// CHECK-NEXT: return

module {
  func.func @cube_local_reuse(%in: !pto.partition_tensor_view<16x16xf16>,
      %out: !pto.partition_tensor_view<16x16xf32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %zero = arith.constant 0 : i64
    %a = pto.alloc_tile addr = %zero : !pto.tile_buf<mat, 16x16xf16>
    %b = pto.alloc_tile addr = %zero : !pto.tile_buf<mat, 16x16xf16>
    %left = pto.alloc_tile addr = %zero : !pto.tile_buf<left, 16x16xf16>
    %right = pto.alloc_tile addr = %zero : !pto.tile_buf<right, 16x16xf16>
    %acc = pto.alloc_tile addr = %zero : !pto.tile_buf<acc, 16x16xf32>
    pto.tload ins(%in : !pto.partition_tensor_view<16x16xf16>) outs(%a : !pto.tile_buf<mat, 16x16xf16>)
    pto.tmov ins(%a : !pto.tile_buf<mat, 16x16xf16>) outs(%left : !pto.tile_buf<left, 16x16xf16>)
    pto.tload ins(%in : !pto.partition_tensor_view<16x16xf16>) outs(%b : !pto.tile_buf<mat, 16x16xf16>)
    pto.tmov ins(%b : !pto.tile_buf<mat, 16x16xf16>) outs(%right : !pto.tile_buf<right, 16x16xf16>)
    pto.tmatmul ins(%left, %right : !pto.tile_buf<left, 16x16xf16>, !pto.tile_buf<right, 16x16xf16>) outs(%acc : !pto.tile_buf<acc, 16x16xf32>)
    pto.tstore ins(%acc : !pto.tile_buf<acc, 16x16xf32>) outs(%out : !pto.partition_tensor_view<16x16xf32>)
    return
  }
}
