// RUN: split-file %s %t
// RUN: not ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   %t/scalar_completion.pto -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=SCALAR
// RUN: not ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   %t/late_ffts.pto -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=FFTS
// RUN: not ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   %t/cross_core_visibility.pto -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=VISIBILITY
// RUN: not ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   %t/carried_visibility.pto -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=CARRIED-VISIBILITY
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-dump --emit-pto-ir \
// RUN:   --mlir-print-ir-after=pto-canonical-sync \
// RUN:   %t/carried_visibility_reuse.pto -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=CARRIED-REUSE
// RUN: not ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   %t/wrong_core_latch.pto -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=WRONG-LATCH

// SCALAR: error: canonical sync cannot generate a cross-core event until collective AIC/AIV participation is represented and proven
// FFTS: error: canonical sync cannot generate a cross-core event until collective AIC/AIV participation is represented and proven
// VISIBILITY: error: canonical sync has no proven cross-core GM visibility protocol
// CARRIED-VISIBILITY: error: canonical sync has no proven cross-core GM visibility protocol
// CARRIED-REUSE-LABEL: CANONICAL-SYNC function=carried_visibility_cannot_reuse_completion
// CARRIED-REUSE: kind=visibility-fence resource=AIV:PIPE_S->AIV:PIPE_MTE2
// CARRIED-REUSE: VERIFY ok
// CARRIED-REUSE-LABEL: func.func @carried_visibility_cannot_reuse_completion
// CARRIED-REUSE: pto.cmo.cacheinvalid
// CARRIED-REUSE-NEXT: pto.fence.barrier_all
// WRONG-LATCH: error: canonical sync has no proven loop-carried GM visibility protocol at a matching physical-core latch

//--- scalar_completion.pto
module attributes {pto.target_arch = "a2a3"} {
  func.func @cross_core_scalar_completion(
      %ffts: !pto.ptr<i64>, %payload: !pto.ptr<ui32, gm>,
      %sink: !pto.ptr<ui32, gm>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %addr = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %addr : !pto.tile_buf<loc=vec, dtype=ui32, rows=1,
      cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box,
      fractal=512, pad=0>
    %view = pto.make_tensor_view %payload, shape = [%c1, %c32],
      strides = [%c32, %c1] : !pto.tensor_view<1x32xui32>
    %part = pto.partition_view %view, offsets = [%c0, %c0],
      sizes = [%c1, %c32] : !pto.tensor_view<1x32xui32> ->
      !pto.partition_tensor_view<1x32xui32>
    pto.set_ffts %ffts : !pto.ptr<i64>
    pto.section.cube {
      %loaded = pto.load_scalar %payload[%c0] : !pto.ptr<ui32, gm> -> ui32
      pto.store_scalar %loaded, %sink[%c0] : !pto.ptr<ui32, gm>, ui32
    }
    pto.section.vector {
      pto.tstore ins(%tile : !pto.tile_buf<loc=vec, dtype=ui32, rows=1,
        cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box,
        fractal=512, pad=0>)
        outs(%part : !pto.partition_tensor_view<1x32xui32>)
    }
    return
  }
}

//--- wrong_core_latch.pto
module attributes {pto.target_arch = "a2a3"} {
  func.func @reject_visibility_latch_on_other_core(
      %payload: !pto.ptr<f32, gm>, %trip_count: index, %condition: i1)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %one = arith.constant 1.000000e+00 : f32
    %addr = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %addr : !pto.tile_buf<loc=mat, dtype=f32,
      rows=16, cols=16, v_row=16, v_col=16, blayout=col_major,
      slayout=row_major, fractal=512, pad=0>
    %view = pto.make_tensor_view %payload, shape = [%c16, %c16],
      strides = [%c16, %c1] : !pto.tensor_view<16x16xf32>
    %part = pto.partition_view %view, offsets = [%c0, %c0],
      sizes = [%c16, %c16] : !pto.tensor_view<16x16xf32> ->
      !pto.partition_tensor_view<16x16xf32>
    scf.for %iteration = %c0 to %trip_count step %c1 {
      scf.if %condition {
        pto.section.cube {
          pto.store_scalar %one, %payload[%c0] : !pto.ptr<f32, gm>, f32
        }
      } else {
        pto.section.cube {
          pto.tload ins(%part : !pto.partition_tensor_view<16x16xf32>)
            outs(%tile : !pto.tile_buf<loc=mat, dtype=f32, rows=16, cols=16,
              v_row=16, v_col=16, blayout=col_major, slayout=row_major,
              fractal=512, pad=0>)
        }
      }
    }
    return
  }
}

//--- carried_visibility_reuse.pto
module attributes {pto.target_arch = "a2a3"} {
  func.func @carried_visibility_cannot_reuse_completion(
      %payload: !pto.ptr<ui32, gm>, %scratch: !pto.ptr<ui32, gm>,
      %trip_count: index, %condition: i1)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %value_i32 = arith.constant 7 : i32
    %value = builtin.unrealized_conversion_cast %value_i32 : i32 to ui32
    %payload_addr = arith.constant 0 : i64
    %scratch_addr = arith.constant 1024 : i64
    %payload_tile = pto.alloc_tile addr = %payload_addr :
      !pto.tile_buf<loc=vec, dtype=ui32, rows=1, cols=32, v_row=1, v_col=32,
        blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %scratch_tile = pto.alloc_tile addr = %scratch_addr :
      !pto.tile_buf<loc=vec, dtype=ui32, rows=1, cols=32, v_row=1, v_col=32,
        blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %payload_view = pto.make_tensor_view %payload, shape = [%c1, %c32],
      strides = [%c32, %c1] : !pto.tensor_view<1x32xui32>
    %payload_part = pto.partition_view %payload_view,
      offsets = [%c0, %c0], sizes = [%c1, %c32] :
      !pto.tensor_view<1x32xui32> -> !pto.partition_tensor_view<1x32xui32>
    %scratch_view = pto.make_tensor_view %scratch, shape = [%c1, %c32],
      strides = [%c32, %c1] : !pto.tensor_view<1x32xui32>
    %scratch_part = pto.partition_view %scratch_view,
      offsets = [%c0, %c0], sizes = [%c1, %c32] :
      !pto.tensor_view<1x32xui32> -> !pto.partition_tensor_view<1x32xui32>
    scf.for %iteration = %c0 to %trip_count step %c1 {
      // This pure WAR is an eligible same-iteration Completion candidate on
      // AIV:MTE2->S. It must never be reused for the carried Visibility below.
      pto.tload ins(%scratch_part : !pto.partition_tensor_view<1x32xui32>)
        outs(%scratch_tile : !pto.tile_buf<loc=vec, dtype=ui32, rows=1,
          cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box,
          fractal=512, pad=0>)
      pto.store_scalar %value, %scratch[%c0] : !pto.ptr<ui32, gm>, ui32
      scf.if %condition {
        pto.store_scalar %value, %payload[%c0] : !pto.ptr<ui32, gm>, ui32
      } else {
        pto.tload ins(%payload_part : !pto.partition_tensor_view<1x32xui32>)
          outs(%payload_tile : !pto.tile_buf<loc=vec, dtype=ui32, rows=1,
            cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box,
            fractal=512, pad=0>)
      }
    }
    return
  }
}

//--- carried_visibility.pto
module attributes {pto.target_arch = "a2a3"} {
  func.func @cross_core_carried_visibility(
      %payload: !pto.ptr<ui32, gm>, %trip_count: index, %condition: i1) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %value_i32 = arith.constant 7 : i32
    %value = builtin.unrealized_conversion_cast %value_i32 : i32 to ui32
    %addr = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %addr : !pto.tile_buf<loc=vec, dtype=ui32,
      rows=1, cols=32, v_row=1, v_col=32, blayout=row_major,
      slayout=none_box, fractal=512, pad=0>
    %view = pto.make_tensor_view %payload, shape = [%c1, %c32],
      strides = [%c32, %c1] : !pto.tensor_view<1x32xui32>
    %part = pto.partition_view %view, offsets = [%c0, %c0],
      sizes = [%c1, %c32] : !pto.tensor_view<1x32xui32> ->
      !pto.partition_tensor_view<1x32xui32>
    scf.for %iteration = %c0 to %trip_count step %c1 {
      scf.if %condition {
        pto.section.cube {
          pto.store_scalar %value, %payload[%c0] : !pto.ptr<ui32, gm>, ui32
        }
      } else {
        pto.section.vector {
          pto.tload ins(%part : !pto.partition_tensor_view<1x32xui32>)
            outs(%tile : !pto.tile_buf<loc=vec, dtype=ui32, rows=1, cols=32,
              v_row=1, v_col=32, blayout=row_major, slayout=none_box,
              fractal=512, pad=0>)
        }
      }
    }
    return
  }
}

//--- late_ffts.pto
module attributes {pto.target_arch = "a2a3"} {
  func.func @late_ffts_setup(
      %ffts: !pto.ptr<i64>, %view: !pto.partition_tensor_view<32x32xf32>) {
    %acc_addr = arith.constant 0 : i64
    %vec_addr = arith.constant 0 : i64
    %acc = pto.alloc_tile addr = %acc_addr :
      !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=32, v_row=32,
                    v_col=32, blayout=col_major, slayout=row_major,
                    fractal=1024, pad=0>
    %vec = pto.alloc_tile addr = %vec_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=32,
                    v_col=32, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    pto.section.cube {
      pto.tstore ins(%acc : !pto.tile_buf<loc=acc, dtype=f32, rows=32,
        cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major,
        fractal=1024, pad=0>)
        outs(%view : !pto.partition_tensor_view<32x32xf32>)
    }
    pto.set_ffts %ffts : !pto.ptr<i64>
    pto.section.vector {
      pto.tload ins(%view : !pto.partition_tensor_view<32x32xf32>)
        outs(%vec : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32,
          v_row=32, v_col=32, blayout=row_major, slayout=none_box,
          fractal=512, pad=0>)
    }
    return
  }
}

//--- cross_core_visibility.pto
module attributes {pto.target_arch = "a2a3"} {
  func.func @cross_core_scalar_visibility(
      %payload: !pto.ptr<ui32, gm>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %value_i32 = arith.constant 7 : i32
    %value = builtin.unrealized_conversion_cast %value_i32 : i32 to ui32
    %addr = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %addr : !pto.tile_buf<loc=vec, dtype=ui32, rows=1,
      cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box,
      fractal=512, pad=0>
    %view = pto.make_tensor_view %payload, shape = [%c1, %c32],
      strides = [%c32, %c1] : !pto.tensor_view<1x32xui32>
    %part = pto.partition_view %view, offsets = [%c0, %c0],
      sizes = [%c1, %c32] : !pto.tensor_view<1x32xui32> ->
      !pto.partition_tensor_view<1x32xui32>
    pto.section.cube {
      pto.store_scalar %value, %payload[%c0] : !pto.ptr<ui32, gm>, ui32
    }
    pto.section.vector {
      pto.tload ins(%part : !pto.partition_tensor_view<1x32xui32>)
        outs(%tile : !pto.tile_buf<loc=vec, dtype=ui32, rows=1, cols=32,
          v_row=1, v_col=32, blayout=row_major, slayout=none_box,
          fractal=512, pad=0>)
    }
    return
  }
}
