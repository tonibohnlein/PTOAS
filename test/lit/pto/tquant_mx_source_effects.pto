// RUN: ptoas --pto-arch=a5 --pto-level=level3 --enable-insert-sync --emit-pto-ir \
// RUN:   --mlir-print-ir-after=pto-insert-sync %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  func.func @dn_f16_padded_src(%sink: !pto.partition_tensor_view<64x16xf16>) {
    // Prove the control buffers disjoint; distinct tile arguments do not.
    %address_src = arith.constant 0 : i64
    %src = pto.alloc_tile addr = %address_src : !pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=32, v_row=64, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %address_dst = arith.constant 16384 : i64
    %dst_backing = pto.alloc_tile addr = %address_dst : !pto.tile_buf<vec, 1x1024xui8>
    %dst = pto.treshape %dst_backing : !pto.tile_buf<vec, 1x1024xui8> -> !pto.tile_buf<vec, 64x16xui8>
    %address_exp = arith.constant 32768 : i64
    %exp = pto.alloc_tile addr = %address_exp : !pto.tile_buf<loc=vec, dtype=ui8, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %address_max = arith.constant 49152 : i64
    %max = pto.alloc_tile addr = %address_max : !pto.tile_buf<loc=vec, dtype=f16, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %address_scaling = arith.constant 65536 : i64
    %scaling = pto.alloc_tile addr = %address_scaling : !pto.tile_buf<loc=vec, dtype=f16, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tquant.mx ins(%src : !pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=32, v_row=64, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%dst, %exp, %max, %scaling : !pto.tile_buf<vec, 64x16xui8>, !pto.tile_buf<loc=vec, dtype=ui8, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f16, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f16, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      {quant_type = #pto<quant_type MXFP8>, grpAxis = #pto<mx_group_axis axis0>}
    pto.tstore ins(%src : !pto.tile_buf<loc=vec, dtype=f16, rows=64, cols=32, v_row=64, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%sink : !pto.partition_tensor_view<64x16xf16>)
    return
  }

  func.func @dn_bf16_padded_src_vl_complete(%sink: !pto.partition_tensor_view<64x16xbf16>) {
    // Prove the control buffers disjoint; distinct tile arguments do not.
    %address_src = arith.constant 0 : i64
    %src = pto.alloc_tile addr = %address_src : !pto.tile_buf<loc=vec, dtype=bf16, rows=64, cols=32, v_row=64, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %address_dst = arith.constant 16384 : i64
    %dst_backing = pto.alloc_tile addr = %address_dst : !pto.tile_buf<vec, 1x1024xui8>
    %dst = pto.treshape %dst_backing : !pto.tile_buf<vec, 1x1024xui8> -> !pto.tile_buf<vec, 64x16xui8>
    %address_exp = arith.constant 32768 : i64
    %exp = pto.alloc_tile addr = %address_exp : !pto.tile_buf<loc=vec, dtype=ui8, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %address_max = arith.constant 49152 : i64
    %max = pto.alloc_tile addr = %address_max : !pto.tile_buf<loc=vec, dtype=bf16, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %address_scaling = arith.constant 65536 : i64
    %scaling = pto.alloc_tile addr = %address_scaling : !pto.tile_buf<loc=vec, dtype=bf16, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tquant.mx ins(%src : !pto.tile_buf<loc=vec, dtype=bf16, rows=64, cols=32, v_row=64, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%dst, %exp, %max, %scaling : !pto.tile_buf<vec, 64x16xui8>, !pto.tile_buf<loc=vec, dtype=ui8, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=bf16, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=bf16, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      {quant_type = #pto<quant_type MXFP8>, grpAxis = #pto<mx_group_axis axis0>}
    pto.tstore ins(%src : !pto.tile_buf<loc=vec, dtype=bf16, rows=64, cols=32, v_row=64, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%sink : !pto.partition_tensor_view<64x16xbf16>)
    return
  }

  func.func @dn_f32_padded_src_control(%sink: !pto.partition_tensor_view<64x16xf32>) {
    // Prove the control buffers disjoint; distinct tile arguments do not.
    %address_src = arith.constant 0 : i64
    %src = pto.alloc_tile addr = %address_src : !pto.tile_buf<loc=vec, dtype=f32, rows=64, cols=32, v_row=64, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %address_dst = arith.constant 16384 : i64
    %dst_backing = pto.alloc_tile addr = %address_dst : !pto.tile_buf<vec, 1x1024xui8>
    %dst = pto.treshape %dst_backing : !pto.tile_buf<vec, 1x1024xui8> -> !pto.tile_buf<vec, 64x16xui8>
    %address_exp = arith.constant 32768 : i64
    %exp = pto.alloc_tile addr = %address_exp : !pto.tile_buf<loc=vec, dtype=ui8, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %address_max = arith.constant 49152 : i64
    %max = pto.alloc_tile addr = %address_max : !pto.tile_buf<loc=vec, dtype=f32, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %address_scaling = arith.constant 65536 : i64
    %scaling = pto.alloc_tile addr = %address_scaling : !pto.tile_buf<loc=vec, dtype=f32, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tquant.mx ins(%src : !pto.tile_buf<loc=vec, dtype=f32, rows=64, cols=32, v_row=64, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%dst, %exp, %max, %scaling : !pto.tile_buf<vec, 64x16xui8>, !pto.tile_buf<loc=vec, dtype=ui8, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      {quant_type = #pto<quant_type MXFP8>, grpAxis = #pto<mx_group_axis axis0>}
    pto.tstore ins(%src : !pto.tile_buf<loc=vec, dtype=f32, rows=64, cols=32, v_row=64, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%sink : !pto.partition_tensor_view<64x16xf32>)
    return
  }

  func.func @dn_f16_tight_src_control(%sink: !pto.partition_tensor_view<64x16xf16>) {
    // Prove the control buffers disjoint; distinct tile arguments do not.
    %address_src = arith.constant 0 : i64
    %src = pto.alloc_tile addr = %address_src : !pto.tile_buf<vec, 64x16xf16>
    %address_dst = arith.constant 16384 : i64
    %dst_backing = pto.alloc_tile addr = %address_dst : !pto.tile_buf<vec, 1x1024xui8>
    %dst = pto.treshape %dst_backing : !pto.tile_buf<vec, 1x1024xui8> -> !pto.tile_buf<vec, 64x16xui8>
    %address_exp = arith.constant 32768 : i64
    %exp_backing = pto.alloc_tile addr = %address_exp : !pto.tile_buf<vec, 1x32xui8>
    %exp = pto.treshape %exp_backing : !pto.tile_buf<vec, 1x32xui8> -> !pto.tile_buf<vec, 2x16xui8>
    %address_max = arith.constant 49152 : i64
    %max = pto.alloc_tile addr = %address_max : !pto.tile_buf<vec, 2x16xf16>
    %address_scaling = arith.constant 65536 : i64
    %scaling = pto.alloc_tile addr = %address_scaling : !pto.tile_buf<vec, 2x16xf16>
    pto.tquant.mx ins(%src : !pto.tile_buf<vec, 64x16xf16>)
      outs(%dst, %exp, %max, %scaling : !pto.tile_buf<vec, 64x16xui8>, !pto.tile_buf<vec, 2x16xui8>, !pto.tile_buf<vec, 2x16xf16>, !pto.tile_buf<vec, 2x16xf16>)
      {quant_type = #pto<quant_type MXFP8>, grpAxis = #pto<mx_group_axis axis0>}
    pto.tstore ins(%src : !pto.tile_buf<vec, 64x16xf16>) outs(%sink : !pto.partition_tensor_view<64x16xf16>)
    return
  }
}

// CHECK-LABEL: func.func @dn_f16_padded_src
// CHECK: pto.tquant.mx
// CHECK: pto.set_flag[<PIPE_V>, <PIPE_MTE3>,
// CHECK: pto.wait_flag[<PIPE_V>, <PIPE_MTE3>,
// CHECK: pto.tstore
// CHECK-LABEL: func.func @dn_bf16_padded_src_vl_complete
// CHECK: pto.tquant.mx
// CHECK: pto.set_flag[<PIPE_V>, <PIPE_MTE3>,
// CHECK: pto.wait_flag[<PIPE_V>, <PIPE_MTE3>,
// CHECK: pto.tstore
// CHECK-LABEL: func.func @dn_f32_padded_src_control
// CHECK: pto.tquant.mx
// CHECK-NOT: pto.set_flag[<PIPE_V>, <PIPE_MTE3>,
// CHECK-NOT: pto.wait_flag[<PIPE_V>, <PIPE_MTE3>,
// CHECK: pto.tstore
// CHECK-LABEL: func.func @dn_f16_tight_src_control
// CHECK: pto.tquant.mx
// CHECK-NOT: pto.set_flag[<PIPE_V>, <PIPE_MTE3>,
// CHECK-NOT: pto.wait_flag[<PIPE_V>, <PIPE_MTE3>,
// CHECK: pto.tstore
