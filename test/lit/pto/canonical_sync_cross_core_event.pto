// A mode-2 FFTS counter transfers completion between ordered cube and vector
// sections. The source and destination pipes are carried by the set and wait
// operations respectively; counter IDs are allocated from the documented
// cross-core pool [0, 10].
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-dump --emit-pto-ir \
// RUN:   --mlir-print-ir-after=pto-canonical-sync %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   %s -o - 2>&1 | FileCheck %s --check-prefix=EMITC

module attributes {pto.target_arch = "a2a3"} {
  func.func @cube_store_then_vector_load(
      %ffts: !pto.ptr<i64>,
      %gm: !pto.partition_tensor_view<32x32xf32>) {
    %acc_addr = arith.constant 0 : i64
    %vec_addr = arith.constant 0 : i64
    %acc = pto.alloc_tile addr = %acc_addr :
      !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=32, v_row=32,
                    v_col=32, blayout=col_major, slayout=row_major,
                    fractal=1024, pad=0>
    %vec = pto.alloc_tile addr = %vec_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=32,
                    v_col=32, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    pto.set_ffts %ffts : !pto.ptr<i64>
    pto.section.cube {
      pto.tstore ins(%acc : !pto.tile_buf<loc=acc, dtype=f32, rows=32,
                      cols=32, v_row=32, v_col=32, blayout=col_major,
                      slayout=row_major, fractal=1024, pad=0>)
                 outs(%gm : !pto.partition_tensor_view<32x32xf32>)
    }
    pto.section.vector {
      pto.tload ins(%gm : !pto.partition_tensor_view<32x32xf32>)
                outs(%vec : !pto.tile_buf<loc=vec, dtype=f32, rows=32,
                       cols=32, v_row=32, v_col=32, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
    }
    return
  }
}

// CHECK-LABEL: CANONICAL-SYNC function=cube_store_then_vector_load
// CHECK: kind=RAW
// CHECK: kind=cross-core-event resource=AIC:PIPE_FIX->AIV:PIPE_MTE2
// CHECK: PLAN selected=[
// CHECK-SAME: events=[{{.*}}=e{{[0-9]+}}
// CHECK: VERIFY ok
// CHECK-LABEL: func.func @cube_store_then_vector_load
// CHECK: pto.section.cube
// CHECK: pto.tstore
// CHECK-NEXT: pto.sync.set <PIPE_FIX>, [[EVENT:[0-9]+]] {ffts_mode = 2 : i32
// CHECK: pto.barrier <PIPE_ALL>
// CHECK: pto.section.vector
// CHECK: pto.sync.wait <PIPE_MTE2>, [[EVENT]] {ffts_mode = 2 : i32
// CHECK-NEXT: pto.tload
// CHECK: pto.barrier <PIPE_ALL>

// EMITC-LABEL: AICORE void cube_store_then_vector_load
// EMITC: set_ffts_base_addr
// EMITC: #if defined(__DAV_CUBE__)
// EMITC: TSTORE
// EMITC: __builtin_cce_ffts_cross_core_sync(PIPE_FIX
// EMITC-NEXT: pipe_barrier(PIPE_ALL);
// EMITC: #if defined(__DAV_VEC__)
// EMITC: __builtin_cce_wait_flag_dev([[EVENT:[0-9]+]]);
// EMITC: TLOAD
// EMITC-NEXT: pipe_barrier(PIPE_ALL);
