// RUN: pto-test-opt %s \
// RUN:   '-pto-print-canonical-sync-plan=format=text view=all' \
// RUN:   | FileCheck %s --check-prefix=PLAN
// RUN: pto-test-opt %s '-pto-canonical-sync=event-id-num-max=8' \
// RUN:   | FileCheck %s --check-prefix=IR

module attributes {pto.target_arch = "a2a3"} {
  func.func @region_transitive(
      %src: !pto.partition_tensor_view<16x16xf32>,
      %dst: !pto.partition_tensor_view<16x16xf32>, %condition: i1) {
    %addr0 = arith.constant 0 : i64
    %one = arith.constant 1.000000e+00 : f32
    %shared = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    scf.if %condition {
      pto.tload ins(%src : !pto.partition_tensor_view<16x16xf32>)
                outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
    }
    pto.tmuls ins(%shared, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
               outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
    pto.tstore ins(%shared : !pto.tile_buf<vec, 16x16xf32>)
               outs(%dst : !pto.partition_tensor_view<16x16xf32>)
    return
  }

  func.func @conditional_path_preserved(
      %src: !pto.partition_tensor_view<16x16xf32>,
      %dst: !pto.partition_tensor_view<16x16xf32>, %condition: i1) {
    %addr0 = arith.constant 0 : i64
    %one = arith.constant 1.000000e+00 : f32
    %shared = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    pto.tload ins(%src : !pto.partition_tensor_view<16x16xf32>)
              outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
    scf.if %condition {
      pto.tmuls ins(%shared, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
                 outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
    }
    pto.tstore ins(%shared : !pto.tile_buf<vec, 16x16xf32>)
               outs(%dst : !pto.partition_tensor_view<16x16xf32>)
    return
  }

  func.func @zero_trip_path_preserved(
      %src: !pto.partition_tensor_view<16x16xf32>,
      %dst: !pto.partition_tensor_view<16x16xf32>, %limit: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %addr0 = arith.constant 0 : i64
    %one = arith.constant 1.000000e+00 : f32
    %shared = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    pto.tload ins(%src : !pto.partition_tensor_view<16x16xf32>)
              outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
    scf.for %i = %c0 to %limit step %c1 {
      pto.tmuls ins(%shared, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
                 outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
    }
    pto.tstore ins(%shared : !pto.tile_buf<vec, 16x16xf32>)
               outs(%dst : !pto.partition_tensor_view<16x16xf32>)
    return
  }

  func.func @positive_trip_path_reduced(
      %src: !pto.partition_tensor_view<16x16xf32>,
      %dst: !pto.partition_tensor_view<16x16xf32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %addr0 = arith.constant 0 : i64
    %one = arith.constant 1.000000e+00 : f32
    %shared = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    pto.tload ins(%src : !pto.partition_tensor_view<16x16xf32>)
              outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
    scf.for %i = %c0 to %c1 step %c1 {
      pto.tmuls ins(%shared, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
                 outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
    }
    pto.tstore ins(%shared : !pto.tile_buf<vec, 16x16xf32>)
               outs(%dst : !pto.partition_tensor_view<16x16xf32>)
    return
  }

  func.func @constant_zero_trip_path_preserved(
      %src: !pto.partition_tensor_view<16x16xf32>,
      %dst: !pto.partition_tensor_view<16x16xf32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %addr0 = arith.constant 0 : i64
    %one = arith.constant 1.000000e+00 : f32
    %shared = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    pto.tload ins(%src : !pto.partition_tensor_view<16x16xf32>)
              outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
    scf.for %i = %c0 to %c0 step %c1 {
      pto.tmuls ins(%shared, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
                 outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
    }
    pto.tstore ins(%shared : !pto.tile_buf<vec, 16x16xf32>)
               outs(%dst : !pto.partition_tensor_view<16x16xf32>)
    return
  }

  func.func @positive_outer_zero_inner_path_preserved(
      %src: !pto.partition_tensor_view<16x16xf32>,
      %dst: !pto.partition_tensor_view<16x16xf32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %addr0 = arith.constant 0 : i64
    %one = arith.constant 1.000000e+00 : f32
    %shared = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    pto.tload ins(%src : !pto.partition_tensor_view<16x16xf32>)
              outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
    scf.for %outer = %c0 to %c1 step %c1 {
      scf.for %inner = %c0 to %c0 step %c1 {
        pto.tmuls ins(%shared, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
                   outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
      }
    }
    pto.tstore ins(%shared : !pto.tile_buf<vec, 16x16xf32>)
               outs(%dst : !pto.partition_tensor_view<16x16xf32>)
    return
  }

  func.func @positive_trip_conditional_path_preserved(
      %src: !pto.partition_tensor_view<16x16xf32>,
      %dst: !pto.partition_tensor_view<16x16xf32>, %condition: i1) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %addr0 = arith.constant 0 : i64
    %one = arith.constant 1.000000e+00 : f32
    %shared = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    pto.tload ins(%src : !pto.partition_tensor_view<16x16xf32>)
              outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
    scf.for %i = %c0 to %c1 step %c1 {
      scf.if %condition {
        pto.tmuls ins(%shared, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
                   outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
      }
    }
    pto.tstore ins(%shared : !pto.tile_buf<vec, 16x16xf32>)
               outs(%dst : !pto.partition_tensor_view<16x16xf32>)
    return
  }

  func.func @barrier_covers_event(
      %src_a: !pto.partition_tensor_view<16x16xf32>,
      %src_x0: !pto.partition_tensor_view<16x16xf32>,
      %src_x1: !pto.partition_tensor_view<16x16xf32>) {
    %addr0 = arith.constant 0 : i64
    %addr4096 = arith.constant 4096 : i64
    %one = arith.constant 1.000000e+00 : f32
    %a = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    %x0 = pto.alloc_tile addr = %addr4096 : !pto.tile_buf<vec, 16x16xf32>
    %x1 = pto.alloc_tile addr = %addr4096 : !pto.tile_buf<vec, 16x16xf32>
    pto.tload ins(%src_a : !pto.partition_tensor_view<16x16xf32>)
              outs(%a : !pto.tile_buf<vec, 16x16xf32>)
    pto.tload ins(%src_x0 : !pto.partition_tensor_view<16x16xf32>)
              outs(%x0 : !pto.tile_buf<vec, 16x16xf32>)
    pto.tload ins(%src_x1 : !pto.partition_tensor_view<16x16xf32>)
              outs(%x1 : !pto.tile_buf<vec, 16x16xf32>)
    pto.tmuls ins(%a, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
               outs(%a : !pto.tile_buf<vec, 16x16xf32>)
    return
  }

  func.func @conditional_barrier_does_not_cover(
      %src_a: !pto.partition_tensor_view<16x16xf32>,
      %src_x0: !pto.partition_tensor_view<16x16xf32>,
      %src_x1: !pto.partition_tensor_view<16x16xf32>, %condition: i1) {
    %addr0 = arith.constant 0 : i64
    %addr4096 = arith.constant 4096 : i64
    %one = arith.constant 1.000000e+00 : f32
    %a = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    %x0 = pto.alloc_tile addr = %addr4096 : !pto.tile_buf<vec, 16x16xf32>
    %x1 = pto.alloc_tile addr = %addr4096 : !pto.tile_buf<vec, 16x16xf32>
    pto.tload ins(%src_a : !pto.partition_tensor_view<16x16xf32>)
              outs(%a : !pto.tile_buf<vec, 16x16xf32>)
    scf.if %condition {
      pto.tload ins(%src_x0 : !pto.partition_tensor_view<16x16xf32>)
                outs(%x0 : !pto.tile_buf<vec, 16x16xf32>)
      pto.tload ins(%src_x1 : !pto.partition_tensor_view<16x16xf32>)
                outs(%x1 : !pto.tile_buf<vec, 16x16xf32>)
    }
    pto.tmuls ins(%a, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
               outs(%a : !pto.tile_buf<vec, 16x16xf32>)
    return
  }

  func.func @zero_trip_barrier_does_not_cover(
      %src_a: !pto.partition_tensor_view<16x16xf32>,
      %src_x0: !pto.partition_tensor_view<16x16xf32>,
      %src_x1: !pto.partition_tensor_view<16x16xf32>, %limit: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %addr0 = arith.constant 0 : i64
    %addr4096 = arith.constant 4096 : i64
    %one = arith.constant 1.000000e+00 : f32
    %a = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    %x0 = pto.alloc_tile addr = %addr4096 : !pto.tile_buf<vec, 16x16xf32>
    %x1 = pto.alloc_tile addr = %addr4096 : !pto.tile_buf<vec, 16x16xf32>
    pto.tload ins(%src_a : !pto.partition_tensor_view<16x16xf32>)
              outs(%a : !pto.tile_buf<vec, 16x16xf32>)
    scf.for %i = %c0 to %limit step %c1 {
      pto.tload ins(%src_x0 : !pto.partition_tensor_view<16x16xf32>)
                outs(%x0 : !pto.tile_buf<vec, 16x16xf32>)
      pto.tload ins(%src_x1 : !pto.partition_tensor_view<16x16xf32>)
                outs(%x1 : !pto.tile_buf<vec, 16x16xf32>)
    }
    pto.tmuls ins(%a, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
               outs(%a : !pto.tile_buf<vec, 16x16xf32>)
    return
  }

  func.func @positive_trip_barrier_covers_event(
      %src_a: !pto.partition_tensor_view<16x16xf32>,
      %src_x0: !pto.partition_tensor_view<16x16xf32>,
      %src_x1: !pto.partition_tensor_view<16x16xf32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %addr0 = arith.constant 0 : i64
    %addr4096 = arith.constant 4096 : i64
    %one = arith.constant 1.000000e+00 : f32
    %a = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    %x0 = pto.alloc_tile addr = %addr4096 : !pto.tile_buf<vec, 16x16xf32>
    %x1 = pto.alloc_tile addr = %addr4096 : !pto.tile_buf<vec, 16x16xf32>
    pto.tload ins(%src_a : !pto.partition_tensor_view<16x16xf32>)
              outs(%a : !pto.tile_buf<vec, 16x16xf32>)
    scf.for %i = %c0 to %c1 step %c1 {
      pto.tload ins(%src_x0 : !pto.partition_tensor_view<16x16xf32>)
                outs(%x0 : !pto.tile_buf<vec, 16x16xf32>)
      pto.tload ins(%src_x1 : !pto.partition_tensor_view<16x16xf32>)
                outs(%x1 : !pto.tile_buf<vec, 16x16xf32>)
    }
    pto.tmuls ins(%a, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
               outs(%a : !pto.tile_buf<vec, 16x16xf32>)
    return
  }

  func.func @nested_recurrence_not_summarized(
      %src: !pto.partition_tensor_view<16x16xf32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %addr0 = arith.constant 0 : i64
    %addr4096 = arith.constant 4096 : i64
    %one = arith.constant 1.000000e+00 : f32
    %loaded = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    %computed = pto.alloc_tile addr = %addr4096 : !pto.tile_buf<vec, 16x16xf32>
    scf.for %outer = %c0 to %c2 step %c1 {
      scf.for %inner = %c0 to %c2 step %c1 {
        pto.tload ins(%src : !pto.partition_tensor_view<16x16xf32>)
                  outs(%loaded : !pto.tile_buf<vec, 16x16xf32>)
        pto.tmuls ins(%loaded, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
                   outs(%computed : !pto.tile_buf<vec, 16x16xf32>)
      }
    }
    return
  }

  func.func @nested_recurrence_third_pipe_preserved(
      %src: !pto.partition_tensor_view<16x16xf32>,
      %dst_x: !pto.partition_tensor_view<16x16xf32>,
      %dst_y: !pto.partition_tensor_view<16x16xf32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %addr0 = arith.constant 0 : i64
    %addr4096 = arith.constant 4096 : i64
    %one = arith.constant 1.000000e+00 : f32
    %x = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    %y = pto.alloc_tile addr = %addr4096 : !pto.tile_buf<vec, 16x16xf32>
    scf.for %outer = %c0 to %c2 step %c1 {
      pto.tstore ins(%y : !pto.tile_buf<vec, 16x16xf32>)
                 outs(%dst_y : !pto.partition_tensor_view<16x16xf32>)
      scf.for %inner = %c0 to %c1 step %c1 {
        pto.tload ins(%src : !pto.partition_tensor_view<16x16xf32>)
                  outs(%x : !pto.tile_buf<vec, 16x16xf32>)
        pto.tstore ins(%x : !pto.tile_buf<vec, 16x16xf32>)
                   outs(%dst_x : !pto.partition_tensor_view<16x16xf32>)
        pto.tmuls ins(%x, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
                   outs(%y : !pto.tile_buf<vec, 16x16xf32>)
      }
    }
    return
  }
}

// PLAN-LABEL: PTOCanonicalSyncPlan @region_transitive
// PLAN-SAME: barriers=0 events=2
// PLAN: dependency 0 -> 2 kind=memory-raw distance=0 retained=no

// PLAN-LABEL: PTOCanonicalSyncPlan @conditional_path_preserved
// PLAN: dependency 0 -> 2 kind=memory-raw distance=0 retained=yes

// PLAN-LABEL: PTOCanonicalSyncPlan @zero_trip_path_preserved
// PLAN: dependency 0 -> 2 kind=memory-raw distance=0 retained=yes

// PLAN-LABEL: PTOCanonicalSyncPlan @positive_trip_path_reduced
// PLAN-SAME: barriers=0 events=2
// PLAN: dependency 0 -> 2 kind=memory-raw distance=0 retained=no

// PLAN-LABEL: PTOCanonicalSyncPlan @constant_zero_trip_path_preserved
// PLAN-SAME: barriers=0 events=3
// PLAN: dependency 0 -> 2 kind=memory-raw distance=0 retained=yes

// PLAN-LABEL: PTOCanonicalSyncPlan @positive_outer_zero_inner_path_preserved
// PLAN-SAME: barriers=0 events=3
// PLAN: dependency 0 -> 2 kind=memory-raw distance=0 retained=yes

// PLAN-LABEL: PTOCanonicalSyncPlan @positive_trip_conditional_path_preserved
// PLAN-SAME: barriers=0 events=3
// PLAN: dependency 0 -> 2 kind=memory-raw distance=0 retained=yes

// PLAN-LABEL: PTOCanonicalSyncPlan @barrier_covers_event
// PLAN-SAME: barriers=1 events=0
// PLAN: dependency 0 -> 3 kind=memory-raw distance=0 retained=no

// PLAN-LABEL: PTOCanonicalSyncPlan @conditional_barrier_does_not_cover
// PLAN-SAME: barriers=1 events=1
// PLAN: dependency 0 -> 3 kind=memory-raw distance=0 retained=yes

// PLAN-LABEL: PTOCanonicalSyncPlan @zero_trip_barrier_does_not_cover
// PLAN-SAME: barriers=2 events=1
// PLAN: dependency 0 -> 3 kind=memory-raw distance=0 retained=yes

// PLAN-LABEL: PTOCanonicalSyncPlan @positive_trip_barrier_covers_event
// PLAN-SAME: barriers=1 events=0
// PLAN: dependency 0 -> 3 kind=memory-raw distance=0 retained=no

// PLAN-LABEL: PTOCanonicalSyncPlan @nested_recurrence_not_summarized
// PLAN-SAME: barriers=0 events=3
// PLAN: dependency 1 -> 0 kind=memory-war distance=1 retained=yes
// PLAN: dependency 1 -> 0 kind=memory-war distance=1 retained=yes

// PLAN-LABEL: PTOCanonicalSyncPlan @nested_recurrence_third_pipe_preserved
// PLAN: dependency 3 -> 0 kind=memory-raw distance=1 retained=yes

// IR-LABEL: func.func @positive_trip_path_reduced
// IR-NOT: pto.set_flag[<PIPE_MTE2>, <PIPE_MTE3>
// IR: return

// IR-LABEL: func.func @constant_zero_trip_path_preserved
// IR: pto.set_flag[<PIPE_MTE2>, <PIPE_MTE3>

// IR-LABEL: func.func @barrier_covers_event
// IR: pto.tload
// IR: pto.barrier <PIPE_MTE2>
// IR-NOT: pto.set_flag[<PIPE_MTE2>, <PIPE_V>
// IR: pto.tmuls

// IR-LABEL: func.func @conditional_barrier_does_not_cover
// IR: pto.set_flag[<PIPE_MTE2>, <PIPE_V>
// IR: scf.if
// IR: pto.barrier <PIPE_MTE2>
// IR: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>
// IR-NEXT: pto.tmuls

// IR-LABEL: func.func @positive_trip_barrier_covers_event
// IR-NOT: pto.set_flag[<PIPE_MTE2>, <PIPE_V>
// IR: return
