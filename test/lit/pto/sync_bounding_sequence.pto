// RUN: pto-sync-input-test --bounding-sequence-checks %s
!tile = !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module {
  func.func @bounding_sequence(%n: index, %guard: i1) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %a = pto.alloc_tile addr = %zero : !tile
    scf.for %i = %c0 to %n step %c1 { pto.texpands ins(%one : f32) outs(%a : !tile) }
    scf.for %i = %c0 to %n step %c1 { pto.texpands ins(%one : f32) outs(%a : !tile) }
    scf.for %i = %c0 to %n step %c1 { pto.texpands ins(%one : f32) outs(%a : !tile) }
    return
  }
  func.func @native_reclosure() attributes {test.bounding_native} {
    %zero = arith.constant 0 : i64
    %c0 = arith.constant 0 : index
    %a = pto.alloc_tile addr = %zero : !tile
    %v = pto.tgetval ins(%a, %c0 : !tile, index) outs : f32
    pto.texpands ins(%v : f32) outs(%a : !tile)
    return
  }

}
