// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-gm-alias=may-alias %s | FileCheck %s --check-prefix=MAY
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-gm-alias=may-not-alias %s | FileCheck %s --check-prefix=NO
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-gm-alias=may-alias --emit-pto-ir %s | FileCheck %s --check-prefix=IR
// MAY: set_flag(PIPE_MTE3, PIPE_MTE2,
// MAY: wait_flag(PIPE_MTE3, PIPE_MTE2,
// NO-NOT: set_flag(PIPE_MTE3, PIPE_MTE2,
// NO: TLOAD
// IR: pto.set_flag
// The local tiles are disjoint. Only the selected policy on the two runtime GM
// pointer roots can introduce the store-to-load dependency.
module attributes {pto.target_arch = "a3"} {
  func.func @gm_dynamic(%a: !pto.ptr<f32, gm>, %b: !pto.ptr<f32, gm>, %offset: index) {
    %zero = arith.constant 0 : i64
    %far = arith.constant 4096 : i64
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %a_offset = pto.addptr %a, %offset : !pto.ptr<f32, gm> -> !pto.ptr<f32, gm>
    %va = pto.make_tensor_view %a_offset, shape = [%c16, %c16], strides = [%c16, %c1] : !pto.tensor_view<?x?xf32>
    %vb = pto.make_tensor_view %b, shape = [%c16, %c16], strides = [%c16, %c1] : !pto.tensor_view<?x?xf32>
    %pa = pto.partition_view %va, offsets = [%c0, %c0], sizes = [%c16, %c16] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x16xf32>
    %pb = pto.partition_view %vb, offsets = [%c0, %c0], sizes = [%c16, %c16] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x16xf32>
    %src = pto.alloc_tile addr = %zero : !pto.tile_buf<vec, 16x16xf32>
    %dst = pto.alloc_tile addr = %far : !pto.tile_buf<vec, 16x16xf32>
    pto.tstore ins(%src : !pto.tile_buf<vec, 16x16xf32>) outs(%pa : !pto.partition_tensor_view<16x16xf32>)
    pto.tload ins(%pb : !pto.partition_tensor_view<16x16xf32>) outs(%dst : !pto.tile_buf<vec, 16x16xf32>)
    return
  }
}
