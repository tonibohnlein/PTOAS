// The M-to-FIX event is lifted to the parent of the nested cube section. Each
// choice arm then drains FIX and publishes that imported completion globally,
// so it can reach the later child M phase. Child summaries must export fences
// as composable physical cuts, and the choice must join the two arm-local cuts.
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-analysis-only --emit-pto-ir %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-dump --emit-pto-ir %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=VERIFY

module attributes {pto.target_arch = "a2a3"} {
  func.func @event_then_fence_completion_chain(
      %dst: !pto.partition_tensor_view<32x32xf32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %acc0_addr = arith.constant 0 : i64
    %acc1_addr = arith.constant 4096 : i64
    %left_addr = arith.constant 0 : i64
    %right_addr = arith.constant 0 : i64
    %condition = arith.constant true
    %acc0 = pto.alloc_tile addr = %acc0_addr :
      !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=32, v_row=32,
                    v_col=32, blayout=col_major, slayout=row_major,
                    fractal=1024, pad=0>
    %acc1 = pto.alloc_tile addr = %acc1_addr :
      !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=32, v_row=32,
                    v_col=32, blayout=col_major, slayout=row_major,
                    fractal=1024, pad=0>
    %left = pto.alloc_tile addr = %left_addr :
      !pto.tile_buf<loc=left, dtype=f16, rows=32, cols=32, v_row=32,
                    v_col=32, blayout=row_major, slayout=row_major,
                    fractal=512, pad=0>
    %right = pto.alloc_tile addr = %right_addr :
      !pto.tile_buf<loc=right, dtype=f16, rows=32, cols=32, v_row=32,
                    v_col=32, blayout=row_major, slayout=col_major,
                    fractal=512, pad=0>
    pto.tmatmul.acc ins(%acc0, %left, %right :
                    !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=32,
                      v_row=32, v_col=32, blayout=col_major,
                      slayout=row_major, fractal=1024, pad=0>,
                    !pto.tile_buf<loc=left, dtype=f16, rows=32, cols=32,
                      v_row=32, v_col=32, blayout=row_major,
                      slayout=row_major, fractal=512, pad=0>,
                    !pto.tile_buf<loc=right, dtype=f16, rows=32, cols=32,
                      v_row=32, v_col=32, blayout=row_major,
                      slayout=col_major, fractal=512, pad=0>)
              outs(%acc1 : !pto.tile_buf<loc=acc, dtype=f32, rows=32,
                     cols=32, v_row=32, v_col=32, blayout=col_major,
                     slayout=row_major, fractal=1024, pad=0>)
    pto.section.cube {
      pto.tstore ins(%acc1 : !pto.tile_buf<loc=acc, dtype=f32, rows=32,
                      cols=32, v_row=32, v_col=32, blayout=col_major,
                      slayout=row_major, fractal=1024, pad=0>)
                 outs(%dst : !pto.partition_tensor_view<32x32xf32>)
      scf.if %condition {
        pto.fence.barrier_all #pto.fence_scope<gm>
      } else {
        pto.fence.barrier_all #pto.fence_scope<gm>
      }
      pto.tmatmul.acc ins(%acc1, %left, %right :
                      !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=32,
                        v_row=32, v_col=32, blayout=col_major,
                        slayout=row_major, fractal=1024, pad=0>,
                      !pto.tile_buf<loc=left, dtype=f16, rows=32, cols=32,
                        v_row=32, v_col=32, blayout=row_major,
                        slayout=row_major, fractal=512, pad=0>,
                      !pto.tile_buf<loc=right, dtype=f16, rows=32, cols=32,
                        v_row=32, v_col=32, blayout=row_major,
                        slayout=col_major, fractal=512, pad=0>)
                outs(%acc0 : !pto.tile_buf<loc=acc, dtype=f32, rows=32,
                       cols=32, v_row=32, v_col=32, blayout=col_major,
                       slayout=row_major, fractal=1024, pad=0>)
    }
    return
  }
}

// CHECK-LABEL: CANONICAL-SYNC function=event_then_fence_completion_chain
// CHECK: m[[EVENT:[0-9]+]] kind=event resource=AIC:PIPE_M->AIC:PIPE_FIX
// CHECK: world=singleton-m[[EVENT]]
// CHECK-SAME: oracle=match
// VERIFY-LABEL: CANONICAL-SYNC function=event_then_fence_completion_chain
// VERIFY: VERIFY ok
