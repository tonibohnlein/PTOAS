// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-fallback=fail --protocol-sync-gm-alias=may-alias --protocol-sync-dump=plan %s -o %t.safe.ir 2> %t.plan
// RUN: FileCheck %s --input-file=%t.plan --check-prefix=PLAN
// RUN: FileCheck %s --input-file=%t.safe.ir --check-prefix=IR
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-fallback=fail --protocol-sync-gm-alias=assume-disjoint-arguments %s -o %t.disjoint.ir
// RUN: FileCheck %s --input-file=%t.disjoint.ir --check-prefix=IR
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir --protocol-sync-analysis-only --protocol-sync-dump=concrete-verification %t.safe.ir -o /dev/null 2> %t.verify
// RUN: FileCheck %s --input-file=%t.verify --check-prefix=VERIFY
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir --protocol-sync-analysis-only --protocol-sync-gm-alias=assume-disjoint-arguments --protocol-sync-dump=concrete-verification %t.disjoint.ir -o /dev/null 2> %t.disjoint.verify
// RUN: FileCheck %s --input-file=%t.disjoint.verify --check-prefix=VERIFY
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --protocol-sync-mixed --protocol-sync-fallback=fail --protocol-sync-gm-alias=may-alias %s -o %t.cpp
// RUN: FileCheck %s --input-file=%t.cpp --check-prefix=CXX
// RUN: ptoas --pto-arch=a2 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-fallback=fail %s -o %t.a2.ir
// RUN: FileCheck %s --input-file=%t.a2.ir --check-prefix=IR

// PLAN: world=structured-frontier
// PLAN: world=structured-frontier
// VERIFY: concrete-verification function=@choice_frontier status=accepted first-failed-stage=none
// VERIFY: concrete-verification function=@loop_choice_frontier status=accepted first-failed-stage=none
// CXX-LABEL: AICORE void choice_frontier(
// CXX: if (
// CXX: set_flag(PIPE_V, PIPE_MTE3,
// CXX: TSTORE(
// CXX: wait_flag(PIPE_MTE3, PIPE_V,
// CXX: pipe_barrier(PIPE_ALL);
// CXX-LABEL: AICORE void loop_choice_frontier(
// CXX: for (int64_t
// CXX: if (
// CXX: TSTORE(
// CXX: wait_flag(PIPE_MTE3, PIPE_V,
// CXX: TABS(
// CXX: pipe_barrier(PIPE_ALL);
// IR-LABEL: func.func @choice_frontier
// IR: pto.set_flag[<PIPE_V>, <PIPE_MTE2>,
// IR-NEXT: pto.wait_flag[<PIPE_V>, <PIPE_MTE2>,
// IR-NEXT: pto.tload
// IR-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_V>,
// IR-NEXT: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>,
// IR: scf.if
// IR: pto.set_flag[<PIPE_V>, <PIPE_MTE3>,
// IR-NEXT: pto.wait_flag[<PIPE_V>, <PIPE_MTE3>,
// IR-NEXT: pto.tstore
// IR-NEXT: pto.set_flag[<PIPE_MTE3>, <PIPE_V>,
// IR-NEXT: pto.wait_flag[<PIPE_MTE3>, <PIPE_V>,
// IR: pto.tabs
// IR-NEXT: pto.barrier <PIPE_V>
// IR: pto.barrier <PIPE_ALL>
// IR-LABEL: func.func @loop_choice_frontier
// IR: scf.for
// IR: scf.if
// IR: pto.tstore
// IR-NEXT: pto.set_flag[<PIPE_MTE3>, <PIPE_V>,
// IR-NEXT: pto.wait_flag[<PIPE_MTE3>, <PIPE_V>,
// IR: } else {
// IR: pto.tabs
// IR-NEXT: pto.barrier <PIPE_V>
// IR: pto.tabs
// IR-NEXT: pto.barrier <PIPE_V>
// IR: pto.barrier <PIPE_ALL>

module {
  func.func @choice_frontier(%condition: i1,
      %input: !pto.partition_tensor_view<16x16xf16>,
      %output: !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %c256 = arith.constant 256 : i64
    %a = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    %reuse = pto.alloc_tile addr = %c256 : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
    scf.if %condition {
      pto.tstore ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%output : !pto.partition_tensor_view<16x16xf16>)
    }
    pto.tabs ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%reuse : !pto.tile_buf<vec, 16x16xf16>)
    pto.tstore ins(%reuse : !pto.tile_buf<vec, 16x16xf16>) outs(%output : !pto.partition_tensor_view<16x16xf16>)
    return
  }
  func.func @loop_choice_frontier(%n: index, %condition: i1,
      %input: !pto.partition_tensor_view<16x16xf16>,
      %output: !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %c256 = arith.constant 256 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %a = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    %reuse = pto.alloc_tile addr = %c256 : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
    scf.for %i = %zero to %n step %one {
      scf.if %condition {
        pto.tstore ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%output : !pto.partition_tensor_view<16x16xf16>)
      } else {
        pto.tabs ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%reuse : !pto.tile_buf<vec, 16x16xf16>)
      }
      pto.tabs ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%reuse : !pto.tile_buf<vec, 16x16xf16>)
    }
    pto.tstore ins(%reuse : !pto.tile_buf<vec, 16x16xf16>) outs(%output : !pto.partition_tensor_view<16x16xf16>)
    return
  }
}
