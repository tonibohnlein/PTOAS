// RUN: not ptoas --pto-arch=a2 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail --protocol-sync-gm-alias=may-alias --protocol-sync-dump=plan %s -o /dev/null 2>&1 | FileCheck %s
// RUN: not ptoas --pto-arch=a2 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail --protocol-sync-gm-alias=assume-disjoint-arguments --protocol-sync-dump=plan %s -o /dev/null 2>&1 | FileCheck %s
// RUN: not ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail --protocol-sync-gm-alias=may-alias --protocol-sync-dump=plan %s -o /dev/null 2>&1 | FileCheck %s
// RUN: not ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail --protocol-sync-gm-alias=assume-disjoint-arguments --protocol-sync-dump=plan %s -o /dev/null 2>&1 | FileCheck %s

// Normal synthesis must not silently select the serialized reference recipe.
// Its positive concrete, path and token-mutation tests remain in
// pto-protocol-sync-loop-memory-test through the explicit reference builders.
// Once-only paths now use selective repair; the recurring choice is still
// unsupported rather than falling back to a serialized completion hub.
// CHECK: mixed-plan function=@choice_frontier.__sync_path0 status=ready
// CHECK: mixed-plan function=@loop_choice_frontier status=unsupported
// CHECK: ProtocolSync mixed mode found no complete supported plan

module {
  func.func @choice_frontier(%condition: i1,
      %input: !pto.partition_tensor_view<16x16xf16>,
      %output: !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %c256 = arith.constant 256 : i64
    %a = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    %reuse = pto.alloc_tile addr = %c256 : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
    scf.if %condition {
      pto.tstore ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%output : !pto.partition_tensor_view<16x16xf16>)
    }
    pto.tabs ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%reuse : !pto.tile_buf<vec, 16x16xf16>)
    pto.tstore ins(%reuse : !pto.tile_buf<vec, 16x16xf16>) outs(%output : !pto.partition_tensor_view<16x16xf16>)
    return
  }
  func.func @loop_choice_frontier(%n: index, %condition: i1,
      %input: !pto.partition_tensor_view<16x16xf16>,
      %output: !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %c256 = arith.constant 256 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %a = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    %reuse = pto.alloc_tile addr = %c256 : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
    scf.for %i = %zero to %n step %one {
      scf.if %condition {
        pto.tstore ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%output : !pto.partition_tensor_view<16x16xf16>)
      } else {
        pto.tabs ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%reuse : !pto.tile_buf<vec, 16x16xf16>)
      }
      pto.tabs ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%reuse : !pto.tile_buf<vec, 16x16xf16>)
    }
    pto.tstore ins(%reuse : !pto.tile_buf<vec, 16x16xf16>) outs(%output : !pto.partition_tensor_view<16x16xf16>)
    return
  }
}
