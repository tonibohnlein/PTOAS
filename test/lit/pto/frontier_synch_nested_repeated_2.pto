// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch --emit-pto-ir %s -o %t.ir
// RUN: FileCheck %s --check-prefix=IR < %t.ir
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch %s -o %t.cpp
// RUN: FileCheck %s --check-prefix=CPP < %t.cpp
// RUN: pto-frontier-analysis-test --single-stream-check %s
// RUN: %python %S/Inputs/minimum_demand/check_nested_frames.py pto-test-opt %s
!vec = !pto.tile_buf<loc=vec, dtype=i32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module attributes {pto.target_arch = "a3"} {
  func.func @nested_repeated2(%gm0: !pto.partition_tensor_view<16x128xi32>,
                        %gm1: !pto.partition_tensor_view<16x128xi32>, %n: index, %outer: index)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %a0 = arith.constant 0 : i64
    %a1 = arith.constant 65536 : i64
    %a2 = arith.constant 131072 : i64
    %inputs = pto.alloc_multi_tile addr = %a0 : !pto.multi_tile_buf<!vec, count=2>
    %mid_addr = arith.constant 32768 : i64
    %mid_banks = pto.alloc_multi_tile addr = %mid_addr : !pto.multi_tile_buf<!vec, count=2>
    %tmp = pto.alloc_tile addr = %a2 : !vec
    %banks = pto.alloc_multi_tile addr = %a1 : !pto.multi_tile_buf<!vec, count=2>
    // These constants deliberately follow the entry payload.
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %count = arith.constant 2 : index
    scf.for %j = %zero to %outer step %one {
    scf.for %i = %zero to %n step %one {
      %slot = arith.remui %i, %count : index
      %output = pto.multi_tile_get %banks[%slot] : !pto.multi_tile_buf<!vec, count=2> -> !vec
      %input = pto.multi_tile_get %inputs[%slot] : !pto.multi_tile_buf<!vec, count=2> -> !vec
      pto.barrier <PIPE_MTE2>
      pto.tload ins(%gm0 : !pto.partition_tensor_view<16x128xi32>) outs(%input : !vec)
      %mid = pto.multi_tile_get %mid_banks[%slot] : !pto.multi_tile_buf<!vec, count=2> -> !vec
      pto.txor ins(%input, %input, %tmp : !vec, !vec, !vec) outs(%mid : !vec)
      pto.txor ins(%mid, %input, %tmp : !vec, !vec, !vec) outs(%output : !vec)
    }
    }
    %inner_positive = arith.cmpi slt, %zero, %n : index
    %outer_positive = arith.cmpi sgt, %outer, %zero : index
    %nonempty = arith.andi %inner_positive, %outer_positive : i1
    scf.if %nonempty {
      %last = arith.subi %n, %one : index
      %slot = arith.remui %last, %count : index
      %output = pto.multi_tile_get %banks[%slot] : !pto.multi_tile_buf<!vec, count=2> -> !vec
      pto.tstore ins(%output : !vec) outs(%gm1 : !pto.partition_tensor_view<16x128xi32>)
    }
    return
  }
}
// IR: pto.frontier.physical_status = "certified-repeated-ready-release"
// IR: scf.for
// IR: pto.barrier <PIPE_MTE2>
// IR: pto.wait_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID0>]
// IR: pto.tload
// IR: pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// IR: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// IR: pto.txor
// IR: pto.set_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID0>]
// IR: pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
// IR: pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
// IR: pto.tstore
// IR: pto.barrier <PIPE_ALL>
// IR-NOT: sync.logical_
// CPP: pipe_barrier(PIPE_MTE2);
// CPP: TLOAD(
// CPP: TXOR(
// CPP: TSTORE(
