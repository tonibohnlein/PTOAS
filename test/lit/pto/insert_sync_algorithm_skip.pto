// RUN: pto-test-opt --pto-insert-sync='algorithm=frontier-synch dump-frontier-demands=true' %s | FileCheck %s
// CHECK-LABEL: func.func private @decl
// CHECK-LABEL: func.func @manual
// CHECK: pto.set_flag
// CHECK: pto.wait_flag
// CHECK-LABEL: func.func @empty
module {
  func.func private @decl(!pto.tile_buf<vec, 16x16xf32>)
  func.func @manual() {
    pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
    pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
    return
  }
  func.func @empty() {
    return
  }
}
