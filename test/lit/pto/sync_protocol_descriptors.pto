// RUN: pto-sync-input-test --recognize %s | FileCheck %s --check-prefix=RECOGNIZE
// RUN: pto-test-opt --pto-frontier-analysis %s | FileCheck %s --check-prefix=KEEP
// Reduced from the corpus GEMM+eltwise producer/consumer handle setup.
// Descriptor state is preserved; its pointer values are not dereferenced.
module attributes {pto.target_arch = "a3"} {
  func.func @pipe_descriptors(%gm: !pto.ptr<f32>, %address: i32) {
    %pipe = pto.initialize_l2g2l_pipe{dir_mask = 1, slot_size = 4096, slot_num = 2,
      local_slot_num = 2, flag_base = 0, nosplit = true}
      (%gm : !pto.ptr<f32>, %address : i32) -> !pto.pipe
    %tile = pto.declare_tile -> !pto.tile_buf<vec, 16x64xf32, valid=?x?>
    %global = pto.declare_global -> !pto.tensor_view<?x?xf32>
    pto.barrier <PIPE_ALL>
    return
  }
  func.func @scalar_descriptor_prerequisite(%tile: !pto.tile_buf<vec, 1x32xi32>) {
    %zero = arith.constant 0 : index
    %address = pto.tgetval ins(%tile, %zero : !pto.tile_buf<vec, 1x32xi32>, index) outs : i32
    %pipe = pto.initialize_l2l_pipe{dir_mask = 1, slot_size = 128, slot_num = 2}
      (%address : i32) -> !pto.pipe
    return
  }
}
// RECOGNIZE-LABEL: recognition pipe_descriptors
// RECOGNIZE: recognize explicit: applicable
// RECOGNIZE-LABEL: recognition scalar_descriptor_prerequisite
// RECOGNIZE: recognize explicit: applicable
// KEEP-LABEL: func.func @pipe_descriptors
// KEEP: pto.initialize_l2g2l_pipe
// KEEP: pto.declare_tile
// KEEP: pto.declare_global
// KEEP: pto.barrier <PIPE_ALL>
// KEEP-NEXT: return
// KEEP-LABEL: func.func @scalar_descriptor_prerequisite
// KEEP: pto.tgetval
// KEEP: pto.initialize_l2l_pipe
// KEEP-NOT: pto.logical_
