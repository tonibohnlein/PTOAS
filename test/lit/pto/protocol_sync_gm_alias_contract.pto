// RUN: sed 's/pto.kernel_kind =/pto.gm_alias = "invalid", pto.kernel_kind =/' %s | not pto-test-opt --pto-protocol-sync='execution-mode=analysis gm-alias=assume-disjoint-arguments' -o /dev/null 2>&1 | FileCheck %s --check-prefix=IR-INVALID
// RUN: sed 's/pto.kernel_kind =/pto.gm_alias = 1 : i32, pto.kernel_kind =/' %s | not pto-test-opt --pto-protocol-sync='execution-mode=analysis' -o /dev/null 2>&1 | FileCheck %s --check-prefix=IR-INVALID
// RUN: sed 's/pto.kernel_kind =/pto.gm_alias = "assume-disjoint-arguments", pto.kernel_kind =/' %s | pto-test-opt --pto-protocol-sync='execution-mode=mixed fallback-mode=fail' -o %t.inherited
