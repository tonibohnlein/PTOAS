// RUN: split-file %S/protocol_sync_one_shot_hardening.pto %t.atomicity
// RUN: not pto-test-opt --pto-protocol-sync='execution-mode=one-shot fallback-mode=fail gm-alias=assume-disjoint-arguments' --mlir-print-ir-after-failure %t.atomicity/module-atomicity.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=ATOMIC

module attributes {pto.target_arch = "a3"} {
  func.func @two_copies(
      %input0: !pto.partition_tensor_view<16x16xf16>,
      %output0: !pto.partition_tensor_view<16x16xf16>,
      %input1: !pto.partition_tensor_view<16x16xf16>,
      %output1: !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %c512 = arith.constant 512 : i64
    %first = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    %second = pto.alloc_tile addr = %c512 : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%input0 : !pto.partition_tensor_view<16x16xf16>) outs(%first : !pto.tile_buf<vec, 16x16xf16>)
    pto.tstore ins(%first : !pto.tile_buf<vec, 16x16xf16>) outs(%output0 : !pto.partition_tensor_view<16x16xf16>)
    pto.tload ins(%input1 : !pto.partition_tensor_view<16x16xf16>) outs(%second : !pto.tile_buf<vec, 16x16xf16>)
    pto.tstore ins(%second : !pto.tile_buf<vec, 16x16xf16>) outs(%output1 : !pto.partition_tensor_view<16x16xf16>)
    return
  }
}

// SAFE: ProtocolSync mixed mode found no complete supported plan
// CONTRACT: pto.gm_alias = "assume-disjoint-arguments"
// CONTRACT: pto.set_flag
// CONTRACT: pto.wait_flag
// STATS: "gm_alias_mode":"assume-disjoint-arguments"
// VERIFIED: concrete-verification function=@two_copies status=accepted first-failed-stage=none
// UNCOVERED: concrete-verification function=@two_copies status=rejected first-failed-stage=residual-obligations
// INVALID: --protocol-sync-gm-alias must be 'may-alias' or 'assume-disjoint-arguments'
// MODE: --protocol-sync-gm-alias requires a ProtocolSync mode
// PASS-INVALID: ProtocolSync gm-alias must be 'may-alias' or 'assume-disjoint-arguments'
// IR-INVALID: pto.gm_alias must be 'may-alias' or 'assume-disjoint-arguments'
// ATOMIC: IR Dump After PTOProtocolSync
// ATOMIC-NOT: pto.gm_alias
// ATOMIC: func.func @would_be_supported
// ATOMIC-NOT: pto.gm_alias
// ATOMIC: func.func @later_rejection
// ATOMIC-NOT: pto.gm_alias
