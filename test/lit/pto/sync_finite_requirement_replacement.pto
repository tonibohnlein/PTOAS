// RUN: pto-sync-input-test --finite-replacement-checks %s
!tile = !pto.tile_buf<vec, 4x8xf32>
module {
  func.func @shared_cells(%condition: i1) attributes {test.finite_replacement} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1.0 : f32
    %a = pto.alloc_tile addr = %base : !tile
    pto.texpands ins(%one : f32) outs(%a : !tile)
    %v0 = pto.tgetval ins(%a, %zero : !tile, index) outs : f32
    pto.texpands ins(%one : f32) outs(%a : !tile)
    %v1 = pto.tgetval ins(%a, %zero : !tile, index) outs : f32
    return
  }
  func.func @native_prerequisite(%condition: i1) attributes {test.finite_replacement} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1.0 : f32
    %a = pto.alloc_tile addr = %base : !tile
    pto.texpands ins(%one : f32) outs(%a : !tile)
    %v0 = pto.tgetval ins(%a, %zero : !tile, index) outs : f32
    pto.texpands ins(%v0 : f32) outs(%a : !tile)
    %v1 = pto.tgetval ins(%a, %zero : !tile, index) outs : f32
    return
  }
}
