//
// Exercise the ORIGINAL frozen one-buffer input, not a rewritten payload.
// This file's RUN commands are supplied native acceptance tests; NOT_RUN in
// the patch-producing environment. Do not weaken these checks into fallbacks.
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-gm-alias=assume-disjoint-arguments --insert-sync-lifecycle-synthesis --emit-pto-ir %S/../../experiments/insert_sync/performance/inputs/one_buffer.auto.pto -o %t.combined.pto
// RUN: FileCheck %s --check-prefix=ONE --implicit-check-not='pto.barrier <PIPE_MTE3>' < %t.combined.pto
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-gm-alias=assume-disjoint-arguments --insert-sync-lifecycle-synthesis --insert-sync-defer-same-pipe --emit-pto-ir %S/../../experiments/insert_sync/performance/inputs/one_buffer.auto.pto -o %t.staged.pto
// RUN: FileCheck %s --check-prefix=ONE --implicit-check-not='pto.barrier <PIPE_MTE3>' < %t.staged.pto
// RUN: ptoas --pto-arch=a2 --pto-level=level3 --enable-insert-sync --insert-sync-gm-alias=assume-disjoint-arguments --insert-sync-lifecycle-synthesis --insert-sync-defer-same-pipe %S/../../experiments/insert_sync/performance/inputs/one_buffer.auto.pto -o %t.cpp
// ONE-LABEL: func.func @pipeline
// ONE-SAME: pto.insert_sync.lifecycle_completion_pairs = {{[1-9][0-9]*}}
// ONE-SAME: lifecycle-plus-residuals
// ONE: pto.tload
// ONE: pto.tabs
// ONE: pto.tstore
// ONE: pto.barrier <PIPE_ALL>
