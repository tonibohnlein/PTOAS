// RUN: pto-sync-input-test --storage-effects %s | FileCheck %s
// RUN: pto-sync-input-test --recognize %s | FileCheck %s --check-prefix=RECOGNIZE

// RECOGNIZE-LABEL: recognition reused_ranges
// RECOGNIZE: recognize explicit: missing-premise backend=unavailable
// RECOGNIZE-LABEL: recognition scalar_only
// RECOGNIZE: recognize explicit: applicable backend=unavailable

// One large allocation is reused as two smaller allocations with distinct SSA
// roots. InsertSync's shared ranges distinguish the disjoint smaller buffers
// and the separate allocation while preserving overlap with the large buffer.
// Only the shared scalar declarations establish exact element overwrites.
// CHECK-LABEL: storage reused_ranges: cells=5 all-exact=0
// CHECK: effect 0 pto.texpands write upper definite-write=0 cells=
// CHECK: effect 1 pto.texpands write upper definite-write=0 cells=
// CHECK: effect 2 pto.texpands write upper definite-write=0 cells=
// CHECK: effect 3 pto.tsetval write exact definite-write=1 cells=
// CHECK: effect 4 pto.tgetval read exact definite-write=0 cells=
// CHECK: effect 5 pto.tsetval write exact definite-write=1 cells=
// CHECK: effect 6 pto.texpands write upper definite-write=0 cells=
// CHECK: overlap 0,1=1
// CHECK: overlap 0,2=1
// CHECK: overlap 1,2=0
// CHECK: overlap 4,5=1
// CHECK: overlap 3,5=0
// CHECK: overlap 0,6=0
// CHECK-LABEL: storage scalar_only: cells=1 all-exact=1
// CHECK: effect 0 pto.tsetval write exact definite-write=1 cells=
// CHECK: effect 1 pto.tgetval read exact definite-write=0 cells=
// CHECK: source-unchanged; dependency-analysis-not-run

!large = !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=32, v_row=16, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!small = !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module {
  func.func @reused_ranges() attributes {test.overlap = array<i64: 0, 1, 0, 2, 1, 2, 4, 5, 3, 5, 0, 6>} {
    %zero = arith.constant 0 : i64
    %middle = arith.constant 1024 : i64
    %far = arith.constant 4096 : i64
    %i0 = arith.constant 0 : index
    %i256 = arith.constant 256 : index
    %one = arith.constant 1.0 : f32
    %large = pto.alloc_tile addr = %zero : !large
    %left = pto.alloc_tile addr = %zero : !small
    %right = pto.alloc_tile addr = %middle : !small
    %separate = pto.alloc_tile addr = %far : !small
    pto.texpands ins(%one : f32) outs(%large : !large)
    pto.texpands ins(%one : f32) outs(%left : !small)
    pto.texpands ins(%one : f32) outs(%right : !small)
    pto.tsetval ins(%i0, %one : index, f32) outs(%left : !small)
    %v = pto.tgetval ins(%large, %i256 : !large, index) outs : f32
    pto.tsetval ins(%i0, %v : index, f32) outs(%right : !small)
    pto.texpands ins(%one : f32) outs(%separate : !small)
    return
  }
  func.func @scalar_only() {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %one = arith.constant 1.0 : f32
    %a = pto.alloc_tile addr = %zero : !small
    %b = pto.alloc_tile addr = %zero : !small
    pto.tsetval ins(%i0, %one : index, f32) outs(%a : !small)
    %v = pto.tgetval ins(%b, %i0 : !small, index) outs : f32
    return
  }
}
