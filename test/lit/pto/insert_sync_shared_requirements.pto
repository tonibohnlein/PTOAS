// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir %S/../../experiments/insert_sync/performance/inputs/two_buffer.auto.pto -o %t.input.pto
// RUN: %python %S/Inputs/check_sync_requirements.py pto-test-opt %t.input.pto %t
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-buffer-generations --insert-sync-defer-same-pipe --insert-sync-gm-alias=assume-disjoint-arguments --emit-pto-ir %S/../../experiments/insert_sync/performance/inputs/topk_128.auto.pto -o %t.topk.pto
// RUN: FileCheck %s --check-prefix=TOPK < %t.topk.pto
// TopK's translated sort/merge/gather phases reach shared storage refinement
// even though exact-slot protocol construction cannot qualify its aliasing views.
// TOPK: pto.insert_sync.generation_storage_barriers_guarded = 2
// TOPK: pto.barrier <PIPE_V>
// TOPK: pto.tsort32
// TOPK: pto.tmrgsort
// TOPK: pto.tgather
// TOPK: pto.insert_sync.frontier_overflow_guard
// TOPK: pto.barrier <PIPE_ALL>
module {}
