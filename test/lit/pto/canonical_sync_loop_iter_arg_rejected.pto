// RUN: ptoas --pto-arch=a3 --pto-level=level3 \
// RUN:   --enable-canonical-sync --canonical-sync-analysis-only \
// RUN:   --emit-pto-ir %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @memory_loop_iter_arg_fixed_point()
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %addr = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %one_f32 = arith.constant 1.000000e+00 : f32
    %buffer = pto.alloc_tile addr = %addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %result = scf.for %iteration = %zero to %two step %one
        iter_args(%carried = %buffer) ->
        (!pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                       v_col=128, blayout=row_major, slayout=none_box,
                       fractal=512, pad=0>) {
      pto.tmuls ins(%carried, %one_f32 :
                      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128,
                        v_row=16, v_col=128, blayout=row_major,
                        slayout=none_box, fractal=512, pad=0>, f32)
                outs(%buffer : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
      scf.yield %carried : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                            cols=128, v_row=16, v_col=128,
                            blayout=row_major, slayout=none_box,
                            fractal=512, pad=0>
    }
    return
  }

  // The first dynamic instance reads %first, while later instances may read
  // %second through the yielded backedge. The pre-loop write to %second must
  // therefore remain a possible producer for the loop read.
  func.func @memory_loop_iter_arg_init_yield_union(
      %src: !pto.partition_tensor_view<16x128xf32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %first_addr = arith.constant 0 : i64
    %second_addr = arith.constant 8192 : i64
    %output_addr = arith.constant 16384 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %one_f32 = arith.constant 1.000000e+00 : f32
    %first = pto.alloc_tile addr = %first_addr
        : !pto.tile_buf<vec, 16x128xf32>
    %second = pto.alloc_tile addr = %second_addr
        : !pto.tile_buf<vec, 16x128xf32>
    %output = pto.alloc_tile addr = %output_addr
        : !pto.tile_buf<vec, 16x128xf32>
    pto.tload ins(%src : !pto.partition_tensor_view<16x128xf32>)
              outs(%second : !pto.tile_buf<vec, 16x128xf32>)
    %result = scf.for %iteration = %zero to %two step %one
        iter_args(%carried = %first) -> (!pto.tile_buf<vec, 16x128xf32>) {
      pto.tmuls ins(%carried, %one_f32 :
                      !pto.tile_buf<vec, 16x128xf32>, f32)
                outs(%output : !pto.tile_buf<vec, 16x128xf32>)
      scf.yield %second : !pto.tile_buf<vec, 16x128xf32>
    }
    return
  }
}

// CHECK-LABEL: CANONICAL-SYNC function=memory_loop_iter_arg_fixed_point
// CHECK: distance=[
// CHECK-SAME: +
// CHECK: VERIFY skipped (analysis-only; IR unchanged)

// CHECK-LABEL: CANONICAL-SYNC function=memory_loop_iter_arg_init_yield_union
// CHECK: kind=RAW p0->p1
// CHECK: kind=event resource=AIV:PIPE_MTE2->AIV:PIPE_V
// CHECK: VERIFY skipped (analysis-only; IR unchanged)
