// RUN: pto-test-opt --split-input-file --pto-frontier-analysis='completion-only=true' %s | FileCheck %s
// No helper-boundary drains. The write remains pending through the call and the
// first read acquires it; the second read needs no repeated completion.
// CHECK-LABEL: func.func private @writer
// CHECK-NOT: pto.barrier
// CHECK: return
// CHECK-LABEL: func.func private @reader
// CHECK-NOT: pto.barrier
// CHECK: return
// CHECK-LABEL: func.func @parent_last
// CHECK: call @writer
// CHECK-NEXT: pto.barrier <PIPE_ALL>
// CHECK-NEXT: call @reader
// CHECK-NEXT: call @reader
// CHECK-NEXT: pto.barrier <PIPE_ALL>
// CHECK-NEXT: return
!tile = !pto.tile_buf<vec, 1x8xf32>
module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func private @writer() {
    %address = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %address : !tile
    pto.texpands ins(%one : f32) outs(%tile : !tile)
    return
  }
  func.func private @reader() {
    %address = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %tile = pto.alloc_tile addr = %address : !tile
    %read = "pto.tgetval"(%tile, %zero) : (!tile, index) -> f32
    return
  }
  func.func @parent_last() {
    func.call @writer() : () -> ()
    func.call @reader() : () -> ()
    func.call @reader() : () -> ()
    return
  }
}
// -----
// CHECK-LABEL: func.func @parent_first
// CHECK: call @writer
// CHECK-NEXT: pto.barrier <PIPE_ALL>
// CHECK-NEXT: call @reader
// CHECK-NEXT: call @reader
// CHECK-NEXT: pto.barrier <PIPE_ALL>
// CHECK-NEXT: return
// CHECK-LABEL: func.func private @writer
// CHECK-NOT: pto.barrier
// CHECK: return
// CHECK-LABEL: func.func private @reader
// CHECK-NOT: pto.barrier
// CHECK: return
!tile = !pto.tile_buf<vec, 1x8xf32>
module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @parent_first() {
    func.call @writer() : () -> ()
    func.call @reader() : () -> ()
    func.call @reader() : () -> ()
    return
  }
  func.func private @writer() {
    %address = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %address : !tile
    pto.texpands ins(%one : f32) outs(%tile : !tile)
    return
  }
  func.func private @reader() {
    %address = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %tile = pto.alloc_tile addr = %address : !tile
    %read = "pto.tgetval"(%tile, %zero) : (!tile, index) -> f32
    return
  }
}
