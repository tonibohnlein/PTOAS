// Compiler regression, not native/device evidence from this package.
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-gm-alias=assume-disjoint-arguments --emit-pto-ir %s -o %t.off.pto
// RUN: FileCheck %s --check-prefix=OFF < %t.off.pto
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-gm-alias=assume-disjoint-arguments --insert-sync-frontier-refinement --emit-pto-ir %s -o %t.on.pto
// RUN: FileCheck %s --check-prefix=ON < %t.on.pto
// RUN: ptoas --pto-arch=a2 --pto-level=level3 --enable-insert-sync --insert-sync-gm-alias=assume-disjoint-arguments --insert-sync-defer-same-pipe --insert-sync-frontier-refinement %s -o %t.cpp
// OFF-NOT: pto.insert_sync.frontier_barriers_removed
// ON: pto.insert_sync.frontier_barriers_removed
// ON: pto.insert_sync.frontier_requirements
// ON: pto.barrier <PIPE_ALL>
!V = !pto.tile_buf<vec, 16x16xf16>
!G = !pto.tensor_view<?x?xf16>
!P = !pto.partition_tensor_view<16x16xf16>
module attributes {pto.target_arch = "a3"} {
  func.func @production_frontier(%src: !pto.ptr<f16>, %dst: !pto.ptr<f16>, %trips: index)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.gm_alias = "assume-disjoint-arguments"} {
    %z = arith.constant 0 : index
    %one = arith.constant 1 : index
    %s = arith.constant 16 : index
    %a0 = arith.constant 0 : i64
    %a1 = arith.constant 512 : i64
    %a2 = arith.constant 1024 : i64
    %a = pto.alloc_tile addr = %a0 : !V
    %b = pto.alloc_tile addr = %a1 : !V
    %c = pto.alloc_tile addr = %a2 : !V
    %input = pto.make_tensor_view %src, shape = [%s, %s], strides = [%s, %one] : !G
    %p = pto.partition_view %input, offsets = [%z, %z], sizes = [%s, %s] : !G -> !P
    %twos = arith.constant 32 : index
    %three = arith.constant 3 : index
    %rows = arith.muli %trips, %twos : index
    %output = pto.make_tensor_view %dst, shape = [%rows, %s], strides = [%s, %one] : !G
    pto.tload ins(%p : !P) outs(%a : !V)
    pto.tabs ins(%a : !V) outs(%b : !V)
    pto.tabs ins(%a : !V) outs(%c : !V)
    scf.for %i = %z to %trips step %one {
      %row = arith.muli %i, %twos : index
      %row1 = arith.addi %row, %s : index
      %d0 = pto.partition_view %output, offsets = [%row, %z], sizes = [%s, %s] : !G -> !P
      %d1 = pto.partition_view %output, offsets = [%row1, %z], sizes = [%s, %s] : !G -> !P
      pto.tstore ins(%b : !V) outs(%d0 : !P)
      pto.tstore ins(%c : !V) outs(%d1 : !P)
    }
    return
  }
}
