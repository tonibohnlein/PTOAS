// Each direct barrier is analyzed as a singleton. The barrier motivated by d2
// also covers d3, so greedy selection omits d3's direct barrier. No group world
// is created, and materialization emits only the four selected PIPE_V cuts.
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-dump --emit-pto-ir \
// RUN:   --mlir-print-ir-after=pto-canonical-sync %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @singleton_cover_omits_redundant_barrier(%condition: i1)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %input_addr = arith.constant 0 : i64
    %shared_addr = arith.constant 8192 : i64
    %then_addr = arith.constant 16384 : i64
    %then_second_addr = arith.constant 24576 : i64
    %else_addr = arith.constant 32768 : i64
    %else_second_addr = arith.constant 40960 : i64
    %output_addr = arith.constant 49152 : i64
    %zero = arith.constant 0 : index
    %one_index = arith.constant 1 : index
    %two = arith.constant 2 : index
    %one = arith.constant 1.000000e+00 : f32
    %input = pto.alloc_tile addr = %input_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %shared = pto.alloc_tile addr = %shared_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %then_output = pto.alloc_tile addr = %then_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %then_second = pto.alloc_tile addr = %then_second_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %else_output = pto.alloc_tile addr = %else_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %else_second = pto.alloc_tile addr = %else_second_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %output = pto.alloc_tile addr = %output_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    pto.tmuls ins(%input, %one : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                    cols=128, v_row=16, v_col=128, blayout=row_major,
                    slayout=none_box, fractal=512, pad=0>, f32)
              outs(%shared : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                     cols=128, v_row=16, v_col=128, blayout=row_major,
                     slayout=none_box, fractal=512, pad=0>)
    scf.if %condition {
      scf.for %iteration = %zero to %two step %one_index {
        pto.tmuls ins(%shared, %one : !pto.tile_buf<loc=vec, dtype=f32,
                        rows=16, cols=128, v_row=16, v_col=128,
                        blayout=row_major, slayout=none_box, fractal=512,
                        pad=0>, f32)
                  outs(%then_output : !pto.tile_buf<loc=vec, dtype=f32,
                         rows=16, cols=128, v_row=16, v_col=128,
                         blayout=row_major, slayout=none_box, fractal=512,
                         pad=0>)
      }
      pto.tmuls ins(%shared, %one : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%then_second : !pto.tile_buf<loc=vec, dtype=f32,
                       rows=16, cols=128, v_row=16, v_col=128,
                       blayout=row_major, slayout=none_box, fractal=512,
                       pad=0>)
    } else {
      pto.tmuls ins(%shared, %one : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%else_output : !pto.tile_buf<loc=vec, dtype=f32,
                       rows=16, cols=128, v_row=16, v_col=128,
                       blayout=row_major, slayout=none_box, fractal=512,
                       pad=0>)
      pto.tmuls ins(%shared, %one : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%else_second : !pto.tile_buf<loc=vec, dtype=f32,
                       rows=16, cols=128, v_row=16, v_col=128,
                       blayout=row_major, slayout=none_box, fractal=512,
                       pad=0>)
    }
    pto.tmuls ins(%shared, %one : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                    cols=128, v_row=16, v_col=128, blayout=row_major,
                    slayout=none_box, fractal=512, pad=0>, f32)
              outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                     cols=128, v_row=16, v_col=128, blayout=row_major,
                     slayout=none_box, fractal=512, pad=0>)
    return
  }
}

// CHECK-LABEL: CANONICAL-SYNC function=singleton_cover_omits_redundant_barrier
// CHECK: m0 kind=barrier resource=AIV:PIPE_V->AIV:PIPE_V
// CHECK: m1 kind=barrier resource=AIV:PIPE_V->AIV:PIPE_V
// CHECK: m2 kind=barrier resource=AIV:PIPE_V->AIV:PIPE_V
// CHECK: world=singleton-m2 mechanisms=[m2, m5]
// CHECK-SAME: covered=[d2, d3, d6, d7, d8, d9, d10, d11]
// CHECK-SAME: oracle=match
// CHECK-NOT: world=choice-group
// CHECK: SET-COVER optimization=singleton baseline=[m5]
// CHECK-SAME: universe=[d0, d1, d2, d3, d4, d5]
// CHECK: candidate=c2 mechanisms=[m2] weight=1
// CHECK-SAME: direct-origins=[d2]
// CHECK-SAME: additional=[d3]
// CHECK: OPTIMIZATION enabled=yes mode=singleton-greedy
// CHECK-SAME: greedy=[c0, c2, c1, c4]
// CHECK-SAME: proposed=[m0, m1, m2, m4, m5]
// CHECK-SAME: reverse-deleted=[] weight=4 coverage-verified=yes
// CHECK: PLAN selected=[m0, m1, m2, m4, m5] events=[]
// CHECK: VERIFY ok
// CHECK-COUNT-4: pto.barrier <PIPE_V>
// CHECK: pto.barrier <PIPE_ALL>
