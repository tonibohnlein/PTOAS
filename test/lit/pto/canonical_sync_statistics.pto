// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-stats --canonical-sync-analysis-only \
// RUN:   --emit-pto-ir %s -o /dev/null 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @statistics_record()
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    return
  }
}

// CHECK: VERIFY skipped (analysis-only; IR unchanged)
// CHECK-NEXT: {"counts":{
// CHECK-SAME: "accesses":0
// CHECK-SAME: "max_verifier_loop_states":0
// CHECK-SAME: "function":"statistics_record"
// CHECK-SAME: "kind":"canonical-sync-statistics"
// CHECK-SAME: "status":"ok"
// CHECK-SAME: "time_us":{
