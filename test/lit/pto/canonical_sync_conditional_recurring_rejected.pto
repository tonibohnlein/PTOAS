// The ready handoff executes only on even iterations, while an ordinary
// release cycle would execute at every loop header and latch.  On a skipped
// arm there is no cross-pipeline proof that the old release token was consumed
// before it is reset, so the recurring protocol must remain fail-closed.
// RUN: not ptoas --pto-arch=a3 --pto-level=level3 \
// RUN:   --enable-canonical-sync --emit-pto-ir %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @conditional_recurring_rejected(
      %src: !pto.partition_tensor_view<16x128xf32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %input_addr = arith.constant 0 : i64
    %output_addr = arith.constant 8192 : i64
    %zero = arith.constant 0 : index
    %one_index = arith.constant 1 : index
    %two = arith.constant 2 : index
    %four = arith.constant 4 : index
    %one = arith.constant 1.000000e+00 : f32
    %input = pto.alloc_tile addr = %input_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %output = pto.alloc_tile addr = %output_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    scf.for %iteration = %zero to %four step %one_index {
      %remainder = arith.remui %iteration, %two : index
      %even = arith.cmpi eq, %remainder, %zero : index
      scf.if %even {
        pto.tload ins(%src : !pto.partition_tensor_view<16x128xf32>)
                  outs(%input : !pto.tile_buf<loc=vec, dtype=f32,
                         rows=16, cols=128, v_row=16, v_col=128,
                         blayout=row_major, slayout=none_box,
                         fractal=512, pad=0>)
        pto.tmuls ins(%input, %one : !pto.tile_buf<loc=vec, dtype=f32,
                        rows=16, cols=128, v_row=16, v_col=128,
                        blayout=row_major, slayout=none_box, fractal=512,
                        pad=0>, f32)
                  outs(%output : !pto.tile_buf<loc=vec, dtype=f32,
                         rows=16, cols=128, v_row=16, v_col=128,
                         blayout=row_major, slayout=none_box, fractal=512,
                         pad=0>)
      }
    }
    return
  }
}

// CHECK: error: canonical sync cannot construct a single-lane recurring event
// CHECK-SAME: requires loop-body physical anchors and a reverse release event
