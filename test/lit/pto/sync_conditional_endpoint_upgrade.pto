// RUN: pto-sync-input-test --certify-regions %s | FileCheck %s
// RUN: pto-sync-input-test --gm-alias=may-alias --certify-regions %s | FileCheck %s
// CHECK: conditional-endpoint-upgrade: guarded-closure-reused both-preparation-routes cold-equivalent residual
!tile = !pto.tile_buf<vec, 1x16xf32>
module attributes {pto.target_arch = "a3"} {
  func.func @conditional_upgrade(%condition: i1) attributes {test.conditional_endpoint_upgrade} {
    %address = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %value = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %address : !tile
    scf.if %condition {
      pto.tadds ins(%tile, %value : !tile, f32) outs(%tile : !tile)
      %then = pto.tgetval ins(%tile, %zero : !tile, index) outs : f32
    } else {
      pto.tadds ins(%tile, %value : !tile, f32) outs(%tile : !tile)
      %else = pto.tgetval ins(%tile, %one : !tile, index) outs : f32
    }
    return
  }
}
