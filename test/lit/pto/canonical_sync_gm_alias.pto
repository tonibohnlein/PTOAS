// RUN: pto-test-opt %s \
// RUN:   '-pto-print-canonical-sync-plan=format=text view=all' \
// RUN:   | FileCheck %s --check-prefix=PLAN
// RUN: pto-test-opt %s '-pto-canonical-sync=event-id-num-max=8' \
// RUN:   | FileCheck %s --check-prefix=IR
// RUN: pto-test-opt %s \
// RUN:   '-pto-print-canonical-sync-plan=format=text view=all assume-distinct-gm-args-noalias=true' \
// RUN:   | FileCheck %s --check-prefix=ASSUME
// RUN: pto-test-opt %s \
// RUN:   '-pto-canonical-sync=event-id-num-max=8 assume-distinct-gm-args-noalias=true' \
// RUN:   | FileCheck %s --check-prefix=ASSUME-IR
// RUN: pto-test-opt %s \
// RUN:   '-pto-print-canonical-sync-plan=format=dot view=plan assume-distinct-gm-args-noalias=true' \
// RUN:   | FileCheck %s --check-prefix=ASSUME-DOT
// RUN: ptoas %s --pto-level=level3 --pto-arch=a3 \
// RUN:   --enable-canonical-sync \
// RUN:   --canonical-sync-assume-distinct-gm-args-noalias -o - \
// RUN:   | FileCheck %s --check-prefix=CLI-CPP
// RUN: ptoas %s --pto-level=level3 --pto-arch=a3 --emit-pto-ir \
// RUN:   --enable-canonical-sync \
// RUN:   --canonical-sync-assume-distinct-gm-args-noalias -o - \
// RUN:   | FileCheck %s --check-prefix=CLI-IR

module attributes {pto.target_arch = "a2a3"} {
  func.func @external_may_alias(%first: !pto.ptr<f32>,
                                %second: !pto.ptr<f32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %addr0 = arith.constant 0 : i64
    %addr1024 = arith.constant 1024 : i64
    %first_view = pto.make_tensor_view %first,
      shape = [%c1, %c16], strides = [%c16, %c1]
      : !pto.tensor_view<1x16xf32>
    %first_part = pto.partition_view %first_view,
      offsets = [%c0, %c0], sizes = [%c1, %c16]
      : !pto.tensor_view<1x16xf32>
     -> !pto.partition_tensor_view<1x16xf32>
    %second_view = pto.make_tensor_view %second,
      shape = [%c1, %c16], strides = [%c16, %c1]
      : !pto.tensor_view<1x16xf32>
    %second_part = pto.partition_view %second_view,
      offsets = [%c0, %c0], sizes = [%c1, %c16]
      : !pto.tensor_view<1x16xf32>
     -> !pto.partition_tensor_view<1x16xf32>
    %source = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 1x16xf32>
    %target = pto.alloc_tile addr = %addr1024 : !pto.tile_buf<vec, 1x16xf32>
    pto.tstore ins(%source : !pto.tile_buf<vec, 1x16xf32>)
               outs(%first_part : !pto.partition_tensor_view<1x16xf32>)
    pto.tload ins(%second_part : !pto.partition_tensor_view<1x16xf32>)
              outs(%target : !pto.tile_buf<vec, 1x16xf32>)
    return
  }

  func.func @external_noalias(%first: !pto.ptr<f32>,
                              %second: !pto.ptr<f32>)
      attributes {pto.noalias_pairs = array<i64: 0, 1>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %addr0 = arith.constant 0 : i64
    %addr1024 = arith.constant 1024 : i64
    %first_view = pto.make_tensor_view %first,
      shape = [%c1, %c16], strides = [%c16, %c1]
      : !pto.tensor_view<1x16xf32>
    %first_part = pto.partition_view %first_view,
      offsets = [%c0, %c0], sizes = [%c1, %c16]
      : !pto.tensor_view<1x16xf32>
     -> !pto.partition_tensor_view<1x16xf32>
    %second_view = pto.make_tensor_view %second,
      shape = [%c1, %c16], strides = [%c16, %c1]
      : !pto.tensor_view<1x16xf32>
    %second_part = pto.partition_view %second_view,
      offsets = [%c0, %c0], sizes = [%c1, %c16]
      : !pto.tensor_view<1x16xf32>
     -> !pto.partition_tensor_view<1x16xf32>
    %source = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 1x16xf32>
    %target = pto.alloc_tile addr = %addr1024 : !pto.tile_buf<vec, 1x16xf32>
    pto.tstore ins(%source : !pto.tile_buf<vec, 1x16xf32>)
               outs(%first_part : !pto.partition_tensor_view<1x16xf32>)
    pto.tload ins(%second_part : !pto.partition_tensor_view<1x16xf32>)
              outs(%target : !pto.tile_buf<vec, 1x16xf32>)
    return
  }

  func.func @addptr_adjacent(%base: !pto.ptr<f32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %addr0 = arith.constant 0 : i64
    %addr1024 = arith.constant 1024 : i64
    %first_ptr = pto.addptr %base, %c0 : !pto.ptr<f32> -> !pto.ptr<f32>
    %second_ptr = pto.addptr %base, %c16 : !pto.ptr<f32> -> !pto.ptr<f32>
    %first_view = pto.make_tensor_view %first_ptr,
      shape = [%c1, %c16], strides = [%c16, %c1]
      : !pto.tensor_view<1x16xf32>
    %first_part = pto.partition_view %first_view,
      offsets = [%c0, %c0], sizes = [%c1, %c16]
      : !pto.tensor_view<1x16xf32>
     -> !pto.partition_tensor_view<1x16xf32>
    %second_view = pto.make_tensor_view %second_ptr,
      shape = [%c1, %c16], strides = [%c16, %c1]
      : !pto.tensor_view<1x16xf32>
    %second_part = pto.partition_view %second_view,
      offsets = [%c0, %c0], sizes = [%c1, %c16]
      : !pto.tensor_view<1x16xf32>
     -> !pto.partition_tensor_view<1x16xf32>
    %source = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 1x16xf32>
    %target = pto.alloc_tile addr = %addr1024 : !pto.tile_buf<vec, 1x16xf32>
