    return
  }

  func.func @addptr_invalid_offsets(%base: !pto.ptr<ui32>) {
    %cneg1 = arith.constant -1 : index
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %cmax = arith.constant 9223372036854775807 : index
    %cwrap = arith.constant 4294967304 : i64
    %addr0 = arith.constant 0 : i64
    %view = pto.make_tensor_view %base,
      shape = [%c1, %c16], strides = [%c16, %c1]
      : !pto.tensor_view<1x16xui32>
    %part = pto.partition_view %view,
      offsets = [%c0, %c0], sizes = [%c1, %c16]
      : !pto.tensor_view<1x16xui32>
     -> !pto.partition_tensor_view<1x16xui32>
    %source = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 1x16xui32>
    pto.tstore ins(%source : !pto.tile_buf<vec, 1x16xui32>)
               outs(%part : !pto.partition_tensor_view<1x16xui32>)
    %negative = pto.addptr %base, %cneg1
      : !pto.ptr<ui32> -> !pto.ptr<ui32>
    %negative_value = pto.load_scalar %negative[%c0]
      : !pto.ptr<ui32> -> ui32
    %overflow = pto.addptr %base, %cmax
      : !pto.ptr<ui32> -> !pto.ptr<ui32>
    %overflow_value = pto.load_scalar %overflow[%c0]
      : !pto.ptr<ui32> -> ui32
    %wrapped_i32 = arith.trunci %cwrap : i64 to i32
    %wrapped_index = arith.index_cast %wrapped_i32 : i32 to index
    %wrapped = pto.addptr %base, %wrapped_index
      : !pto.ptr<ui32> -> !pto.ptr<ui32>
    %wrapped_value = pto.load_scalar %wrapped[%c0]
      : !pto.ptr<ui32> -> ui32
    return
  }

