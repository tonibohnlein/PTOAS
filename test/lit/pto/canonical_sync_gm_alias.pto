// PLAN-LABEL: PTOCanonicalSyncPlan @external_may_alias
// PLAN-SAME: gm-alias-policy=may-alias
// PLAN-SAME: requirements=1 conservative-requirements=1
// PLAN-SAME: events=1
// PLAN-LABEL: PTOCanonicalSyncPlan @external_noalias
// PLAN-SAME: requirements=0 conservative-requirements=1
// PLAN-SAME: events=0
// PLAN-LABEL: PTOCanonicalSyncPlan @addptr_adjacent
// PLAN-SAME: events=0
// PLAN-LABEL: PTOCanonicalSyncPlan @addptr_overlap
// PLAN-SAME: events=1
// PLAN-LABEL: PTOCanonicalSyncPlan @addptr_dynamic
// PLAN-SAME: events=1
// PLAN-LABEL: PTOCanonicalSyncPlan @partition_adjacent
// PLAN-SAME: events=0
// PLAN-LABEL: PTOCanonicalSyncPlan @partition_strided_holes
// PLAN-SAME: events=0
