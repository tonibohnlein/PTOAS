// RUN: pto-sync-input-test --sequence-analysis %s | FileCheck %s
// CHECK: symbolic arithmetic siblings: exact queries, covers, recursive exports, and endpoints passed
// Model moving tensor windows, as used by tiled corpus transfers. Family size
// remains dynamic; the C++ oracle specializes only its independent finite check.
module attributes {pto.backend = "emitc", pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @symbolic_siblings(%src: !pto.ptr<f32, gm>, %dst: !pto.ptr<f32, gm>, %n: index) attributes {test.symbolic_arithmetic_siblings, test.trace_arguments = array<i64: 0, 65536, 3>} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %four = arith.constant 4 : index
    %eight = arith.constant 8 : index
    %sv = pto.make_tensor_view %src, shape = [%one, %eight], strides = [%eight, %one] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf32>
    %dv = pto.make_tensor_view %dst, shape = [%one, %eight], strides = [%eight, %one] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf32>
    %sp = pto.partition_view %sv, offsets = [%zero, %zero], sizes = [%one, %eight] : !pto.tensor_view<?x?xf32>
    %dp = pto.partition_view %dv, offsets = [%zero, %zero], sizes = [%one, %eight] : !pto.tensor_view<?x?xf32>
    scf.for %i = %zero to %n step %one {
      %offset = arith.muli %i, %four overflow<nsw> : index
      %address = arith.index_cast %offset : index to i64
      %tile = pto.alloc_tile addr = %address : !pto.tile_buf<vec, 1x8xf32>
      pto.tload ins(%sp : !pto.partition_tensor_view<1x8xf32>) outs(%tile : !pto.tile_buf<vec, 1x8xf32>) {layout = #pto.layout<nd>}
    }
    scf.for %j = %zero to %n step %one {
      %offset = arith.muli %j, %four overflow<nsw> : index
      %address = arith.index_cast %offset : index to i64
      %tile = pto.alloc_tile addr = %address : !pto.tile_buf<vec, 1x8xf32>
      pto.tstore ins(%tile : !pto.tile_buf<vec, 1x8xf32>) outs(%dp : !pto.partition_tensor_view<1x8xf32>) {layout = #pto.layout<nd>}
    }
    scf.for %k = %zero to %n step %one {
      %offset = arith.muli %k, %four overflow<nsw> : index
      %address = arith.index_cast %offset : index to i64
      %tile = pto.alloc_tile addr = %address : !pto.tile_buf<vec, 1x8xf32>
      pto.tload ins(%sp : !pto.partition_tensor_view<1x8xf32>) outs(%tile : !pto.tile_buf<vec, 1x8xf32>) {layout = #pto.layout<nd>}
    }
    return
  }
}
