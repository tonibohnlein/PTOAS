// RUN: pto-sync-input-test --explicit-analysis %s | %python %S/Inputs/check_explicit_residual_order.py
// Only the later phase needs residual queries. Keep original reference order
// when applying asymmetric accumulator protection; read/read L0 aliases do not
// manufacture software completion demands.
!a = !pto.tile_buf<left, 32x16xf16, slayout=row_major>
!b = !pto.tile_buf<right, 16x80xf16, slayout=col_major>
!c = !pto.tile_buf<acc, 32x80xf32, blayout=col_major, slayout=row_major, fractal=1024>
module attributes {pto.target_arch = "a3"} {
  func.func @reset_then_writer(%address: i64) attributes {test.residual_eligibility} {
    %base = arith.constant 0 : i64
    %a = pto.alloc_tile addr = %base : !a
    %asym = pto.alloc_tile addr = %address : !a
    %b = pto.alloc_tile addr = %base : !b
    %c = pto.alloc_tile addr = %base : !c
    pto.tmatmul ins(%a, %b : !a, !b) outs(%c : !c)
    pto.tmatmul.acc ins(%c, %asym, %b : !c, !a, !b) outs(%c : !c)
    return
  }
  func.func @writer_then_reset(%address: i64) attributes {test.residual_eligibility} {
    %base = arith.constant 0 : i64
    %a = pto.alloc_tile addr = %base : !a
    %asym = pto.alloc_tile addr = %address : !a
    %b = pto.alloc_tile addr = %base : !b
    %c = pto.alloc_tile addr = %base : !c
    pto.tmatmul.acc ins(%c, %a, %b : !c, !a, !b) outs(%c : !c)
    pto.tmatmul ins(%asym, %b : !a, !b) outs(%c : !c)
    return
  }
}
