// RUN: not pto-sync-input-test --storage-effects %s 2>&1 | FileCheck %s
module attributes {pto.target_arch = "a3"} {
  func.func @invalid_byte_stride() {
    %zero = arith.constant 0 : i64
    %src = pto.alloc_tile addr = %zero : !pto.tile_buf<vec, 2x33xi8, valid=2x33>
    return
  }
}
// CHECK: expects result row-major none_box tile row byte size
// CHECK-SAME: to be 32-byte aligned, but got 33 bytes
