// The explicit fence executes after the source on every loop iteration and
// drains V, so it closes the V self-recurrence without relying on the optional
// direct barrier candidate.
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-analysis-only --emit-pto-ir %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @fixed_fence_closes_vector_recurrence()
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %buffer_addr = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one_index = arith.constant 1 : index
    %two = arith.constant 2 : index
    %one = arith.constant 1.000000e+00 : f32
    %buffer = pto.alloc_tile addr = %buffer_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    scf.for %iteration = %zero to %two step %one_index {
      pto.tmuls ins(%buffer, %one : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%buffer : !pto.tile_buf<loc=vec, dtype=f32,
                       rows=16, cols=128, v_row=16, v_col=128,
                       blayout=row_major, slayout=none_box, fractal=512,
                       pad=0>)
      pto.fence.barrier_all #pto.fence_scope<gm>
    }
    return
  }

  func.func @fixed_fence_closes_cross_pipe_recurrence(
      %src: !pto.partition_tensor_view<16x128xf32>, %condition: i1)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %buffer_addr = arith.constant 0 : i64
    %output_addr = arith.constant 8192 : i64
    %zero = arith.constant 0 : index
    %one_index = arith.constant 1 : index
    %two = arith.constant 2 : index
    %one = arith.constant 1.000000e+00 : f32
    %buffer = pto.alloc_tile addr = %buffer_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %output = pto.alloc_tile addr = %output_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    scf.for %iteration = %zero to %two step %one_index {
      scf.if %condition {
        pto.tload ins(%src : !pto.partition_tensor_view<16x128xf32>)
                  outs(%buffer : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                         cols=128, v_row=16, v_col=128,
                         blayout=row_major, slayout=none_box, fractal=512,
                         pad=0>)
        pto.fence.barrier_all #pto.fence_scope<gm>
      } else {
        pto.tmuls ins(%buffer, %one : !pto.tile_buf<loc=vec, dtype=f32,
                        rows=16, cols=128, v_row=16, v_col=128,
                        blayout=row_major, slayout=none_box, fractal=512,
                        pad=0>, f32)
                  outs(%output : !pto.tile_buf<loc=vec, dtype=f32,
                         rows=16, cols=128, v_row=16, v_col=128,
                         blayout=row_major, slayout=none_box, fractal=512,
                         pad=0>)
        pto.fence.barrier_all #pto.fence_scope<gm>
      }
    }
    return
  }
}

// CHECK-LABEL: CANONICAL-SYNC function=fixed_fence_closes_vector_recurrence
// CHECK: distance=[r{{[0-9]+}}:+]
// CHECK: kind=fixed-fence fence=f0
// CHECK: world=baseline
// CHECK-SAME: oracle=match
// CHECK: SET-COVER optimization=disabled
// CHECK-SAME: universe=[]
// CHECK-LABEL: CANONICAL-SYNC function=fixed_fence_closes_cross_pipe_recurrence
// CHECK: d{{[0-9]+}} kind=RAW {{.*}} distance=[r{{[0-9]+}}:+]
// CHECK-SAME: direct=m[[RECURRENCE_FENCE:[0-9]+]]
// CHECK: m[[RECURRENCE_FENCE]] kind=fixed-fence fence=f0
// CHECK: world=baseline
// CHECK-SAME: oracle=match
// CHECK: SET-COVER optimization=disabled
// CHECK-SAME: universe=[]
