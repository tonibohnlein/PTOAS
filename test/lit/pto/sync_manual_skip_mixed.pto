// RUN: not pto-test-opt --pto-frontier-allocate="eligible-ids=0,1,2,3,4,5" %s 2>&1 | FileCheck %s
// A partial logical plan mixed with physical flags must not silently skip allocation.
module {
  func.func @mixed(%ordinal: index) {
    pto.set_flag [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_V>, #pto.event<EVENT_ID0>]
    pto.logical_set [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_V>] plan 0 record 0 ordinal %ordinal
    pto.logical_wait [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_V>] plan 0 record 0 ordinal %ordinal
    return
  }
}
// CHECK: error: physical allocation requires a supported finite or uniform allocation export
