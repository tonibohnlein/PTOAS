// RUN: pto-test-opt --split-input-file --pto-insert-sync --verify-diagnostics %s

module {
  func.func private @opaque(!pto.tile_buf<vec, 16x16xf16>)
      attributes {pto.tileop.kind = "vector"}
  func.func @missing_helper(%a: !pto.tile_buf<vec, 16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    // expected-error @+1 {{InsertSync unsupported helper: complete pto.tileop.effects contract required}}
    func.call @opaque(%a) : (!pto.tile_buf<vec, 16x16xf16>) -> ()
    return
  }
}

// -----

module {
  func.func private @opaque(!pto.tile_buf<vec, 16x16xf16>)
      attributes {pto.tileop.kind = "vector", pto.tileop.effects = ["reed"]}
  func.func @invalid_helper(%a: !pto.tile_buf<vec, 16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    // expected-error @+1 {{InsertSync unsupported helper: invalid operand effect}}
    func.call @opaque(%a) : (!pto.tile_buf<vec, 16x16xf16>) -> ()
    return
  }
}

// -----

module {
  func.func private @opaque(!pto.tile_buf<vec, 16x16xf16>)
      attributes {pto.tileop.effects = ["write"]}
  func.func @missing_pipe(%a: !pto.tile_buf<vec, 16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    // expected-error @+1 {{write has no translated storage/pipeline summary}}
    func.call @opaque(%a) : (!pto.tile_buf<vec, 16x16xf16>) -> ()
    return
  }
}
