// RUN: pto-test-opt --pto-protocol-sync='dump=schedule' %s -o /dev/null 2>&1 | FileCheck %s
// RUN: not ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail %s -o %t.pto 2>&1 | FileCheck %s --check-prefix=FAIL
// FAIL: ProtocolSync mixed mode found no complete supported plan (unsupported)
// CHECK: schedule function=@unknown_dimension
// CHECK: rejected reason=unsupported-descriptor-state op=pto.set_validshape
// CHECK-SAME: dimensions need bounded constants
// CHECK: schedule function=@unresolved_getter_consumer
// CHECK: rejected reason=unsupported-descriptor-state op=pto.alloc_tile
// CHECK-SAME: dimensions need bounded constants
// CHECK-NOT: failed internally
// CHECK: schedule function=@conditional_update
// CHECK: rejected reason=unsupported-descriptor-state
// CHECK-SAME: cross-region users are unsupported
// CHECK: schedule function=@physical_scalar_dimension
// CHECK: rejected reason=unsupported-descriptor-state op=pto.set_validshape
// CHECK-SAME: dimensions need bounded constants

!tile = !pto.tile_buf<loc=vec, dtype=f16, rows=4, cols=16, v_row=?, v_col=?,
                     blayout=row_major, slayout=none_box, fractal=512, pad=0>
module attributes {pto.target_arch = "a3"} {
  func.func @unknown_dimension(%rows: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %base = arith.constant 0 : i64
    %c4 = arith.constant 4 : index
    %c16 = arith.constant 16 : index
    %tile = pto.alloc_tile addr = %base valid_row = %c4 valid_col = %c16 : !tile
    pto.set_validshape %tile, %rows, %c16 : !tile
    return
  }
  func.func @unresolved_getter_consumer(%rows: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %base = arith.constant 0 : i64
    %c16 = arith.constant 16 : index
    %tile = pto.alloc_tile addr = %base valid_row = %rows valid_col = %c16 : !tile
    %r, %c = pto.get_validshape %tile : !tile
    %integer = arith.index_cast %r : index to i32
    %scalar = arith.sitofp %integer : i32 to f16
    pto.tadds ins(%tile, %scalar : !tile, f16) outs(%tile : !tile)
    return
  }
  func.func @conditional_update(%condition: i1) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %base = arith.constant 0 : i64
    %c4 = arith.constant 4 : index
    %c16 = arith.constant 16 : index
    %tile = pto.alloc_tile addr = %base valid_row = %c4 valid_col = %c16 : !tile
    scf.if %condition {
      pto.set_validshape %tile, %c4, %c16 : !tile
    }
    return
  }
  func.func @physical_scalar_dimension(%pointer: !pto.ptr<i32, gm>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %c4 = arith.constant 4 : index
    %c16 = arith.constant 16 : index
    %tile = pto.alloc_tile addr = %base valid_row = %c4 valid_col = %c16 : !tile
    %value = pto.load_scalar %pointer[%zero] : !pto.ptr<i32, gm> -> i32
    %rows = arith.index_cast %value : i32 to index
    pto.set_validshape %tile, %rows, %c16 : !tile
    return
  }
}
