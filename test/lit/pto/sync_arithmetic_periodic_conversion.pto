    %1 = pto.make_tensor_view %arg1, shape = [%c32, %c32], strides = [%c32, %c1] {layout = #pto.layout<nd>, pto.inferred_layout = true} : !pto.tensor_view<?x?xf32>
    %2 = pto.partition_view %0, offsets = [%c0, %c0], sizes = [%c32, %c32] : !pto.tensor_view<?x?xf32>
    %3 = pto.partition_view %1, offsets = [%c0, %c0], sizes = [%c32, %c32] : !pto.tensor_view<?x?xf32>
    %4 = pto.alloc_tile addr = %c0_i64 : !pto.tile_buf<vec, 32x32xf32>
    scf.for %arg2 = %c0 to %c10 step %c1 {
      pto.tload ins(%2 : !pto.partition_tensor_view<32x32xf32>) outs(%4 : !pto.tile_buf<vec, 32x32xf32>) {layout = #pto.layout<nd>, pto.inferred_layout = true}
        pto.tstore ins(%4 : !pto.tile_buf<vec, 32x32xf32>) outs(%3 : !pto.partition_tensor_view<32x32xf32>) {layout = #pto.layout<nd>, pto.inferred_layout = true}
    }
    return
  }
