// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch --emit-pto-ir %s -o %t.ir
// RUN: FileCheck %s --check-prefix=IR < %t.ir
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch --emit-pto-ir --report-frontier-costs %s -o %t.cost.ir 2> %t.cost
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch %s -o %t.cpp 2> %t.cpp.log
// RUN: FileCheck %s --check-prefix=CPP < %t.cpp
// RUN: FileCheck %s --check-prefix=LOWERING --allow-empty < %t.cpp.log
// RUN: %python %S/Inputs/minimum_demand/check_periodic_physical.py %s %t.ir %t.cost
// Fixed participation is independent of SSA allocation/view placement. The
// scalar conditional has no shared payload and must survive canonicalization
// because its result changes the actual tile addresses. The selected graph
// still uses the original shared modeled phase-pair hazards, including unknown
// local ranges; it does not claim exact physical effects of those addresses.
// The independent checker executes n<=0, n=1, and longer dynamic prefixes,
// checks original requirement coverage and declared weighted closure equality,
// and checks causal rearm plus missing-WAIT/early-SET mutations.
!vec = !pto.tile_buf<loc=vec, dtype=i32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!gm = !pto.partition_tensor_view<16x128xi32>
!view = !pto.tensor_view<?x?xi32>
module attributes {pto.target_arch = "a3"} {
  func.func @modeled_periodic_views(%src: !view, %dst: !view, %n: index)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %rows = arith.constant 16 : index
    %cols = arith.constant 128 : index
    %page = arith.constant 8192 : index
    %twopages = arith.constant 16384 : index
    %stride = arith.constant 24576 : index
    scf.for %i = %zero to %n step %one {
      %first = arith.cmpi eq, %i, %zero : index
      %control = scf.if %first -> (index) {
        %bank = arith.remui %i, %two : index
        %selected = arith.muli %bank, %page : index
        scf.yield %selected : index
      } else {
        %bank = arith.remui %i, %two : index
        %selected = arith.muli %bank, %twopages : index
        scf.yield %selected : index
      }
      %iteration = arith.muli %i, %stride : index
      %offset = arith.addi %iteration, %control : index
      %addr0 = arith.index_cast %offset : index to i64
      %middle = arith.addi %offset, %page : index
      %addr1 = arith.index_cast %middle : index to i64
      %last = arith.addi %offset, %twopages : index
      %addr2 = arith.index_cast %last : index to i64
      %tile0 = pto.alloc_tile addr = %addr0 : !vec
      %tile1 = pto.alloc_tile addr = %addr1 : !vec
      %tile2 = pto.alloc_tile addr = %addr2 : !vec
      %row = arith.muli %i, %rows : index
      %input = pto.partition_view %src, offsets = [%row, %zero], sizes = [%rows, %cols] : !view -> !gm
      %output = pto.partition_view %dst, offsets = [%row, %zero], sizes = [%rows, %cols] : !view -> !gm
      pto.tload ins(%input : !gm) outs(%tile0 : !vec)
      pto.txor ins(%tile0, %tile0, %tile2 : !vec, !vec, !vec) outs(%tile1 : !vec)
      pto.tstore ins(%tile1 : !vec) outs(%output : !gm)
    }
    return
  }
}
// IR-DAG: representation = "weighted-periodic-quotient"
// IR-DAG: route = "certified-periodic-quotient"
// IR-DAG: pto.frontier.physical_status = "certified-periodic-pools"
// IR: scf.for
// IR: scf.if
// IR: pto.alloc_tile
// IR: pto.partition_view
// IR: pto.tload
// IR: pto.txor
// IR: pto.tstore
// IR-NOT: sync.logical_
// LOWERING-NOT: Unsupported IntegerType width
// CPP: __int128
// CPP: TLOAD(
// CPP: TXOR(
// CPP: TSTORE(
// CPP: pipe_barrier(PIPE_ALL);
