// RUN: ptoas --pto-level=level3 --pto-arch=a5 --enable-canonical-sync \
// RUN:   --canonical-sync-analysis-only \
// RUN:   --canonical-sync-comparison-report=%t.json --emit-pto-ir %s \
// RUN:   > %t.mlir
// RUN: pto-test-opt %s \
// RUN:   '-pto-canonical-sync=analysis-only event-id-num-max=8' \
// RUN:   > /dev/null 2> %t.log
// RUN: FileCheck %s --check-prefix=UNCHANGED < %t.mlir
// RUN: FileCheck %s --check-prefix=SUMMARY < %t.log
// RUN: FileCheck %s --check-prefix=REPORT < %t.json
// RUN: not ptoas --pto-level=level3 --pto-arch=a5 --enable-canonical-sync \
// RUN:   --canonical-sync-selection-strategy=invalid --emit-pto-ir %s \
// RUN:   2>&1 | FileCheck %s --check-prefix=INVALID

// SUMMARY: canonical sync: demands=
// SUMMARY-DAG: canonical sync strategy=fixed-cover
// SUMMARY-DAG: canonical sync strategy=action-aware-singleton
// SUMMARY-DAG: canonical sync strategy=pair-lookahead
// SUMMARY-DAG: repair-trials=
// SUMMARY-DAG: repair-work=
// SUMMARY-DAG: repair-frontier-truncated=
// SUMMARY-DAG: repair-budget-exhausted=
// SUMMARY-DAG: backstop-deletion-trials=
// SUMMARY-DAG: backstop-deletion-work=
// SUMMARY-DAG: backstop-deletion-truncated=
// REPORT: "demands":
// REPORT: "direct_pair_evaluations":
// REPORT: "backstop_deletion_trials":
// REPORT: "backstop_deletion_truncated":
// REPORT: "backstop_deletion_work_units":
// REPORT: "repair_budget_exhausted":
// REPORT: "repair_frontier_truncated":
// REPORT: "repair_trials":
// REPORT: "repair_work_units":
// REPORT: "strategy": "fixed-cover"
// REPORT: "strategy": "action-aware-singleton"
// REPORT: "strategy": "pair-lookahead"
// INVALID: selection-strategy must be fixed-cover, action-aware-singleton, or pair-lookahead

module {
  // UNCHANGED-LABEL: func.func @comparison
  // UNCHANGED: pto.tload
  // UNCHANGED-NEXT: pto.tstore
  // UNCHANGED-NOT: pto.set_flag
  // UNCHANGED-NOT: pto.wait_flag
  func.func @comparison(
      %input: !pto.partition_tensor_view<16x16xf32>,
      %output: !pto.partition_tensor_view<16x16xf32>) {
    %addr0 = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    pto.tload ins(%input : !pto.partition_tensor_view<16x16xf32>)
      outs(%tile : !pto.tile_buf<vec, 16x16xf32>)
    pto.tstore ins(%tile : !pto.tile_buf<vec, 16x16xf32>)
      outs(%output : !pto.partition_tensor_view<16x16xf32>)
    return
  }
}
