// CORE-REPORT-DAG: "maximum_singleton_candidate_coverage_rows":
// CORE-REPORT-DAG: "total_singleton_candidate_coverage_rows":
// CORE-REPORT-DAG: "grounded_coverage_rows":
// CORE-REPORT-DAG: "exact_supply_demand_rows":
// CORE-REPORT-DAG: "additional_grounded_coverage_rows":
// CORE-REPORT-DAG: "exact_supply_demands":
// CORE-REPORT-DAG: "grounded_covered_demands":
// CORE-REPORT-DAG: "used_localized_pipe_all": false
// CORE-REPORT-DAG: "verified": true
// INVALID: selection-strategy must be fixed-cover, action-aware-singleton, or pair-lookahead
// INVALID-OBJECTIVE: selection-objective must be action-first or serialization-first
// INVALID-BOUND: maximum-verification-work-units must be positive
// INVALID-STRICT: strict-direct catalog mode permits only mechanism-families=core or storage-cut-event, and requires enable-conflict-core-repair=false
// INVALID-PHASE-BOUND: maximum-periodic-recurrence-states must be positive
// MAX-PHASE-BOUND: maximum-periodic-recurrence-states must not exceed 16
// INVALID-WITNESS-BOUND: maximum-recurrence-witness-states must be positive
// MAX-WITNESS-BOUND: maximum-recurrence-witness-states must not exceed 262144
// INVALID-OWNERSHIP-INSPECT: maximum-basic-ownership-inspections must be positive
// INVALID-OWNERSHIP-CERTIFICATE: maximum-basic-ownership-certificates must be positive
// INVALID-OWNERSHIP-REFERENCES: maximum-basic-ownership-node-references must be positive
// INVALID-BASIS-EDGE: maximum-demand-basis-group-edges must be positive
// INVALID-BASIS-WORD: maximum-demand-basis-reachability-words must be positive
// INVALID-BASIS-WORK: maximum-demand-basis-reduction-work must be positive
// INVALID-PREFIX-INSPECT: maximum-source-prefix-inspections must be positive
// INVALID-PREFIX-CANDIDATE: maximum-source-prefix-candidates must be positive
// INVALID-PREFIX-INCIDENCE: maximum-source-prefix-incidences must be positive
// INVALID-CARRY-INSPECT: maximum-loop-carry-inspections must be positive
// INVALID-CARRY-CANDIDATE: maximum-loop-carry-candidates must be positive
// INVALID-CARRY-INCIDENCE: maximum-loop-carry-incidences must be positive

module {
  // UNCHANGED-LABEL: func.func @comparison
  // UNCHANGED: pto.tload
  // UNCHANGED-NEXT: pto.tstore
  // UNCHANGED-NOT: pto.set_flag
  // UNCHANGED-NOT: pto.wait_flag
  func.func @comparison(
      %input: !pto.partition_tensor_view<16x16xf32>,
      %output: !pto.partition_tensor_view<16x16xf32>) {
    %addr0 = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    pto.tload ins(%input : !pto.partition_tensor_view<16x16xf32>)
      outs(%tile : !pto.tile_buf<vec, 16x16xf32>)
    pto.tstore ins(%tile : !pto.tile_buf<vec, 16x16xf32>)
      outs(%output : !pto.partition_tensor_view<16x16xf32>)
    return
  }
}
