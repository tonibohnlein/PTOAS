// RUN: pto-test-opt --pto-insert-sync %s | FileCheck %s --check-prefix=EXISTING
// RUN: pto-test-opt --pto-frontier-analysis %s | FileCheck %s --check-prefix=FRONTIER
// A manual function does not disable analysis of its unsynchronized sibling.
module attributes {pto.target_arch = "a3"} {
  func.func @manual() {
    pto.set_flag [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_V>, #pto.event<EVENT_ID0>]
    pto.wait_flag [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_V>, #pto.event<EVENT_ID0>]
    return
  }
  func.func @automatic(%ptr: !pto.ptr<f32, gm>) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %size = arith.constant 32 : index
    %base = arith.constant 0 : i64
    %view = pto.make_tensor_view %ptr, shape = [%size], strides = [%one] : !pto.tensor_view<32xf32>
    %part = pto.partition_view %view, offsets = [%zero], sizes = [%size] : !pto.tensor_view<32xf32>
    %tile = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 1x32xf32>
    pto.tload ins(%part : !pto.partition_tensor_view<32xf32>) outs(%tile : !pto.tile_buf<vec, 1x32xf32>)
    pto.tabs ins(%tile : !pto.tile_buf<vec, 1x32xf32>) outs(%tile : !pto.tile_buf<vec, 1x32xf32>)
    return
  }
}
// EXISTING-LABEL: func.func @automatic
// EXISTING: pto.set_flag
// EXISTING: pto.wait_flag
// FRONTIER-LABEL: func.func @automatic
// FRONTIER: pto.logical_set
// FRONTIER: pto.logical_wait
