// RUN: pto-sync-input-test --descriptor-state-checks %s | FileCheck %s
// CHECK: descriptor-state: same_block
// CHECK: descriptor-state: equal_join
// CHECK: descriptor-state: unequal_join
// CHECK: descriptor-state: zero_trip
// CHECK: descriptor-state: one_trip
// CHECK: descriptor-state: backedge
// CHECK: descriptor-state: strong_update
// CHECK: descriptor-state: recreated
// CHECK: descriptor-state: iv_update
// CHECK: descriptor-state: distinct_identity
!tile = !pto.tile_buf<vec, 8x8xf32, valid=?x?>
module {
  func.func @same_block(%cond: i1, %count: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    %addr = arith.constant 0 : i64
    %t = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    %a = "pto.tgetval"(%t, %c0) {test.shape = array<i64: 8, 8>} : (!tile, index) -> f32
    pto.set_validshape %t, %c1, %c8 : !tile
    %b = "pto.tgetval"(%t, %c0) {test.shape = array<i64: 1, 8>} : (!tile, index) -> f32
    return
  }
  func.func @equal_join(%cond: i1, %count: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    %addr = arith.constant 0 : i64
    %t = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    scf.if %cond {
    pto.set_validshape %t, %c1, %c8 : !tile
    } else {
    pto.set_validshape %t, %c1, %c8 : !tile
    }
    %a = "pto.tgetval"(%t, %c0) {test.shape = array<i64: 1, 8>} : (!tile, index) -> f32
    return
  }
  func.func @unequal_join(%cond: i1, %count: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    %addr = arith.constant 0 : i64
    %t = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    scf.if %cond {
    pto.set_validshape %t, %c1, %c8 : !tile
    } else {
    pto.set_validshape %t, %c2, %c8 : !tile
    }
    %a = "pto.tgetval"(%t, %c0) {test.shape = array<i64: -1, -1>} : (!tile, index) -> f32
    return
  }
  func.func @zero_trip(%cond: i1, %count: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    %addr = arith.constant 0 : i64
    %t = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    scf.for %i = %c0 to %c0 step %c1 {
    pto.set_validshape %t, %c1, %c8 : !tile
    }
    %a = "pto.tgetval"(%t, %c0) {test.shape = array<i64: 8, 8>} : (!tile, index) -> f32
    return
  }
  func.func @one_trip(%cond: i1, %count: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    %addr = arith.constant 0 : i64
    %t = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    scf.for %i = %c0 to %c1 step %c1 {
    %a = "pto.tgetval"(%t, %c0) {test.shape = array<i64: 8, 8>} : (!tile, index) -> f32
    pto.set_validshape %t, %c1, %c8 : !tile
    }
    %b = "pto.tgetval"(%t, %c0) {test.shape = array<i64: 1, 8>} : (!tile, index) -> f32
    return
  }
  func.func @backedge(%cond: i1, %count: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    %addr = arith.constant 0 : i64
    %t = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    scf.for %i = %c0 to %count step %c1 {
    %a = "pto.tgetval"(%t, %c0) {test.shape = array<i64: -1, -1>} : (!tile, index) -> f32
    pto.set_validshape %t, %c1, %c8 : !tile
    }
    %b = "pto.tgetval"(%t, %c0) {test.shape = array<i64: -1, -1>} : (!tile, index) -> f32
    return
  }
  func.func @strong_update(%cond: i1, %count: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    %addr = arith.constant 0 : i64
    %t = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    scf.for %i = %c0 to %count step %c1 {
    pto.set_validshape %t, %c1, %c8 : !tile
    %a = "pto.tgetval"(%t, %c0) {test.shape = array<i64: 1, 8>} : (!tile, index) -> f32
    }
    %b = "pto.tgetval"(%t, %c0) {test.shape = array<i64: -1, -1>} : (!tile, index) -> f32
    return
  }
  func.func @recreated(%cond: i1, %count: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    %addr = arith.constant 0 : i64
    %t = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    scf.for %i = %c0 to %count step %c1 {
    %fresh = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    %a = "pto.tgetval"(%fresh, %c0) {test.shape = array<i64: 8, 8>} : (!tile, index) -> f32
    pto.set_validshape %fresh, %c1, %c8 : !tile
    }
    %b = "pto.tgetval"(%t, %c0) {test.shape = array<i64: 8, 8>} : (!tile, index) -> f32
    return
  }
  func.func @iv_update(%cond: i1, %count: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    %addr = arith.constant 0 : i64
    %t = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    scf.for %i = %c0 to %c4 step %c1 {
    %a = "pto.tgetval"(%t, %c0) {test.shape = array<i64: -1, -1>} : (!tile, index) -> f32
    pto.set_validshape %t, %i, %c8 : !tile
    }
    %b = "pto.tgetval"(%t, %c0) {test.shape = array<i64: -1, -1>} : (!tile, index) -> f32
    return
  }
  func.func @distinct_identity(%cond: i1, %count: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    %addr = arith.constant 0 : i64
    %t = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    %other = pto.alloc_tile addr = %addr valid_row = %c2 valid_col = %c8 : !tile
    pto.set_validshape %t, %c1, %c8 : !tile
    %a = "pto.tgetval"(%t, %c0) {test.shape = array<i64: 1, 8>} : (!tile, index) -> f32
    %b = "pto.tgetval"(%other, %c0) {test.shape = array<i64: 2, 8>} : (!tile, index) -> f32
    return
  }
  func.func private @opaque(!tile)
  func.func @opaque_call(%cond: i1, %count: index) {
    %c0 = arith.constant 0 : index
    %c8 = arith.constant 8 : index
    %addr = arith.constant 0 : i64
    %t = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    func.call @opaque(%t) : (!tile) -> ()
    %a = "pto.tgetval"(%t, %c0) {test.shape = array<i64: -1, -1>} : (!tile, index) -> f32
    return
  }
  func.func @constant_expression() {
    %c0 = arith.constant 0 : index
    %c4 = arith.constant 4 : index
    %sum = arith.addi %c4, %c4 : index
    %addr = arith.constant 0 : i64
    %t = pto.alloc_tile addr = %addr valid_row = %sum valid_col = %sum : !tile
    %a = "pto.tgetval"(%t, %c0) {test.shape = array<i64: 8, 8>} : (!tile, index) -> f32
    return
  }
  func.func @nested_2(%count: index) attributes {test.max_descriptor_visits = 360 : i64} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %addr = arith.constant 0 : i64
    %t0 = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    scf.for %i0 = %c0 to %count step %c1 {
    %t1 = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    scf.for %i1 = %c0 to %count step %c1 {
    %t2 = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    pto.set_validshape %t1, %c1, %c8 : !tile
    }
    pto.set_validshape %t0, %c1, %c8 : !tile
    }
    %a = "pto.tgetval"(%t0, %c0) {test.shape = array<i64: -1, -1>} : (!tile, index) -> f32
    return
  }
  func.func @nested_4(%count: index) attributes {test.max_descriptor_visits = 1000 : i64} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %addr = arith.constant 0 : i64
    %t0 = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    scf.for %i0 = %c0 to %count step %c1 {
