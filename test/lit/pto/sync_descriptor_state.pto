    scf.for %i1 = %c0 to %count step %c1 {
    %t2 = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    scf.for %i2 = %c0 to %count step %c1 {
    %t3 = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    scf.for %i3 = %c0 to %count step %c1 {
    %t4 = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    pto.set_validshape %t3, %c1, %c8 : !tile
    }
    pto.set_validshape %t2, %c1, %c8 : !tile
    }
