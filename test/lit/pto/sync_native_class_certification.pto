// RUN: pto-sync-input-test --certify-regions %s | FileCheck %s
// CHECK: native-certification: retained-demands unresolved-class
// CHECK: certification-json {{.*}}"function":"native_counted"
// CHECK-SAME: "class":"{{[a-z-]+}}","exact_demands":true,"node":0
// CHECK-SAME: "status":"recognized"
// CHECK: source-unchanged; synchronization-insertion-not-run
!tile = !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module {
  func.func @native_while(%keep: i1) attributes {test.native_only} {
    %addr = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %value = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %addr : !tile
    scf.while : () -> () {
      scf.condition(%keep)
    } do {
      pto.tsetval ins(%zero, %value : index, f32) outs(%tile : !tile)
      scf.yield
    }
    return
  }
  func.func @native_counted(%n: index) {
    %addr = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %value = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %addr : !tile
    scf.for %i = %zero to %n step %one {
      pto.tsetval ins(%zero, %value : index, f32) outs(%tile : !tile)
    }
    return
  }
}
