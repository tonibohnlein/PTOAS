// RUN: pto-test-opt %s '-pto-canonical-sync=event-id-num-max=8' \
// RUN:   | FileCheck %s
// RUN: pto-test-opt %s \
// RUN:   '-pto-print-canonical-sync-plan=format=text view=covering' \
// RUN:   > %t.covering-first
// RUN: pto-test-opt %s \
// RUN:   '-pto-print-canonical-sync-plan=format=text view=covering' \
// RUN:   > %t.covering-second
// RUN: diff %t.covering-first %t.covering-second
// RUN: FileCheck %s --check-prefix=COVERING < %t.covering-first

module attributes {pto.target_arch = "a2a3"} {
  func.func @if_branch_anchors(
      %src: !pto.partition_tensor_view<16x16xf32>, %condition: i1) {
    %addr0 = arith.constant 0 : i64
    %addr4096 = arith.constant 4096 : i64
    %one = arith.constant 1.000000e+00 : f32
    %then_value = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    %else_value = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    %common = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    %input = pto.alloc_tile addr = %addr4096 : !pto.tile_buf<vec, 16x16xf32>
    scf.if %condition {
      pto.tload ins(%src : !pto.partition_tensor_view<16x16xf32>)
                outs(%then_value : !pto.tile_buf<vec, 16x16xf32>)
    } else {
      pto.tmuls ins(%input, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
                 outs(%else_value : !pto.tile_buf<vec, 16x16xf32>)
    }
    pto.tstore ins(%common : !pto.tile_buf<vec, 16x16xf32>)
               outs(%src : !pto.partition_tensor_view<16x16xf32>)
    return
  }

  func.func @while_before_after_handshake(
      %src: !pto.partition_tensor_view<16x16xf32>, %limit: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %addr0 = arith.constant 0 : i64
    %one = arith.constant 1.000000e+00 : f32
    %shared = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    %final = scf.while (%i = %c0) : (index) -> index {
      %go = arith.cmpi slt, %i, %limit : index
      pto.tload ins(%src : !pto.partition_tensor_view<16x16xf32>)
                outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
      scf.condition(%go) %i : index
    } do {
    ^bb0(%i: index):
      pto.tmuls ins(%shared, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
                 outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
      %next = arith.addi %i, %c1 : index
      scf.yield %next : index
    }
    return
  }

  func.func @for_zero_trip_recurrence(
      %src: !pto.partition_tensor_view<16x16xf32>, %limit: index) {
    %c1 = arith.constant 1 : index
    %addr0 = arith.constant 0 : i64
    %one = arith.constant 1.000000e+00 : f32
    %shared = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    scf.for %i = %c1 to %limit step %c1 {
      pto.tload ins(%src : !pto.partition_tensor_view<16x16xf32>)
                outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
      pto.tmuls ins(%shared, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
                 outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
    }
    return
  }

  func.func @section_scope(
      %src: !pto.partition_tensor_view<16x16xf32>) {
    %addr0 = arith.constant 0 : i64
    %one = arith.constant 1.000000e+00 : f32
    %shared = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    pto.section.vector {
      pto.tload ins(%src : !pto.partition_tensor_view<16x16xf32>)
                outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
      pto.tmuls ins(%shared, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
                 outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
    }
    return
  }
}

// CHECK-LABEL: func.func @if_branch_anchors
// CHECK: scf.if
// CHECK: pto.tload
// CHECK: } else {
// CHECK: pto.tmuls
// CHECK: }
// CHECK-NEXT: pto.set_flag[<PIPE_V>, <PIPE_MTE3>,
// CHECK-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_MTE3>,
// CHECK: pto.wait_flag[<PIPE_MTE2>, <PIPE_MTE3>,
// CHECK: pto.wait_flag[<PIPE_V>, <PIPE_MTE3>,
// CHECK-NEXT: pto.tstore

// CHECK-LABEL: func.func @while_before_after_handshake
// CHECK: pto.set_flag[<PIPE_V>, <PIPE_MTE2>,
// CHECK-NEXT: scf.while
// CHECK: pto.wait_flag[<PIPE_V>, <PIPE_MTE2>,
// CHECK: pto.tload
// CHECK-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_V>,
// CHECK: scf.condition
// CHECK: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>,
// CHECK-NEXT: pto.tmuls
// CHECK: pto.set_flag[<PIPE_V>, <PIPE_MTE2>,
// CHECK-NEXT: scf.yield
// CHECK: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>,

// CHECK-LABEL: func.func @for_zero_trip_recurrence
// CHECK: pto.set_flag[<PIPE_V>, <PIPE_MTE2>,
// CHECK: scf.for
// CHECK: pto.wait_flag[<PIPE_V>, <PIPE_MTE2>,
// CHECK: pto.tload
// CHECK: pto.set_flag[<PIPE_MTE2>, <PIPE_V>,
// CHECK: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>,
// CHECK-NEXT: pto.tmuls
// CHECK: pto.set_flag[<PIPE_V>, <PIPE_MTE2>,
// CHECK: }
// CHECK: pto.wait_flag[<PIPE_V>, <PIPE_MTE2>,

// COVERING-LABEL: PTOCanonicalSyncPlan @if_branch_anchors
// COVERING: covering status=graph-ready scopes=4 controls=1 nodes=3
// COVERING-SAME: fixed-edges=2 recurrence-carries=0
// COVERING-SAME: conservative-demands=3 active-demands=3 intrinsic-demands=0
// COVERING: covering-selection status=ready error=none
// COVERING: covering-control[0] alternatives=2 scope=1
// COVERING: covering-node[0] resource=PIPE_MTE2 scope=2 order=1 guard=[0:0]
// COVERING: covering-node[1] resource=PIPE_V scope=3 order=4 guard=[0:1]
// COVERING: covering-edge[0] 0 -> 2 kind=non-completion-preserving-issue-order
// COVERING-SAME: scope=0 distance=0 origin=fixed source-guard=[0:0] target-guard=[]
// COVERING: covering-edge[1] 1 -> 2 kind=non-completion-preserving-issue-order
// COVERING-SAME: scope=0 distance=0 origin=fixed source-guard=[0:1] target-guard=[]
// COVERING: covering-demand[0] 0 -> 2 kind=memory-war scope=0 distance=0 active=yes source-guard=[0:0] target-guard=[]

// COVERING-LABEL: PTOCanonicalSyncPlan @while_before_after_handshake
// COVERING: covering-scope[1] parent=0 must-execute=no loop=yes
// COVERING: covering-scope[2] parent=1 must-execute=yes loop=no
// COVERING: covering-scope[3] parent=1 must-execute=no loop=no
// COVERING: covering-edge[0] 0 -> 0 kind=completion-preserving-issue-order scope=1 distance=1 origin=recurrence-carry
// COVERING: covering-demand[5] 1 -> 0 kind=memory-war scope=1 distance=1 active=yes

// COVERING-LABEL: PTOCanonicalSyncPlan @for_zero_trip_recurrence
// COVERING: covering-scope[1] parent=0 must-execute=no loop=yes
// COVERING: covering-scope[2] parent=1 must-execute=yes loop=no
// COVERING: covering-edge[1] 1 -> 1 kind=completion-preserving-issue-order scope=1 distance=1 origin=recurrence-carry
// COVERING: covering-demand[7] 1 -> 1 kind=memory-raw scope=1 distance=1 active=yes

// COVERING-LABEL: PTOCanonicalSyncPlan @section_scope
// COVERING: covering status=graph-ready scopes=3 controls=0 nodes=2
// COVERING: covering-selection status=ready error=none
// COVERING: covering-scope[1] parent=0 must-execute=yes loop=no
// COVERING: covering-scope[2] parent=1 must-execute=yes loop=no
// COVERING: covering-node[0] resource=PIPE_MTE2 scope=2
// COVERING: covering-node[1] resource=PIPE_V scope=2
