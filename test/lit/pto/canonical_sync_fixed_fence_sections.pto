// A physical section overrides the enclosing function kind for both Canonical
// Sync fence modeling and EmitC lowering.
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-analysis-only --emit-pto-ir %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s
// RUN: ptoas --pto-arch=a3 --pto-level=level3 %s -o - 2>&1 \
// RUN:   | FileCheck %s --check-prefix=EMITC

module attributes {pto.target_arch = "a2a3"} {
  func.func @vector_section_in_cube_function()
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    pto.section.vector {
      pto.fence.barrier_all #pto.fence_scope<gm>
    }
    return
  }

  func.func @cube_section_in_vector_function()
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    pto.section.cube {
      pto.fence.barrier_all #pto.fence_scope<gm>
    }
    return
  }
}

// CHECK-LABEL: CANONICAL-SYNC function=vector_section_in_cube_function
// CHECK: FENCE-EFFECTS 1
// CHECK: drains=[AIV:PIPE_S, AIV:PIPE_V, AIV:PIPE_MTE2, AIV:PIPE_MTE3]
// CHECK-LABEL: CANONICAL-SYNC function=cube_section_in_vector_function
// CHECK: FENCE-EFFECTS 1
// CHECK: drains=[AIC:PIPE_MTE2, AIC:PIPE_MTE3, AIC:PIPE_FIX]

// EMITC-LABEL: AICORE void vector_section_in_cube_function()
// EMITC: #if defined(__DAV_VEC__)
// EMITC: pipe_barrier(PIPE_ALL);
// EMITC-NEXT: dsb(DSB_DDR);
// EMITC-NOT: pipe_barrier(PIPE_FIX);
// EMITC-LABEL: AICORE void cube_section_in_vector_function()
// EMITC: #if defined(__DAV_CUBE__)
// EMITC-NOT: pipe_barrier(PIPE_ALL);
// EMITC: pipe_barrier(PIPE_MTE2);
// EMITC-NEXT: pipe_barrier(PIPE_MTE3);
// EMITC-NEXT: pipe_barrier(PIPE_FIX);
// EMITC-NEXT: dsb(DSB_DDR);
// EMITC-NOT: pipe_barrier(PIPE_ALL);
