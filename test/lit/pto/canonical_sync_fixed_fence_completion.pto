// An existing vector-kernel GM fence drains MTE2 before publishing completion.
// It is fixed baseline supply, so the MTE2-to-V RAW demand is absent from the
// selectable set-cover universe even though its diagnostic direct event remains
// in the candidate catalog.
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-analysis-only --emit-pto-ir %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-dump --emit-pto-ir \
// RUN:   --mlir-print-ir-after=pto-canonical-sync %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=MATERIALIZE

module attributes {pto.target_arch = "a2a3"} {
  func.func @fixed_fence_completes_vector_pipe(
      %src: !pto.partition_tensor_view<16x128xf32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %input_addr = arith.constant 0 : i64
    %output_addr = arith.constant 8192 : i64
    %one = arith.constant 1.000000e+00 : f32
    %input = pto.alloc_tile addr = %input_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %output = pto.alloc_tile addr = %output_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    pto.tload ins(%src : !pto.partition_tensor_view<16x128xf32>)
              outs(%input : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                     cols=128, v_row=16, v_col=128, blayout=row_major,
                     slayout=none_box, fractal=512, pad=0>)
    pto.fence.barrier_all #pto.fence_scope<gm>
    pto.tmuls ins(%input, %one : !pto.tile_buf<loc=vec, dtype=f32,
                    rows=16, cols=128, v_row=16, v_col=128,
                    blayout=row_major, slayout=none_box, fractal=512, pad=0>,
                    f32)
              outs(%output : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                     cols=128, v_row=16, v_col=128, blayout=row_major,
                     slayout=none_box, fractal=512, pad=0>)
    return
  }
}

// CHECK-LABEL: CANONICAL-SYNC function=fixed_fence_completes_vector_pipe
// CHECK: FENCE-EFFECTS 1
// CHECK: f0 scope=gm
// CHECK-SAME: drains=[{{.*}}AIV:PIPE_V{{.*}}AIV:PIPE_MTE2{{.*}}]
// CHECK: kind=RAW
// CHECK: kind=fixed-fence fence=f0
// CHECK: kind=event resource=AIV:PIPE_MTE2->AIV:PIPE_V
// CHECK: world=baseline
// CHECK-SAME: oracle=match
// CHECK: SET-COVER optimization=singleton
// CHECK-SAME: universe=[]
// CHECK: PLAN selected=[m0, m2] events=[]

// MATERIALIZE: PLAN selected=[m0, m2] events=[]
// MATERIALIZE-NOT: pto.set_flag
// MATERIALIZE-NOT: pto.wait_flag
// MATERIALIZE: VERIFY ok
// MATERIALIZE-NOT: pto.set_flag
// MATERIALIZE-NOT: pto.wait_flag
// MATERIALIZE-LABEL: func.func @fixed_fence_completes_vector_pipe
// MATERIALIZE-NOT: pto.set_flag
// MATERIALIZE-NOT: pto.wait_flag
// MATERIALIZE: pto.fence.barrier_all
// MATERIALIZE-NOT: pto.set_flag
// MATERIALIZE-NOT: pto.wait_flag
// MATERIALIZE: return
