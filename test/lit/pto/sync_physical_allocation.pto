// RUN: %python %S/Inputs/check_physical_allocation.py pto-sync-input-test pto-test-opt %s
// Two independent slots require two IDs in each direction, using the same two
// numbers in both directions. The IDs need not
// form a contiguous range; runtime bounds use a nonzero lower and nonunit step.
!tile = !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major>
!left = !pto.tile_buf<left, 16x16xf16, slayout=row_major>
module attributes {pto.target_arch = "a3"} {
  func.func @two_slots(%a: !pto.ptr<f16, gm>, %n: index)
      attributes {test.trace_arguments = array<i64: 8>, test.eligible_ids = array<i64: 1, 3>} {
    %base = arith.constant 0 : i64
    %offset = arith.constant 512 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %sixteen = arith.constant 16 : index
    %view = pto.make_tensor_view %a, shape = [%sixteen, %sixteen], strides = [%sixteen, %one]
      {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf16>
    %part = pto.partition_view %view, offsets = [%zero, %zero], sizes = [%sixteen, %sixteen]
      : !pto.tensor_view<?x?xf16>
    %tile0 = pto.alloc_tile addr = %base : !tile
    %tile1 = pto.alloc_tile addr = %offset : !tile
    %left0 = pto.alloc_tile addr = %base : !left
    %left1 = pto.alloc_tile addr = %offset : !left
    scf.for %t = %one to %n step %two {
      pto.tload ins(%part : !pto.partition_tensor_view<16x16xf16>) outs(%tile0 : !tile)
      pto.tload ins(%part : !pto.partition_tensor_view<16x16xf16>) outs(%tile1 : !tile)
      pto.textract ins(%tile0, %zero, %zero : !tile, index, index) outs(%left0 : !left)
      pto.textract ins(%tile1, %zero, %zero : !tile, index, index) outs(%left1 : !left)
    }
    return
  }
}
