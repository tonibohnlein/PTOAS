// RUN: not pto-test-opt %s '-pto-print-kernel-schedule-graph=format=text' 2>&1 | FileCheck %s

module {
  func.func @unstructured_cfg(%src: !pto.ptr<i32>) {
    cf.br ^next
  ^next:
    %c0 = arith.constant 0 : index
    %value = pto.load_scalar %src[%c0] : !pto.ptr<i32> -> i32
    return
  }
}

// CHECK: error: kernel schedule graph does not yet support unstructured control flow
