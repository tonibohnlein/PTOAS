// RUN: pto-sync-input-test --certify-regions %s | FileCheck %s
// RUN: %python %S/Inputs/check_phase_minmax.py pto-sync-input-test %s
// CHECK: phase-minmax: signed-extrema cached narrow-layout-refused
module {
  func.func @extrema() attributes {test.phase_minmax} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %four = arith.constant 4 : index
    scf.for %i = %zero to %four step %one {
      %shifted = arith.subi %i, %one : index
      %min = arith.minsi %shifted, %zero : index
      %max = arith.maxsi %shifted, %zero : index
    }
    return
  }
}
