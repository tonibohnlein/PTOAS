// RUN: pto-test-opt --pto-insert-sync %s | FileCheck %s --check-prefix=PRESERVE
// RUN: not pto-test-opt --pto-frontier-analysis %s 2>&1 | FileCheck %s --check-prefix=ANALYZE
// Derived from the corpus SyncAll sample. Cross-core sync must not trigger
// the manual on-core skip. Until its analysis adapter exists, it must report
// the unsupported obligation rather than silently pass the function through.
module {
  func.func @cross_core(%ptr: !pto.ptr<i32, gm>) {
    pto.syncall(%ptr : !pto.ptr<i32, gm>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<aiv_only>
    return
  }
}
// PRESERVE: pto.syncall
// ANALYZE: error: explicit route requires resolved control and shared modeled effects
