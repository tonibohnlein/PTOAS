// RUN: not ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --protocol-sync-ready-release --protocol-sync-fallback=fail \
// RUN:   --protocol-sync-dump=plan --protocol-sync-statistics %s \
// RUN:   -o /dev/null 2> %t.diagnostics
// RUN: FileCheck %s --input-file=%t.diagnostics --check-prefix=PLAN
// RUN: not ptoas --pto-level=level2 --emit-pto-ir \
// RUN:   --protocol-sync-ready-release %s -o /dev/null 2>&1 | \
// RUN:   FileCheck %s --check-prefix=IMPLICIT
// RUN: not ptoas --pto-arch=a2 --pto-level=level2 --emit-pto-ir \
// RUN:   --protocol-sync-ready-release --protocol-sync-fallback=fail \
// RUN:   --protocol-sync-dump=plan %s -o /dev/null 2>&1 | \
// RUN:   FileCheck %s --check-prefix=A2
// RUN: not ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --enable-insert-sync --protocol-sync-ready-release %s -o /dev/null 2>&1 | \
// RUN:   FileCheck %s --check-prefix=MUTEX

module {
  func.func @ready_release_one(
      %input : !pto.partition_tensor_view<16x16xf16>,
      %output : !pto.partition_tensor_view<16x16xf16>,
      %trip_count : index)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    scf.for %index = %c0 to %trip_count step %c1 {
      pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>)
                outs(%tile : !pto.tile_buf<vec, 16x16xf16>)
      pto.tstore ins(%tile : !pto.tile_buf<vec, 16x16xf16>)
                 outs(%output : !pto.partition_tensor_view<16x16xf16>)
    }
    return
  }
}

// PLAN: PROTOCOL-SYNC ready-release-plan function=@ready_release_one status=unsupported
// PLAN: reason=unsupported-visibility
// PLAN: ProtocolSync ready-release mode found no complete supported plan

// IMPLICIT: --protocol-sync-ready-release requires an explicit --pto-arch=a3
// A2: PROTOCOL-SYNC ready-release-plan function=@ready_release_one status=unsupported
// A2: reason=unsupported-target
// A2-SAME: ReadyRelease emission is qualified only for the explicit ProtocolSync A3 target
// MUTEX: --enable-insert-sync
// MUTEX: --protocol-sync-ready-release
// MUTEX-SAME: mutually exclusive
