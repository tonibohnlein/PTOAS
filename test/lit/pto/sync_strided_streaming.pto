// RUN: %python %S/Inputs/check_strided_streaming.py pto-sync-input-test %s
!tile = !pto.tile_buf<loc=vec, dtype=f32, rows=2, cols=16, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module {
  func.func @strided_streaming(%gm: !pto.ptr<f32, gm>) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %n = arith.constant 4 : index
    %sixteen = arith.constant 16 : index
    %rowstride = arith.constant 64 : index
    %cols = arith.constant 128 : index
    %base = arith.constant 1024 : i64
    %value = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %base : !tile
    %output = pto.make_tensor_view %gm, shape = [%two, %cols], strides = [%rowstride, %one] : !pto.tensor_view<2x128xf32>
    scf.for %i = %zero to %n step %one {
      pto.texpands ins(%value : f32) outs(%tile : !tile)
      %column = arith.muli %i, %sixteen : index
      %destination = pto.partition_view %output, offsets = [%zero, %column], sizes = [%two, %sixteen] : !pto.tensor_view<2x128xf32> -> !pto.partition_tensor_view<2x16xf32>
      pto.tstore ins(%tile : !tile) outs(%destination : !pto.partition_tensor_view<2x16xf32>)
    }
    return
  }
}
