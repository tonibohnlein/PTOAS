// Native lifecycle-synthesis regression exercised by repository lit.
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-gm-alias=assume-disjoint-arguments --insert-sync-lifecycle-synthesis --emit-pto-ir %s -o %t.on.pto
// RUN: FileCheck %s --check-prefix=ON < %t.on.pto
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-gm-alias=assume-disjoint-arguments --emit-pto-ir %s -o %t.off.pto
// RUN: FileCheck %s --check-prefix=OFF < %t.off.pto
// RUN: ptoas --pto-arch=a2 --pto-level=level3 --enable-insert-sync --insert-sync-gm-alias=assume-disjoint-arguments --insert-sync-lifecycle-synthesis --insert-sync-defer-same-pipe %s -o %t.cpp
// OFF-NOT: lifecycle-plus-residuals
// ON-LABEL: func.func @operand_bundles
// ON-SAME: lifecycle-plus-residuals
// ON-NOT: pto.set_flag
// ON: pto.section.cube
// ON: pto.set_flag
// ON: scf.for
// ON: pto.textract
// ON-NOT: pto.barrier <PIPE_MTE1>
// ON: pto.tmatmul ins
// ON-NOT: pto.barrier <PIPE_MTE1>
// ON: pto.tmatmul.acc
// ON-NOT: pto.barrier <PIPE_MTE1>
// ON: pto.tstore
module attributes {pto.target_arch = "a3"} {
  func.func @operand_bundles(%ga: !pto.ptr<f16>, %gb: !pto.ptr<f16>, %gc: !pto.ptr<f16>, %trips: index, %choose: i1)
      {
    pto.section.cube {
    %z = arith.constant 0 : index
    %one = arith.constant 1 : index
    %m = arith.constant 128 : index
    %n = arith.constant 256 : index
    %k = arith.constant 64 : index
    %addr0 = arith.constant 0 : i64
    %addrB = arith.constant 131072 : i64
    %av = pto.make_tensor_view %ga, shape = [%m, %k], strides = [%k, %one] : !pto.tensor_view<?x?xf16>
    %bv = pto.make_tensor_view %gb, shape = [%k, %n], strides = [%one, %k] {layout = #pto.layout<dn>} : !pto.tensor_view<?x?xf16>
    %cv = pto.make_tensor_view %gc, shape = [%m, %n], strides = [%n, %one] : !pto.tensor_view<?x?xf16>
    %ap = pto.partition_view %av, offsets = [%z, %z], sizes = [%m, %k] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<128x64xf16>
    %bp = pto.partition_view %bv, offsets = [%z, %z], sizes = [%k, %n] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<64x256xf16>
    %cp = pto.partition_view %cv, offsets = [%z, %z], sizes = [%m, %n] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<128x256xf16>
    %ma = pto.alloc_tile addr = %addr0 : !pto.tile_buf<loc=mat, dtype=f16, rows=128, cols=64, v_row=128, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %mb = pto.alloc_tile addr = %addrB : !pto.tile_buf<loc=mat, dtype=f16, rows=64, cols=256, v_row=64, v_col=256, blayout=row_major, slayout=col_major, fractal=512, pad=0>
    %a = pto.alloc_tile addr = %addr0 : !pto.tile_buf<loc=left, dtype=f16, rows=128, cols=64, v_row=128, v_col=64, blayout=row_major, slayout=row_major, fractal=512, pad=0>
    %b = pto.alloc_tile addr = %addr0 : !pto.tile_buf<loc=right, dtype=f16, rows=64, cols=256, v_row=64, v_col=256, blayout=row_major, slayout=col_major, fractal=512, pad=0>
    %c = pto.alloc_tile addr = %addr0 : !pto.tile_buf<loc=acc, dtype=f32, rows=128, cols=256, v_row=128, v_col=256, blayout=col_major, slayout=row_major, fractal=1024, pad=0>
    %extra = arith.constant 32768 : i64
    %a1 = pto.alloc_tile addr = %extra : !pto.tile_buf<loc=left, dtype=f16, rows=128, cols=64, v_row=128, v_col=64, blayout=row_major, slayout=row_major, fractal=512, pad=0>
    %b1 = pto.alloc_tile addr = %extra : !pto.tile_buf<loc=right, dtype=f16, rows=64, cols=256, v_row=64, v_col=256, blayout=row_major, slayout=col_major, fractal=512, pad=0>
    scf.for %i = %z to %trips step %one {
      pto.tload ins(%ap : !pto.partition_tensor_view<128x64xf16>) outs(%ma : !pto.tile_buf<loc=mat, dtype=f16, rows=128, cols=64, v_row=128, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
      pto.tload ins(%bp : !pto.partition_tensor_view<64x256xf16>) outs(%mb : !pto.tile_buf<loc=mat, dtype=f16, rows=64, cols=256, v_row=64, v_col=256, blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      pto.textract ins(%ma, %z, %z : !pto.tile_buf<loc=mat, dtype=f16, rows=128, cols=64, v_row=128, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>, index, index) outs(%a : !pto.tile_buf<loc=left, dtype=f16, rows=128, cols=64, v_row=128, v_col=64, blayout=row_major, slayout=row_major, fractal=512, pad=0>)
      pto.textract ins(%mb, %z, %z : !pto.tile_buf<loc=mat, dtype=f16, rows=64, cols=256, v_row=64, v_col=256, blayout=row_major, slayout=col_major, fractal=512, pad=0>, index, index) outs(%b : !pto.tile_buf<loc=right, dtype=f16, rows=64, cols=256, v_row=64, v_col=256, blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      pto.tmatmul ins(%a, %b : !pto.tile_buf<loc=left, dtype=f16, rows=128, cols=64, v_row=128, v_col=64, blayout=row_major, slayout=row_major, fractal=512, pad=0>, !pto.tile_buf<loc=right, dtype=f16, rows=64, cols=256, v_row=64, v_col=256, blayout=row_major, slayout=col_major, fractal=512, pad=0>) outs(%c : !pto.tile_buf<loc=acc, dtype=f32, rows=128, cols=256, v_row=128, v_col=256, blayout=col_major, slayout=row_major, fractal=1024, pad=0>)
      pto.textract ins(%ma, %z, %z : !pto.tile_buf<loc=mat, dtype=f16, rows=128, cols=64, v_row=128, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>, index, index) outs(%a1 : !pto.tile_buf<loc=left, dtype=f16, rows=128, cols=64, v_row=128, v_col=64, blayout=row_major, slayout=row_major, fractal=512, pad=0>)
      pto.textract ins(%mb, %z, %z : !pto.tile_buf<loc=mat, dtype=f16, rows=64, cols=256, v_row=64, v_col=256, blayout=row_major, slayout=col_major, fractal=512, pad=0>, index, index) outs(%b1 : !pto.tile_buf<loc=right, dtype=f16, rows=64, cols=256, v_row=64, v_col=256, blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      pto.tmatmul.acc ins(%c, %a1, %b1 : !pto.tile_buf<loc=acc, dtype=f32, rows=128, cols=256, v_row=128, v_col=256, blayout=col_major, slayout=row_major, fractal=1024, pad=0>, !pto.tile_buf<loc=left, dtype=f16, rows=128, cols=64, v_row=128, v_col=64, blayout=row_major, slayout=row_major, fractal=512, pad=0>, !pto.tile_buf<loc=right, dtype=f16, rows=64, cols=256, v_row=64, v_col=256, blayout=row_major, slayout=col_major, fractal=512, pad=0>) outs(%c : !pto.tile_buf<loc=acc, dtype=f32, rows=128, cols=256, v_row=128, v_col=256, blayout=col_major, slayout=row_major, fractal=1024, pad=0>)
      pto.tstore ins(%c : !pto.tile_buf<loc=acc, dtype=f32, rows=128, cols=256, v_row=128, v_col=256, blayout=col_major, slayout=row_major, fractal=1024, pad=0>) outs(%cp : !pto.partition_tensor_view<128x256xf16>)
    }
    }
    return
  }
}
