// RUN: pto-test-opt --pto-prune-completed-sync-barriers %s -o %t.pto 2> %t.log
// RUN: FileCheck %s < %t.pto
// RUN: FileCheck %s --check-prefix=STATS < %t.log
// STATS-DAG: 0 barriers removed; unchanged: structured, macro, or over-budget domain
// STATS-DAG: 0 barriers removed; unchanged: unmatched event at boundary
// STATS-DAG: 0 barriers removed; unchanged: signal domain or consumption-before-rearm unproved
// Every second barrier is initially eligible for deletion. A later failure
// must discard the proposal and preserve both barriers, plus all event sites.
// The unmatched/unsafe-rearm programs deliberately lie outside the supported
// event protocol; preserving them does not certify them as executable kernels.
module attributes {pto.target_arch = "a3"} {
  // CHECK-LABEL: func.func @later_unsupported_region(
  // CHECK: pto.barrier <PIPE_MTE2>
  // CHECK-NEXT: pto.barrier <PIPE_MTE2>
  // CHECK-NEXT: scf.if
  func.func @later_unsupported_region(%condition: i1)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    pto.barrier <PIPE_MTE2>
    pto.barrier <PIPE_MTE2>
    scf.if %condition {
    }
    return
  }

  // CHECK-LABEL: func.func @unmatched_event(
  // CHECK: pto.barrier <PIPE_MTE2>
  // CHECK-NEXT: pto.barrier <PIPE_MTE2>
  // CHECK-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
  // CHECK-NEXT: return
  func.func @unmatched_event()
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    pto.barrier <PIPE_MTE2>
    pto.barrier <PIPE_MTE2>
    pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
    return
  }

  // CHECK-LABEL: func.func @unsafe_rearm(
  // CHECK: pto.barrier <PIPE_MTE2>
  // CHECK-NEXT: pto.barrier <PIPE_MTE2>
  // CHECK-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
  // CHECK-NEXT: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
  // CHECK-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
  // CHECK-NEXT: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
  // CHECK-NEXT: return
  // A lexically prior wait on V supplies no V-to-MTE2 causal handoff before
  // MTE2 rearms that event. Matching set/wait counts alone are insufficient.
  func.func @unsafe_rearm()
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    pto.barrier <PIPE_MTE2>
    pto.barrier <PIPE_MTE2>
    pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
    pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
    pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
    pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
    return
  }
}
