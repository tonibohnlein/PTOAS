            pto.tmatmul.acc ins(%24, %21, %23 : !pto.tile_buf<acc, 128x256xf32, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 128x64xf16, slayout=row_major>, !pto.tile_buf<right, 64x256xf16, slayout=col_major>) outs(%24 : !pto.tile_buf<acc, 128x256xf32, blayout=col_major, slayout=row_major, fractal=1024>)
            pto.textract ins(%17, %c0, %c384 : !pto.tile_buf<mat, 128x512xf16, blayout=col_major, slayout=row_major>, index, index) outs(%20 : !pto.tile_buf<left, 128x64xf16, slayout=row_major>)
            pto.textract ins(%19, %c128, %c0 : !pto.tile_buf<mat, 256x256xf16, slayout=col_major>, index, index) outs(%22 : !pto.tile_buf<right, 64x256xf16, slayout=col_major>)
            pto.tmatmul.acc ins(%24, %20, %22 : !pto.tile_buf<acc, 128x256xf32, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 128x64xf16, slayout=row_major>, !pto.tile_buf<right, 64x256xf16, slayout=col_major>) outs(%24 : !pto.tile_buf<acc, 128x256xf32, blayout=col_major, slayout=row_major, fractal=1024>)
            pto.textract ins(%17, %c0, %c448 : !pto.tile_buf<mat, 128x512xf16, blayout=col_major, slayout=row_major>, index, index) outs(%21 : !pto.tile_buf<left, 128x64xf16, slayout=row_major>)
            pto.textract ins(%19, %c192, %c0 : !pto.tile_buf<mat, 256x256xf16, slayout=col_major>, index, index) outs(%23 : !pto.tile_buf<right, 64x256xf16, slayout=col_major>)
            pto.tmatmul.acc ins(%24, %21, %23 : !pto.tile_buf<acc, 128x256xf32, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 128x64xf16, slayout=row_major>, !pto.tile_buf<right, 64x256xf16, slayout=col_major>) outs(%24 : !pto.tile_buf<acc, 128x256xf32, blayout=col_major, slayout=row_major, fractal=1024>)
            %55 = arith.addi %arg7, %c1 : index
            %56 = arith.cmpi slt, %55, %12 : index
            scf.if %56 {
              %57 = arith.addi %48, %c512 : index
              %58 = pto.partition_view %13, offsets = [%44, %57], sizes = [%c128, %c512] : !pto.tensor_view<?x?xf16>
              pto.tload ins(%58 : !pto.partition_tensor_view<128x512xf16>) outs(%16 : !pto.tile_buf<mat, 128x512xf16, blayout=col_major, slayout=row_major>) {layout = #pto.layout<nd>, pto.inferred_layout = true}
            }
          }
        }
        %47 = pto.partition_view %15, offsets = [%44, %45], sizes = [%c128, %c256] : !pto.tensor_view<?x?xf16>
        pto.tstore ins(%24 : !pto.tile_buf<acc, 128x256xf32, blayout=col_major, slayout=row_major, fractal=1024>) outs(%47 : !pto.partition_tensor_view<128x256xf16>) {layout = #pto.layout<nd>, pto.inferred_layout = true}
      }
    }
    return
  }
}
