// RUN: ptoas --pto-arch=a3 --enable-canonical-sync --canonical-sync-dump \
// RUN:   --emit-pto-ir --mlir-print-ir-after=pto-canonical-sync %s \
// RUN:   -o /dev/null 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @scalar_publish_generated(
      %payload: !pto.ptr<ui32, gm>,
      %view: !pto.partition_tensor_view<1x32xui32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %value_i32 = arith.constant 7 : i32
    %value = builtin.unrealized_conversion_cast %value_i32 : i32 to ui32
    %tile = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=ui32, rows=1,
      cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box,
      fractal=512, pad=0>
    pto.store_scalar %value, %payload[%c0] : !pto.ptr<ui32, gm>, ui32
    pto.tload ins(%view : !pto.partition_tensor_view<1x32xui32>)
      outs(%tile : !pto.tile_buf<loc=vec, dtype=ui32, rows=1, cols=32,
        v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512,
        pad=0>)
    return
  }

  func.func @scalar_acquire_generated(
      %view: !pto.partition_tensor_view<1x32xui32>,
      %payload: !pto.ptr<ui32, gm>, %sink: !pto.ptr<ui32, gm>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %value_i32 = arith.constant 7 : i32
    %value = builtin.unrealized_conversion_cast %value_i32 : i32 to ui32
    %tile = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=ui32, rows=1,
      cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box,
      fractal=512, pad=0>
    pto.tci ins(%value : ui32)
      outs(%tile : !pto.tile_buf<loc=vec, dtype=ui32, rows=1, cols=32,
        v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512,
        pad=0>)
    pto.tstore ins(%tile : !pto.tile_buf<loc=vec, dtype=ui32, rows=1,
      cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box,
      fractal=512, pad=0>)
      outs(%view : !pto.partition_tensor_view<1x32xui32>)
    %loaded = pto.load_scalar %payload[%c0] : !pto.ptr<ui32, gm> -> ui32
    pto.store_scalar %loaded, %sink[%c0] : !pto.ptr<ui32, gm>, ui32
    return
  }
}

// CHECK-LABEL: CANONICAL-SYNC function=scalar_publish_generated
// CHECK: visibility=scalar-to-nonscalar:gm:clean-source
// CHECK: kind=visibility-fence
// CHECK: VERIFY ok
// CHECK-LABEL: func.func @scalar_publish_generated
// CHECK: pto.store_scalar
// CHECK-NEXT: pto.cmo.cacheinvalid all #pto.address_space<gm>
// CHECK-NEXT: pto.fence.barrier_all <gm>
// CHECK-NEXT: pto.tload

// CHECK-LABEL: CANONICAL-SYNC function=scalar_acquire_generated
// CHECK: visibility=nonscalar-to-scalar:gm:invalidate-target
// CHECK: kind=visibility-fence
// CHECK: VERIFY ok
// CHECK-LABEL: func.func @scalar_acquire_generated
// CHECK: pto.tstore
// CHECK-NEXT: pto.fence.barrier_all <gm>
// CHECK-NEXT: pto.cmo.cacheinvalid all #pto.address_space<gm>
// CHECK-NEXT: pto.load_scalar
