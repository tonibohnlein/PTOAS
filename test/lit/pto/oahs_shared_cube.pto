// RUN: pto-test-opt %s -pto-insert-sync > %t.default
// RUN: pto-test-opt %s '-pto-insert-sync=algorithm=existing' > %t.existing
// RUN: diff %t.default %t.existing
// RUN: pto-test-opt %s '-pto-insert-sync=algorithm=handoff' | FileCheck %s

!mat = !pto.tile_buf<loc=mat, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!left = !pto.tile_buf<loc=left, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=row_major, fractal=512, pad=0>
!right = !pto.tile_buf<loc=right, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=col_major, fractal=512, pad=0>
!acc = !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=1024, pad=0>
module attributes {pto.target_arch = "a3"} {
  func.func @ordinary_cube(%src: !pto.partition_tensor_view<32x32xf16>,
                           %dst: !pto.partition_tensor_view<32x32xf32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %z = arith.constant 0 : index
    %addr = arith.constant 0 : i64
    %a = pto.alloc_tile addr = %addr : !mat
    %l = pto.alloc_tile addr = %addr : !left
    %r = pto.alloc_tile addr = %addr : !right
    %c = pto.alloc_tile addr = %addr : !acc
    pto.tload ins(%src : !pto.partition_tensor_view<32x32xf16>) outs(%a : !mat)
    pto.textract ins(%a, %z, %z : !mat, index, index) outs(%l : !left)
    pto.textract ins(%a, %z, %z : !mat, index, index) outs(%r : !right)
    pto.tmatmul ins(%l, %r : !left, !right) outs(%c : !acc)
    pto.tmatmul.acc ins(%c, %l, %r : !acc, !left, !right) outs(%c : !acc)
    pto.tstore ins(%c : !acc) outs(%dst : !pto.partition_tensor_view<32x32xf32>)
    return
  }
}
// CHECK-LABEL: func.func @ordinary_cube
// CHECK: pto.tload
// CHECK: pto.set_flag[<PIPE_MTE2>, <PIPE_MTE1>,
// CHECK: pto.wait_flag[<PIPE_MTE2>, <PIPE_MTE1>,
// CHECK: pto.textract
// CHECK: pto.textract
// CHECK: pto.set_flag[<PIPE_MTE1>, <PIPE_M>,
// CHECK: pto.wait_flag[<PIPE_MTE1>, <PIPE_M>,
// CHECK: pto.tmatmul
// CHECK: pto.tmatmul.acc
// CHECK: pto.set_flag[<PIPE_M>, <PIPE_FIX>,
// CHECK: pto.wait_flag[<PIPE_M>, <PIPE_FIX>,
// CHECK: pto.tstore
// CHECK: pto.barrier <PIPE_ALL>
// CHECK-NEXT: return
