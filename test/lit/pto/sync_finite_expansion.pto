// RUN: pto-sync-input-test --certify-regions %s | FileCheck %s
// CHECK: finite-expansion-session: original-scope retained-demands cached-exports no-child-promotion
// RUN: %python %S/Inputs/check_finite_expansion.py pto-sync-input-test %s
// RUN: %python %S/Inputs/check_fixed_branches.py pto-sync-input-test %s
// RUN: %python %S/Inputs/check_finite_translation.py pto-sync-input-test %s
// RUN: %python %S/Inputs/check_finite_storage.py pto-sync-input-test %s
!mat = !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major>
!left = !pto.tile_buf<left, 16x16xf16, slayout=row_major>
!right = !pto.tile_buf<right, 16x16xf16, slayout=col_major>
!acc = !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>
!banks = !pto.multi_tile_buf<!pto.tile_buf<left, 16x16xf16, slayout=row_major>, count=2>
module attributes {pto.target_arch = "a3"} {
  func.func @finite(%outer: index) attributes {test.finite_expansion_session} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %three = arith.constant 3 : index
    %five = arith.constant 5 : index
    %mat = pto.alloc_tile addr = %base : !mat
    %banks = pto.alloc_multi_tile addr = %base : !banks
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    // BODY
    scf.for %i = %one to %five step %two {
      %slot = arith.remui %i, %two : index
      %left = pto.multi_tile_get %banks[%slot] : !banks -> !left
      pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
      %first = arith.cmpi eq, %outer, %i : index
      scf.if %first {
        pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
      } else {
        pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
      }
    } {frontier.test_expanded_region}
    // END_BODY
    return
  }
}
