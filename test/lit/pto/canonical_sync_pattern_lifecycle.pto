// RUN: pto-test-opt %s '-pto-canonical-sync=event-id-num-max=8' \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a3"} {
  // CHECK-LABEL: func.func @unit_slot_lifecycle
  // CHECK: pto.set_flag[<PIPE_V>, <PIPE_MTE2>,
  // CHECK-NEXT: scf.for
  // CHECK: pto.wait_flag[<PIPE_V>, <PIPE_MTE2>,
  // CHECK-NEXT: pto.tload
  // CHECK-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_V>,
  // CHECK-NEXT: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>,
  // CHECK-NEXT: pto.tmuls
  // CHECK-NEXT: pto.set_flag[<PIPE_V>, <PIPE_MTE2>,
  // CHECK: pto.wait_flag[<PIPE_V>, <PIPE_MTE2>,
  // CHECK-NEXT: pto.barrier <PIPE_ALL>
  // CHECK-NEXT: return
  func.func @unit_slot_lifecycle(
      %input: !pto.partition_tensor_view<16x16xf32>, %limit: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %addr0 = arith.constant 0 : i64
    %addr4096 = arith.constant 4096 : i64
    %one = arith.constant 1.000000e+00 : f32
    %shared = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    %result = pto.alloc_tile addr = %addr4096 : !pto.tile_buf<vec, 16x16xf32>

    scf.for %iteration = %c0 to %limit step %c1 {
      pto.tload ins(%input : !pto.partition_tensor_view<16x16xf32>)
        outs(%shared : !pto.tile_buf<vec, 16x16xf32>)
      pto.tmuls ins(%shared, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
        outs(%result : !pto.tile_buf<vec, 16x16xf32>)
    }
    return
  }
}
