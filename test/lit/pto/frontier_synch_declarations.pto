// RUN: pto-frontier-analysis-test %s | FileCheck %s
// CHECK: helper: phases=0 declaration-skipped
// CHECK: empty: phases=0 footprints=0 alias-pairs=0 alias-queries=0
// CHECK: original-ir-unchanged; construction-not-run
module {
  func.func private @helper()
  func.func @empty() {
    return
  }
}
