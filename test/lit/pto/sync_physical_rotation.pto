// RUN: %python %S/Inputs/check_physical_rotation.py pto-sync-input-test %s
!tile = !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module {
  func.func @physical_banks(%n: index) attributes {test.trace_arguments = array<i64: 5>} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %bytes = arith.constant 64 : index
    %base = arith.constant 1024 : index
    %value = arith.constant 1.0 : f32
    scf.for %i = %zero to %n step %one {
      %slot = arith.remui %i, %two : index
      %offset = arith.muli %slot, %bytes : index
      %address = arith.addi %base, %offset : index
      %addr = arith.index_cast %address : index to i64
      %writer = pto.alloc_tile addr = %addr : !tile
      pto.texpands ins(%value : f32) outs(%writer : !tile)
      %reader = pto.alloc_tile addr = %addr : !tile
      %v = pto.tgetval ins(%reader, %zero : !tile, index) outs : f32
    }
    return
  }
}
