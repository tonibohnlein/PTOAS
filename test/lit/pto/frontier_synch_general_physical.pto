// RUN: pto-frontier-analysis-test --symbolic-allocation-check %s
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch --emit-pto-ir --dump-frontier-demands --report-frontier-costs %s -o %t.ir 2> %t.report
// RUN: FileCheck %s --check-prefix=IR < %t.ir
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --insert-sync-algorithm=frontier-synch %s -o %t.cpp
// RUN: FileCheck %s --check-prefix=CPP < %t.cpp
// RUN: %python %S/Inputs/minimum_demand/check_general_physical.py %s %t.ir %t.report
!acc = !pto.tile_buf<vec, 32x32xf32, blayout=col_major, slayout=row_major, fractal=1024>
module attributes {pto.target_arch = "a3"} {
  func.func @general_physical(%f: !pto.ptr<f32>, %n: index, %c: i8) -> f32 attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %limit = arith.minsi %n, %c4 : index
    %offset = arith.index_cast %c : i8 to index
    %c32 = arith.constant 32 : index
    %addr = arith.constant 0 : i64
    %view = pto.make_tensor_view %f, shape = [%c32, %c32], strides = [%c32, %c1]
      : !pto.tensor_view<?x?xf32>
    %dst = pto.partition_view %view, offsets = [%c0, %c0], sizes = [%c32, %c32]
      : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<32x32xf32>
    %src = pto.alloc_tile addr = %addr : !acc
    %initial = arith.constant 0.0 : f32
    %last = scf.for %i = %c0 to %limit step %c1 iter_args(%previous = %initial) -> (f32) {
      pto.tstore ins(%src : !acc) outs(%dst : !pto.partition_tensor_view<32x32xf32>)
      %scaled = arith.muli %i, %c2 : index
      %row = arith.addi %scaled, %offset : index
      %current = scf.for %j = %c0 to %row step %c1 iter_args(%prior = %previous) -> (f32) {
        %value = pto.load %f[%c0] : !pto.ptr<f32> -> f32
        scf.yield %value : f32
      }
      scf.yield %current : f32
    }
    return %last : f32
  }
}
// IR: pto.frontier.physical_status = "certified-general-pools"
// IR: pto.tstore
// IR: pto.load
// IR: pto.barrier <PIPE_ALL>
// IR-NOT: sync.logical_
// CPP-DAG: __int128
// CPP-DAG: TSTORE(
// CPP-DAG: pipe_barrier(PIPE_ALL);
