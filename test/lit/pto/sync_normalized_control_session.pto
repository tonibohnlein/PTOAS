// RUN: pto-sync-input-test --certify-regions %s | FileCheck %s
// RUN: pto-sync-input-test --gm-alias=may-alias --certify-regions %s | FileCheck %s
// CHECK-COUNT-9: normalized-control-session: shared-input numerical-to-finite original-coordinates isolated-context
// CHECK: dynamic-uniform-crossings: non-unit-coordinates zero-trips extrema exact-required-closure
// CHECK: deferred-nonuniform-crossing: exact-adapter-required
// CHECK: deferred-writer-slices: disjoint-visits accepted overlapping-visits refused
// CHECK: uniform-relation-crossings: shared-alias-policy exact-crossing complete-reduction
// CHECK: fixed-coordinate-relations: distinct-visits scalar-mapping retained-identities no-reanalysis
// CHECK: exact-form-fast-path: explicit no-normalization no-arithmetic
// CHECK: source-unchanged; synchronization-insertion-not-run
!mat = !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major>
!left = !pto.tile_buf<left, 16x16xf16, slayout=row_major>
!right = !pto.tile_buf<right, 16x16xf16, slayout=col_major>
!acc = !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>
module attributes {pto.target_arch = "a3"} {
  func.func @non_unit() attributes {test.normalization_requests, test.normalization_coordinates = array<i64: 1, 3>} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %five = arith.constant 5 : index
    %seven = arith.constant 7 : index
    %nine = arith.constant 9 : index
    %mat = pto.alloc_tile addr = %base : !mat
    %left = pto.alloc_tile addr = %base : !left
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    scf.for %t = %zero to %two step %one {
      scf.for %i = %one to %five step %two {
        pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
        pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
      }
    }
    return
  }
  func.func @runtime_guard(%choice: i1) attributes {test.normalization_requests, test.normalization_coordinates = array<i64: 1, 3>, test.normalization_runtime_guard} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %five = arith.constant 5 : index
    %seven = arith.constant 7 : index
    %nine = arith.constant 9 : index
    %mat = pto.alloc_tile addr = %base : !mat
    %left = pto.alloc_tile addr = %base : !left
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    scf.for %t = %zero to %two step %one {
      scf.for %i = %one to %five step %two {
        scf.if %choice {
        pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
        pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
        }
      }
    }
    return
  }
  func.func @zero() attributes {test.normalization_requests, test.normalization_coordinates = array<i64>} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %five = arith.constant 5 : index
    %seven = arith.constant 7 : index
    %nine = arith.constant 9 : index
    %mat = pto.alloc_tile addr = %base : !mat
    %left = pto.alloc_tile addr = %base : !left
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    scf.for %t = %zero to %two step %one {
      scf.for %i = %zero to %zero step %one {
        pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
        pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
      }
    }
    return
  }
  func.func @one() attributes {test.normalization_requests, test.normalization_coordinates = array<i64: 7>} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %five = arith.constant 5 : index
    %seven = arith.constant 7 : index
    %nine = arith.constant 9 : index
    %mat = pto.alloc_tile addr = %base : !mat
    %left = pto.alloc_tile addr = %base : !left
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    scf.for %t = %zero to %two step %one {
      scf.for %i = %seven to %nine step %two {
        pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
        pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
      }
    }
    return
  }
  func.func @dead_oversized_arm() attributes {test.normalization_requests, test.normalization_coordinates = array<i64>, test.normalization_compact} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %five = arith.constant 5000 : index
    %false = arith.constant false
    %seven = arith.constant 7 : index
    %nine = arith.constant 9 : index
    %mat = pto.alloc_tile addr = %base : !mat
    %left = pto.alloc_tile addr = %base : !left
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    scf.for %t = %zero to %two step %one {
      scf.if %false {
      scf.for %i = %one to %five step %one {
        pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
        pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
      }
      }
    }
    return
  }
  func.func @dependent_nested() attributes {test.normalization_requests, test.normalization_coordinates = array<i64>, test.normalization_compact, test.normalization_deep} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %five = arith.constant 5 : index
    %seven = arith.constant 7 : index
    %nine = arith.constant 9 : index
    %mat = pto.alloc_tile addr = %base : !mat
    %left = pto.alloc_tile addr = %base : !left
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    scf.for %t = %zero to %two step %one {
      scf.for %i = %one to %two step %one {
        scf.for %j = %zero to %i step %one {
        pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
        pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
        }
      }
    }
    return
  }
  func.func @dependent_with_alternative() attributes {test.normalization_requests, test.normalization_coordinates = array<i64: 0>, test.normalization_deep} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %five = arith.constant 5 : index
    %seven = arith.constant 7 : index
    %nine = arith.constant 9 : index
    %mat = pto.alloc_tile addr = %base : !mat
    %left = pto.alloc_tile addr = %base : !left
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    scf.for %t = %zero to %two step %one {
      scf.for %i = %one to %two step %one {
        scf.for %j = %zero to %i step %one {
        pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
        pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
        }
      }
      scf.for %once = %zero to %one step %one {
        pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
        pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
      }
    }
    return
  }
  func.func @nested_failed_expansions() attributes {test.normalization_requests, test.normalization_coordinates = array<i64>, test.normalization_compact} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %five = arith.constant 5000 : index
    %false = arith.constant false
    %seven = arith.constant 7 : index
    %nine = arith.constant 9 : index
    %mat = pto.alloc_tile addr = %base : !mat
    %left = pto.alloc_tile addr = %base : !left
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    scf.for %t = %zero to %two step %one {
      scf.if %false {
      scf.for %i = %one to %five step %one {
        scf.for %j = %one to %five step %one {
          scf.for %k = %one to %five step %one {
            scf.for %l = %one to %five step %one {
        pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
        pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
            }
          }
        }
      }
      }
    }
    return
  }
  func.func @external_producer() attributes {test.normalization_requests, test.normalization_external, test.normalization_coordinates = array<i64: 7>} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %five = arith.constant 5 : index
    %seven = arith.constant 7 : index
    %nine = arith.constant 9 : index
    %mat = pto.alloc_tile addr = %base : !mat
    %left = pto.alloc_tile addr = %base : !left
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
    scf.for %t = %zero to %two step %one {
      scf.for %i = %seven to %nine step %two {
        pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
        pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
      }
    }
    return
  }
  func.func @dynamic_uniform_gm(%n: index, %m: index, %src: !pto.ptr<f32, gm>, %dst: !pto.ptr<f32, gm>)
      attributes {test.dynamic_uniform_crossings} {
    %base = arith.constant 0 : i64
    %other = arith.constant 128 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %three = arith.constant 3 : index
    %eight = arith.constant 8 : index
    %a = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 1x8xf32>
    %b = pto.alloc_tile addr = %other : !pto.tile_buf<vec, 1x8xf32>
    %source = pto.make_tensor_view %src, shape = [%one, %eight], strides = [%eight, %one]
      : !pto.tensor_view<1x8xf32>
    %target = pto.make_tensor_view %dst, shape = [%one, %eight], strides = [%eight, %one]
      : !pto.tensor_view<1x8xf32>
    %read = pto.partition_view %source, offsets = [%zero, %zero], sizes = [%one, %eight]
      : !pto.tensor_view<1x8xf32> -> !pto.partition_tensor_view<1x8xf32>
    %write = pto.partition_view %target, offsets = [%zero, %zero], sizes = [%one, %eight]
      : !pto.tensor_view<1x8xf32> -> !pto.partition_tensor_view<1x8xf32>
    scf.for %i = %one to %n step %two {
      pto.tload ins(%read : !pto.partition_tensor_view<1x8xf32>) outs(%a : !pto.tile_buf<vec, 1x8xf32>)
    }
    scf.for %j = %three to %m step %three {
      pto.tstore ins(%b : !pto.tile_buf<vec, 1x8xf32>) outs(%write : !pto.partition_tensor_view<1x8xf32>)
    }
    return
  }
  func.func @dynamic_nonuniform_deferred(%n: index, %m: index, %src: !pto.ptr<f32, gm>, %dst: !pto.ptr<f32, gm>)
      attributes {test.dynamic_uniform_crossings, test.nonuniform_deferred} {
    %base = arith.constant 0 : i64
    %other = arith.constant 128 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %three = arith.constant 3 : index
    %eight = arith.constant 8 : index
    %a = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 1x8xf32>
    %b = pto.alloc_tile addr = %other : !pto.tile_buf<vec, 1x8xf32>
    %source = pto.make_tensor_view %src, shape = [%one, %eight], strides = [%eight, %one]
      : !pto.tensor_view<1x8xf32>
    %target = pto.make_tensor_view %src, shape = [%one, %eight], strides = [%eight, %one]
      : !pto.tensor_view<1x8xf32>
    %read = pto.partition_view %source, offsets = [%zero, %zero], sizes = [%one, %eight]
      : !pto.tensor_view<1x8xf32> -> !pto.partition_tensor_view<1x8xf32>
    %write = pto.partition_view %target, offsets = [%zero, %zero], sizes = [%one, %eight]
      : !pto.tensor_view<1x8xf32> -> !pto.partition_tensor_view<1x8xf32>
    scf.for %i = %one to %n step %two {
      pto.tload ins(%read : !pto.partition_tensor_view<1x8xf32>) outs(%a : !pto.tile_buf<vec, 1x8xf32>)
    }
    scf.for %j = %three to %m step %three {
      pto.tstore ins(%b : !pto.tile_buf<vec, 1x8xf32>) outs(%write : !pto.partition_tensor_view<1x8xf32>)
    }
    return
  }
  func.func @disjoint_deferred_writer(%dst: !pto.ptr<f32, gm>)
      attributes {test.dynamic_uniform_crossings, test.disjoint_deferred} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %four = arith.constant 4 : index
    %eight = arith.constant 8 : index
    %tile = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 1x8xf32>
    %target = pto.make_tensor_view %dst, shape = [%four, %eight], strides = [%eight, %one]
      : !pto.tensor_view<4x8xf32>
    scf.for %i = %zero to %four step %one {
      %write = pto.partition_view %target, offsets = [%i, %zero], sizes = [%one, %eight]
        : !pto.tensor_view<4x8xf32> -> !pto.partition_tensor_view<1x8xf32>
      pto.tstore ins(%tile : !pto.tile_buf<vec, 1x8xf32>) outs(%write : !pto.partition_tensor_view<1x8xf32>)
    }
    return
  }
  func.func @uniform_gm_crossing(%src: !pto.ptr<f32, gm>, %dst: !pto.ptr<f32, gm>)
      attributes {test.uniform_relation_crossings} {
    %base = arith.constant 0 : i64
    %other = arith.constant 128 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %eight = arith.constant 8 : index
    %a = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 1x8xf32>
    %b = pto.alloc_tile addr = %other : !pto.tile_buf<vec, 1x8xf32>
    %source = pto.make_tensor_view %src, shape = [%one, %eight], strides = [%eight, %one]
      : !pto.tensor_view<1x8xf32>
    %target = pto.make_tensor_view %dst, shape = [%one, %eight], strides = [%eight, %one]
      : !pto.tensor_view<1x8xf32>
    %read = pto.partition_view %source, offsets = [%zero, %zero], sizes = [%one, %eight]
      : !pto.tensor_view<1x8xf32> -> !pto.partition_tensor_view<1x8xf32>
    %write = pto.partition_view %target, offsets = [%zero, %zero], sizes = [%one, %eight]
      : !pto.tensor_view<1x8xf32> -> !pto.partition_tensor_view<1x8xf32>
    pto.tload ins(%read : !pto.partition_tensor_view<1x8xf32>) outs(%a : !pto.tile_buf<vec, 1x8xf32>)
    pto.tload ins(%read : !pto.partition_tensor_view<1x8xf32>) outs(%b : !pto.tile_buf<vec, 1x8xf32>)
    pto.tstore ins(%a : !pto.tile_buf<vec, 1x8xf32>) outs(%write : !pto.partition_tensor_view<1x8xf32>)
    return
  }
  func.func @fixed_scalar_copies() attributes {test.fixed_coordinate_relations} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %tile = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 1x8xf32>
    scf.for %i = %zero to %two step %one {
      %value = pto.tgetval ins(%tile, %i : !pto.tile_buf<vec, 1x8xf32>, index) outs : f32
      pto.tsetval ins(%i, %value : index, f32) outs(%tile : !pto.tile_buf<vec, 1x8xf32>)
    }
    return
  }
  func.func @straightline() attributes {test.exact_form_explicit} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %five = arith.constant 5 : index
    %seven = arith.constant 7 : index
    %nine = arith.constant 9 : index
    %mat = pto.alloc_tile addr = %base : !mat
    %left = pto.alloc_tile addr = %base : !left
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
    pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
    return
  }
}
