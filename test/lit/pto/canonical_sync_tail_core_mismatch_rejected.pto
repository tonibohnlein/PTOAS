// An opposite-core physical section is drained inside that section. A
// function-core PIPE_ALL barrier would execute on the wrong core.
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-dump --emit-pto-ir \
// RUN:   --mlir-print-ir-after=pto-canonical-sync %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @vector_section_tail(
      %source: !pto.partition_tensor_view<32xf32>) {
    %address = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %address :
      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32,
                    blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.section.vector {
      pto.tload ins(%source : !pto.partition_tensor_view<32xf32>)
                outs(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1,
                       cols=32, v_row=1, v_col=32, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
    }
    return
  }
}

// CHECK-LABEL: CANONICAL-SYNC function=vector_section_tail
// CHECK: kind=tail resource=AIV:PIPE_ALL->AIV:PIPE_ALL
// CHECK-SAME: points=after(pto.tload)->after(pto.tload)
// CHECK: VERIFY ok
// CHECK-LABEL: func.func @vector_section_tail
// CHECK: pto.section.vector
// CHECK: pto.tload
// CHECK-NEXT: pto.barrier <PIPE_ALL>
