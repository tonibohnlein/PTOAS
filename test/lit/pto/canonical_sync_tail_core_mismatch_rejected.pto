// A function-level PIPE_ALL epilogue executes on the function core. It cannot
// discharge an exit-completion demand created by a phase in an opposite-core
// physical section until a multi-core exit protocol is modeled explicitly.
// RUN: not ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-analysis-only --emit-pto-ir %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @vector_phase_in_cube_function(
      %source: !pto.partition_tensor_view<32xf32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %address = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %address :
      !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32,
                    blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.section.vector {
      pto.tload ins(%source : !pto.partition_tensor_view<32xf32>)
                outs(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1,
                       cols=32, v_row=1, v_col=32, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
    }
    return
  }
}

// CHECK: error: canonical sync cannot use a function-core PIPE_ALL epilogue
// CHECK-SAME: to complete an opposite-core section phase
