// RUN: ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --protocol-sync-analysis-only --protocol-sync-dump=residuals \
// RUN:   %S/protocol_sync_one_shot.pto -o /dev/null 2> %t.analysis0
// RUN: ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --protocol-sync-analysis-only --protocol-sync-dump=residuals \
// RUN:   %S/protocol_sync_one_shot.pto -o /dev/null 2> %t.analysis1
// RUN: cmp %t.analysis0 %t.analysis1
// RUN: FileCheck %s --input-file=%t.analysis0 --check-prefix=EMPTY
// RUN: ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --protocol-sync-analysis-only --protocol-sync-dump=residuals \
// RUN:   --protocol-sync-statistics %S/protocol_sync_one_shot.pto \
// RUN:   -o /dev/null 2> %t.analysis-stats
// RUN: FileCheck %s --input-file=%t.analysis-stats --check-prefix=EMPTY-STATS
// RUN: ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --protocol-sync-one-shot --protocol-sync-fallback=fail \
// RUN:   --protocol-sync-dump=residuals --protocol-sync-statistics \
// RUN:   %S/protocol_sync_one_shot.pto -o /dev/null 2> %t.one-shot
// RUN: FileCheck %s --input-file=%t.one-shot --check-prefix=ONE-SHOT
// RUN: ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --protocol-sync-analysis-only --protocol-sync-dump=residuals \
// RUN:   %S/protocol_sync_channel_diagnostics.pto -o /dev/null 2> %t.residuals
// RUN: FileCheck %s --input-file=%t.residuals --check-prefix=RESIDUALS

// EMPTY: PROTOCOL-SYNC selected-world function=@linear_one_shot status=residual
// EMPTY-SAME: protocols=0 completions=0 visibility=0 exit-completions=0 obligations=7
// EMPTY: obligation #0 kind=completion source=#0 target=#1 generation=none channel=none
// EMPTY-SAME: local-requirement=#0 accesses=[#1, #2] atoms=[#0] precision=conservative
// EMPTY: obligation #3 kind=completion source=#0 target=#3 generation=none channel=none
// EMPTY: obligation #6 kind=exit-completion source=#3 target=#3
// EMPTY-STATS: "residual_obligations":7
// EMPTY-STATS: "residual_obligations_by_kind":{"completion":4,"exit-completion":3}

// ONE-SHOT: PROTOCOL-SYNC selected-world function=@linear_one_shot status=complete
// ONE-SHOT-SAME: protocols=3 completions=3 visibility=0 exit-completions=4 obligations=0
// ONE-SHOT: selected-protocol kind=one-shot-publish channel=#0 generation=#0 capacity=1
// ONE-SHOT: selected-completion source=#2 target=#3 control=must-execute iteration=same-iteration distance=0
// ONE-SHOT: "interpreter_peak_states":1
// ONE-SHOT-SAME: "interpreter_transitions":7
// ONE-SHOT: "residual_obligations_by_kind":{}
// ONE-SHOT: "interpretation":{{[0-9]+}}

// RESIDUALS: PROTOCOL-SYNC selected-world function=@depth_one_recurrence status=residual
// RESIDUALS: obligation #0 kind=completion source=#0 target=#1 generation=#0 channel=#0
// RESIDUALS-NEXT: obligation #1 kind=reclamation source=#1 target=#0 generation=#0 channel=#0
// RESIDUALS-SAME: iteration=loop-carried distance=1
// RESIDUALS: PROTOCOL-SYNC selected-world function=@sequential_generations status=residual
// RESIDUALS: kind=reclamation source=#1 target=#2 generation=none channel=none
// RESIDUALS-SAME: local-requirement=
// RESIDUALS: PROTOCOL-SYNC selected-world function=@partial_overlapping_writes status=residual
// This fixture uses subviews: keep its old protection until their provenance is recovered.
// RESIDUALS: obligation #0 kind=unknown-alias source=#0 target=#0 generation=#0 channel=none
// RESIDUALS: obligation #1 kind=unknown-alias source=#1 target=#1 generation=#1 channel=none
// RESIDUALS: PROTOCOL-SYNC selected-world function=@in_place_access status=residual
// RESIDUALS: obligation #0 kind=completion source=#0 target=#1 generation=none channel=none
// RESIDUALS-SAME: local-requirement=#0
