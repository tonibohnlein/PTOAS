// RUN: ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail --protocol-sync-dump=plan --protocol-sync-statistics %S/protocol_sync_one_shot.pto -o %t.pto 2> %t.log
// RUN: FileCheck %s --input-file=%t.log --check-prefix=GENERAL
// RUN: ptoas --pto-arch=a2 --pto-level=level2 --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail %S/protocol_sync_one_shot.pto -o %t.cpp
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir --protocol-sync-analysis-only --protocol-sync-dump=concrete-verification %t.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=CONCRETE
// RUN: not ptoas --protocol-sync-patterns=off %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=MODE
// RUN: not ptoas --pto-arch=a3 --protocol-sync-mixed --protocol-sync-patterns=invalid %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=VALUE

module {}

// GENERAL: PROTOCOL-SYNC mixed-plan function=@linear_one_shot status=ready world=direct-only
// GENERAL: "selected_one_shot_protocols":0
// GENERAL-SAME: "selected_ready_release_protocols":0
// CONCRETE: PROTOCOL-SYNC concrete-verification function=@linear_one_shot status=accepted
// MODE: --protocol-sync-patterns requires --protocol-sync-mixed
// VALUE: --protocol-sync-patterns must be 'on' or 'off'
