// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir \
// RUN:   --enable-insert-sync %s -o %t.default
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir \
// RUN:   --enable-insert-sync --protocol-sync-analysis-only \
// RUN:   --protocol-sync-dump=lane-frontiers --protocol-sync-statistics \
// RUN:   %s -o %t.analysis 2> %t.diagnostics
// RUN: diff %t.default %t.analysis
// RUN: FileCheck %s --input-file=%t.diagnostics
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir \
// RUN:   --enable-insert-sync --protocol-sync-analysis-only \
// RUN:   --protocol-sync-dump=storage-tracks --protocol-sync-statistics \
// RUN:   %s -o %t.storage 2> %t.storage-diagnostics
// RUN: FileCheck %s --input-file=%t.storage-diagnostics --check-prefix=STORAGE

// These reduced cases pin placements selected by the older CanonicalSync
// experiments. The MTE2 WAW case intentionally records a disagreement: the
// old hardware-graph test selected a barrier, while the current target query
// inherits InsertSync's TLoad-to-TLoad intrinsic-order exemption.

module attributes {pto.target_arch = "a2a3"} {
  func.func @reference_shared_event(
      %src0 : !pto.partition_tensor_view<16x16xf16>,
      %src1 : !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %addr0 = arith.constant 0 : i64
    %addr1 = arith.constant 512 : i64
    %addr2 = arith.constant 1024 : i64
    %addr3 = arith.constant 1536 : i64
    %input0 = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf16>
    %input1 = pto.alloc_tile addr = %addr1 : !pto.tile_buf<vec, 16x16xf16>
    %output0 = pto.alloc_tile addr = %addr2 : !pto.tile_buf<vec, 16x16xf16>
    %output1 = pto.alloc_tile addr = %addr3 : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%src0 : !pto.partition_tensor_view<16x16xf16>)
              outs(%input0 : !pto.tile_buf<vec, 16x16xf16>)
    pto.tload ins(%src1 : !pto.partition_tensor_view<16x16xf16>)
              outs(%input1 : !pto.tile_buf<vec, 16x16xf16>)
    pto.tabs ins(%input0 : !pto.tile_buf<vec, 16x16xf16>)
             outs(%output0 : !pto.tile_buf<vec, 16x16xf16>)
    pto.tabs ins(%input1 : !pto.tile_buf<vec, 16x16xf16>)
             outs(%output1 : !pto.tile_buf<vec, 16x16xf16>)
    return
  }

  func.func @reference_old_mte2_barrier(
      %src0 : !pto.partition_tensor_view<16x16xf16>,
      %src1 : !pto.partition_tensor_view<16x16xf16>,
      %src2 : !pto.partition_tensor_view<16x16xf16>,
      %src3 : !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %addr0 = arith.constant 0 : i64
    %addr1 = arith.constant 512 : i64
    %first = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf16>
    %second = pto.alloc_tile addr = %addr1 : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%src0 : !pto.partition_tensor_view<16x16xf16>)
              outs(%first : !pto.tile_buf<vec, 16x16xf16>)
    pto.tload ins(%src1 : !pto.partition_tensor_view<16x16xf16>)
              outs(%second : !pto.tile_buf<vec, 16x16xf16>)
    pto.tload ins(%src2 : !pto.partition_tensor_view<16x16xf16>)
              outs(%first : !pto.tile_buf<vec, 16x16xf16>)
    pto.tload ins(%src3 : !pto.partition_tensor_view<16x16xf16>)
              outs(%second : !pto.tile_buf<vec, 16x16xf16>)
    return
  }

  func.func @reference_vector_completion_cut(
      %src0 : !pto.partition_tensor_view<16x16xf16>,
      %src1 : !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %addr0 = arith.constant 0 : i64
    %addr1 = arith.constant 512 : i64
    %addr2 = arith.constant 1024 : i64
    %addr3 = arith.constant 1536 : i64
    %input0 = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf16>
    %input1 = pto.alloc_tile addr = %addr1 : !pto.tile_buf<vec, 16x16xf16>
    %first = pto.alloc_tile addr = %addr2 : !pto.tile_buf<vec, 16x16xf16>
    %second = pto.alloc_tile addr = %addr3 : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%src0 : !pto.partition_tensor_view<16x16xf16>)
              outs(%input0 : !pto.tile_buf<vec, 16x16xf16>)
    pto.tload ins(%src1 : !pto.partition_tensor_view<16x16xf16>)
              outs(%input1 : !pto.tile_buf<vec, 16x16xf16>)
    pto.tabs ins(%input0 : !pto.tile_buf<vec, 16x16xf16>)
             outs(%first : !pto.tile_buf<vec, 16x16xf16>)
    pto.tabs ins(%input1 : !pto.tile_buf<vec, 16x16xf16>)
             outs(%second : !pto.tile_buf<vec, 16x16xf16>)
    pto.tabs ins(%input0 : !pto.tile_buf<vec, 16x16xf16>)
             outs(%first : !pto.tile_buf<vec, 16x16xf16>)
    pto.tabs ins(%input1 : !pto.tile_buf<vec, 16x16xf16>)
             outs(%second : !pto.tile_buf<vec, 16x16xf16>)
    return
  }

  func.func @reference_choice_round_trip(
      %limit : index,
      %input : !pto.partition_tensor_view<16x16xf16>,
      %output : !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %addr0 = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf16>
    scf.for %index = %c0 to %limit step %c1 {
      pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>)
                outs(%tile : !pto.tile_buf<vec, 16x16xf16>)
      %condition = arith.cmpi eq, %index, %c0 : index
      scf.if %condition {
        pto.tstore ins(%tile : !pto.tile_buf<vec, 16x16xf16>)
                   outs(%output : !pto.partition_tensor_view<16x16xf16>)
      } else {
        pto.tstore ins(%tile : !pto.tile_buf<vec, 16x16xf16>)
                   outs(%output : !pto.partition_tensor_view<16x16xf16>)
      }
    }
    return
  }
}

// CHECK-LABEL: PROTOCOL-SYNC lane-patterns function=@reference_shared_event
// CHECK: lane-pattern #0 kind=shared-one-shot-frontier old-pattern=shared-event-frontier old-mechanism=event lanes=#0->#1
// CHECK-NEXT: ready-source=[pp4 guard=[]] ready-target=[pp5 guard=[]]
// CHECK-NEXT: reference-placement=after(pto.tload)->before(pto.tabs)
// CHECK: target-query=supported checkpoint-e=not-applicable checkpoint-e-reason=none cost-logical=1 cost-steady-actions=2 selectable=no

// CHECK-LABEL: PROTOCOL-SYNC lane-patterns function=@reference_old_mte2_barrier
// CHECK: raw-pair #0 hazard=waw{{.*}}interval=after(pp2)->before(pp5) completion-query=intrinsic
// CHECK: raw-pair #1 hazard=waw{{.*}}interval=after(pp4)->before(pp7) completion-query=intrinsic
// CHECK-NOT: kind=same-lane-completion-cut
// CHECK: PROTOCOL-SYNC lane-patterns-end function=@reference_old_mte2_barrier

// CHECK-LABEL: PROTOCOL-SYNC lane-patterns function=@reference_vector_completion_cut
// CHECK: raw-pair #3 hazard=waw{{.*}}interval=after(pp6)->before(pp9) completion-query=pipe-barrier
// CHECK: raw-pair #5 hazard=waw{{.*}}interval=after(pp8)->before(pp11) completion-query=pipe-barrier
// CHECK: kind=same-lane-completion-cut old-pattern=multi-demand-pipe-barrier old-mechanism=barrier lanes=#1->#1
// CHECK-NEXT: completion-cut=[pp9 guard=[]]
// CHECK-NEXT: reference-placement=before(pto.tabs)
// CHECK: raw-pair-members=[r#3, r#5]
// CHECK: target-query=supported checkpoint-e=not-applicable checkpoint-e-reason=none cost-logical=1 cost-steady-actions=1 selectable=no

// CHECK-LABEL: PROTOCOL-SYNC lane-patterns function=@reference_choice_round_trip
// CHECK: kind=choice-balanced-round-trip old-pattern=lifted-choice-ready-release old-mechanism=recurring-event lanes=#0->#1
// CHECK-NEXT: ready-source=[pp3 guard=[]] ready-target=[pp4 guard=[]]
// CHECK-NEXT: release-source=[pp13 guard=[]] release-target=[pp2 guard=[]]
// CHECK-NEXT: reference-placement=after(pto.tload)->before(scf.if);after(scf.if)->before(pto.tload)
// CHECK: target-query=supported checkpoint-e=rejected checkpoint-e-reason=multiple-consumers cost-logical=1 cost-steady-actions=4 selectable=no

// STORAGE-LABEL: PROTOCOL-SYNC storage-tracks function=@reference_shared_event
// STORAGE: storage-transition #0 kind=ready origin=lane-frontier old-pattern=storage-ready-frontier old-mechanism=event
// STORAGE-SAME: resource=AIV:PIPE_MTE2->AIV:PIPE_V
// STORAGE: reference-placement=after(pto.tload)->before(pto.tabs)

// STORAGE-LABEL: PROTOCOL-SYNC storage-tracks function=@reference_old_mte2_barrier
// STORAGE: kind=residual origin=raw-access-pair old-pattern=raw-storage-hazard old-mechanism=intrinsic
// STORAGE: reference-placement=after(pto.tload)->before(pto.tload)
// STORAGE: target-query=intrinsic checkpoint-e=not-applicable

// STORAGE-LABEL: PROTOCOL-SYNC storage-tracks function=@reference_vector_completion_cut
// STORAGE: kind=completion origin=completion-cut old-pattern=multi-demand-pipe-barrier old-mechanism=barrier lanes=#1->#1
// STORAGE-SAME: resource=AIV:PIPE_V->AIV:PIPE_V
// STORAGE-SAME: tracks=[t#2, t#3] raw-pair-members=[r#3, r#5]
// STORAGE: reference-placement=before(pto.tabs)->before(pto.tabs)
// STORAGE: target-query=pipe-barrier checkpoint-e=not-applicable checkpoint-e-reason=none cost-logical=1 cost-steady-actions=1 selectable=no

// STORAGE-LABEL: PROTOCOL-SYNC storage-tracks function=@reference_choice_round_trip
// STORAGE: kind=ready origin=lane-frontier old-pattern=storage-ready-frontier old-mechanism=recurring-event
// STORAGE: reference-placement=after(pto.tload)->before(scf.if)
// STORAGE: target-query=event checkpoint-e=rejected checkpoint-e-reason=unsupported-control-flow
// STORAGE: kind=release origin=lane-frontier old-pattern=storage-release-frontier old-mechanism=recurring-event
// STORAGE: reference-placement=after(scf.if)->before(pto.tload)
