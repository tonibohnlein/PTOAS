// RUN: pto-sync-input-test --region-contract-checks %s | FileCheck %s
// RUN: pto-sync-input-test --storage-effects %s | FileCheck %s --check-prefix=MAP
// MAP-LABEL: storage carried_geometry:
// MAP: descriptor base=absolute bytes=4 map=(d0, d1)[s0]
// MAP-SAME: (s0 mod 2) * 32 + 1024
// MAP-SAME: loops=2
// CHECK: scalar-evolution carried_reset: 2 passed
// CHECK: scalar-evolution direct: 3 passed
// CHECK: scalar-evolution nonunit: 1 passed
// CHECK: scalar-evolution unsafe: 3 passed
// CHECK: scalar-evolution conditional_update: 1 passed
// CHECK: scalar-evolution zero_trip_result: 1 passed
// CHECK: scalar-evolution bounded_clamps: 4 passed
// CHECK: scalar-evolution unsafe_clamps: 2 passed
// CHECK: scalar-evolution inferred_operation_range: 2 passed
// CHECK: scalar-evolution loaded_integer_bound: 3 passed
module {
  func.func @carried_reset(%n: index) attributes {test.no_region} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %size = arith.constant 65536 : index
    scf.for %outer = %c0 to %n step %c1 {
      %last = scf.for %i = %c0 to %n step %c1 iter_args(%bank = %c1) -> (index) {
        %inc = arith.addi %bank, %c1 : index
        %next = arith.remui %inc, %c2 {test.scalar_samples = array<i64: 0,0, 1,1, 2,0, 3,1, 1000000,0>} : index
        %bytes = arith.muli %next, %size : index
        %addr = arith.index_cast %bytes {test.scalar_samples = array<i64: 0,0, 1,65536, 2,0, 3,65536>} : index to i64
        scf.yield %next : index
      }
    }
    return
  }
  func.func @direct() attributes {test.no_region} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c16 = arith.constant 16 : index
    %size = arith.constant 131072 : index
    scf.for %i = %c0 to %c16 step %c1 {
      %inc = arith.addi %i, %c1 : index
      %bank = arith.remui %inc, %c2 {test.scalar_samples = array<i64: 0,1, 1,0, 14,1, 15,0>} : index
      %offset = arith.muli %bank, %size : index
      %base = arith.addi %offset, %size : index
      %addr = arith.index_cast %base {test.scalar_samples = array<i64: 0,262144, 1,131072, 14,262144, 15,131072>} : index to i64
      %extract = arith.muli %i, %c16 {test.scalar_samples = array<i64: 0,0, 1,16, 14,224, 15,240>} : index
    }
    return
  }
  func.func @nonunit(%n: index) attributes {test.no_region} {
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c3 = arith.constant 3 : index
    %c5 = arith.constant 5 : index
    %last = scf.for %i = %c5 to %n step %c2 iter_args(%bank = %c1) -> (index) {
      %inc = arith.addi %bank, %c2 : index
      %next = arith.remsi %inc, %c3 {test.scalar_samples = array<i64: 5,0, 7,2, 9,1, 11,0>} : index
      scf.yield %next : index
    }
    return
  }
  func.func @unsafe(%unknown: index) attributes {test.no_region} {
    %c1 = arith.constant 1 : index
    %add = arith.addi %unknown, %c1 {test.scalar_opaque} : index
    %negative = arith.constant -1 : i8
    %unsigned = arith.extui %negative {test.scalar_opaque} : i8 to i64
    %large = arith.constant 2147483648 : i64
    %narrow = arith.trunci %large {test.scalar_opaque} : i64 to i32
    return
  }
  func.func @conditional_update(%n: index, %condition: i1) attributes {test.no_region} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %last = scf.for %i = %c0 to %n step %c1 iter_args(%bank = %c1) -> (index) {
      %inc = arith.addi %bank, %c1 {test.scalar_opaque} : index
      %next = arith.remui %inc, %c2 : index
      %selected = arith.select %condition, %next, %bank : index
      scf.yield %selected : index
    }
    return
  }
  func.func @zero_trip_result() attributes {test.no_region} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %last = scf.for %i = %c0 to %c0 step %c1 iter_args(%bank = %c1) -> (index) {
      %inc = arith.addi %bank, %c1 : index
      %next = arith.remui %inc, %c2 : index
      scf.yield %next : index
    } {test.scalar_opaque}
    return
  }
  func.func @bounded_clamps() attributes {test.no_region} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %twenty = arith.constant 20 : index
    %ten = arith.constant 10 : index
    %scale = arith.constant 256 : index
    %limit = arith.constant 8192 : index
    scf.for %i = %zero to %twenty step %one {
      %offset = arith.muli %i, %scale : index
      %low = arith.maxsi %offset, %zero {test.scalar_samples = array<i64: 0,0, 1,256, 19,4864>} : index
      %high = arith.minsi %limit, %offset {test.scalar_samples = array<i64: 0,0, 19,4864>} : index
      %floor = arith.maxsi %zero, %offset {test.scalar_samples = array<i64: 0,0, 19,4864>} : index
      %shift = arith.subi %i, %ten : index
      %crossing = arith.maxsi %shift, %zero {test.scalar_opaque} : index
    }
    return
  }
  func.func @unsafe_clamps(%n: index, %p: index) attributes {test.no_region} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %scale = arith.constant 256 : index
    scf.for %i = %zero to %n step %one {
      %overflow = arith.muli %i, %scale : index
      %clamped = arith.maxsi %overflow, %zero {test.scalar_opaque} : index
      %unknown = arith.minsi %p, %zero {test.scalar_opaque} : index
    }
    return
  }
  func.func @carried_geometry(%n: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c32 = arith.constant 32 : index
    %base = arith.constant 1024 : index
    %one = arith.constant 1.0 : f32
    scf.for %outer = %c0 to %n step %c1 {
      %last = scf.for %i = %c0 to %n step %c1 iter_args(%bank = %c1) -> (index) {
        %inc = arith.addi %bank, %c1 : index
        %next = arith.remui %inc, %c2 : index
        %bytes = arith.muli %next, %c32 : index
        %address = arith.addi %bytes, %base : index
        %cast = arith.index_cast %address : index to i64
        %tile = pto.alloc_tile addr = %cast : !pto.tile_buf<vec, 1x8xf32>
        pto.texpands ins(%one : f32) outs(%tile : !pto.tile_buf<vec, 1x8xf32>)
        scf.yield %next : index
      }
    }
    return
  }

  func.func @inferred_operation_range() attributes {test.no_region} {
    %id = pto.get_subblock_idx {test.scalar_input}
    %i = arith.index_cast %id : i64 to index
    %stride = arith.constant 8192 : index
    %bank = arith.muli %i, %stride {test.scalar_external_input,
      test.scalar_samples = array<i64: 0,0, 1,8192>} : index
    %huge = arith.constant 9223372036854775807 : i64
    %unsafe = arith.addi %id, %huge {test.scalar_opaque} : i64
    return
  }
  // The source type bounds a load even without value or metadata-order facts.
  func.func @loaded_integer_bound(%metadata: !pto.ptr<i32, gm>) attributes {test.no_region} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %four = arith.constant 4 : index
    %loaded = pto.load %metadata[%zero] {test.scalar_input} : !pto.ptr<i32, gm> -> i32
    %upper = arith.index_cast %loaded {test.scalar_external_input,
      test.scalar_samples = array<i64: -2147483648,-2147483648, -1,-1, 0,0, 2147483647,2147483647>} : i32 to index
    scf.for %i = %zero to %upper step %one {
      %scaled = arith.muli %i, %four {
        test.scalar_samples = array<i64: 0,0, 1,4, 2147483646,8589934584>} : index
    }
    // Truncation still wraps. Having a range does not justify substituting
    // the original load through a value-changing cast.
    %narrow = arith.trunci %loaded {test.scalar_opaque} : i32 to i8
    return
  }

}
