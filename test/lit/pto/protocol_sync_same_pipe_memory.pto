// RUN: pto-test-opt \
// RUN:   --pto-protocol-sync='execution-mode=direct-repair fallback-mode=fail' \
// RUN:   %s | FileCheck %s

module attributes {pto.target_arch = "a3"} {
  func.func private @produce(%tile: !pto.tile_buf<vec, 16x16xf16>)
      attributes {pto.tileop.effects = ["write"], pto.tileop.helper,
                  pto.tileop.kind = "vector"} {
    return
  }

  func.func @same_mte3_waw(
      %output: !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %c512 = arith.constant 512 : i64
    %first = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    %second = pto.alloc_tile addr = %c512 : !pto.tile_buf<vec, 16x16xf16>
    func.call @produce(%first) : (!pto.tile_buf<vec, 16x16xf16>) -> ()
    func.call @produce(%second) : (!pto.tile_buf<vec, 16x16xf16>) -> ()
    pto.tstore ins(%first : !pto.tile_buf<vec, 16x16xf16>)
               outs(%output : !pto.partition_tensor_view<16x16xf16>)
    pto.tstore ins(%second : !pto.tile_buf<vec, 16x16xf16>)
               outs(%output : !pto.partition_tensor_view<16x16xf16>)
    return
  }
}

// CHECK-LABEL: func.func @same_mte3_waw
// CHECK: pto.tstore
// CHECK-NEXT: pto.barrier <PIPE_MTE3>
// CHECK-NEXT: pto.tstore
// CHECK-NEXT: pto.barrier <PIPE_ALL>
