// Cross-resource pipe drains are not legal without a target capability that
// certifies their directed completion contract. The down-projection case then
// exceeds the event-channel supply, so the pass must use its explicit localized
// PIPE_ALL backstop instead of selecting an uncertified repair mechanism.

// RUN: ptoas --pto-level=level3 --pto-arch=a3 --enable-canonical-sync \
// RUN:   --emit-pto-ir \
// RUN:   --canonical-sync-assume-distinct-gm-args-noalias \
// RUN:   --canonical-sync-selection-objective=action-first \
// RUN:   --canonical-sync-maximum-repair-frontier-inspections=1 \
// RUN:   --canonical-sync-comparison-report=%t.json \
// RUN:   %S/../../samples/Qwen3_14BDecodeA3/kernels/aic/down_proj.pto \
// RUN:   -o %t.pto
// RUN: FileCheck %s < %t.json

// CHECK: "selection_objective": "action-first"
// CHECK: "emitted_pipe_all_barriers": 31
// CHECK: "error": 0
// CHECK: "plan_signature": "0x186537040b52337b"
// CHECK: "precise_error": 4
// CHECK: "repair_frontier_truncated": true
// CHECK: "repair_rounds": 3
// CHECK: "selected_mechanisms_by_origin": {
// CHECK: "localized-pipe-all": 31
// CHECK: "repair-source-local-pipe-drain": 0
// CHECK-NEXT: "repair-source-prefix-pipe-drain": 0
// CHECK-NEXT: "repair-target-local-pipe-drain": 0
// CHECK: "used_localized_pipe_all": true
// CHECK: "verification_error": 0
// CHECK: "verified": true
