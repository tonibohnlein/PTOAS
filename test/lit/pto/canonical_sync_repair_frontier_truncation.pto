// Cross-resource pipe drains are not legal without a target capability that
// certifies their directed completion contract. When the optimized catalog
// exceeds the event-channel supply, the pass must retry the complete verified
// strict-direct basis before generating repair-frontier or PIPE_ALL mechanisms.
// Repair-frontier truncation itself is covered by the synthetic unit test,
// where the conflict core and proposal shape can be controlled precisely.

// RUN: ptoas --pto-level=level3 --pto-arch=a3 --enable-canonical-sync \
// RUN:   --emit-pto-ir \
// RUN:   --canonical-sync-assume-distinct-gm-args-noalias \
// RUN:   --canonical-sync-selection-objective=action-first \
// RUN:   --canonical-sync-maximum-repair-frontier-inspections=1 \
// RUN:   --canonical-sync-comparison-report=%t.json \
// RUN:   %S/../../samples/Qwen3_14BDecodeA3/kernels/aic/down_proj.pto \
// RUN:   -o %t.pto
// RUN: FileCheck %s < %t.json

// CHECK: "selection_objective": "action-first"
// CHECK: "emitted_event_sets": 55
// CHECK: "emitted_event_waits": 55
// CHECK: "emitted_pipe_all_barriers": 0
// CHECK: "emitted_targeted_barriers": 22
// CHECK: "error": 0
// CHECK: "precise_error": 4
// CHECK: "repair_frontier_truncated": false
// CHECK: "repair_rounds": 1
// CHECK: "repair_trials": 1
// CHECK: "selected_mechanisms_by_origin": {
// CHECK: "direct-lifecycle-protocol": 21
// CHECK: "direct-targeted-barrier": 22
// CHECK: "localized-pipe-all": 0
// CHECK: "used_localized_pipe_all": false
// CHECK: "verification_error": 0
// CHECK: "verified": true
