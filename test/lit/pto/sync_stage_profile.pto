// RUN: %python %S/Inputs/check_frontier_stage_profile.py pto-test-opt %s
// RUN: pto-sync-input-test --stage-profile-checks %s | FileCheck %s
// RUN: pto-sync-input-test --profile-stages --certify-regions %s 2>&1 | FileCheck %s --check-prefix=PROFILE
// RUN: pto-test-opt --pto-frontier-analysis="profile-stages=true" %s 2>&1 | FileCheck %s --check-prefix=PUBLIC
// CHECK: stage-profile: shared ledger cached requests exclusive timing unchanged route audit reuse
// PROFILE: frontier-profile
// PROFILE-SAME: "workload":"exhaustive-certification"
// PUBLIC: frontier-profile
// PUBLIC-SAME: "workload":"production-root"
!tile = !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module {
  func.func @profile_finite() {
    %c0 = arith.constant 0 : index
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %zero : !tile
    pto.texpands ins(%one : f32) outs(%tile : !tile)
    %v = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
    return
  }
}
