// RUN: pto-test-opt %s '-pto-insert-sync=algorithm=handoff' 2>&1 | FileCheck %s
// Preserve the existing translator result without an extra semantic-admission gate.
module attributes {pto.target_arch = "a3"} {
  func.func @soft_collective(%workspace: !pto.ptr<i32, gm>) {
    pto.syncall(%workspace : !pto.ptr<i32, gm>) mode = #pto.sync_all_mode<soft>, core_type = #pto.sync_core_type<mix>
    return
  }
}
// CHECK: pto.syncall
// CHECK-SAME: #pto.sync_all_mode<soft>
// CHECK: return
