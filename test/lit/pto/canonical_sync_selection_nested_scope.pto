// RUN: pto-test-opt %s -pto-plan-memory \
// RUN:   '-pto-print-canonical-sync-plan=format=text view=selection event-id-num-max=8' \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @nested_scope(
      %input : !pto.partition_tensor_view<16x16xf32>,
      %output : !pto.partition_tensor_view<16x16xf32>, %n : index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %one = arith.constant 1.0 : f32
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf32>

    scf.for %outer = %c0 to %n step %c1 {
      scf.for %inner = %c0 to %n step %c1 {
        pto.tload ins(%input : !pto.partition_tensor_view<16x16xf32>)
                  outs(%tile : !pto.tile_buf<vec, 16x16xf32>)
        pto.tadds ins(%tile, %one : !pto.tile_buf<vec, 16x16xf32>, f32)
                   outs(%tile : !pto.tile_buf<vec, 16x16xf32>)
        pto.tstore ins(%tile : !pto.tile_buf<vec, 16x16xf32>)
                   outs(%output : !pto.partition_tensor_view<16x16xf32>)
      }
    }
    return
  }
}

// CHECK-LABEL: PTOCanonicalSyncPlan @nested_scope
// CHECK: selection scope[1] op=scf.for
// CHECK-SAME: parent-scope=2
// CHECK: selection scope[2] op=scf.for
// CHECK-SAME: parent-scope=0
