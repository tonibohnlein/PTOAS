// RUN: pto-test-opt --pto-refine-storage-frontiers="placement=true" %s | FileCheck %s
// CHECK-LABEL: func.func @earlier_publication
// CHECK: pto.tabs
// CHECK-NEXT: pto.set_flag[<PIPE_V>, <PIPE_MTE2>
// CHECK-NEXT: pto.tabs
// CHECK: pto.wait_flag[<PIPE_V>, <PIPE_MTE2>
// CHECK: pto.tload
// CHECK-LABEL: func.func @later_acquisition
// CHECK: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID1>]
// CHECK-NEXT: pto.tabs
// CHECK-NEXT: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// CHECK-NEXT: pto.tabs
// CHECK-LABEL: func.func @all_readers_needed
// CHECK: pto.tabs
// CHECK-NEXT: pto.tabs
// CHECK-NEXT: pto.set_flag[<PIPE_V>, <PIPE_MTE2>
// CHECK-LABEL: func.func @unmarked_publication
// CHECK: pto.tabs
// CHECK-NEXT: pto.tabs
// CHECK-NEXT: pto.set_flag[<PIPE_V>, <PIPE_MTE2>
!V = !pto.tile_buf<vec, 16x16xf16>
!G = !pto.tensor_view<?x?xf16>
!P = !pto.partition_tensor_view<16x16xf16>
module attributes {pto.target_arch = "a3"} {
  func.func @earlier_publication(%src: !pto.ptr<f16>, %trips: index)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.gm_alias = "assume-disjoint-arguments"} {
    %z = arith.constant 0 : index
    %one = arith.constant 1 : index
    %s = arith.constant 16 : index
    %addra = arith.constant 0 : i64
    %a = pto.alloc_tile addr = %addra : !V
    %addrb = arith.constant 512 : i64
    %b = pto.alloc_tile addr = %addrb : !V
    %addrc = arith.constant 1024 : i64
    %c = pto.alloc_tile addr = %addrc : !V
    %addrd = arith.constant 1536 : i64
    %d = pto.alloc_tile addr = %addrd : !V
    %addre = arith.constant 2048 : i64
    %e = pto.alloc_tile addr = %addre : !V
    %view = pto.make_tensor_view %src, shape = [%s, %s], strides = [%s, %one] : !G
    %input = pto.partition_view %view, offsets = [%z, %z], sizes = [%s, %s] : !G -> !P
    pto.tload ins(%input : !P) outs(%a : !V)
    pto.tload ins(%input : !P) outs(%c : !V)
    "pto.set_flag"() {src_pipe = #pto.pipe<PIPE_MTE2>, dst_pipe = #pto.pipe<PIPE_V>, event_id = #pto.event<EVENT_ID0>} : () -> ()
    "pto.wait_flag"() {src_pipe = #pto.pipe<PIPE_MTE2>, dst_pipe = #pto.pipe<PIPE_V>, event_id = #pto.event<EVENT_ID0>} : () -> ()
    pto.tabs ins(%a : !V) outs(%b : !V)
    pto.tabs ins(%c : !V) outs(%d : !V)
    "pto.set_flag"() {src_pipe = #pto.pipe<PIPE_V>, dst_pipe = #pto.pipe<PIPE_MTE2>, event_id = #pto.event<EVENT_ID0>, pto.insert_sync.frontier_candidate} : () -> ()
    "pto.wait_flag"() {src_pipe = #pto.pipe<PIPE_V>, dst_pipe = #pto.pipe<PIPE_MTE2>, event_id = #pto.event<EVENT_ID0>} : () -> ()
    pto.tload ins(%input : !P) outs(%a : !V)
    pto.barrier <PIPE_ALL>
    return
  }
  func.func @later_acquisition(%src: !pto.ptr<f16>, %trips: index)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.gm_alias = "assume-disjoint-arguments"} {
    %z = arith.constant 0 : index
    %one = arith.constant 1 : index
    %s = arith.constant 16 : index
    %addra = arith.constant 0 : i64
    %a = pto.alloc_tile addr = %addra : !V
    %addrb = arith.constant 512 : i64
    %b = pto.alloc_tile addr = %addrb : !V
    %addrc = arith.constant 1024 : i64
    %c = pto.alloc_tile addr = %addrc : !V
    %addrd = arith.constant 1536 : i64
    %d = pto.alloc_tile addr = %addrd : !V
    %addre = arith.constant 2048 : i64
    %e = pto.alloc_tile addr = %addre : !V
    %view = pto.make_tensor_view %src, shape = [%s, %s], strides = [%s, %one] : !G
    %input = pto.partition_view %view, offsets = [%z, %z], sizes = [%s, %s] : !G -> !P
    pto.tload ins(%input : !P) outs(%c : !V)
    "pto.set_flag"() {src_pipe = #pto.pipe<PIPE_MTE2>, dst_pipe = #pto.pipe<PIPE_V>, event_id = #pto.event<EVENT_ID1>} : () -> ()
    pto.tload ins(%input : !P) outs(%a : !V)
    "pto.set_flag"() {src_pipe = #pto.pipe<PIPE_MTE2>, dst_pipe = #pto.pipe<PIPE_V>, event_id = #pto.event<EVENT_ID0>} : () -> ()
    "pto.wait_flag"() {src_pipe = #pto.pipe<PIPE_MTE2>, dst_pipe = #pto.pipe<PIPE_V>, event_id = #pto.event<EVENT_ID1>} : () -> ()
    "pto.wait_flag"() {src_pipe = #pto.pipe<PIPE_MTE2>, dst_pipe = #pto.pipe<PIPE_V>, event_id = #pto.event<EVENT_ID0>, pto.insert_sync.frontier_candidate} : () -> ()
    pto.tabs ins(%c : !V) outs(%d : !V)
    pto.tabs ins(%a : !V) outs(%b : !V)
    pto.barrier <PIPE_ALL>
    return
  }
  func.func @all_readers_needed(%src: !pto.ptr<f16>, %trips: index)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.gm_alias = "assume-disjoint-arguments"} {
    %z = arith.constant 0 : index
    %one = arith.constant 1 : index
    %s = arith.constant 16 : index
    %addra = arith.constant 0 : i64
    %a = pto.alloc_tile addr = %addra : !V
    %addrb = arith.constant 512 : i64
    %b = pto.alloc_tile addr = %addrb : !V
    %addrc = arith.constant 1024 : i64
    %c = pto.alloc_tile addr = %addrc : !V
    %addrd = arith.constant 1536 : i64
    %d = pto.alloc_tile addr = %addrd : !V
    %addre = arith.constant 2048 : i64
    %e = pto.alloc_tile addr = %addre : !V
    %view = pto.make_tensor_view %src, shape = [%s, %s], strides = [%s, %one] : !G
    %input = pto.partition_view %view, offsets = [%z, %z], sizes = [%s, %s] : !G -> !P
    pto.tload ins(%input : !P) outs(%a : !V)
    pto.tload ins(%input : !P) outs(%c : !V)
    "pto.set_flag"() {src_pipe = #pto.pipe<PIPE_MTE2>, dst_pipe = #pto.pipe<PIPE_V>, event_id = #pto.event<EVENT_ID0>} : () -> ()
    "pto.wait_flag"() {src_pipe = #pto.pipe<PIPE_MTE2>, dst_pipe = #pto.pipe<PIPE_V>, event_id = #pto.event<EVENT_ID0>} : () -> ()
    pto.tabs ins(%a : !V) outs(%b : !V)
    pto.tabs ins(%a : !V) outs(%d : !V)
    "pto.set_flag"() {src_pipe = #pto.pipe<PIPE_V>, dst_pipe = #pto.pipe<PIPE_MTE2>, event_id = #pto.event<EVENT_ID0>, pto.insert_sync.frontier_candidate} : () -> ()
    "pto.wait_flag"() {src_pipe = #pto.pipe<PIPE_V>, dst_pipe = #pto.pipe<PIPE_MTE2>, event_id = #pto.event<EVENT_ID0>} : () -> ()
    pto.tload ins(%input : !P) outs(%a : !V)
    pto.barrier <PIPE_ALL>
    return
  }
  func.func @unmarked_publication(%src: !pto.ptr<f16>, %trips: index)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.gm_alias = "assume-disjoint-arguments"} {
    %z = arith.constant 0 : index
    %one = arith.constant 1 : index
    %s = arith.constant 16 : index
    %addra = arith.constant 0 : i64
    %a = pto.alloc_tile addr = %addra : !V
    %addrb = arith.constant 512 : i64
    %b = pto.alloc_tile addr = %addrb : !V
    %addrc = arith.constant 1024 : i64
    %c = pto.alloc_tile addr = %addrc : !V
    %addrd = arith.constant 1536 : i64
    %d = pto.alloc_tile addr = %addrd : !V
    %addre = arith.constant 2048 : i64
    %e = pto.alloc_tile addr = %addre : !V
    %view = pto.make_tensor_view %src, shape = [%s, %s], strides = [%s, %one] : !G
    %input = pto.partition_view %view, offsets = [%z, %z], sizes = [%s, %s] : !G -> !P
    pto.tload ins(%input : !P) outs(%a : !V)
    pto.tload ins(%input : !P) outs(%c : !V)
    "pto.set_flag"() {src_pipe = #pto.pipe<PIPE_MTE2>, dst_pipe = #pto.pipe<PIPE_V>, event_id = #pto.event<EVENT_ID0>} : () -> ()
    "pto.wait_flag"() {src_pipe = #pto.pipe<PIPE_MTE2>, dst_pipe = #pto.pipe<PIPE_V>, event_id = #pto.event<EVENT_ID0>} : () -> ()
    pto.tabs ins(%a : !V) outs(%b : !V)
    pto.tabs ins(%c : !V) outs(%d : !V)
    "pto.set_flag"() {src_pipe = #pto.pipe<PIPE_V>, dst_pipe = #pto.pipe<PIPE_MTE2>, event_id = #pto.event<EVENT_ID0>} : () -> ()
    "pto.wait_flag"() {src_pipe = #pto.pipe<PIPE_V>, dst_pipe = #pto.pipe<PIPE_MTE2>, event_id = #pto.event<EVENT_ID0>} : () -> ()
    pto.tload ins(%input : !P) outs(%a : !V)
    pto.barrier <PIPE_ALL>
    return
  }
}
