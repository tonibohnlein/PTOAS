// RUN: pto-sync-input-test --arithmetic-periodic-input-checks %s | FileCheck %s
// CHECK: access failure precedes order; permissive profile remains available
!tile = !pto.tile_buf<vec, 1x8xf32>
module attributes {pto.target_arch = "a3"} {
  func.func @access_first(%pointer: !pto.ptr<f32, gm>) attributes {test.access_first} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %four = arith.constant 4 : index
    %eight = arith.constant 8 : index
    %size = arith.constant 32 : index
    %address = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %address : !tile
    %tensor = pto.make_tensor_view %pointer, shape = [%size, %size], strides = [%eight, %one] : !pto.tensor_view<?x?xf32>
    scf.for %i = %zero to %four step %one {
      %view = pto.partition_view %tensor, offsets = [%i, %zero], sizes = [%one, %eight] : !pto.tensor_view<?x?xf32>
      pto.tstore ins(%tile : !tile) outs(%view : !pto.partition_tensor_view<1x8xf32>)
    }
    return
  }
}
