// RUN: pto-sync-input-test --arithmetic-periodic-input-checks %s
module attributes {pto.backend = "emitc", "pto.device-spec" = "Ascend910B1", pto.kernel_kind = #pto.kernel_kind<vector>, pto.target_arch = "a3"} {
  func.func @nested_difference_fallback(%arg0: !pto.ptr<f32, gm>, %arg1: !pto.ptr<f32, gm>) attributes {test.difference_routing, test.trace_arguments = array<i64: 0, 0>} {
    %c0_i64 = arith.constant 0 : i64
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %0 = pto.make_tensor_view %arg0, shape = [%c32, %c32], strides = [%c32, %c1] {layout = #pto.layout<nd>, pto.inferred_layout = true} : !pto.tensor_view<?x?xf32>
    %1 = pto.make_tensor_view %arg1, shape = [%c32, %c32], strides = [%c32, %c1] {layout = #pto.layout<nd>, pto.inferred_layout = true} : !pto.tensor_view<?x?xf32>
    %2 = pto.partition_view %0, offsets = [%c0, %c0], sizes = [%c32, %c32] : !pto.tensor_view<?x?xf32>
    %3 = pto.partition_view %1, offsets = [%c0, %c0], sizes = [%c32, %c32] : !pto.tensor_view<?x?xf32>
    %4 = pto.alloc_tile addr = %c0_i64 : !pto.tile_buf<vec, 32x32xf32>
    scf.for %outer = %c0 to %c1 step %c1 {
      scf.for %arg2 = %c0 to %c1 step %c1 {
        pto.tload ins(%2 : !pto.partition_tensor_view<32x32xf32>) outs(%4 : !pto.tile_buf<vec, 32x32xf32>) {layout = #pto.layout<nd>, pto.inferred_layout = true}
        pto.tstore ins(%4 : !pto.tile_buf<vec, 32x32xf32>) outs(%3 : !pto.partition_tensor_view<32x32xf32>) {layout = #pto.layout<nd>, pto.inferred_layout = true}
      }
    }
    return
  }
  func.func @straight_lazy_dispatch(%arg0: !pto.ptr<f32, gm>, %arg1: !pto.ptr<f32, gm>) attributes {test.lazy_arithmetic, test.trace_arguments = array<i64: 0, 0>} {
    %c0_i64 = arith.constant 0 : i64
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %0 = pto.make_tensor_view %arg0, shape = [%c32, %c32], strides = [%c32, %c1] {layout = #pto.layout<nd>, pto.inferred_layout = true} : !pto.tensor_view<?x?xf32>
    %1 = pto.make_tensor_view %arg1, shape = [%c32, %c32], strides = [%c32, %c1] {layout = #pto.layout<nd>, pto.inferred_layout = true} : !pto.tensor_view<?x?xf32>
    %2 = pto.partition_view %0, offsets = [%c0, %c0], sizes = [%c32, %c32] : !pto.tensor_view<?x?xf32>
    %3 = pto.partition_view %1, offsets = [%c0, %c0], sizes = [%c32, %c32] : !pto.tensor_view<?x?xf32>
    %4 = pto.alloc_tile addr = %c0_i64 : !pto.tile_buf<vec, 32x32xf32>
    pto.tload ins(%2 : !pto.partition_tensor_view<32x32xf32>) outs(%4 : !pto.tile_buf<vec, 32x32xf32>) {layout = #pto.layout<nd>, pto.inferred_layout = true}
    pto.tstore ins(%4 : !pto.tile_buf<vec, 32x32xf32>) outs(%3 : !pto.partition_tensor_view<32x32xf32>) {layout = #pto.layout<nd>, pto.inferred_layout = true}
    return
  }
  // Both sites have the same loop domain, but the fixed writer and moving
  // reader overlap only at early reader iterations. This absolute cutoff is
  // not a distance interval, although the source relations are difference bounds.
  func.func @populated_stage_difference_fallback(%src: !pto.ptr<f32, gm>, %dst: !pto.ptr<f32, gm>) attributes {test.difference_routing, test.interval_rejection} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %eight = arith.constant 8 : index
    %limit = arith.constant 64 : index
    %address = arith.constant 0 : i64
    %sv = pto.make_tensor_view %src, shape = [%one, %eight], strides = [%eight, %one] {layout = #pto.layout<nd>, pto.inferred_layout = true} : !pto.tensor_view<?x?xf32>
    %dv = pto.make_tensor_view %dst, shape = [%one, %eight], strides = [%eight, %one] {layout = #pto.layout<nd>, pto.inferred_layout = true} : !pto.tensor_view<?x?xf32>
    %sp = pto.partition_view %sv, offsets = [%zero, %zero], sizes = [%one, %eight] : !pto.tensor_view<?x?xf32>
    %dp = pto.partition_view %dv, offsets = [%zero, %zero], sizes = [%one, %eight] : !pto.tensor_view<?x?xf32>
    %fixed = pto.alloc_tile addr = %address : !pto.tile_buf<vec, 1x8xf32>
    scf.for %i = %zero to %limit step %one {
      %offset = arith.index_cast %i : index to i64
      %moving = pto.alloc_tile addr = %offset : !pto.tile_buf<vec, 1x8xf32>
      pto.tload ins(%sp : !pto.partition_tensor_view<1x8xf32>) outs(%fixed : !pto.tile_buf<vec, 1x8xf32>) {layout = #pto.layout<nd>, pto.inferred_layout = true}
      pto.tstore ins(%moving : !pto.tile_buf<vec, 1x8xf32>) outs(%dp : !pto.partition_tensor_view<1x8xf32>) {layout = #pto.layout<nd>, pto.inferred_layout = true}
    }
    return
  }
}
