// A physical fence without an enclosing vector/cube section or a kernel kind
// has no safe target drain set. CanonicalSync must reject it rather than assume
// the cube/AIC lowering.
// RUN: not ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-analysis-only --emit-pto-ir %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @unknown_fence_execution_context() {
    pto.fence.barrier_all #pto.fence_scope<gm>
    return
  }
}

// CHECK: error: canonical sync cannot resolve the physical execution context
// CHECK-SAME: for fence
