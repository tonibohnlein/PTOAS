// RUN: pto-sync-input-test --gm-alias=may-not-alias --bounded-endpoint-audit %S/sync_bounded_boundary_presence.pto | FileCheck %s
// The opt-in audit checks every retained record in separate detached fragments.
// The tool repeats the audit, runs ordinary preparation on the same owned
// demands, and checks that the original module remains unchanged.
// CHECK: endpoint-anchor site=0 pipe={{[0-9]+}} operation=pto.textract
// CHECK-NOT: endpoint-obligation
// CHECK: endpoint-audit records={{[1-9][0-9]*}} failures=0
// CHECK: endpoint-audit repeat-failure-count=stable normal-preparation=ready
module {}
