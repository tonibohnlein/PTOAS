// RUN: pto-sync-input-test --sequence-analysis %s | FileCheck %s
// CHECK: "slice_prerequisite":true
!tile = !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module {
  func.func @scalar_to_slice() attributes {test.slice_bounds = array<i64: 2, 5>} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %five = arith.constant 5 : index
    %base = arith.constant 0 : i64
    %other = arith.constant 1024 : i64
    %a = pto.alloc_tile addr = %base : !tile
    %b = pto.alloc_tile addr = %other : !tile
    %v = pto.tgetval ins(%a, %zero : !tile, index) outs : f32
    scf.for %i = %zero to %five step %one {
      pto.texpands ins(%v : f32) outs(%b : !tile)
    }
    return
  }
}
