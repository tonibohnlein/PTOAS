// RUN: pto-sync-input-test --storage-effects %s | FileCheck %s
// RUN: pto-sync-input-test --region-contract-checks %s | FileCheck %s --check-prefix=CONTRACT
// RUN: pto-sync-input-test --step0-json %s | FileCheck %s --check-prefix=AUDIT
// Distinct selections of the same source are disjoint; destination accesses
// cover their entire tiles. The shared extractor must retain symbolic offsets.
// CHECK-LABEL: storage two_windows:
// CHECK: effect 0 pto.textract read exact
// CHECK: access {{.*}}extents=16, 16 loops=0
// CHECK: effect 1 pto.textract write exact definite-write=1
// CHECK: effect 2 pto.textract read exact
// CHECK: overlap 0,2=0
// CHECK: overlap 1,3=0
// CHECK-LABEL: storage dynamic_window:
// CHECK: effect 0 pto.textract read exact
// CHECK: access {{.*}}mod 65536{{.*}}extents=16, 16 loops=1
// CHECK-LABEL: storage unproven_alignment:
// CHECK: effect 0 pto.textract read unknown
// CHECK: effect 1 pto.textract write unknown
// CONTRACT: synthetic-region-contract two_windows: 4 passed
// CONTRACT: synthetic-region-contract dynamic_window: 2 passed
// CONTRACT: synthetic-region-contract unproven_alignment: 2 passed
// AUDIT: "exact_accesses":4
// AUDIT: "exact_accesses":2
// AUDIT: "exact_accesses":0
!src = !pto.tile_buf<mat, 32x64xf16, slayout=col_major>
!dst = !pto.tile_buf<left, 16x16xf16, slayout=row_major>
module attributes {pto.target_arch = "a3"} {
  func.func @two_windows() attributes {test.overlap = array<i64: 0, 2, 1, 3>} {
    %a0 = arith.constant 0 : i64
    %a512 = arith.constant 512 : i64
    %i0 = arith.constant 0 : index
    %i16 = arith.constant 16 : index
    %src = pto.alloc_tile addr = %a0 : !src
    %left = pto.alloc_tile addr = %a0 : !dst
    %right = pto.alloc_tile addr = %a512 : !dst
    pto.textract ins(%src, %i0, %i0 : !src, index, index) outs(%left : !dst)
    pto.textract ins(%src, %i0, %i16 : !src, index, index) outs(%right : !dst)
    return
  }
  func.func @dynamic_window() {
    %a0 = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i4 = arith.constant 4 : index
    %i16 = arith.constant 16 : index
    %src = pto.alloc_tile addr = %a0 : !src
    %dst = pto.alloc_tile addr = %a0 : !dst
    scf.for %k = %i0 to %i4 step %i1 {
      %col = arith.muli %k, %i16 : index
      pto.textract ins(%src, %i0, %col : !src, index, index) outs(%dst : !dst)
    }
    return
  }
  func.func @unproven_alignment(%offset: index) {
    %a0 = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %src = pto.alloc_tile addr = %a0 : !src
    %dst = pto.alloc_tile addr = %a0 : !dst
    pto.textract ins(%src, %i0, %offset : !src, index, index) outs(%dst : !dst)
    return
  }
}
