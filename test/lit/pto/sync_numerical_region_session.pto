// RUN: pto-sync-input-test --certify-regions %s | FileCheck %s
// RUN: pto-sync-input-test --gm-alias=may-alias --certify-regions %s | FileCheck %s
// CHECK: numerical-request-order: fresh-and-warm exact-queries selectors logical-root-and-child
// CHECK: numerical-region-session: owned-demands cached-sequence independent-root lazy-endpoints
// CHECK: numerical-request-order: fresh-and-warm exact-queries selectors logical-root-and-child
// CHECK: numerical-region-session: owned-demands cached-sequence independent-root lazy-endpoints
// CHECK: numerical-request-order: fresh-and-warm exact-queries selectors logical-root-and-child
// CHECK: numerical-region-session: owned-demands cached-sequence independent-root lazy-endpoints
// CHECK: numerical-region-session: preexisting-sync rejected retained-demands
// CHECK: recognition-skipped existing_sync: manual-on-core-synchronization
// CHECK: source-unchanged; synchronization-insertion-not-run
!mat = !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major>
!left = !pto.tile_buf<left, 16x16xf16, slayout=row_major>
!right = !pto.tile_buf<right, 16x16xf16, slayout=col_major>
!acc = !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>
module attributes {pto.target_arch = "a3"} {
  func.func @surrounding_payload(%n: index) attributes {test.numerical_region_session, test.numerical_external} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %mat = pto.alloc_tile addr = %base : !mat
    %left = pto.alloc_tile addr = %base : !left
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
    scf.for %t = %zero to %n step %one {
      scf.for %i = %zero to %two step %one {
        pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
        pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
      }
    }
    return
  }
  func.func @whole_template(%n: index) attributes {test.numerical_region_session} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %mat = pto.alloc_tile addr = %base : !mat
    %left = pto.alloc_tile addr = %base : !left
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    scf.for %t = %zero to %n step %one {
      scf.for %i = %zero to %two step %one {
        pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
        pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
      }
    }
    return
  }
  func.func @zero_trip() attributes {test.numerical_region_session} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %mat = pto.alloc_tile addr = %base : !mat
    %left = pto.alloc_tile addr = %base : !left
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    scf.for %t = %zero to %zero step %one {
      scf.for %i = %zero to %two step %one {
        pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
        pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
      }
    }
    return
  }
  func.func @existing_sync(%n: index) attributes {test.numerical_region_session, test.numerical_existing} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %mat = pto.alloc_tile addr = %base : !mat
    %left = pto.alloc_tile addr = %base : !left
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    pto.set_flag [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_V>, #pto.event<EVENT_ID0>]
    scf.for %t = %zero to %n step %one {
      scf.for %i = %zero to %two step %one {
        pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
        pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
      }
    }
    return
  }
}
