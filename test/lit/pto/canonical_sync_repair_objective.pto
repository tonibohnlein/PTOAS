// Both objectives must reject cross-resource pipe-drain repairs when the target
// does not certify their completion contract. The safe localized PIPE_ALL
// backstop is therefore objective-independent for this pressure-heavy kernel.

// RUN: ptoas --pto-level=level3 --pto-arch=a3 --enable-canonical-sync \
// RUN:   --emit-pto-ir \
// RUN:   --canonical-sync-assume-distinct-gm-args-noalias \
// RUN:   --canonical-sync-selection-objective=action-first \
// RUN:   --canonical-sync-comparison-report=%t.action.json \
// RUN:   %S/../../samples/Qwen3_14BDecodeA3/kernels/aic/down_proj.pto \
// RUN:   -o %t.action.pto
// RUN: ptoas --pto-level=level3 --pto-arch=a3 --enable-canonical-sync \
// RUN:   --emit-pto-ir \
// RUN:   --canonical-sync-assume-distinct-gm-args-noalias \
// RUN:   --canonical-sync-selection-objective=serialization-first \
// RUN:   --canonical-sync-comparison-report=%t.serialization.json \
// RUN:   %S/../../samples/Qwen3_14BDecodeA3/kernels/aic/down_proj.pto \
// RUN:   -o %t.serialization.pto
// RUN: FileCheck %s --check-prefix=ACTION < %t.action.json
// RUN: FileCheck %s --check-prefix=SERIALIZATION < %t.serialization.json

// ACTION: "selection_objective": "action-first"
// ACTION: "emitted_pipe_all_barriers": 31
// ACTION: "error": 0
// ACTION: "plan_signature": "0x7eb17dfe8ead2b71"
// ACTION: "precise_error": 4
// ACTION: "predicted_sync_instructions": 32
// ACTION: "repair_rounds": 2
// ACTION: "serialization_breadth": 4196
// ACTION: "used_localized_pipe_all": true
// ACTION: "verified": true

// SERIALIZATION: "selection_objective": "serialization-first"
// SERIALIZATION: "emitted_pipe_all_barriers": 31
// SERIALIZATION: "error": 0
// SERIALIZATION: "plan_signature": "0x7eb17dfe8ead2b71"
// SERIALIZATION: "precise_error": 4
// SERIALIZATION: "predicted_sync_instructions": 32
// SERIALIZATION: "repair_rounds": 3
// SERIALIZATION: "serialization_breadth": 4196
// SERIALIZATION: "used_localized_pipe_all": true
// SERIALIZATION: "verified": true
