// Exact step4 manual payload, explicit sync statements removed before frontend lowering.
// Shenggan/pypto-gemm@4b7fe5558996f8468f0c55189fc44092222c5085
// RUN: pto-test-opt --pto-insert-sync=algorithm=handoff %s -o %t
// RUN: FileCheck %s < %t
// RUN: %python %S/../../oahs/check_carried_slot_trace.py %t
// CHECK-LABEL: func.func @hpgemm_hpgemm
// CHECK: scf.for
// CHECK: pto.wait_flag[<PIPE_M>, <PIPE_MTE1>
// CHECK: pto.textract
// CHECK: pto.set_flag[<PIPE_MTE1>, <PIPE_M>
// CHECK: pto.tmatmul
// CHECK: pto.set_flag[<PIPE_M>, <PIPE_MTE1>
// CHECK: pto.barrier <PIPE_ALL>
module attributes {pto.backend = "emitc", pto.kernel_kind = #pto.kernel_kind<cube>, pto.target_arch = "a3"} {
  func.func @hpgemm_hpgemm(%arg0: !pto.ptr<f32, gm>, %arg1: !pto.ptr<f16, gm>, %arg2: !pto.ptr<f16, gm>, %arg3: i32, %arg4: i32) attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %c3 = arith.constant 3 : index
    %c0_i64 = arith.constant 0 : i64
    %c2048 = arith.constant 2048 : index
    %c4096 = arith.constant 4096 : index
    %c1 = arith.constant 1 : index
    %c256 = arith.constant 256 : index
    %c64 = arith.constant 64 : index
    %c4 = arith.constant 4 : index
    %c16 = arith.constant 16 : index
    %c2 = arith.constant 2 : index
    %c128 = arith.constant 128 : index
    %c0 = arith.constant 0 : index
    %c65536 = arith.constant 65536 : index
    %c131072 = arith.constant 131072 : index
    %c16384 = arith.constant 16384 : index
    %c32768 = arith.constant 32768 : index
    %0 = pto.make_tensor_view %arg0, shape = [%c2048, %c4096], strides = [%c4096, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf32>
    %1 = pto.make_tensor_view %arg1, shape = [%c2048, %c4096], strides = [%c4096, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf16>
    %2 = pto.make_tensor_view %arg2, shape = [%c4096, %c4096], strides = [%c4096, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf16>
    %3 = pto.alloc_tile addr = %c0_i64 valid_row = %c128 valid_col = %c256 : !pto.tile_buf<acc, 128x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
    %4 = arith.index_cast %arg3 : i32 to index
    %5 = arith.index_cast %arg4 : i32 to index
    scf.for %arg5 = %4 to %c256 step %5 {
      %6 = arith.divsi %arg5, %c64 : index
      %7 = arith.remsi %arg5, %c64 : index
      %8 = arith.cmpi eq, %6, %c3 : index
      %9 = arith.muli %6, %c4 : index
      %10 = arith.subi %c16, %9 : index
      %11 = scf.if %8 -> (index) {
        scf.yield %10 : index
      } else {
        scf.yield %c4 : index
      }
      %12 = arith.divsi %7, %11 : index
      %13 = arith.muli %6, %c4 : index
      %14 = arith.remsi %7, %11 : index
      %15 = arith.addi %13, %14 : index
      %16 = arith.remsi %6, %c2 : index
      %17 = arith.cmpi eq, %16, %c1 : index
      %18 = scf.if %17 -> (index) {
        %26 = arith.subi %c16, %12 : index
        %27 = arith.subi %26, %c1 : index
        scf.yield %27 : index
      } else {
        scf.yield %12 : index
      }
      %19 = arith.muli %18, %c128 : index
      %20 = arith.muli %15, %c256 : index
      %21 = pto.alloc_tile addr = %c0_i64 valid_row = %c128 valid_col = %c256 : !pto.tile_buf<acc, 128x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
      %22 = scf.for %arg6 = %c0 to %c16 step %c1 iter_args(%arg7 = %c1) -> (index) {
        %26 = arith.addi %arg7, %c1 : index
        %27 = arith.remsi %26, %c2 : index
        %28 = arith.muli %arg6, %c256 : index
        %29 = arith.muli %27, %c65536 : index
        %30 = arith.index_cast %29 : index to i64
        %31 = pto.alloc_tile addr = %30 valid_row = %c128 valid_col = %c256 : !pto.tile_buf<mat, 128x256xf16, valid=?x?, blayout=col_major, slayout=row_major>
        %32 = arith.maxsi %19, %c0 : index
        %33 = arith.maxsi %28, %c0 : index
        %34 = pto.partition_view %1, offsets = [%32, %33], sizes = [%c128, %c256] : !pto.tensor_view<?x?xf16>
        pto.tload ins(%34 : !pto.partition_tensor_view<128x256xf16>) outs(%31 : !pto.tile_buf<mat, 128x256xf16, valid=?x?, blayout=col_major, slayout=row_major>) {layout = #pto.layout<nd>}
        %35 = arith.muli %27, %c131072 : index
        %36 = arith.addi %35, %c131072 : index
        %37 = arith.index_cast %36 : index to i64
        %38 = pto.alloc_tile addr = %37 valid_row = %c256 valid_col = %c256 : !pto.tile_buf<mat, 256x256xf16, valid=?x?, blayout=col_major, slayout=row_major>
        %39 = arith.maxsi %28, %c0 : index
        %40 = arith.maxsi %20, %c0 : index
        %41 = pto.partition_view %2, offsets = [%39, %40], sizes = [%c256, %c256] : !pto.tensor_view<?x?xf16>
        pto.tload ins(%41 : !pto.partition_tensor_view<256x256xf16>) outs(%38 : !pto.tile_buf<mat, 256x256xf16, valid=?x?, blayout=col_major, slayout=row_major>) {layout = #pto.layout<nd>}
        %42 = scf.for %arg8 = %c0 to %c4 step %c1 iter_args(%arg9 = %c1) -> (index) {
          %43 = arith.muli %arg8, %c64 : index
          %44 = arith.addi %arg9, %c1 : index
          %45 = arith.remsi %44, %c2 : index
          %46 = arith.muli %45, %c16384 : index
          %47 = arith.index_cast %46 : index to i64
          %48 = pto.alloc_tile addr = %47 valid_row = %c128 valid_col = %c64 : !pto.tile_buf<left, 128x64xf16, valid=?x?, slayout=row_major>
          pto.textract ins(%31, %c0, %43 : !pto.tile_buf<mat, 128x256xf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%48 : !pto.tile_buf<left, 128x64xf16, valid=?x?, slayout=row_major>)
          %49 = arith.muli %45, %c32768 : index
          %50 = arith.index_cast %49 : index to i64
          %51 = pto.alloc_tile addr = %50 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<right, 64x256xf16, valid=?x?, slayout=col_major>
          pto.textract ins(%38, %43, %c0 : !pto.tile_buf<mat, 256x256xf16, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%51 : !pto.tile_buf<right, 64x256xf16, valid=?x?, slayout=col_major>)
          %52 = arith.cmpi eq, %arg6, %c0 : index
          %53 = arith.cmpi eq, %arg8, %c0 : index
          %54 = arith.andi %52, %53 : i1
          scf.if %54 {
            %55 = pto.alloc_tile addr = %c0_i64 valid_row = %c128 valid_col = %c256 : !pto.tile_buf<acc, 128x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
            pto.tmatmul ins(%48, %51 : !pto.tile_buf<left, 128x64xf16, valid=?x?, slayout=row_major>, !pto.tile_buf<right, 64x256xf16, valid=?x?, slayout=col_major>) outs(%55 : !pto.tile_buf<acc, 128x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>)
          } else {
            pto.tmatmul.acc ins(%21, %48, %51 : !pto.tile_buf<acc, 128x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 128x64xf16, valid=?x?, slayout=row_major>, !pto.tile_buf<right, 64x256xf16, valid=?x?, slayout=col_major>) outs(%21 : !pto.tile_buf<acc, 128x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>)
          }
          scf.yield %45 : index
        }
        scf.yield %27 : index
      }
      %23 = arith.maxsi %19, %c0 : index
      %24 = arith.maxsi %20, %c0 : index
      %25 = pto.partition_view %0, offsets = [%23, %24], sizes = [%c128, %c256] : !pto.tensor_view<?x?xf32>
      pto.tstore ins(%21 : !pto.tile_buf<acc, 128x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>) outs(%25 : !pto.partition_tensor_view<128x256xf32>) {layout = #pto.layout<nd>}
    }
    return
  }
}
