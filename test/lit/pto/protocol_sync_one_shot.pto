// RUN: ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --protocol-sync-one-shot --protocol-sync-fallback=fail --protocol-sync-dump=plan \
// RUN:   --protocol-sync-statistics %s -o %t.a3 2> %t.a3.diagnostics
// RUN: FileCheck %s --input-file=%t.a3 --check-prefix=IR
// RUN: FileCheck %s --input-file=%t.a3.diagnostics --check-prefix=PLAN
// RUN: ptoas --pto-arch=a2 --pto-level=level2 --emit-pto-ir \
// RUN:   --protocol-sync-one-shot --protocol-sync-fallback=fail --protocol-sync-dump=plan \
// RUN:   --protocol-sync-statistics %s \
// RUN:   -o %t.a2 2> %t.a2.diagnostics
// RUN: FileCheck %s --input-file=%t.a2 --check-prefix=IR
// RUN: FileCheck %s --input-file=%t.a2.diagnostics --check-prefix=A2-PLAN
// RUN: not ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --enable-insert-sync --protocol-sync-one-shot %s -o /dev/null 2>&1 | \
// RUN:   FileCheck %s --check-prefix=MUTEX
// RUN: not ptoas --pto-arch=a5 --pto-level=level2 --emit-pto-ir \
// RUN:   --enable-bufid_sync --protocol-sync-one-shot %s -o /dev/null 2>&1 | \
// RUN:   FileCheck %s --check-prefix=MUTEX
// RUN: not ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --enable-inject-barrier-all-sync --protocol-sync-one-shot %s -o /dev/null 2>&1 | \
// RUN:   FileCheck %s --check-prefix=MUTEX
module {
  func.func @linear_one_shot(
      %input : !pto.partition_tensor_view<16x16xf16>,
      %output : !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %source = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    %middle = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>)
              outs(%source : !pto.tile_buf<vec, 16x16xf16>)
    pto.tabs ins(%source : !pto.tile_buf<vec, 16x16xf16>)
             outs(%middle : !pto.tile_buf<vec, 16x16xf16>)
    pto.tabs ins(%middle : !pto.tile_buf<vec, 16x16xf16>)
             outs(%result : !pto.tile_buf<vec, 16x16xf16>)
    pto.tstore ins(%result : !pto.tile_buf<vec, 16x16xf16>)
               outs(%output : !pto.partition_tensor_view<16x16xf16>)
    return
  }
}
// PLAN: PROTOCOL-SYNC one-shot-plan function=@linear_one_shot status=ready phases=4 protocols=3 core=vector target=npu2201-a3
// PLAN: protocol #0 kind=directed-event
// PLAN-SAME: event-id=0
// PLAN: protocol #1 kind=pipe-barrier
// PLAN: protocol #2 kind=directed-event
// PLAN-SAME: event-id=0
// PLAN: tail-drain=true placement=function-return
// PLAN: "event_domains":2
// PLAN-SAME: "max_event_domain_pressure":1
// PLAN-SAME: "maximum_event_id":0
// PLAN-SAME: "protocol_plans_admitted":1
// PLAN-SAME: "protocol_plans_attempted":1
// PLAN-SAME: "protocol_plans_rejected":0
// PLAN-SAME: "selected_directed_event_pairs":2
// PLAN-SAME: "selected_one_shot_protocols":3
// PLAN-SAME: "selected_same_pipe_barriers":1
// PLAN-SAME: "selected_tail_drains":1
// PLAN: "planner_result":"materialized"
// PLAN-SAME: "producer":"protocol-plan"
// IR-LABEL: func.func @linear_one_shot
// IR: pto.tload
// IR: pto.set_flag
// IR: pto.wait_flag
// IR: pto.tabs
// IR: pto.barrier <PIPE_V>
// IR: pto.tabs
// IR: pto.set_flag
// IR: pto.wait_flag
// IR: pto.tstore
// IR: pto.barrier <PIPE_ALL>
// A2-PLAN: PROTOCOL-SYNC one-shot-plan function=@linear_one_shot status=ready phases=4 protocols=3 core=vector target=npu2201-a2
// A2-PLAN: "planner_result":"materialized"
// A2-PLAN-SAME: "producer":"protocol-plan"
// MUTEX: Error: --enable-insert-sync
// MUTEX: --protocol-sync-one-shot
// MUTEX-SAME: mutually exclusive
