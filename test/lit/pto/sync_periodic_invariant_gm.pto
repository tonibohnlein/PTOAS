// RUN: %python %S/Inputs/check_periodic_invariant_gm.py pto-sync-input-test pto-test-opt %s
// A fixed body reuses UB while GM slices advance from loop-invariant row origins.
// Reduced from the prefill save-token loop; neither its name nor dimensions
// participate in recognition. All input/output GM pointers are assumed disjoint.
module attributes {pto.backend = "emitc", pto.kernel_kind = #pto.kernel_kind<vector>, pto.target_arch = "a3"} {
  func.func @copy_invariant_rows(%arg0: !pto.ptr<bf16, gm>, %arg1: !pto.ptr<bf16, gm>, %arg2: index, %arg3: index, %arg4: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>, test.eligible_ids = array<i64: 0, 1, 2, 3, 4, 5>, test.trace_arguments = array<i64: 1, 2, 3>} {
    %c0_i64 = arith.constant 0 : i64
    %c16 = arith.constant 16 : index
    %c5120 = arith.constant 5120 : index
    %c1 = arith.constant 1 : index
    %c4096 = arith.constant 4096 : index
    %c0 = arith.constant 0 : index
    %c20 = arith.constant 20 : index
    %c256 = arith.constant 256 : index
    %c2 = arith.constant 2 : index
    %c2048 = arith.constant 2048 : index
    %0 = pto.make_tensor_view %arg0, shape = [%c16, %c5120], strides = [%c5120, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xbf16>
    %1 = pto.make_tensor_view %arg1, shape = [%c4096, %c5120], strides = [%c5120, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xbf16>
    scf.for %arg5 = %c0 to %c20 step %c1 {
      %2 = arith.muli %arg5, %c256 : index
      %3 = arith.remsi %arg2, %c2 : index
      %4 = arith.muli %3, %c2048 : index
      %5 = pto.alloc_tile addr = %c0_i64 valid_row = %c1 valid_col = %c256 : !pto.tile_buf<vec, 1x256xbf16, valid=?x?>
      %6 = arith.addi %4, %arg3 : index
      %7 = arith.maxsi %6, %c0 : index
      %8 = arith.maxsi %2, %c0 : index
      %9 = pto.partition_view %1, offsets = [%7, %8], sizes = [%c1, %c256] : !pto.tensor_view<?x?xbf16>
      pto.tload ins(%9 : !pto.partition_tensor_view<1x256xbf16>) outs(%5 : !pto.tile_buf<vec, 1x256xbf16, valid=?x?>) {layout = #pto.layout<nd>}
      %10 = arith.maxsi %arg4, %c0 : index
      %11 = arith.maxsi %2, %c0 : index
      %12 = pto.partition_view %0, offsets = [%10, %11], sizes = [%c1, %c256] : !pto.tensor_view<?x?xbf16>
      pto.tstore ins(%5 : !pto.tile_buf<vec, 1x256xbf16, valid=?x?>) outs(%12 : !pto.partition_tensor_view<1x256xbf16>) {layout = #pto.layout<nd>}
    }
    return
  }
}
