// RUN: pto-frontier-analysis-test --sync-preflight-check %s | FileCheck %s
// CHECK: verified detached-clone preflight: module-only, conflicts, guards, mutation rollback
module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<cube>} {
  func.func @module_only() attributes {test.preflight_accept = true} {
    pto.sync.logical_set [<PIPE_MTE2>, <PIPE_MTE1>, 0]()
    return
  }
  func.func @conflicting_function() attributes {pto.kernel_kind = #pto.kernel_kind<vector>,
                                               test.preflight_accept = false} {
    pto.sync.logical_set [<PIPE_MTE2>, <PIPE_MTE1>, 0]()
    return
  }
  func.func @guarded_conflict(%condition: i1) attributes {test.preflight_accept = false} {
    scf.if %condition {
      pto.section.vector {
        pto.sync.logical_set [<PIPE_MTE2>, <PIPE_V>, 0]()
      }
    }
    return
  }
  func.func @mutated_clone() attributes {test.preflight_accept = false, test.mutate_clone} {
    pto.sync.logical_set [<PIPE_MTE2>, <PIPE_MTE1>, 0]()
    return
  }
  module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
    func.func @conflicting_module() attributes {test.preflight_accept = false} {
      pto.sync.logical_set [<PIPE_MTE2>, <PIPE_V>, 0]()
      return
    }
  }
}
