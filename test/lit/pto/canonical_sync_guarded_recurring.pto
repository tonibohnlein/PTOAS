// A conditional ready/release handoff keeps all four body actions in the same
// repeated control arm. A skipped iteration issues no reset; the release token
// remains live until the next guarded handoff or the loop drain.
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-dump --emit-pto-ir %s -o %t 2> %t.log
// RUN: FileCheck %s --check-prefix=PLAN < %t.log
// RUN: FileCheck %s --check-prefix=IR < %t

module attributes {pto.target_arch = "a2a3"} {
  func.func @guarded_recurring(
      %src: !pto.partition_tensor_view<16x128xf32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %input_addr = arith.constant 0 : i64
    %output_addr = arith.constant 8192 : i64
    %zero = arith.constant 0 : index
    %one_index = arith.constant 1 : index
    %two = arith.constant 2 : index
    %four = arith.constant 4 : index
    %one = arith.constant 1.000000e+00 : f32
    %input = pto.alloc_tile addr = %input_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %output = pto.alloc_tile addr = %output_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    scf.for %iteration = %zero to %four step %one_index {
      %remainder = arith.remui %iteration, %two : index
      %even = arith.cmpi eq, %remainder, %zero : index
      scf.if %even {
        pto.tload ins(%src : !pto.partition_tensor_view<16x128xf32>)
                  outs(%input : !pto.tile_buf<loc=vec, dtype=f32,
                         rows=16, cols=128, v_row=16, v_col=128,
                         blayout=row_major, slayout=none_box,
                         fractal=512, pad=0>)
        pto.tmuls ins(%input, %one : !pto.tile_buf<loc=vec, dtype=f32,
                        rows=16, cols=128, v_row=16, v_col=128,
                        blayout=row_major, slayout=none_box, fractal=512,
                        pad=0>, f32)
                  outs(%output : !pto.tile_buf<loc=vec, dtype=f32,
                         rows=16, cols=128, v_row=16, v_col=128,
                         blayout=row_major, slayout=none_box,
                         fractal=512, pad=0>)
      }
    }
    return
  }
}

// PLAN-LABEL: CANONICAL-SYNC function=guarded_recurring
// PLAN: kind=recurring-event resource=AIV:PIPE_MTE2->AIV:PIPE_V
// PLAN-SAME: protocol=guarded-handshake
// PLAN: VERIFY ok

// IR-LABEL: func.func @guarded_recurring
// IR: pto.set_flag[<PIPE_V>, <PIPE_MTE2>, {{.*}}]
// IR-SAME: protocol_role = "release-prime-set"
// IR: scf.for
// IR: scf.if
// IR: pto.wait_flag[<PIPE_V>, <PIPE_MTE2>, {{.*}}]
// IR-SAME: protocol_role = "release-body-wait"
// IR-NEXT: pto.tload
// IR-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_V>, {{.*}}]
// IR-SAME: protocol_role = "ready-body-set"
// IR: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, {{.*}}]
// IR-SAME: protocol_role = "ready-body-wait"
// IR-NEXT: pto.tmuls
// IR-NEXT: pto.set_flag[<PIPE_V>, <PIPE_MTE2>, {{.*}}]
// IR-SAME: protocol_role = "release-body-set"
// IR: pto.wait_flag[<PIPE_V>, <PIPE_MTE2>, {{.*}}]
// IR-SAME: protocol_role = "release-drain-wait"
