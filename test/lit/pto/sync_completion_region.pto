// RUN: pto-sync-input-test --completion-region-checks %s | FileCheck %s
// CHECK: completion region: while_control cuts=3 payload-control-preserved
// CHECK: completion region: counted cuts=3 payload-control-preserved
// CHECK: completion refused: opaque
// CHECK: completion refused: manual
!tile = !pto.tile_buf<vec, 1x8xf32>
module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func private @unknown()
  func.func @while_control(%condition: i1) attributes {test.completion_cuts = array<i64: 1, 2, 3>} {
    %addr = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %addr : !tile
    pto.texpands ins(%one : f32) outs(%tile : !tile)
    scf.while : () -> () {
      %read = "pto.tgetval"(%tile, %zero) {test.cut = 1 : i64} : (!tile, index) -> f32
      %positive = arith.cmpf ogt, %read, %one : f32
      %continue = arith.andi %positive, %condition : i1
      scf.condition(%continue)
    } do {
      "pto.texpands"(%one, %tile) {test.cut = 2 : i64} : (f32, !tile) -> ()
      scf.yield
    }
    "func.return"() {test.cut = 3 : i64} : () -> ()
  }
  func.func @counted(%count: index, %condition: i1) attributes {test.completion_cuts = array<i64: 1, 2, 3>} {
    %addr = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %step = arith.constant 1 : index
    %one = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %addr : !tile
    scf.for %i = %zero to %count step %step {
      scf.if %condition {
        "pto.texpands"(%one, %tile) {test.cut = 1 : i64} : (f32, !tile) -> ()
      }
      %read = "pto.tgetval"(%tile, %zero) {test.cut = 2 : i64} : (!tile, index) -> f32
    }
    "func.return"() {test.cut = 3 : i64} : () -> ()
  }
  func.func @opaque() attributes {test.completion_refuse} {
    func.call @unknown() : () -> ()
    return
  }
  func.func @manual() attributes {test.completion_refuse} {
    pto.set_flag [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_V>, #pto.event<EVENT_ID0>]
    return
  }
}
