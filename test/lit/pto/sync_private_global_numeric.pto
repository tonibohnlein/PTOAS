// RUN: %python %S/Inputs/check_private_global_numeric.py pto-sync-input-test %s
!tile = !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @private_global(%read: !pto.ptr<f32>, %base: !pto.ptr<f32>, %seed: index)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>, test.recurring_global_numeric,
                  test.private_global_numeric, test.trace_arguments = array<i64: 0>,
                  test.eligible_ids = array<i64: 0, 1, 2, 3, 4, 5>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c5 = arith.constant 5 : index
    %c16 = arith.constant 16 : index
    %c8 = arith.constant 8 : index
    %c64 = arith.constant 64 : index
    %zero = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %zero : !tile
    %origin = arith.muli %seed, %c8 : index
    %view = pto.make_tensor_view %base, shape = [%c64, %c8], strides = [%c8, %c1]
        {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf32>
    %readView = pto.make_tensor_view %read, shape = [%c64, %c8], strides = [%c8, %c1]
        {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf32>
    %readPart = pto.partition_view %readView, offsets = [%c0, %c0], sizes = [%c1, %c8]
        : !pto.tensor_view<?x?xf32>
    scf.for %outer = %c1 to %c5 step %c2 {
      %outerDelta = arith.muli %outer, %c16 : index
      %translated = arith.addi %origin, %outerDelta : index
      scf.for %inner = %c0 to %c2 step %c1 {
        %delta = arith.muli %inner, %c8 : index
        %row = arith.addi %translated, %delta : index
        %part = pto.partition_view %view, offsets = [%row, %c0], sizes = [%c1, %c8]
            : !pto.tensor_view<?x?xf32>
        pto.tload ins(%readPart : !pto.partition_tensor_view<1x8xf32>) outs(%tile : !tile)
        pto.tstore ins(%tile : !tile) outs(%part : !pto.partition_tensor_view<1x8xf32>)
      }
    }
    return
  }
}
