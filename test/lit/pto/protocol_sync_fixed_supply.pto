// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir \
// RUN:   --protocol-sync-direct-repair --protocol-sync-fallback=fail %s -o %t.ir
// RUN: FileCheck %s --input-file=%t.ir
// RUN: ptoas --pto-arch=a2 --pto-level=level3 --emit-pto-ir \
// RUN:   --protocol-sync-mixed --protocol-sync-fallback=fail %s -o %t.mixed.ir
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir \
// RUN:   --protocol-sync-analysis-only --protocol-sync-dump=concrete-verification \
// RUN:   %t.ir -o /dev/null 2> %t.verify
// RUN: FileCheck %s --input-file=%t.verify --check-prefix=VERIFY
// RUN: ptoas --pto-arch=a2 --pto-level=level3 --emit-pto-ir \
// RUN:   --protocol-sync-analysis-only --protocol-sync-dump=concrete-verification \
// RUN:   %t.mixed.ir -o /dev/null 2> %t.mixed.verify
// RUN: FileCheck %s --input-file=%t.mixed.verify --check-prefix=VERIFY

// The first handoff is fixed supply, not a generated candidate. Its ID remains
// reserved even though another static handoff is lexically later in the domain.
// CHECK-LABEL: func.func @fixed_partial
// CHECK: pto.tload
// CHECK-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// CHECK-NEXT: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// CHECK-NEXT: pto.tabs
// CHECK: pto.tload
// CHECK: pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID1>]
// CHECK: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID1>]
// CHECK-NEXT: pto.tabs
// CHECK-NEXT: pto.set_flag[<PIPE_V>, <PIPE_MTE3>,
// CHECK-NEXT: pto.barrier <PIPE_V>
// CHECK-NEXT: pto.tabs
// CHECK-NEXT: pto.wait_flag[<PIPE_V>, <PIPE_MTE3>,
// CHECK-NEXT: pto.wait_flag[<PIPE_MTE2>, <PIPE_MTE3>,
// CHECK-NEXT: pto.tstore
// VERIFY: concrete-verification function=@fixed_partial status=accepted first-failed-stage=none

module {
  func.func @fixed_partial(%in: !pto.partition_tensor_view<16x16xf16>,
                           %out: !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %c512 = arith.constant 512 : i64
    %c1024 = arith.constant 1024 : i64
    %c1536 = arith.constant 1536 : i64
    %a = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    %b = pto.alloc_tile addr = %c512 : !pto.tile_buf<vec, 16x16xf16>
    %c = pto.alloc_tile addr = %c1024 : !pto.tile_buf<vec, 16x16xf16>
    %d = pto.alloc_tile addr = %c1536 : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%in : !pto.partition_tensor_view<16x16xf16>)
              outs(%a : !pto.tile_buf<vec, 16x16xf16>)
    pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
    pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
    pto.tabs ins(%a : !pto.tile_buf<vec, 16x16xf16>)
             outs(%b : !pto.tile_buf<vec, 16x16xf16>)
    pto.tload ins(%in : !pto.partition_tensor_view<16x16xf16>)
              outs(%c : !pto.tile_buf<vec, 16x16xf16>)
    pto.tabs ins(%c : !pto.tile_buf<vec, 16x16xf16>)
             outs(%d : !pto.tile_buf<vec, 16x16xf16>)
    pto.barrier <PIPE_V>
    pto.tabs ins(%b : !pto.tile_buf<vec, 16x16xf16>)
             outs(%b : !pto.tile_buf<vec, 16x16xf16>)
    pto.tstore ins(%d : !pto.tile_buf<vec, 16x16xf16>)
               outs(%out : !pto.partition_tensor_view<16x16xf16>)
    return
  }
}
