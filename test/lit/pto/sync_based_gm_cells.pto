// RUN: %python %S/Inputs/check_based_gm_cells.py pto-sync-input-test %s
// The same relative interval belongs to distinct cells for independent roots.
!mat = !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major>
!acc = !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>
module attributes {pto.target_arch = "a3"} {
  func.func @based_gm(%a: !pto.ptr<f16, gm>, %b: !pto.ptr<f16, gm>) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %n = arith.constant 16 : index
    %shift = arith.constant 128 : index
    %base = arith.constant 0 : i64
    %alias = pto.addptr %a, %shift : !pto.ptr<f16, gm> -> !pto.ptr<f16, gm>
    %av = pto.make_tensor_view %a, shape = [%n, %n], strides = [%n, %one] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf16>
    %bv = pto.make_tensor_view %b, shape = [%n, %n], strides = [%n, %one] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf16>
    %ap = pto.partition_view %av, offsets = [%zero, %zero], sizes = [%n, %n] : !pto.tensor_view<?x?xf16>
    %bp = pto.partition_view %bv, offsets = [%zero, %zero], sizes = [%n, %n] : !pto.tensor_view<?x?xf16>
    %acc = pto.alloc_tile addr = %base : !acc
    %mat = pto.alloc_tile addr = %base : !mat
    pto.tstore ins(%acc : !acc) outs(%ap : !pto.partition_tensor_view<16x16xf16>)
    pto.tload ins(%bp : !pto.partition_tensor_view<16x16xf16>) outs(%mat : !mat)
    return
  }
}
