// RUN: pto-test-opt %s '-pto-insert-sync=algorithm=handoff' | FileCheck %s
// The two allocation roots are distinct, but use the SAME dynamic address.
// Losing that possible overlap used to remove every MTE2->V obligation.
module attributes {pto.target_arch = "a3"} {
  func.func @dynamic_local_alias(%src: !pto.partition_tensor_view<1x32xf32>,
                                %address: i64)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %outAddress = arith.constant 1024 : i64
    %a = pto.alloc_tile addr = %address : !pto.tile_buf<vec, 1x32xf32>
    %b = pto.alloc_tile addr = %address : !pto.tile_buf<vec, 1x32xf32>
    %c = pto.alloc_tile addr = %outAddress : !pto.tile_buf<vec, 1x32xf32>
    pto.tload ins(%src : !pto.partition_tensor_view<1x32xf32>)
      outs(%a : !pto.tile_buf<vec, 1x32xf32>)
    pto.tadd ins(%b, %b : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xf32>)
      outs(%c : !pto.tile_buf<vec, 1x32xf32>)
    return
  }
}
// CHECK-LABEL: func.func @dynamic_local_alias
// CHECK: pto.tload
// CHECK: pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// CHECK: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// CHECK: pto.tadd
