// RUN: pto-sync-input-test --storage-effects %s | FileCheck %s

// Slot selectors belong to buffer geometry. Neither a dynamic nor a constant
// slot establishes the actual accessed set or a definite overwrite.
// CHECK-LABEL: storage slots: cells=0 all-exact=0
// CHECK: effect 0 pto.tsetval write unknown definite-write=0 cells=
// CHECK: effect 1 pto.tsetval write unknown definite-write=0 cells=
// CHECK: effect 2 pto.tgetval read unknown definite-write=0 cells=
// CHECK: overlap 0,1=1
// CHECK: overlap 0,2=1
// CHECK: overlap 1,2=1
// CHECK: source-unchanged; dependency-analysis-not-run

!tile = !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!ring = !pto.multi_tile_buf<!pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, count=2>
module {
  func.func @slots(%slot: index) attributes {test.overlap = array<i64: 0, 1, 0, 2, 1, 2>} {
    %zero = arith.constant 0 : i64
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %one = arith.constant 1.0 : f32
    %ring = pto.alloc_multi_tile addr = %zero : !ring
    %dynamic = pto.multi_tile_get %ring[%slot] : !ring -> !tile
    %first = pto.multi_tile_get %ring[%i0] : !ring -> !tile
    %second = pto.multi_tile_get %ring[%i1] : !ring -> !tile
    pto.tsetval ins(%i0, %one : index, f32) outs(%dynamic : !tile)
    pto.tsetval ins(%i0, %one : index, f32) outs(%first : !tile)
    %v = pto.tgetval ins(%second, %i0 : !tile, index) outs : f32
    return
  }
}
