// RUN: pto-test-opt %s '-pto-insert-sync=algorithm=handoff' | FileCheck %s

module attributes {pto.target_arch = "a3"} {
  func.func @repeated_loop(%src: !pto.partition_tensor_view<1x32xf32>,
                           %trips: index) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %a0 = arith.constant 0 : i64
    %a1 = arith.constant 128 : i64
    %a = pto.alloc_tile addr = %a0 : !pto.tile_buf<vec, 1x32xf32>
    %b = pto.alloc_tile addr = %a1 : !pto.tile_buf<vec, 1x32xf32>
    scf.for %i = %zero to %trips step %one {
      pto.tload ins(%src : !pto.partition_tensor_view<1x32xf32>)
        outs(%a : !pto.tile_buf<vec, 1x32xf32>)
      pto.tadd ins(%a, %a : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xf32>)
        outs(%b : !pto.tile_buf<vec, 1x32xf32>)
    }
    return
  }
}

// The generic selected F8 protocol keeps both directions balanced inside the
// body. Zero trips execute no event commands; only return performs retirement.
// CHECK-LABEL: func.func @repeated_loop
// CHECK: scf.for
// CHECK-NEXT: pto.set_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID0>]
// CHECK-NEXT: pto.wait_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID0>]
// CHECK-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// CHECK-NEXT: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// CHECK-NEXT: pto.barrier <PIPE_MTE2>
// CHECK-NEXT: pto.tload
// CHECK-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID1>]
// CHECK-NEXT: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID1>]
// CHECK-NEXT: pto.set_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID1>]
// CHECK-NEXT: pto.wait_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID1>]
// CHECK-NEXT: pto.tadd
// CHECK-NEXT: }
// CHECK-NEXT: pto.barrier <PIPE_ALL>
// CHECK-NEXT: return
