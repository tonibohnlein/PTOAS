// RUN: sed 's/ attributes {pto.noalias_pairs = array<i64: 0, 1, 0, 2, 1, 2>}//' \
// RUN:   %s > %t.unannotated.pto
// RUN: pto-test-opt %t.unannotated.pto \
// RUN:   '-pto-print-canonical-sync-plan=format=text view=all event-id-num-max=8' \
// RUN:   | tee %t.unannotated.out | FileCheck %s --check-prefix=UNANNOTATED
// RUN: sed -n '/^  barrier\[/,/^module /p' %t.annotated.out | sed '$d' \
// RUN:   > %t.annotated.mechanisms
// RUN: sed -n '/^  barrier\[/,/^module /p' %t.unannotated.out | sed '$d' \
// RUN:   > %t.unannotated.mechanisms
// RUN: diff -u %t.annotated.mechanisms %t.unannotated.mechanisms
// RUN: pto-test-opt %s \
// RUN:   '-pto-print-canonical-sync-plan=format=text view=covering event-id-num-max=8 assume-distinct-gm-args-noalias=true' \
// RUN:   | FileCheck %s --check-prefix=GLOBAL-NOALIAS

