// RUN: pto-sync-input-test --descriptor-state-checks %s | FileCheck %s
// CHECK: descriptor-state: wrapping_lower_bound
!tile = !pto.tile_buf<vec, 8x8xf32, valid=?x?>
module attributes {dlti.dl_spec = #dlti.dl_spec<#dlti.dl_entry<index, 32 : i32>>} {
  func.func @wrapping_lower_bound() {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %wide = arith.constant 4294967295 : index
    %addr = arith.constant 0 : i64
    %t = pto.alloc_tile addr = %addr valid_row = %c8 valid_col = %c8 : !tile
    scf.for %i = %wide to %c1 step %c1 {
      pto.set_validshape %t, %c1, %c8 : !tile
    }
    %a = "pto.tgetval"(%t, %c0) {test.shape = array<i64: -1, -1>} : (!tile, index) -> f32
    return
  }
}
