// RUN: pto-test-opt --mlir-disable-threading --pto-frontier-analysis="deferred-output=true allocation-ids=0,1,2,3,4,5" %s | FileCheck %s
// RUN: %python %S/Inputs/check_deferred_family_output.py pto-test-opt pto-sync-input-test ptoas %s
// CHECK: pto.deferred_family =
// CHECK-SAME: version = 2 : i64
// A straight-line child and a rotating loop retain separate original cuts.
// Both leaves must survive serialization without constructing scalar endpoints.
!mat = !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major>
!left = !pto.tile_buf<left, 16x16xf16, slayout=row_major>
!right = !pto.tile_buf<right, 16x16xf16, slayout=col_major>
!acc = !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>
!ring = !pto.multi_tile_buf<!pto.tile_buf<left, 16x16xf16, slayout=row_major>, count=2>
module attributes {pto.target_arch = "a3"} {
  func.func @deferred_mixed(%n: index) attributes {test.trace_arguments = array<i64: 8>} {
    %base = arith.constant 0 : i64
    %separate = arith.constant 4096 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %mat = pto.alloc_tile addr = %base : !mat
    %initial = pto.alloc_tile addr = %separate : !left
    %initial_acc = pto.alloc_tile addr = %separate : !acc
    %ring = pto.alloc_multi_tile addr = %base : !ring
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%initial : !left)
    pto.tmatmul ins(%initial, %right : !left, !right) outs(%initial_acc : !acc)
    scf.for %i = %zero to %n step %one {
      %slot = arith.remui %i, %two : index
      %left = pto.multi_tile_get %ring[%slot] : !ring -> !left
      pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
      pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
    }
    return
  }
}
