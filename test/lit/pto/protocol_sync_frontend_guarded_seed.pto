// Unmodified frontend attn_out_seed program, except source locations.
// The guard selects a suffix of the original unit-step iteration domain.
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail --protocol-sync-dump=plan %s -o %t.pto 2>&1 | FileCheck %s --check-prefix=PLAN
// RUN: FileCheck %s --input-file=%t.pto
// RUN: ptoas --pto-arch=a2 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail --protocol-sync-gm-alias=assume-disjoint-arguments %s -o %t.a2.pto
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir --protocol-sync-analysis-only --protocol-sync-dump=concrete-verification %t.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=VERIFY
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail %s -o %t.cpp
// PLAN: protocol-sync-normalization function=@attn_out_seed expanded-inner-loops=0 expanded-iterations=0 restricted-loop-domains=1
// PLAN: mixed-plan function=@attn_out_seed status=ready world=selective-loop
// VERIFY: concrete-verification function=@attn_out_seed status=accepted
// CHECK-LABEL: func.func @attn_out_seed
// CHECK: %[[LOWER:.*]] = arith.maxsi
// CHECK: scf.for {{.*}} = %[[LOWER]] to
// CHECK: pto.texpands
// CHECK-NEXT: pto.set_flag[<PIPE_V>, <PIPE_MTE3>,
// CHECK: pto.wait_flag[<PIPE_V>, <PIPE_MTE3>,
// CHECK-NEXT: pto.tstore
// CHECK: pto.barrier <PIPE_ALL>
// CHECK-NEXT: return

module attributes {pto.target_arch = "a2a3"} {
  func.func @attn_out_seed(%arg0: !pto.ptr<bf16>, %arg1: i32) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  %c0_i64 = arith.constant 0 : i64
  %c16_index = arith.constant 16 : index
  %c5120_index = arith.constant 5120 : index
  %c1_index = arith.constant 1 : index
  %c0_index = arith.constant 0 : index
  %cst_5 = arith.constant 0.00000000000000000e+00 : bf16
  %attn_out_inline721__ssa_v0_view = pto.make_tensor_view %arg0, shape = [%c16_index, %c5120_index], strides = [%c5120_index, %c1_index] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xbf16>
  scf.for %b_inline744__idx_v0 = %c0_index to %c16_index step %c1_index {
    %0 = arith.index_cast %arg1 : i32 to index
    %1 = arith.cmpi sle, %0, %b_inline744__idx_v0 : index
    scf.if %1 {
      %t__tile = pto.alloc_tile addr = %c0_i64 valid_row = %c1_index valid_col = %c5120_index : !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=5120, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
      pto.texpands ins(%cst_5 : bf16) outs(%t__tile : !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=5120, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      %2 = arith.maxsi %b_inline744__idx_v0, %c0_index : index
      %attn_out_inline721__iter_v1_pview = pto.partition_view %attn_out_inline721__ssa_v0_view, offsets = [%2, %c0_index], sizes = [%c1_index, %c5120_index] : !pto.tensor_view<?x?xbf16> -> !pto.partition_tensor_view<1x5120xbf16>
      pto.tstore ins(%t__tile : !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=5120, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%attn_out_inline721__iter_v1_pview : !pto.partition_tensor_view<1x5120xbf16>)
    } else {
    }
  }
  return
  }
}
