// RUN: pto-sync-input-test --certify-regions %s | FileCheck %s
// RUN: pto-sync-input-test --gm-alias=may-alias --certify-regions %s | FileCheck %s
// RUN: %python %S/Inputs/check_sequence_endpoint_retry.py pto-sync-input-test %s
// CHECK: sequence-endpoint-retry: retained-expanded-math recomposed-strong-children cached fresh-plans source-unchanged
// CHECK: source-unchanged; synchronization-insertion-not-run
// Nonzero-origin scalar copies advance through a vector tile. The mathematical
// request may use expanded occurrences; endpoint preparation must choose its
// own compatible child representation and reduce complete crossings again.
!tile = !pto.tile_buf<vec, 1x16xf32>
module attributes {pto.target_arch = "a3"} {
  func.func @scalar_copy(%unused: index) attributes {test.sequence_endpoint_retry, test.trace_arguments = array<i64: 0>} {
    %addr = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %four = arith.constant 4 : index
    %value = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %addr : !tile
    pto.tadds ins(%tile, %value : !tile, f32) outs(%tile : !tile) {test.label = "before"}
    scf.for %outer = %one to %four step %one {
      scf.for %inner = %zero to %four step %one {
        %base = arith.muli %outer, %four : index
        %at = arith.addi %base, %inner : index
        %read = pto.tgetval ins(%tile, %inner : !tile, index) outs : f32 {test.label = "read"}
        pto.tsetval ins(%at, %read : index, f32) outs(%tile : !tile) {test.label = "write"}
      }
    }
    pto.tadds ins(%tile, %value : !tile, f32) outs(%tile : !tile) {test.label = "after"}
    return
  }
}
