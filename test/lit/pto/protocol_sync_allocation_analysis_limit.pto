// 65 load/compute pairs need 129 cross-pipe generations. Existing acknowledgements
// would permit reuse, but exceed the bounded consumption-order proof. Report an
// analysis limitation, never physical scarcity or an internal compiler error.
// CHECK: status=allocation-analysis-limit world=direct-only
// CHECK-SAME: allocation-failure=event-allocation-analysis-limit
// CHECK: "allocation_analysis_failures":1
// CHECK-SAME: "allocation_lifetime_limit_hits":1
// CHECK-SAME: "planner_result":"event-allocation-analysis-limit"
// CHECK-SAME: "producer":"fail-closed-policy"

module {
  func.func @bounded_acknowledgements(%input: !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %zero = arith.constant 0 : i64
    %offset = arith.constant 512 : i64
    %a = pto.alloc_tile addr = %zero : !pto.tile_buf<vec, 16x16xf16>
    %b = pto.alloc_tile addr = %offset : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
    pto.tabs ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%b : !pto.tile_buf<vec, 16x16xf16>)
