// RUN: pto-test-opt --pto-frontier-analysis --pto-frontier-allocate='eligible-ids=0,1,2,3,4,5' %s | FileCheck %s
// Indexed TSCATTER has both a vector writer and a scalar writer. Preserve
// both outgoing conflicts, including across section and conditional boundaries.
!tile = !pto.tile_buf<vec, 1x32xf16>
!indices = !pto.tile_buf<vec, 1x32xi16>
module attributes {pto.target_arch = "a3"} {
  func.func @guarded_macro_writers(%take: i1, %output: !pto.partition_tensor_view<1x32xf16>) {
    %a = arith.constant 0 : i64
    %b = arith.constant 64 : i64
    %c = arith.constant 128 : i64
    %src = pto.alloc_tile addr = %a : !tile
    %idx = pto.alloc_tile addr = %b : !indices
    %dst = pto.alloc_tile addr = %c : !tile
    pto.section.vector {
      scf.if %take {
        pto.tscatter ins(%src, %idx : !tile, !indices) outs(%dst : !tile)
      }
    }
    pto.section.vector {
      pto.tstore ins(%dst : !tile) outs(%output : !pto.partition_tensor_view<1x32xf16>)
    }
    return
  }
  func.func @local_hidden_reservations(%dst: !pto.partition_tensor_view<1x32xf16>,
                                      %peer: !pto.partition_tensor_view<1x32xf16>) {
    %a = arith.constant 0 : i64
    %b = arith.constant 64 : i64
    %tile = pto.alloc_tile addr = %a : !tile
    %ping = pto.alloc_tile addr = %b : !tile
    pto.tstore ins(%tile : !tile) outs(%peer : !pto.partition_tensor_view<1x32xf16>)
    pto.comm.tgather(%dst, recv(%ping), group(%peer) :
      !pto.partition_tensor_view<1x32xf16>, !tile, !pto.partition_tensor_view<1x32xf16>) {root = 0 : i32}
    pto.tload ins(%dst : !pto.partition_tensor_view<1x32xf16>) outs(%tile : !tile)
    pto.tstore ins(%tile : !tile) outs(%peer : !pto.partition_tensor_view<1x32xf16>)
    pto.tload ins(%peer : !pto.partition_tensor_view<1x32xf16>) outs(%tile : !tile)
    return
  }

}
// CHECK-LABEL: func.func @guarded_macro_writers
// CHECK: pto.section.vector
// CHECK: scf.if %arg0
// CHECK: pto.tscatter
// CHECK-DAG: pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
// CHECK-DAG: pto.set_flag[<PIPE_S>, <PIPE_MTE3>, <EVENT_ID0>]
// CHECK: pto.section.vector
// CHECK-DAG: pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
// CHECK-DAG: pto.wait_flag[<PIPE_S>, <PIPE_MTE3>, <EVENT_ID0>]
// CHECK: pto.tstore
// CHECK-NOT: pto.logical_

// CHECK-LABEL: func.func @local_hidden_reservations
// CHECK: pto.tstore
// CHECK: pto.set_flag[<PIPE_MTE3>, <PIPE_MTE2>, <EVENT_ID1>]
// CHECK: pto.comm.tgather
// CHECK: pto.tload
// CHECK: pto.tstore
// CHECK: pto.set_flag[<PIPE_MTE3>, <PIPE_MTE2>, <EVENT_ID0>]
// CHECK: pto.wait_flag[<PIPE_MTE3>, <PIPE_MTE2>, <EVENT_ID0>]
// CHECK: pto.tload
