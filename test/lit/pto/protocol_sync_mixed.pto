// RUN: not ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --protocol-sync-mixed --protocol-sync-fallback=fail \
// RUN:   --protocol-sync-dump=plan --protocol-sync-statistics \
// RUN:   %s -o /dev/null 2> %t.plan
// RUN: FileCheck %s --input-file=%t.plan --check-prefix=MIXED-FAIL
// RUN: ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --protocol-sync-mixed --protocol-sync-fallback=fail \
// RUN:   --protocol-sync-dump=plan --protocol-sync-statistics \
// RUN:   %S/protocol_sync_one_shot.pto \
// RUN:   -o /dev/null 2> %t.one-shot
// RUN: FileCheck %s --input-file=%t.one-shot --check-prefix=ONE-SHOT
// RUN: ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --protocol-sync-mixed --protocol-sync-fallback=fail \
// RUN:   --protocol-sync-dump=plan %S/protocol_sync_direct_repair.pto \
// RUN:   -o /dev/null 2> %t.direct
// RUN: FileCheck %s --input-file=%t.direct --check-prefix=DIRECT
// RUN: not ptoas --pto-level=level2 --emit-pto-ir --protocol-sync-mixed \
// RUN:   %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=IMPLICIT
// RUN: not ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --enable-insert-sync --protocol-sync-mixed %s -o /dev/null 2>&1 | \
// RUN:   FileCheck %s --check-prefix=MUTEX

module attributes {pto.target_arch = "a3"} {
  func.func @ready_release_with_direct_tail(
      %input : !pto.partition_tensor_view<16x16xf16>,
      %output : !pto.partition_tensor_view<16x16xf16>,
      %flat_input : !pto.partition_tensor_view<16x16xf16>,
      %flat_output : !pto.partition_tensor_view<16x16xf16>,
      %trip_count : index)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    %flat_tile = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%flat_input : !pto.partition_tensor_view<16x16xf16>)
              outs(%flat_tile : !pto.tile_buf<vec, 16x16xf16>)
    pto.tstore ins(%flat_tile : !pto.tile_buf<vec, 16x16xf16>)
               outs(%flat_output : !pto.partition_tensor_view<16x16xf16>)
    scf.for %index = %c0 to %trip_count step %c1 {
      pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>)
                outs(%tile : !pto.tile_buf<vec, 16x16xf16>)
      pto.tstore ins(%tile : !pto.tile_buf<vec, 16x16xf16>)
                 outs(%output : !pto.partition_tensor_view<16x16xf16>)
    }
    return
  }
}

// MIXED-FAIL: PROTOCOL-SYNC mixed-plan function=@ready_release_with_direct_tail status=unsupported
// MIXED-FAIL: ProtocolSync mixed mode found no complete supported plan

// ONE-SHOT: PROTOCOL-SYNC mixed-plan function=@linear_one_shot status=ready world=one-shot-publish
// ONE-SHOT-SAME: initial-residuals=3 direct-candidates=1 candidates-before-deletion=4 reverse-attempts=4 reverse-removed=0 worlds-attempted=6 worlds-feasible=6 event-pairs=2 targeted-barriers=1 fixed-exit-drains=1
// ONE-SHOT: one-shot-publish #0 kind=directed-event phases=#0->#1 channels=[#0]
// ONE-SHOT: one-shot-publish #1 kind=pipe-barrier phases=#1->#2 channels=[#1]
// ONE-SHOT: one-shot-publish #2 kind=directed-event phases=#2->#3 channels=[#2]
// ONE-SHOT: "complete_worlds_attempted":6
// ONE-SHOT-SAME: "complete_worlds_feasible":6
// ONE-SHOT: "selected_world_event_pairs":2
// ONE-SHOT-SAME: "selected_world_fixed_exit_drains":1
// ONE-SHOT-SAME: "selected_world_targeted_barriers":1

// DIRECT: PROTOCOL-SYNC mixed-plan function=@guarded_direct status=ready world=direct-only
// DIRECT-SAME: direct-candidates=3 candidates-before-deletion=4 reverse-attempts=4 reverse-removed=1 worlds-attempted=1 worlds-feasible=1 event-pairs=2 targeted-barriers=0 fixed-exit-drains=1

// IMPLICIT: --protocol-sync-mixed requires an explicit --pto-arch=a3
// MUTEX: --enable-insert-sync
// MUTEX-SAME: --protocol-sync-mixed
// MUTEX-SAME: mutually exclusive
