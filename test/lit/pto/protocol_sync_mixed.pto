// RUN: ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --protocol-sync-mixed --protocol-sync-fallback=fail \
// RUN:   --protocol-sync-dump=plan --protocol-sync-statistics \
// RUN:   %s -o %t.ir 2> %t.plan
// RUN: FileCheck %s --input-file=%t.ir --check-prefix=IR
// RUN: FileCheck %s --input-file=%t.plan --check-prefix=PLAN
// RUN: ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --protocol-sync-mixed --protocol-sync-fallback=fail \
// RUN:   --protocol-sync-dump=residuals %s -o %t.cli.ir 2> %t.cli.log
// RUN: FileCheck %s --input-file=%t.cli.ir --check-prefix=IR
// RUN: FileCheck %s --input-file=%t.cli.log --check-prefix=WORLD
// RUN: ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --protocol-sync-mixed --protocol-sync-fallback=fail \
// RUN:   --protocol-sync-dump=plan %S/protocol_sync_one_shot.pto \
// RUN:   -o /dev/null 2> %t.one-shot
// RUN: FileCheck %s --input-file=%t.one-shot --check-prefix=ONE-SHOT
// RUN: ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --protocol-sync-mixed --protocol-sync-fallback=fail \
// RUN:   --protocol-sync-dump=plan %S/protocol_sync_direct_repair.pto \
// RUN:   -o /dev/null 2> %t.direct
// RUN: FileCheck %s --input-file=%t.direct --check-prefix=DIRECT
// RUN: not ptoas --pto-level=level2 --emit-pto-ir --protocol-sync-mixed \
// RUN:   %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=IMPLICIT
// RUN: not ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir \
// RUN:   --enable-insert-sync --protocol-sync-mixed %s -o /dev/null 2>&1 | \
// RUN:   FileCheck %s --check-prefix=MUTEX

module attributes {pto.target_arch = "a3"} {
  func.func @ready_release_with_direct_tail(
      %input : !pto.partition_tensor_view<16x16xf16>,
      %output : !pto.partition_tensor_view<16x16xf16>,
      %flat_input : !pto.partition_tensor_view<16x16xf16>,
      %flat_output : !pto.partition_tensor_view<16x16xf16>,
      %trip_count : index)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    %flat_tile = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%flat_input : !pto.partition_tensor_view<16x16xf16>)
              outs(%flat_tile : !pto.tile_buf<vec, 16x16xf16>)
    pto.tstore ins(%flat_tile : !pto.tile_buf<vec, 16x16xf16>)
               outs(%flat_output : !pto.partition_tensor_view<16x16xf16>)
    scf.for %index = %c0 to %trip_count step %c1 {
      pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>)
                outs(%tile : !pto.tile_buf<vec, 16x16xf16>)
      pto.tstore ins(%tile : !pto.tile_buf<vec, 16x16xf16>)
                 outs(%output : !pto.partition_tensor_view<16x16xf16>)
    }
    return
  }
}

// PLAN: PROTOCOL-SYNC mixed-plan function=@ready_release_with_direct_tail status=ready protocol=ready-release
// PLAN-SAME: initial-residuals=3 direct-candidates=2 candidates-before-deletion=3 reverse-attempts=3 reverse-removed=0
// PLAN: PROTOCOL-SYNC ready-release-plan function=@ready_release_with_direct_tail status=ready
// PLAN: PROTOCOL-SYNC direct-repair function=@ready_release_with_direct_tail status=ready obligations=3 candidates=2 uncovered=0
// PLAN: candidate #0 kind=directed-event
// PLAN-SAME: event=1
// PLAN: candidate #1 kind=exit-barrier
// PLAN: "mixed_selection_candidates":3
// PLAN-SAME: "reverse_deletion_attempts":3
// PLAN-SAME: "reverse_deletion_removed":0
// PLAN-SAME: "selected_direct_repairs":2
// PLAN-SAME: "selected_ready_release_protocols":1
// PLAN: "planner_result":"materialized-mixed"
// PLAN-SAME: "producer":"protocol-plus-direct-residuals"

// WORLD: PROTOCOL-SYNC selected-world function=@ready_release_with_direct_tail status=complete
// WORLD-SAME: protocols=1 completions=3 visibility=0 exit-completions=4 obligations=0

// ONE-SHOT: PROTOCOL-SYNC mixed-plan function=@linear_one_shot status=ready protocol=one-shot
// ONE-SHOT-SAME: initial-residuals=0 direct-candidates=0 candidates-before-deletion=1 reverse-attempts=1 reverse-removed=0

// DIRECT: PROTOCOL-SYNC mixed-plan function=@guarded_direct status=ready protocol=none
// DIRECT-SAME: direct-candidates=3 candidates-before-deletion=3 reverse-attempts=3 reverse-removed=0

// IR-LABEL: func.func @ready_release_with_direct_tail
// IR: pto.tload
// IR-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_MTE3>, <EVENT_ID1>]
// IR-NEXT: pto.wait_flag[<PIPE_MTE2>, <PIPE_MTE3>, <EVENT_ID1>]
// IR-NEXT: pto.tstore
// IR: pto.set_flag[<PIPE_MTE3>, <PIPE_MTE2>, <EVENT_ID0>]
// IR-NEXT: scf.for
// IR: pto.wait_flag[<PIPE_MTE3>, <PIPE_MTE2>, <EVENT_ID0>]
// IR-NEXT: pto.tload
// IR-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_MTE3>, <EVENT_ID0>]
// IR-NEXT: pto.wait_flag[<PIPE_MTE2>, <PIPE_MTE3>, <EVENT_ID0>]
// IR-NEXT: pto.tstore
// IR-NEXT: pto.set_flag[<PIPE_MTE3>, <PIPE_MTE2>, <EVENT_ID0>]
// IR: pto.wait_flag[<PIPE_MTE3>, <PIPE_MTE2>, <EVENT_ID0>]
// IR-NEXT: pto.barrier <PIPE_ALL>
// IR-NEXT: return

// IMPLICIT: --protocol-sync-mixed requires an explicit --pto-arch=a3
// MUTEX: --enable-insert-sync
// MUTEX-SAME: --protocol-sync-mixed
// MUTEX-SAME: mutually exclusive
