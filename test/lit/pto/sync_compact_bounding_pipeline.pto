// RUN: pto-sync-input-test --compact-bounding-pipeline-checks %s
!tile = !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module {
  func.func @readonly_balanced(%n: index) attributes {test.compact_direct, test.no_notifications} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %zero = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %zero : !tile
    scf.for %i = %c0 to %n step %c1 {
      %r = arith.remui %i, %c2 : index
      %even = arith.cmpi eq, %r, %c0 : index
      scf.if %even {
        %a = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32 {test.label = "R_then"}
      } else {
        %b = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32 {test.label = "R_else"}
      }
    }
    return
  }
  func.func @unknown_address(%n: index, %address: i64) attributes {test.expect_compact_dispatch} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %one = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %address : !tile
    scf.for %i = %c0 to %n step %c1 {
      pto.texpands ins(%one : f32) outs(%tile : !tile) {test.label = "W"}
      %v = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32 {test.label = "R"}
    }
    return
  }
  func.func @exact_route_priority(%n: index) attributes {test.exact_priority} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %zero : !tile
    scf.for %i = %c0 to %n step %c1 {
      pto.texpands ins(%one : f32) outs(%tile : !tile) {test.label = "W"}
      %v = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32 {test.label = "R"}
    }
    return
  }
  func.func @balanced_future_arms(%n: index) attributes {test.compact_direct} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %zero : !tile
    scf.for %i = %c0 to %n step %c1 {
      %r = arith.remui %i, %c2 : index
      %even = arith.cmpi eq, %r, %c0 : index
      scf.if %even {
        pto.texpands ins(%one : f32) outs(%tile : !tile) {test.label = "W_then"}
        %a = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32 {test.label = "R_then"}
      } else {
        pto.texpands ins(%one : f32) outs(%tile : !tile) {test.label = "W_else"}
        %b = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32 {test.label = "R_else"}
      }
    }
    return
  }
  // Current uniform lane proof cannot establish symbolic guarded extrema equality.
  // All logical/storage checks still apply; this is an export gap, not scarcity.
  func.func @nested_uniform(%m: index, %n: index)
      attributes {test.compact_direct, test.missing_allocation_export} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %zero : !tile
    scf.for %i = %c0 to %m step %c1 {
      %before = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32 {test.label = "R_before"}
      scf.for %j = %c0 to %n step %c1 {
        pto.texpands ins(%one : f32) outs(%tile : !tile) {test.label = "W_inner"}
        %inside = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32 {test.label = "R_inner"}
      }
    }
    return
  }
  func.func @nested_numeric_inner(%m: index) attributes {test.compact_direct} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %zero : !tile
    scf.for %i = %c0 to %m step %c1 {
      %before = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32 {test.label = "R_before"}
      scf.for %j = %c0 to %c2 step %c1 {
        pto.texpands ins(%one : f32) outs(%tile : !tile) {test.label = "W_inner"}
        %inside = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32 {test.label = "R_inner"}
      }
    }
    return
  }
  func.func @finite_loop_sequence(%n: index) attributes {test.compact_direct} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %zero : !tile
    pto.texpands ins(%one : f32) outs(%tile : !tile) {test.label = "W_entry"}
    scf.for %i = %c0 to %n step %c1 {
      %inside = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32 {test.label = "R_loop"}
      pto.texpands ins(%one : f32) outs(%tile : !tile) {test.label = "W_loop"}
    }
    %after = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32 {test.label = "R_exit"}
    return
  }
  // Exact guarded demands exist, but the source cut cannot evaluate the later
  // division. Keep that result and consume skipped notifications at return.
  func.func @late_guard(%n: index, %d: index) attributes {test.late_guard} {
    %c0 = arith.constant 0 : index
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %tile = pto.alloc_tile addr = %zero : !tile
    pto.texpands ins(%one : f32) outs(%tile : !tile)
    %q = arith.divsi %n, %d : index
    %g = arith.cmpi sge, %q, %c0 : index
    scf.if %g {
      %v = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
    }
    return
  }
  // The prefill tail expression, with the unsigned trip computation supplied
  // independently by the checker. Negative lengths exercise signed wrap cuts.
  func.func @machine_tail(%length: index, %trips: index) attributes {test.machine_boundary} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %zero = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %zero : !tile
    scf.for %i = %c0 to %trips step %c1 {
      %offset = arith.muli %i, %c4 : index
      %remaining = arith.subi %length, %offset : index
      %slt = arith.cmpi slt, %remaining, %c1 : index
      scf.if %slt {
        %r_slt = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %sle = arith.cmpi sle, %remaining, %c1 : index
      scf.if %sle {
        %r_sle = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %sge = arith.cmpi sge, %remaining, %c1 : index
      scf.if %sge {
        %r_sge = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %sgt = arith.cmpi sgt, %remaining, %c1 : index
      scf.if %sgt {
        %r_sgt = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %eq = arith.cmpi eq, %remaining, %c1 : index
      scf.if %eq {
        %r_eq = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %ne = arith.cmpi ne, %remaining, %c1 : index
      scf.if %ne {
        %r_ne = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
    }
    return
  }
  func.func @machine_positive_stride(%length: index, %trips: index) attributes {test.machine_boundary} {
    %readIndex = arith.constant 0 : index
    %c0 = arith.constant -3 : index
    %c1 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %zero = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %zero : !tile
    scf.for %i = %c0 to %trips step %c1 {
      %offset = arith.muli %i, %c4 : index
      %remaining = arith.addi %length, %offset : index
      %slt = arith.cmpi slt, %remaining, %c1 : index
      scf.if %slt {
        %r_slt = pto.tgetval ins(%tile, %readIndex : !tile, index) outs : f32
      }
      %sle = arith.cmpi sle, %remaining, %c1 : index
      scf.if %sle {
        %r_sle = pto.tgetval ins(%tile, %readIndex : !tile, index) outs : f32
      }
      %sge = arith.cmpi sge, %remaining, %c1 : index
      scf.if %sge {
        %r_sge = pto.tgetval ins(%tile, %readIndex : !tile, index) outs : f32
      }
      %sgt = arith.cmpi sgt, %remaining, %c1 : index
      scf.if %sgt {
        %r_sgt = pto.tgetval ins(%tile, %readIndex : !tile, index) outs : f32
      }
      %eq = arith.cmpi eq, %remaining, %c1 : index
      scf.if %eq {
        %r_eq = pto.tgetval ins(%tile, %readIndex : !tile, index) outs : f32
      }
      %ne = arith.cmpi ne, %remaining, %c1 : index
      scf.if %ne {
        %r_ne = pto.tgetval ins(%tile, %readIndex : !tile, index) outs : f32
      }
    }
    return
  }
  func.func @machine_minimum(%length: index, %trips: index) attributes {test.machine_boundary} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %bound = arith.constant -9223372036854775808 : index
    %c4 = arith.constant 4 : index
    %zero = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %zero : !tile
    scf.for %i = %c0 to %trips step %c1 {
      %offset = arith.muli %i, %c4 : index
      %remaining = arith.subi %length, %offset : index
      %slt = arith.cmpi slt, %remaining, %bound : index
      scf.if %slt {
        %r_slt = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %sle = arith.cmpi sle, %remaining, %bound : index
      scf.if %sle {
        %r_sle = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %sge = arith.cmpi sge, %remaining, %bound : index
      scf.if %sge {
        %r_sge = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %sgt = arith.cmpi sgt, %remaining, %bound : index
      scf.if %sgt {
        %r_sgt = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %eq = arith.cmpi eq, %remaining, %bound : index
      scf.if %eq {
        %r_eq = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %ne = arith.cmpi ne, %remaining, %bound : index
      scf.if %ne {
        %r_ne = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
    }
    return
  }
  func.func @machine_maximum(%length: index, %trips: index) attributes {test.machine_boundary} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %bound = arith.constant 9223372036854775807 : index
    %c4 = arith.constant 4 : index
    %zero = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %zero : !tile
    scf.for %i = %c0 to %trips step %c1 {
      %offset = arith.muli %i, %c4 : index
      %remaining = arith.subi %length, %offset : index
      %slt = arith.cmpi slt, %remaining, %bound : index
      scf.if %slt {
        %r_slt = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %sle = arith.cmpi sle, %remaining, %bound : index
      scf.if %sle {
        %r_sle = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %sge = arith.cmpi sge, %remaining, %bound : index
      scf.if %sge {
        %r_sge = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %sgt = arith.cmpi sgt, %remaining, %bound : index
      scf.if %sgt {
        %r_sgt = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %eq = arith.cmpi eq, %remaining, %bound : index
      scf.if %eq {
        %r_eq = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %ne = arith.cmpi ne, %remaining, %bound : index
      scf.if %ne {
        %r_ne = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
    }
    return
  }
  func.func @machine_folded_coefficients(%length: index, %trips: index) attributes {test.machine_boundary} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %zero = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %zero : !tile
    scf.for %i = %c0 to %trips step %c1 {
      %offset = arith.muli %i, %c4 : index
      %factor = arith.constant 4294967296 : index
      %wide1 = arith.muli %i, %factor : index
      %wide2 = arith.muli %wide1, %factor : index
      %wide3 = arith.muli %wide2, %factor : index
      %combined = arith.addi %offset, %wide3 : index
      %remaining = arith.subi %length, %combined : index
      %slt = arith.cmpi slt, %remaining, %c1 : index
      scf.if %slt {
        %r_slt = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %sle = arith.cmpi sle, %remaining, %c1 : index
      scf.if %sle {
        %r_sle = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %sge = arith.cmpi sge, %remaining, %c1 : index
      scf.if %sge {
        %r_sge = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %sgt = arith.cmpi sgt, %remaining, %c1 : index
      scf.if %sgt {
        %r_sgt = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %eq = arith.cmpi eq, %remaining, %c1 : index
      scf.if %eq {
        %r_eq = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
      %ne = arith.cmpi ne, %remaining, %c1 : index
      scf.if %ne {
        %r_ne = pto.tgetval ins(%tile, %c0 : !tile, index) outs : f32
      }
    }
    return
  }
}
