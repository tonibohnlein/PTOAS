// The two branch-local events are analyzed independently. Each singleton world
// covers only its own guarded demand, so the set-cover plan must select both.
// The bottom-up summary, flat scoreboard, and structured oracle agree for each
// singleton; no synthetic choice-group column is introduced.
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-dump --emit-pto-ir %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @choice_must_summary(
      %condition: i1, %src: !pto.partition_tensor_view<16x128xf32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %input0_addr = arith.constant 0 : i64
    %output0_addr = arith.constant 8192 : i64
    %input1_addr = arith.constant 16384 : i64
    %output1_addr = arith.constant 24576 : i64
    %one = arith.constant 1.000000e+00 : f32
    %input0 = pto.alloc_tile addr = %input0_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %output0 = pto.alloc_tile addr = %output0_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %input1 = pto.alloc_tile addr = %input1_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %output1 = pto.alloc_tile addr = %output1_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    scf.if %condition {
      pto.tload ins(%src : !pto.partition_tensor_view<16x128xf32>)
                outs(%input0 : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
      pto.tmuls ins(%input0, %one : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%output0 : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
    } else {
      pto.tload ins(%src : !pto.partition_tensor_view<16x128xf32>)
                outs(%input1 : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
      pto.tmuls ins(%input1, %one : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%output1 : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
                       cols=128, v_row=16, v_col=128, blayout=row_major,
                       slayout=none_box, fractal=512, pad=0>)
    }
    return
  }
}

// CHECK-LABEL: CANONICAL-SYNC function=choice_must_summary
// CHECK: m0 kind=event resource=AIV:PIPE_MTE2->AIV:PIPE_V
// CHECK: m1 kind=event resource=AIV:PIPE_MTE2->AIV:PIPE_V
// CHECK: world=singleton-m0
// CHECK-SAME: covered=[d0]
// CHECK-SAME: oracle=match
// CHECK: world=singleton-m1
// CHECK-SAME: covered=[d1]
// CHECK-SAME: oracle=match
// CHECK-NOT: world=choice-group
// CHECK: PLAN selected=[m0, m1, m2]
// CHECK: VERIFY ok
