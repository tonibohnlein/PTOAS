// RUN: pto-sync-input-test --gm-alias=may-not-alias --structured-trace %s > %t.trace
// RUN: %python -c "import sys; sys.path.insert(0, r'%S/Inputs'); import json; from check_finite_allocation import physical_check; physical_check(json.load(open(r'%t.trace')), set(range(6)))"
// RUN: pto-sync-input-test --allocation-session-checks %s | FileCheck %s --check-prefix=SESSION
// RUN: pto-test-opt --mlir-disable-threading --pto-frontier-analysis=gm-alias=may-not-alias %s > %t.logical
// RUN: FileCheck %s --check-prefix=LOGICAL < %t.logical
// RUN: pto-test-opt --mlir-disable-threading --pto-frontier-allocate=eligible-ids=0,1,2,3,4,5 %t.logical > %t.physical
// RUN: FileCheck %s --check-prefix=PHYSICAL < %t.physical
// The first M-pipe operation is conditional on the ORIGINAL IV equaling 11.
// Its presence at ordinal zero certifies the regional lifetime boundary even
// though no individually unconditional M operation precedes the else branch.
// Footprints use IV-11, preserving the 256-step original-coordinate mapping.
// SESSION: bounded regional allocation: session recipe consumed, cached export
// SESSION: allocation-session: sequence available=1 retained-demands cached-export
// LOGICAL: pto.finite_allocation
// LOGICAL-SAME: strategy = "regional-palettes"
// LOGICAL: pto.logical_
// PHYSICAL-NOT: pto.logical_
// PHYSICAL: pto.set_flag
// PHYSICAL: pto.wait_flag
// PHYSICAL-NOT: pto.logical_
module attributes {pto.backend = "emitc", pto.kernel_kind = #pto.kernel_kind<cube>, pto.target_arch = "a5"} {
  func.func @bounded_boundary_presence(%arg0: !pto.ptr<i8, gm>, %arg1: !pto.ptr<i8, gm>, %arg2: !pto.ptr<i32, gm>, %arg3: !pto.ptr<i8, gm>, %arg4: !pto.ptr<i8, gm>, %arg5: !pto.ptr<i32, gm>, %arg6: index, %arg7: index, %arg8: i32, %arg9: i32) attributes {pto.kernel_kind = #pto.kernel_kind<cube>, test.require_bounded_regional_allocation, test.trace_arguments = array<i64: 1, 1, 0, 0>, test.eligible_ids = array<i64: 0, 1, 2, 3, 4, 5>} {
    %c0_i64 = arith.constant 0 : i64
    %c196608_i64 = arith.constant 196608 : i64
    %c8192_i64 = arith.constant 8192 : i64
    %c32768_i64 = arith.constant 32768 : i64
    %c131072_i64 = arith.constant 131072 : i64
    %c163840_i64 = arith.constant 163840 : i64
    %c16384_i64 = arith.constant 16384 : i64
    %c24576_i64 = arith.constant 24576 : i64
    %c4096 = arith.constant 4096 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %c256 = arith.constant 256 : index
    %c512 = arith.constant 512 : index
    %c11 = arith.constant 11 : index
    %c523 = arith.constant 523 : index
    %c0 = arith.constant 0 : index
    %c128 = arith.constant 128 : index
    %c3584 = arith.constant 3584 : index
    %c1024 = arith.constant 1024 : index
    %c4 = arith.constant 4 : index
    %c64 = arith.constant 64 : index
    %0 = pto.make_tensor_view %arg0, shape = [%arg6, %c4096], strides = [%c4096, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xi8>
    %1 = pto.make_tensor_view %arg1, shape = [%c4096, %c4096], strides = [%c4096, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xi8>
    %2 = pto.make_tensor_view %arg2, shape = [%arg6, %c4096], strides = [%c4096, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xi32>
    %3 = pto.make_tensor_view %arg3, shape = [%c4096, %c4096], strides = [%c4096, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xi8>
    %4 = pto.make_tensor_view %arg4, shape = [%arg7, %c4096], strides = [%c4096, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xi8>
    %5 = pto.make_tensor_view %arg5, shape = [%arg7, %c4096], strides = [%c4096, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xi32>
    %6 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c256 : !pto.tile_buf<acc, 16x256xi32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
    %7 = pto.alloc_tile addr = %c0_i64 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<acc, 64x256xi32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
    %8 = arith.index_cast %arg8 : i32 to index
    %9 = arith.divsi %8, %c16 : index
    %10 = arith.muli %9, %c16 : index
    %11 = arith.remsi %8, %c16 : index
    %12 = arith.muli %11, %c256 : index
    %13 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c512 : !pto.tile_buf<mat, 16x512xi8, valid=?x?, blayout=col_major, slayout=row_major>
    %14 = arith.maxsi %10, %c0 : index
    %15 = pto.partition_view %0, offsets = [%14, %c0], sizes = [%c16, %c512] : !pto.tensor_view<?x?xi8>
    pto.tload ins(%15 : !pto.partition_tensor_view<16x512xi8>) outs(%13 : !pto.tile_buf<mat, 16x512xi8, valid=?x?, blayout=col_major, slayout=row_major>) {layout = #pto.layout<nd>}
    %16 = pto.alloc_tile addr = %c196608_i64 valid_row = %c256 valid_col = %c512 : !pto.tile_buf<mat, 256x512xi8, valid=?x?, blayout=col_major, slayout=row_major>
    %17 = arith.maxsi %12, %c0 : index
    %18 = pto.partition_view %1, offsets = [%17, %c0], sizes = [%c256, %c512] : !pto.tensor_view<?x?xi8>
    pto.tload ins(%18 : !pto.partition_tensor_view<256x512xi8>) outs(%16 : !pto.tile_buf<mat, 256x512xi8, valid=?x?, blayout=col_major, slayout=row_major>) {layout = #pto.layout<nd>}
    %19 = pto.alloc_tile addr = %c196608_i64 valid_row = %c512 valid_col = %c256 : !pto.tile_buf<mat, 512x256xi8, valid=?x?, slayout=col_major>
    %20 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c256 : !pto.tile_buf<acc, 16x256xi32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
    scf.for %arg10 = %c11 to %c523 step %c256 {
      %column = arith.subi %arg10, %c11 : index
      %52 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c128 : !pto.tile_buf<left, 16x128xi8, valid=?x?, blayout=col_major, slayout=row_major>
      pto.textract ins(%13, %c0, %column : !pto.tile_buf<mat, 16x512xi8, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%52 : !pto.tile_buf<left, 16x128xi8, valid=?x?, blayout=col_major, slayout=row_major>)
      %53 = pto.alloc_tile addr = %c0_i64 valid_row = %c128 valid_col = %c256 : !pto.tile_buf<right, 128x256xi8, valid=?x?, slayout=col_major>
      pto.textract ins(%19, %column, %c0 : !pto.tile_buf<mat, 512x256xi8, valid=?x?, slayout=col_major>, index, index) outs(%53 : !pto.tile_buf<right, 128x256xi8, valid=?x?, slayout=col_major>)
      %54 = pto.alloc_tile addr = %c8192_i64 valid_row = %c16 valid_col = %c128 : !pto.tile_buf<left, 16x128xi8, valid=?x?, blayout=col_major, slayout=row_major>
      %55 = arith.addi %column, %c128 : index
      pto.textract ins(%13, %c0, %55 : !pto.tile_buf<mat, 16x512xi8, valid=?x?, blayout=col_major, slayout=row_major>, index, index) outs(%54 : !pto.tile_buf<left, 16x128xi8, valid=?x?, blayout=col_major, slayout=row_major>)
      %56 = pto.alloc_tile addr = %c32768_i64 valid_row = %c128 valid_col = %c256 : !pto.tile_buf<right, 128x256xi8, valid=?x?, slayout=col_major>
      %57 = arith.addi %column, %c128 : index
      pto.textract ins(%19, %57, %c0 : !pto.tile_buf<mat, 512x256xi8, valid=?x?, slayout=col_major>, index, index) outs(%56 : !pto.tile_buf<right, 128x256xi8, valid=?x?, slayout=col_major>)
      %58 = arith.cmpi eq, %arg10, %c11 : index
      scf.if %58 {
        %60 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c256 : !pto.tile_buf<acc, 16x256xi32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
        pto.tmatmul ins(%52, %53 : !pto.tile_buf<left, 16x128xi8, valid=?x?, blayout=col_major, slayout=row_major>, !pto.tile_buf<right, 128x256xi8, valid=?x?, slayout=col_major>) outs(%60 : !pto.tile_buf<acc, 16x256xi32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>)
      } else {
        %60 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c256 : !pto.tile_buf<acc, 16x256xi32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
        pto.tmatmul.acc ins(%60, %52, %53 : !pto.tile_buf<acc, 16x256xi32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 16x128xi8, valid=?x?, blayout=col_major, slayout=row_major>, !pto.tile_buf<right, 128x256xi8, valid=?x?, slayout=col_major>) outs(%60 : !pto.tile_buf<acc, 16x256xi32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>)
      }
      %59 = pto.alloc_tile addr = %c0_i64 valid_row = %c16 valid_col = %c256 : !pto.tile_buf<acc, 16x256xi32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
      pto.tmatmul.acc ins(%59, %54, %56 : !pto.tile_buf<acc, 16x256xi32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 16x128xi8, valid=?x?, blayout=col_major, slayout=row_major>, !pto.tile_buf<right, 128x256xi8, valid=?x?, slayout=col_major>) outs(%59 : !pto.tile_buf<acc, 16x256xi32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>)
    }
    %out = pto.partition_view %2, offsets = [%14, %c0], sizes = [%c16, %c256] : !pto.tensor_view<?x?xi32>
    pto.tstore ins(%20 : !pto.tile_buf<acc, 16x256xi32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>) outs(%out : !pto.partition_tensor_view<16x256xi32>) {layout = #pto.layout<nd>}
    return
  }
}
