// RUN: %python %S/Inputs/check_logical_insertion.py pto-sync-input-test %s
// A generic reused tile, two pipes, nested counted coordinates and a selected arm.
// Runtime outer bounds deliberately use a nonzero lower bound and nonunit step.
!tile = !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major>
!left = !pto.tile_buf<left, 16x16xf16, slayout=row_major>
module attributes {pto.target_arch = "a3"} {
  func.func @nested_transfer(%a: !pto.ptr<f16, gm>, %n: index) attributes {test.trace_arguments = array<i64: 8>} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %five = arith.constant 5 : index
    %sixteen = arith.constant 16 : index
    %lower = arith.constant 1 : index
    %view = pto.make_tensor_view %a, shape = [%sixteen, %sixteen], strides = [%sixteen, %one] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf16>
    %part = pto.partition_view %view, offsets = [%zero, %zero], sizes = [%sixteen, %sixteen] : !pto.tensor_view<?x?xf16>
    %tile = pto.alloc_tile addr = %base : !tile
    %left = pto.alloc_tile addr = %base : !left
    scf.for %t = %lower to %n step %two {
      scf.for %k = %one to %five step %two {
        pto.tload ins(%part : !pto.partition_tensor_view<16x16xf16>) outs(%tile : !tile)
        pto.textract ins(%tile, %zero, %zero : !tile, index, index) outs(%left : !left)
        %first = arith.cmpi eq, %k, %one : index
        scf.if %first {
          pto.textract ins(%tile, %zero, %zero : !tile, index, index) outs(%left : !left)
        }
      }
    }
    return
  }
}
