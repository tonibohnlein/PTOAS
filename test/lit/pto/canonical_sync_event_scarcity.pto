// RUN: not pto-test-opt %s \
// RUN:   '-pto-canonical-sync=event-id-num-max=1' 2>&1 \
// RUN:   | FileCheck %s
// RUN: not pto-test-opt %s \
// RUN:   '-pto-canonical-sync=event-id-num-max=0' 2>&1 \
// RUN:   | FileCheck %s --check-prefix=ZERO
// RUN: pto-test-opt %s '-pto-canonical-sync=event-id-num-max=8' \
// RUN:   | FileCheck %s --check-prefix=EIGHT
// RUN: not pto-test-opt %s \
// RUN:   '-pto-canonical-sync=event-id-num-max=9' 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NINE

module attributes {pto.target_arch = "a2a3"} {
  func.func @two_live_events(
      %src0: !pto.partition_tensor_view<16x128xf32>,
      %src1: !pto.partition_tensor_view<16x128xf32>) {
    %addr0 = arith.constant 0 : i64
    %addr8192 = arith.constant 8192 : i64
    %one = arith.constant 1.000000e+00 : f32
    %tile0 = pto.alloc_tile addr = %addr0 :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %tile1 = pto.alloc_tile addr = %addr8192 :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>

    pto.tload ins(%src0 : !pto.partition_tensor_view<16x128xf32>)
      outs(%tile0 : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tload ins(%src1 : !pto.partition_tensor_view<16x128xf32>)
      outs(%tile1 : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tmuls ins(%tile0, %one : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>, f32)
      outs(%tile0 : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tmuls ins(%tile1, %one : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>, f32)
      outs(%tile1 : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}

// CHECK: error: PTOCanonicalSync cannot allocate domain
// CHECK-SAME: 2 colors requested but only 1 event IDs are available
// CHECK-SAME: interval-domain color count is exact
// ZERO: error: event-id-num-max must be in [1, 8]
// EIGHT-LABEL: func.func @two_live_events
// EIGHT: pto.set_flag
// NINE: error: event-id-num-max must be in [1, 8]
