// RUN: pto-test-opt --pto-protocol-sync='execution-mode=one-shot fallback-mode=fail' %s | FileCheck %s
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --protocol-sync-one-shot \
// RUN:   --protocol-sync-fallback=fail %s -o - | FileCheck %s --check-prefix=CXX

module attributes {pto.target_arch = "a3"} {
  func.func @flat_vector(
      %input: !pto.partition_tensor_view<16x16xf16>,
      %output: !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %c512 = arith.constant 512 : i64
    %source = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    %result = pto.alloc_tile addr = %c512 : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>)
              outs(%source : !pto.tile_buf<vec, 16x16xf16>)
    pto.tabs ins(%source : !pto.tile_buf<vec, 16x16xf16>)
             outs(%result : !pto.tile_buf<vec, 16x16xf16>)
    pto.tstore ins(%result : !pto.tile_buf<vec, 16x16xf16>)
               outs(%output : !pto.partition_tensor_view<16x16xf16>)
    return
  }

  func.func @empty_vector_section() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    pto.section.vector {
      %c0 = arith.constant 0 : i64
    }
    return
  }

  func.func @vector_section(
      %input: !pto.partition_tensor_view<16x16xf16>,
      %output: !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    pto.section.vector {
      %c0 = arith.constant 0 : i64
      %c512 = arith.constant 512 : i64
      %source = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
      %result = pto.alloc_tile addr = %c512 : !pto.tile_buf<vec, 16x16xf16>
      pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>)
                outs(%source : !pto.tile_buf<vec, 16x16xf16>)
      pto.tabs ins(%source : !pto.tile_buf<vec, 16x16xf16>)
               outs(%result : !pto.tile_buf<vec, 16x16xf16>)
      pto.tstore ins(%result : !pto.tile_buf<vec, 16x16xf16>)
                 outs(%output : !pto.partition_tensor_view<16x16xf16>)
    }
    return
  }

  func.func @cube_section(
      %input: !pto.partition_tensor_view<16x16xf16>,
      %output: !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    pto.section.cube {
      %c0 = arith.constant 0 : i64
      %c512 = arith.constant 512 : i64
      %c1024 = arith.constant 1024 : i64
      %c1536 = arith.constant 1536 : i64
      %c2048 = arith.constant 2048 : i64
      %matA = pto.alloc_tile addr = %c0 : !pto.tile_buf<mat, 16x16xf16>
      %matB = pto.alloc_tile addr = %c512 : !pto.tile_buf<mat, 16x16xf16>
      %left = pto.alloc_tile addr = %c1024 : !pto.tile_buf<left, 16x16xf16>
      %right = pto.alloc_tile addr = %c1536 : !pto.tile_buf<right, 16x16xf16>
      %acc = pto.alloc_tile addr = %c2048 : !pto.tile_buf<acc, 16x16xf32>
      pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>)
                outs(%matA : !pto.tile_buf<mat, 16x16xf16>)
      pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>)
                outs(%matB : !pto.tile_buf<mat, 16x16xf16>)
      pto.tmov ins(%matA : !pto.tile_buf<mat, 16x16xf16>)
               outs(%left : !pto.tile_buf<left, 16x16xf16>)
      pto.tmov ins(%matB : !pto.tile_buf<mat, 16x16xf16>)
               outs(%right : !pto.tile_buf<right, 16x16xf16>)
      pto.tmatmul ins(%left, %right : !pto.tile_buf<left, 16x16xf16>,
                                          !pto.tile_buf<right, 16x16xf16>)
                   outs(%acc : !pto.tile_buf<acc, 16x16xf32>)
      pto.tstore ins(%acc : !pto.tile_buf<acc, 16x16xf32>)
                 outs(%output : !pto.partition_tensor_view<16x16xf16>)
    }
    return
  }
}

// CHECK-LABEL: func.func @flat_vector
// CHECK: pto.tstore
// CHECK-NEXT: pto.barrier <PIPE_ALL>
// CHECK-NEXT: return

// CHECK-LABEL: func.func @empty_vector_section
// CHECK: pto.section.vector {
// CHECK-NOT: pto.barrier
// CHECK: {{^ *}}}
// CHECK-NEXT: {{^ *}}return

// CHECK-LABEL: func.func @vector_section
// CHECK: pto.section.vector {
// CHECK: pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// CHECK: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// CHECK: pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
// CHECK: pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
// CHECK: pto.tstore
// CHECK-NEXT: pto.barrier <PIPE_ALL>
// CHECK-NEXT: {{^ *}}}
// CHECK-NEXT: {{^ *}}return

// CXX-LABEL: AICORE void flat_vector(
// CXX: TSTORE
// CXX-NEXT: #endif // __DAV_VEC__
// CXX: ptoas_auto_sync_tail(PTOAutoSyncTailMode::kBarrierAll);
// CXX-NEXT: return;

// CXX-LABEL: AICORE void empty_vector_section()
// CXX-NOT: ptoas_auto_sync_tail
// CXX: return;

// CXX-LABEL: AICORE void vector_section(
// CXX: set_flag(PIPE_MTE2, PIPE_V, EVENT_ID0);
// CXX: wait_flag(PIPE_MTE2, PIPE_V, EVENT_ID0);
// CXX: set_flag(PIPE_V, PIPE_MTE3, EVENT_ID0);
// CXX: wait_flag(PIPE_V, PIPE_MTE3, EVENT_ID0);
// CXX: TSTORE
// CXX-NEXT: ptoas_auto_sync_tail(PTOAutoSyncTailMode::kBarrierAll);
// CXX-NEXT: #endif // __DAV_VEC__

// CXX-LABEL: AICORE void cube_section(
// CXX: pipe_barrier(PIPE_MTE2);
// CXX: set_flag(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
// CXX: pipe_barrier(PIPE_MTE1);
// CXX: set_flag(PIPE_MTE1, PIPE_M, EVENT_ID0);
// CXX: set_flag(PIPE_M, PIPE_FIX, EVENT_ID0);
// CXX: TSTORE
// CXX-NEXT: ptoas_auto_sync_tail(PTOAutoSyncTailMode::kBarrierAll);
// CXX-NEXT: #endif // __DAV_CUBE__

// CHECK-LABEL: func.func @cube_section
// CHECK: pto.section.cube {
// CHECK: pto.barrier <PIPE_MTE2>
// CHECK: pto.set_flag[<PIPE_MTE2>, <PIPE_MTE1>, <EVENT_ID0>]
// CHECK: pto.wait_flag[<PIPE_MTE2>, <PIPE_MTE1>, <EVENT_ID0>]
// CHECK: pto.barrier <PIPE_MTE1>
// CHECK: pto.set_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID0>]
// CHECK: pto.wait_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID0>]
// CHECK: pto.set_flag[<PIPE_M>, <PIPE_FIX>, <EVENT_ID0>]
// CHECK: pto.wait_flag[<PIPE_M>, <PIPE_FIX>, <EVENT_ID0>]
// CHECK: pto.tstore
// CHECK-NEXT: pto.barrier <PIPE_ALL>
// CHECK-NEXT: {{^ *}}}
// CHECK-NEXT: {{^ *}}return
