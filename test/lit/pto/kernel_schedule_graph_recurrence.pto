// RUN: pto-test-opt %s '-pto-print-kernel-schedule-graph=format=text' | FileCheck %s
// RUN: pto-test-opt %s \
// RUN:   '-pto-print-canonical-sync-plan=format=text view=dependencies' \
// RUN:   | FileCheck %s --check-prefix=CANONICAL
// RUN: pto-test-opt %s \
// RUN:   '-pto-print-canonical-sync-plan=format=text view=covering' \
// RUN:   | FileCheck %s --check-prefix=COVERING

module {
  func.func @scalar_recurrence(%src: !pto.ptr<i32>, %dst: !pto.ptr<i32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %initial = pto.load_scalar %src[%c0] : !pto.ptr<i32> -> i32
    %result = scf.for %i = %c0 to %c4 step %c1
        iter_args(%carried = %initial) -> (i32) {
      pto.store_scalar %carried, %dst[%i] : !pto.ptr<i32>, i32
      %next = pto.load_scalar %src[%i] : !pto.ptr<i32> -> i32
      scf.yield %next : i32
    }
    pto.store_scalar %result, %dst[%c0] : !pto.ptr<i32>, i32
    return
  }

  func.func @nested_recurrence_owners() {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %factor = arith.constant 2.0 : f32
    %tile = pto.alloc_tile :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    scf.for %outer = %c0 to %c2 step %c1 {
      scf.for %inner = %c0 to %c2 step %c1 {
        pto.tmuls ins(%tile, %factor : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, f32)
          outs(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      }
    }
    return
  }
}

// CHECK-LABEL: KernelScheduleGraph @scalar_recurrence nodes=4
// CHECK: node[0] op=pto.load_scalar pipe=PIPE_S
// CHECK-NEXT: node[1] op=pto.store_scalar pipe=PIPE_S
// CHECK-NEXT: node[2] op=pto.load_scalar pipe=PIPE_S
// CHECK-NEXT: node[3] op=pto.store_scalar pipe=PIPE_S
// CHECK-DAG: edge 2 -> 1 kind=loop-carried-ssa distance=1
// CHECK-DAG: edge 1 -> 1 kind=memory-waw distance=1

// CHECK-LABEL: KernelScheduleGraph @nested_recurrence_owners nodes=1
// CHECK: node[0] op=pto.tmuls pipe=PIPE_V
// CHECK-DAG: edge 0 -> 0 kind=memory-waw distance=1 recurrence_loop_depth=1
// CHECK-DAG: edge 0 -> 0 kind=memory-waw distance=1 recurrence_loop_depth=2

// CANONICAL-LABEL: PTOCanonicalSyncPlan @scalar_recurrence
// CANONICAL: dependency 2 -> 1 kind=loop-carried-ssa distance=1
// CANONICAL-LABEL: PTOCanonicalSyncPlan @nested_recurrence_owners
// CANONICAL-DAG: dependency 0 -> 0 kind=memory-waw distance=1

// COVERING-LABEL: PTOCanonicalSyncPlan @scalar_recurrence
// COVERING: covering status=graph-ready scopes=3 controls=0 nodes=4
// COVERING-SAME: fixed-edges=10 recurrence-carries=4
// COVERING-SAME: conservative-demands=9 active-demands=9 intrinsic-demands=0
// COVERING: covering-scope[1] parent=0 must-execute=yes loop=yes
// COVERING: covering-node[1] resource=PIPE_S scope=2 order=2 guard=[]
// COVERING: covering-edge[0] 0 -> 1 kind=completion-supply scope=0 distance=0 origin=fixed
// COVERING: covering-edge[6] 0 -> 1 kind=completion-preserving-issue-order scope=0 distance=0 origin=fixed
// COVERING: covering-edge[10] 1 -> 1 kind=completion-supply scope=1 distance=1 origin=recurrence-carry
// COVERING: covering-demand[8] 2 -> 1 kind=ssa scope=1 distance=1 active=yes
// COVERING-LABEL: PTOCanonicalSyncPlan @nested_recurrence_owners
// COVERING: covering status=graph-ready scopes=5 controls=0 nodes=1
// COVERING-SAME: fixed-edges=0 recurrence-carries=2
// COVERING-SAME: conservative-demands=6 active-demands=6 intrinsic-demands=0
// COVERING: covering-scope[1] parent=0 must-execute=yes loop=yes
// COVERING: covering-scope[3] parent=2 must-execute=yes loop=yes
// COVERING: covering-node[0] resource=PIPE_V scope=4 order=2 guard=[]
// COVERING: covering-edge[0] 0 -> 0 kind=completion-preserving-issue-order scope=3 distance=1 origin=recurrence-carry
// COVERING: covering-edge[1] 0 -> 0 kind=completion-preserving-issue-order scope=1 distance=1 origin=recurrence-carry
// COVERING: covering-demand[0] 0 -> 0 kind=memory-raw scope=3 distance=1 active=yes
// COVERING: covering-demand[3] 0 -> 0 kind=memory-raw scope=1 distance=1 active=yes
