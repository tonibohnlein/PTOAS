// RUN: pto-sync-input-test --mixed-symbolic-checks %s
// RUN: %python %S/Inputs/check_mixed_symbolic_regions.py pto-sync-input-test %s
!mat = !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major>
!left = !pto.tile_buf<left, 16x16xf16, slayout=row_major>
!right = !pto.tile_buf<right, 16x16xf16, slayout=col_major>
!acc = !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>
!vec = !pto.tile_buf<vec, 1x8xf32>
!ring = !pto.multi_tile_buf<!pto.tile_buf<left, 16x16xf16, slayout=row_major>, count=2>
module attributes {pto.target_arch = "a3"} {
  func.func @mixed_owned_siblings(%n: index, %m: index, %p: !pto.ptr<f32, gm>) attributes {test.trace_arguments = array<i64: 2, 3>} {
    %base = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %length = arith.constant 3 : index
    %eight = arith.constant 8 : index
    %stride = arith.constant 16 : index
    %value = arith.constant 1.0 : f32
    %mat = pto.alloc_tile addr = %base : !mat
    %ring = pto.alloc_multi_tile addr = %base : !ring
    %right = pto.alloc_tile addr = %base : !right
    %acc = pto.alloc_tile addr = %base : !acc
    scf.for %visit = %zero to %n step %one {
      scf.for %i = %zero to %length step %one {
        %slot = arith.remui %i, %two : index
        %left = pto.multi_tile_get %ring[%slot] : !ring -> !left
        pto.textract ins(%mat, %zero, %zero : !mat, index, index) outs(%left : !left)
        pto.tmatmul ins(%left, %right : !left, !right) outs(%acc : !acc)
      }
      %offset = arith.muli %visit, %stride overflow<nsw> : index
      pto.store %value, %p[%offset] : !pto.ptr<f32, gm>, f32
    }
    %extent = arith.muli %n, %stride overflow<nsw> : index
    %view = pto.make_tensor_view %p, shape = [%one, %extent], strides = [%eight, %one] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf32>
    %tile = pto.alloc_tile addr = %base : !vec
    scf.for %read = %zero to %n step %one {
      %source = arith.muli %read, %stride overflow<nsw> : index
      %part = pto.partition_view %view, offsets = [%zero, %source], sizes = [%one, %eight] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
      pto.tload ins(%part : !pto.partition_tensor_view<1x8xf32>) outs(%tile : !vec) {layout = #pto.layout<nd>}
    }
    scf.for %write = %zero to %n step %one {
      %destination = arith.muli %write, %stride overflow<nsw> : index
      pto.store %value, %p[%destination] : !pto.ptr<f32, gm>, f32
    }
    return
  }
}
