// RUN: pto-sync-input-test --certify-regions %s | FileCheck %s
// RUN: pto-sync-input-test --gm-alias=may-alias --certify-regions %s | FileCheck %s
// CHECK: numeric-geometry-policy: both-orders separate-attempts physical-GM-coordinate alias-reset
// RUN: %python %S/Inputs/check_evolving_numeric_body.py pto-sync-input-test %s
// Period-two local banking coexists with an evolving, visit-owned GM store.
// The finite inner word computes a quadratic scalar index, which the numerical
// adapter evaluates at its actual inner coordinates. The original arithmetic
// class does not admit that index expression. Original GM maps remain retained
// for the mandatory joint storage proof. The oracle covers partial periods and
// explicitly refused unequal startup words whose symbolic crossing adapter is
// not implemented.
!cell = !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!ring = !pto.multi_tile_buf<!pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>, count=2>
module attributes {pto.target_arch = "a3"} {
  func.func @evolving_numeric_body(%n: index, %m: index, %dst: !pto.ptr<f32, gm>) attributes {test.specialized_numeric_requests, test.specialized_numeric_geometry_policy, test.trace_arguments = array<i64: 3, 2, 65536>} {
    %base = arith.constant 512 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %scalar = arith.constant 1.0 : f32
    %eight = arith.constant 8 : index
    %owned_stride = arith.constant 8192 : index
    %columns = arith.constant 1073741824 : index
    %inner_trips = arith.constant 2 : index
    %dv = pto.make_tensor_view %dst, shape = [%one, %columns], strides = [%columns, %one]
      {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf32>
    %ring = pto.alloc_multi_tile addr = %base : !ring
    scf.for %visit = %zero to %n step %one {
      %slot = arith.remui %visit, %two : index
      %selected = pto.multi_tile_get %ring[%slot] : !ring -> !cell
      %value = pto.tgetval ins(%selected, %zero : !cell, index) outs : f32 {test.label = "prologue"}
      scf.for %i = %zero to %inner_trips step %one {
        pto.tadds ins(%selected, %value : !cell, f32) outs(%selected : !cell) {test.label = "compute"}
        %read_index = arith.muli %i, %i : index
        %unused = pto.tgetval ins(%selected, %read_index : !cell, index) outs : f32 {test.label = "read"}
      }
      pto.tsetval ins(%zero, %value : index, f32) outs(%selected : !cell) {test.label = "epilogue"}
      %column = arith.muli %visit, %owned_stride overflow<nsw> : index
      %output = pto.partition_view %dv, offsets = [%zero, %column], sizes = [%one, %eight]
        : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
      pto.tstore ins(%selected : !cell) outs(%output : !pto.partition_tensor_view<1x8xf32>)
        {layout = #pto.layout<nd>, test.label = "owned"}
    }
    return
  }
}
