// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-dump --emit-pto-ir \
// RUN:   --mlir-print-ir-after=pto-canonical-sync %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @canonical_sync_loop_barrier()
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %first_addr = arith.constant 0 : i64
    %second_addr = arith.constant 8192 : i64
    %zero = arith.constant 0 : index
    %one_index = arith.constant 1 : index
    %two = arith.constant 2 : index
    %one = arith.constant 1.000000e+00 : f32
    %first = pto.alloc_tile addr = %first_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %second = pto.alloc_tile addr = %second_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    scf.for %iteration = %zero to %two step %one_index {
      pto.tmuls ins(%first, %one : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%second : !pto.tile_buf<loc=vec, dtype=f32,
                       rows=16, cols=128, v_row=16, v_col=128,
                       blayout=row_major, slayout=none_box, fractal=512,
                       pad=0>)
      pto.tmuls ins(%second, %one : !pto.tile_buf<loc=vec, dtype=f32,
                      rows=16, cols=128, v_row=16, v_col=128,
                      blayout=row_major, slayout=none_box, fractal=512,
                      pad=0>, f32)
                outs(%first : !pto.tile_buf<loc=vec, dtype=f32,
                       rows=16, cols=128, v_row=16, v_col=128,
                       blayout=row_major, slayout=none_box, fractal=512,
                       pad=0>)
    }
    return
  }
}

// CHECK: kind=loop
// CHECK: distance=[+]
// CHECK: kind=barrier resource=AIV:PIPE_V->AIV:PIPE_V
// CHECK: VERIFY ok
// CHECK-LABEL: scf.for
// CHECK-NEXT: pto.barrier <PIPE_V>
// CHECK: pto.tmuls
// CHECK-NEXT: pto.barrier <PIPE_V>
// CHECK-NEXT: pto.tmuls
