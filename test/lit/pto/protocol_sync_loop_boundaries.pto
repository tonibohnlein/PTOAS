// RUN: ptoas --pto-arch=a2 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail --protocol-sync-gm-alias=may-alias --protocol-sync-dump=plan %s -o /dev/null 2>&1 | FileCheck %s
// RUN: ptoas --pto-arch=a2 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail --protocol-sync-gm-alias=assume-disjoint-arguments --protocol-sync-dump=plan %s -o /dev/null 2>&1 | FileCheck %s
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail --protocol-sync-gm-alias=may-alias --protocol-sync-dump=plan %s -o /dev/null 2>&1 | FileCheck %s
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir --protocol-sync-mixed --protocol-sync-patterns=off --protocol-sync-fallback=fail --protocol-sync-gm-alias=assume-disjoint-arguments --protocol-sync-dump=plan %s -o /dev/null 2>&1 | FileCheck %s

// These boundaries now use selective repair, never the serialized reference.
// Independent path/token and overlap tests remain in the loop-memory unit.
// CHECK: mixed-plan function=@loop_boundaries status=ready world=selective-loop
// CHECK: mixed-plan function=@same_pipe_loop_boundaries status=ready world=selective-loop

module {
  func.func @loop_boundaries(%n: index,
      %input: !pto.partition_tensor_view<16x16xf16>,
      %output: !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %c1024 = arith.constant 1024 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %a = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    %reuse = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    %scratch = pto.alloc_tile addr = %c1024 : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
    pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>) outs(%scratch : !pto.tile_buf<vec, 16x16xf16>)
    scf.for %i = %zero to %n step %one {
      pto.tabs ins(%scratch : !pto.tile_buf<vec, 16x16xf16>) outs(%scratch : !pto.tile_buf<vec, 16x16xf16>)
      pto.tabs ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
      pto.tstore ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%output : !pto.partition_tensor_view<16x16xf16>)
    }
    pto.tabs ins(%reuse : !pto.tile_buf<vec, 16x16xf16>) outs(%reuse : !pto.tile_buf<vec, 16x16xf16>)
    pto.tstore ins(%reuse : !pto.tile_buf<vec, 16x16xf16>) outs(%output : !pto.partition_tensor_view<16x16xf16>)
    return
  }
  func.func @same_pipe_loop_boundaries(%n: index,
      %input: !pto.partition_tensor_view<16x16xf16>,
      %output: !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %a = pto.alloc_tile addr = %c0 : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%input : !pto.partition_tensor_view<16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
    scf.for %i = %zero to %n step %one {
      pto.tabs ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
    }
    pto.tstore ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%output : !pto.partition_tensor_view<16x16xf16>)
    return
  }
}
