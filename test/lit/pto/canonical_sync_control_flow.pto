// A guarded producer and an unguarded consumer require a balanced event. The
// set is lifted after the choice, rather than being left live on only one arm.
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-canonical-sync \
// RUN:   --canonical-sync-dump --emit-pto-ir \
// RUN:   --mlir-print-ir-after=pto-canonical-sync %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @canonical_sync_control_flow(
      %condition: i1, %src: !pto.partition_tensor_view<16x128xf32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %input_addr = arith.constant 0 : i64
    %output_addr = arith.constant 8192 : i64
    %one = arith.constant 1.000000e+00 : f32
    %input = pto.alloc_tile addr = %input_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    %output = pto.alloc_tile addr = %output_addr :
      !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16,
                    v_col=128, blayout=row_major, slayout=none_box,
                    fractal=512, pad=0>
    scf.if %condition {
      pto.tload ins(%src : !pto.partition_tensor_view<16x128xf32>)
                outs(%input : !pto.tile_buf<loc=vec, dtype=f32,
                       rows=16, cols=128, v_row=16, v_col=128,
                       blayout=row_major, slayout=none_box,
                       fractal=512, pad=0>)
    }
    pto.tmuls ins(%input, %one : !pto.tile_buf<loc=vec, dtype=f32,
                    rows=16, cols=128, v_row=16, v_col=128,
                    blayout=row_major, slayout=none_box, fractal=512,
                    pad=0>, f32)
              outs(%output : !pto.tile_buf<loc=vec, dtype=f32,
                     rows=16, cols=128, v_row=16, v_col=128,
                     blayout=row_major, slayout=none_box, fractal=512,
                     pad=0>)
    return
  }
}

// CHECK: kind=choice
// CHECK: kind=RAW p0->p1
// CHECK: guard=[r{{[0-9]+}}.a0]
// CHECK: kind=event resource=AIV:PIPE_MTE2->AIV:PIPE_V
// CHECK: VERIFY ok
// CHECK-LABEL: func.func @canonical_sync_control_flow
// CHECK: scf.if
// CHECK: }
// CHECK-NEXT: pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// CHECK-NEXT: pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
// CHECK-NEXT: pto.tmuls
