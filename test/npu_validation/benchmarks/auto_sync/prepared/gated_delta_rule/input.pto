          %v130 = pto.alloc_tile addr = %c27 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
          pto.tcvt ins(%v130 {rmode = #pto<round_mode CAST_RINT>} : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%v129 : !pto.tile_buf<loc=vec, dtype=f16, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
          %v131 = pto.partition_view %v9, offsets = [%v74, %v14], sizes = [%c0, %c4] : !pto.tensor_view<192x32xf16> -> !pto.partition_tensor_view<1x16xf16>
          pto.tstore ins(%v129 : !pto.tile_buf<loc=vec, dtype=f16, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%v131 : !pto.partition_tensor_view<1x16xf16>)
        }
        pto.tcvt ins(%v21 {rmode = #pto<round_mode CAST_RINT>} : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=32, v_row=16, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%v36 : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
        %v132 = arith.muli %v41, %c2 : index
        %v133 = arith.addi %v132, %v14 : index
        %v134 = pto.partition_view %v8, offsets = [%v133, %c29], sizes = [%c4, %c2] : !pto.tensor_view<768x32xf16> -> !pto.partition_tensor_view<16x32xf16>
        pto.tstore ins(%v36 : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=32, v_row=16, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%v134 : !pto.partition_tensor_view<16x32xf16>)
      }
    }
    return
  }
}
