        %v43 = arith.shli %v42, %c16 : i32
        %v44 = arith.bitcast %v43 : i32 to f32
        pto.tsetval ins(%iv41, %v44 : index, f32) outs(%v19 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=2, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
        %v45 = pto.tgetval ins(%v19, %iv41 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=2, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index) outs : f32
        %v46 = arith.addi %v40, %iv41 : index
        %v47 = arith.muli %v7, %c15 : index
        %v48 = arith.addi %v47, %v46 : index
        pto.store %v45, %out_sf[%v48] : !pto.ptr<f32, gm>, f32
