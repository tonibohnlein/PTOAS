          %v31 = pto.tgetval ins(%v18, %v30 : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=2, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index) outs : i32
          %v32 = arith.muli %iv28, %c3 : index
          %v33 = arith.addi %v32, %iv29 : index
          %v34 = pto.tgetval ins(%v14, %v33 : !pto.tile_buf<loc=vec, dtype=i32, rows=64, cols=8, v_row=64, v_col=4, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index) outs : i32
          %v35 = arith.maxsi %v31, %v34 : i32
          pto.tsetval ins(%v30, %v35 : index, i32) outs(%v18 : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=2, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
