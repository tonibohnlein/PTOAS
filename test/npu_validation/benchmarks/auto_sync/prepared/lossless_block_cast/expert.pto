      pto.tload ins(%v22 : !pto.partition_tensor_view<64x4xf32>) outs(%v12 : !pto.tile_buf<loc=vec, dtype=f32, rows=64, cols=8, v_row=64, v_col=4, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
