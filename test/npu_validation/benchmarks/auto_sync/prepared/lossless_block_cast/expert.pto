  func.func @lossless_block_cast(%x_sf: !pto.ptr<f32, gm>, %X: !pto.ptr<bf16, gm>, %Y: !pto.ptr<f32, gm>, %out_sf: !pto.ptr<f32, gm>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 128 : index
