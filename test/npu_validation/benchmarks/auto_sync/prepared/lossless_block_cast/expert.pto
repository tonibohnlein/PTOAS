          %v52 = arith.addi %v51, %iv50 : index
          %v53 = pto.tgetval ins(%v14, %v52 : !pto.tile_buf<loc=vec, dtype=i32, rows=64, cols=8, v_row=64, v_col=4, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index) outs : i32
          %v54 = arith.divui %iv50, %c4 : index
          %v55 = pto.tgetval ins(%v18, %v54 : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=2, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index) outs : i32
