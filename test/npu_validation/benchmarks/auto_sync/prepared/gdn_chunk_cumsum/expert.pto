module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @gdn_chunk_cumsum(%G: !pto.ptr<f32, gm>, %S: !pto.ptr<f32, gm>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 32 : index
    %c1 = arith.constant 16384 : index
    %c2 = arith.constant 1 : index
    %c3 = arith.constant 16 : index
    %c4 = arith.constant 2 : index
    %c5 = arith.constant 1024 : index
    %c6 = arith.constant 0 : i64
    %c7 = arith.constant 4096 : i64
    %c8 = arith.constant 0.0 : f32
    %c9 = arith.constant 0 : index
    %c10 = arith.constant 8 : index
    %c11 = arith.constant 128 : index
    %v0 = pto.make_tensor_view %G, shape = [%c0, %c1], strides = [%c1, %c2] : !pto.tensor_view<32x16384xf32>
    %v1 = pto.make_tensor_view %S, shape = [%c0, %c1], strides = [%c1, %c2] : !pto.tensor_view<32x16384xf32>
    %v2 = pto.get_block_idx
    %v3 = arith.index_cast %v2 : i64 to index
    %v4 = pto.get_subblock_idx
    %v5 = arith.index_cast %v4 : i64 to index
    %v6 = arith.remui %v3, %c3 : index
    %v7 = arith.divui %v3, %c3 : index
    %v8 = arith.muli %v7, %c4 : index
    %v9 = arith.addi %v8, %v5 : index
    %v10 = arith.muli %v6, %c5 : index
    %v11 = pto.alloc_tile addr = %c6 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=1024, v_row=1, v_col=1024, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %v12 = pto.alloc_tile addr = %c7 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=1024, v_row=1, v_col=1024, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.texpands ins(%c8 : f32) outs(%v12 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=1024, v_row=1, v_col=1024, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    %v13 = pto.partition_view %v0, offsets = [%v9, %v10], sizes = [%c2, %c5] : !pto.tensor_view<32x16384xf32> -> !pto.partition_tensor_view<1x1024xf32>
    pto.tload ins(%v13 : !pto.partition_tensor_view<1x1024xf32>) outs(%v11 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=1024, v_row=1, v_col=1024, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.set_flag_dyn[<PIPE_MTE2>, <PIPE_V>, %c9]
    pto.wait_flag_dyn[<PIPE_MTE2>, <PIPE_V>, %c9]
    scf.for %iv14 = %c9 to %c10 step %c2 {
      %v15 = arith.muli %iv14, %c11 : index
      pto.set_flag_dyn[<PIPE_V>, <PIPE_S>, %c9]
      pto.wait_flag_dyn[<PIPE_V>, <PIPE_S>, %c9]
      %v16 = pto.tgetval ins(%v11, %v15 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=1024, v_row=1, v_col=1024, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index) outs : f32
      pto.tsetval ins(%v15, %v16 : index, f32) outs(%v12 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=1024, v_row=1, v_col=1024, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      scf.for %iv17 = %c2 to %c11 step %c2 {
        %v18 = arith.addi %v15, %iv17 : index
        %v19 = arith.subi %v18, %c2 : index
        %v20 = pto.tgetval ins(%v12, %v19 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=1024, v_row=1, v_col=1024, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index) outs : f32
        %v21 = pto.tgetval ins(%v11, %v18 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=1024, v_row=1, v_col=1024, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index) outs : f32
        %v22 = arith.addf %v20, %v21 : f32
        pto.tsetval ins(%v18, %v22 : index, f32) outs(%v12 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=1024, v_row=1, v_col=1024, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      }
    }
    pto.set_flag_dyn[<PIPE_V>, <PIPE_MTE3>, %c9]
    pto.wait_flag_dyn[<PIPE_V>, <PIPE_MTE3>, %c9]
    %v23 = pto.partition_view %v1, offsets = [%v9, %v10], sizes = [%c2, %c5] : !pto.tensor_view<32x16384xf32> -> !pto.partition_tensor_view<1x1024xf32>
    pto.tstore ins(%v12 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=1024, v_row=1, v_col=1024, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%v23 : !pto.partition_tensor_view<1x1024xf32>)
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
