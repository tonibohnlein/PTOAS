// Mutually exclusive loads feed a common vector consumer. Their qualified
// readiness domains can share one unconditional acquisition at that consumer.
module attributes {pto.target_arch = "a3"} {
  func.func @alternative_producers(%src: !pto.ptr<f16>, %p: i1)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %a = arith.constant 0 : i64
    %b = arith.constant 512 : i64
    %input = pto.alloc_tile addr = %a : !pto.tile_buf<vec, 16x16xf16>
    %output = pto.alloc_tile addr = %b : !pto.tile_buf<vec, 16x16xf16>
    %view = pto.make_tensor_view %src, shape = [%c16, %c16], strides = [%c16, %c1] : !pto.tensor_view<?x?xf16>
    %part = pto.partition_view %view, offsets = [%c0, %c0], sizes = [%c16, %c16] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x16xf16>
    scf.if %p {
      pto.tload ins(%part : !pto.partition_tensor_view<16x16xf16>) outs(%input : !pto.tile_buf<vec, 16x16xf16>)
    } else {
      pto.tload ins(%part : !pto.partition_tensor_view<16x16xf16>) outs(%input : !pto.tile_buf<vec, 16x16xf16>)
    }
    pto.tabs ins(%input : !pto.tile_buf<vec, 16x16xf16>) outs(%output : !pto.tile_buf<vec, 16x16xf16>)
    return
  }
}
