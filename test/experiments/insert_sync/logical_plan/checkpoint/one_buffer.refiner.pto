module attributes {pto.backend = "emitc", pto.kernel_kind = #pto.kernel_kind<vector>, pto.target_arch = "a3"} {
  func.func @pipeline(%arg0: !pto.ptr<f16, gm>, %arg1: !pto.ptr<f16, gm>, %arg2: index) attributes {pto.gm_alias = "assume-disjoint-arguments", pto.insert_sync.buffer_generations, pto.insert_sync.effect_coverage = "complete", pto.insert_sync.generation_barriers_removed = 1 : i64, pto.insert_sync.generation_global_witnesses = 0 : i64, pto.insert_sync.generation_initial_pairs_removed = 0 : i64, pto.insert_sync.generation_initial_sets_removed = 0 : i64, pto.insert_sync.generation_initial_waits_removed = 0 : i64, pto.insert_sync.generation_mmad_witnesses = 0 : i64, pto.insert_sync.generation_publication_edges_removed = 0 : i64, pto.insert_sync.generation_publication_work = 0 : i64, pto.insert_sync.generation_publications_advanced = 0 : i64, pto.insert_sync.generation_publications_guarded = 0 : i64, pto.insert_sync.generation_ready_sets_removed = 0 : i64, pto.insert_sync.generation_ready_streams_supplied = 0 : i64, pto.insert_sync.generation_ready_waits_removed = 0 : i64, pto.insert_sync.generation_residual_keys_shared = 0 : i64, pto.insert_sync.generation_slot_witnesses = 0 : i64, pto.insert_sync.generation_storage_barriers_guarded = 0 : i64, pto.insert_sync.generation_storage_barriers_removed = 0 : i64, pto.insert_sync.handoff_advanced = 0 : i64, pto.insert_sync.handoff_delayed = 0 : i64, pto.insert_sync.handoff_reason = "retained unproved candidate: unproved requirement 4294967295 -> 4294967295; event node 70", pto.insert_sync.handoff_sets_removed = 0 : i64, pto.insert_sync.handoff_split = 0 : i64, pto.insert_sync.handoff_waits_removed = 0 : i64, pto.insert_sync.handoff_work = 10116 : i64, pto.insert_sync.lifecycle_channels = 2 : i64, pto.insert_sync.lifecycle_completion_pairs = 1 : i64, pto.insert_sync.lifecycle_completion_witnesses = 1 : i64, pto.insert_sync.lifecycle_completion_work = 3346 : i64, pto.insert_sync.lifecycle_consumer_regions = 0 : i64, pto.insert_sync.lifecycle_guarded_actions = 0 : i64, pto.insert_sync.lifecycle_retries = 0 : i64, pto.insert_sync.lifecycle_supplied_pairs = 11 : i64, pto.insert_sync.mmad_chain_targets = 0 : i64, pto.insert_sync.mmad_dependency_groups_elided = 0 : i64, pto.insert_sync.status = "lifecycle-plus-residuals", pto.kernel_kind = #pto.kernel_kind<vector>} {
    pto.set_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID0>]
    pto.set_flag[<PIPE_MTE3>, <PIPE_V>, <EVENT_ID0>]
    %true = arith.constant true
    %c512_i64 = arith.constant 512 : i64
    %c0_i64 = arith.constant 0 : i64
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %0 = arith.muli %arg2, %c16 : index
    %1 = pto.make_tensor_view %arg0, shape = [%0, %c16], strides = [%c16, %c1] {layout = #pto.layout<nd>, pto.inferred_layout = true} : !pto.tensor_view<?x?xf16>
    %2 = pto.make_tensor_view %arg1, shape = [%0, %c16], strides = [%c16, %c1] {layout = #pto.layout<nd>, pto.inferred_layout = true} : !pto.tensor_view<?x?xf16>
    %3 = pto.alloc_tile addr = %c0_i64 : !pto.tile_buf<vec, 16x16xf16>
    %4 = pto.alloc_tile addr = %c512_i64 : !pto.tile_buf<vec, 16x16xf16>
    scf.for %arg3 = %c0 to %arg2 step %c1 {
      %5 = arith.muli %arg3, %c16 : index
      %6 = pto.partition_view %1, offsets = [%5, %c0], sizes = [%c16, %c16] : !pto.tensor_view<?x?xf16>
      scf.if %true {
        pto.wait_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID0>]
        pto.tload ins(%6 : !pto.partition_tensor_view<16x16xf16>) outs(%3 : !pto.tile_buf<vec, 16x16xf16>) {layout = #pto.layout<nd>, pto.inferred_layout = true}
        pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
        %7 = arith.muli %arg3, %c16 : index
        %8 = pto.partition_view %2, offsets = [%7, %c0], sizes = [%c16, %c16] : !pto.tensor_view<?x?xf16>
        pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
        pto.wait_flag[<PIPE_MTE3>, <PIPE_V>, <EVENT_ID0>]
        pto.tabs ins(%3 : !pto.tile_buf<vec, 16x16xf16>) outs(%4 : !pto.tile_buf<vec, 16x16xf16>)
        pto.set_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID0>]
        pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
        pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
        pto.tstore ins(%4 : !pto.tile_buf<vec, 16x16xf16>) outs(%8 : !pto.partition_tensor_view<16x16xf16>) {layout = #pto.layout<nd>, pto.inferred_layout = true}
        pto.set_flag[<PIPE_MTE3>, <PIPE_V>, <EVENT_ID0>]
      }
    }
    pto.wait_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID0>]
    pto.wait_flag[<PIPE_MTE3>, <PIPE_V>, <EVENT_ID0>]
    return
  }
}
