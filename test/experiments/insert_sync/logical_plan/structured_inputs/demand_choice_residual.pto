// A and B have distinct first consumers in both arms. Loading unrelated C
// after B must not force the B acquisition to wait for C's completion.
module attributes {pto.target_arch = "a3"} {
  func.func @choice_residual(%src: !pto.partition_tensor_view<16x16xf16>, %take: i1)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %a0 = arith.constant 0 : i64
    %a1 = arith.constant 512 : i64
    %a2 = arith.constant 1024 : i64
    %a3 = arith.constant 1536 : i64
    %a4 = arith.constant 2048 : i64
    %a = pto.alloc_tile addr = %a0 : !pto.tile_buf<vec, 16x16xf16>
    %b = pto.alloc_tile addr = %a1 : !pto.tile_buf<vec, 16x16xf16>
    %c = pto.alloc_tile addr = %a2 : !pto.tile_buf<vec, 16x16xf16>
    %out_a = pto.alloc_tile addr = %a3 : !pto.tile_buf<vec, 16x16xf16>
    %out_b = pto.alloc_tile addr = %a4 : !pto.tile_buf<vec, 16x16xf16>
      pto.tload ins(%src : !pto.partition_tensor_view<16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
      pto.tload ins(%src : !pto.partition_tensor_view<16x16xf16>) outs(%b : !pto.tile_buf<vec, 16x16xf16>)
      pto.tload ins(%src : !pto.partition_tensor_view<16x16xf16>) outs(%c : !pto.tile_buf<vec, 16x16xf16>)
      scf.if %take {
        pto.tabs ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%out_a : !pto.tile_buf<vec, 16x16xf16>)
        pto.tabs ins(%b : !pto.tile_buf<vec, 16x16xf16>) outs(%out_b : !pto.tile_buf<vec, 16x16xf16>)
      } else {
        pto.tabs ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%out_a : !pto.tile_buf<vec, 16x16xf16>)
        pto.tabs ins(%b : !pto.tile_buf<vec, 16x16xf16>) outs(%out_b : !pto.tile_buf<vec, 16x16xf16>)
      }
    return
  }
}
