// S6 synthetic split-K GEMM: M=16, N=256, K=2048, 32 K panels.
// First iteration initializes C; later iterations accumulate. The raw induction
// is 0..64 step 2. This is NOT the frozen historical two-level-buffered GEMM.
// No UnitFlag or shape-based implicit completion is enabled.
module attributes {pto.target_arch = "a3"} {
  func.func @s6_startup_gemm(%a: !pto.ptr<f16>, %b: !pto.ptr<f16>, %c: !pto.ptr<f32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %z = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %m = arith.constant 16 : index
    %n = arith.constant 256 : index
    %k = arith.constant 2048 : index
    %panel = arith.constant 64 : index
    %half_panel = arith.constant 32 : index
    %addr0 = arith.constant 0 : i64
    %addrB = arith.constant 2048 : i64
    %av = pto.make_tensor_view %a, shape = [%m, %k], strides = [%k, %one] : !pto.tensor_view<?x?xf16>
    %bv = pto.make_tensor_view %b, shape = [%k, %n], strides = [%n, %one] : !pto.tensor_view<?x?xf16>
    %cv = pto.make_tensor_view %c, shape = [%m, %n], strides = [%n, %one] : !pto.tensor_view<?x?xf32>
    %al1 = pto.alloc_tile addr = %addr0 : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=64, v_row=16, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %bl1 = pto.alloc_tile addr = %addrB : !pto.tile_buf<loc=mat, dtype=f16, rows=64, cols=256, v_row=64, v_col=256, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %al0 = pto.alloc_tile addr = %addr0 : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=64, v_row=16, v_col=64, blayout=row_major, slayout=row_major, fractal=512, pad=0>
    %bl0 = pto.alloc_tile addr = %addr0 : !pto.tile_buf<loc=right, dtype=f16, rows=64, cols=256, v_row=64, v_col=256, blayout=row_major, slayout=col_major, fractal=512, pad=0>
    %acc = pto.alloc_tile addr = %addr0 : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=256, v_row=16, v_col=256, blayout=col_major, slayout=row_major, fractal=1024, pad=0>
    scf.for %iv = %z to %panel step %two {
      %offset = arith.muli %iv, %half_panel : index
      %ap = pto.partition_view %av, offsets = [%z, %offset], sizes = [%m, %panel] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x64xf16>
      %bp = pto.partition_view %bv, offsets = [%offset, %z], sizes = [%panel, %n] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<64x256xf16>
      pto.tload ins(%ap : !pto.partition_tensor_view<16x64xf16>) outs(%al1 : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=64, v_row=16, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
      pto.tload ins(%bp : !pto.partition_tensor_view<64x256xf16>) outs(%bl1 : !pto.tile_buf<loc=mat, dtype=f16, rows=64, cols=256, v_row=64, v_col=256, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
      pto.textract ins(%al1, %z, %z : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=64, v_row=16, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>, index, index) outs(%al0 : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=64, v_row=16, v_col=64, blayout=row_major, slayout=row_major, fractal=512, pad=0>)
      pto.textract ins(%bl1, %z, %z : !pto.tile_buf<loc=mat, dtype=f16, rows=64, cols=256, v_row=64, v_col=256, blayout=col_major, slayout=row_major, fractal=512, pad=0>, index, index) outs(%bl0 : !pto.tile_buf<loc=right, dtype=f16, rows=64, cols=256, v_row=64, v_col=256, blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      %first = arith.cmpi eq, %iv, %z : index
      scf.if %first {
        pto.tmatmul ins(%al0, %bl0 : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=64, v_row=16, v_col=64, blayout=row_major, slayout=row_major, fractal=512, pad=0>, !pto.tile_buf<loc=right, dtype=f16, rows=64, cols=256, v_row=64, v_col=256, blayout=row_major, slayout=col_major, fractal=512, pad=0>) outs(%acc : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=256, v_row=16, v_col=256, blayout=col_major, slayout=row_major, fractal=1024, pad=0>)
      } else {
        pto.tmatmul.acc ins(%acc, %al0, %bl0 : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=256, v_row=16, v_col=256, blayout=col_major, slayout=row_major, fractal=1024, pad=0>, !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=64, v_row=16, v_col=64, blayout=row_major, slayout=row_major, fractal=512, pad=0>, !pto.tile_buf<loc=right, dtype=f16, rows=64, cols=256, v_row=64, v_col=256, blayout=row_major, slayout=col_major, fractal=512, pad=0>) outs(%acc : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=256, v_row=16, v_col=256, blayout=col_major, slayout=row_major, fractal=1024, pad=0>)
      }
    }
    %cp = pto.partition_view %cv, offsets = [%z, %z], sizes = [%m, %n] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x256xf32>
    pto.tstore ins(%acc : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=256, v_row=16, v_col=256, blayout=col_major, slayout=row_major, fractal=1024, pad=0>) outs(%cp : !pto.partition_tensor_view<16x256xf32>)
    return
  }
}
