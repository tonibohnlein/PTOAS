module attributes {pto.target_arch = "a3"} {
  func.func @composition_remote_wait_loop_scalar_visibility(
      %payload: !pto.ptr<i32>, %signal_ptr: !pto.ptr<i32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %one = arith.constant 1 : i32
    %signal_view = pto.make_tensor_view %signal_ptr, shape = [%c1],
        strides = [%c1] : !pto.tensor_view<1xi32>
    %signal = pto.partition_view %signal_view, offsets = [%c0], sizes = [%c1]
        : !pto.tensor_view<1xi32> -> !pto.partition_tensor_view<1xi32>
    scf.for %i = %c0 to %c2 step %c1 {
      // Iteration i>0 follows the previous iteration's remote acquisition.
      // The loop invariant must therefore require invalidation here even
      // though this read is lexically before TWAIT.
      %value = pto.load_scalar %payload[%i] : !pto.ptr<i32> -> i32
      pto.comm.twait(%signal, %one : !pto.partition_tensor_view<1xi32>, i32)
          {cmp = #pto<wait_cmp ge>}
    }
    return
  }
}
