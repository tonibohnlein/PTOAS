module attributes {pto.target_arch = "a3"} {
  func.func @gm_same_root_ranges(%root: !pto.ptr<i8>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %c64 = arith.constant 64 : index
    %c128 = arith.constant 128 : index
    %a0 = arith.constant 0 : i64
    %a1 = arith.constant 512 : i64
    %view = pto.make_tensor_view %root, shape = [%c128], strides = [%c1]
      {layout = #pto.layout<nd>} : !pto.tensor_view<?xi8>
    %written = pto.partition_view %view, offsets = [%c0], sizes = [%c64]
      : !pto.tensor_view<?xi8> -> !pto.partition_tensor_view<64xi8>
    %read = pto.partition_view %view, offsets = [%c64], sizes = [%c64]
      : !pto.tensor_view<?xi8> -> !pto.partition_tensor_view<64xi8>
    %source = pto.alloc_tile addr = %a0 : !pto.tile_buf<vec, 1x64xi8>
    %sink = pto.alloc_tile addr = %a1 : !pto.tile_buf<vec, 1x64xi8>
    pto.tstore ins(%source : !pto.tile_buf<vec, 1x64xi8>)
      outs(%written : !pto.partition_tensor_view<64xi8>)
    pto.tload ins(%read : !pto.partition_tensor_view<64xi8>)
      outs(%sink : !pto.tile_buf<vec, 1x64xi8>)
    return
  }
}
