// The inner body's first V demand is behind nested unknown choices, including
// an empty arm. Its MTE2 source arrives from outside the owner and the previous
// outer visit, not from a lexical producer earlier in the outer body.
module attributes {pto.target_arch = "a3"} {
  func.func @entry_choice(%src: !pto.partition_tensor_view<16x16xf16>,
                          %outer_count: index, %lower: index, %upper: index,
                          %take: i1, %other: i1)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %a0 = arith.constant 0 : i64
    %a1 = arith.constant 512 : i64
    %a = pto.alloc_tile addr = %a0 : !pto.tile_buf<vec, 16x16xf16>
    %out = pto.alloc_tile addr = %a1 : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%src : !pto.partition_tensor_view<16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
    scf.for %outer = %c0 to %outer_count step %c1 {
      scf.for %iv = %lower to %upper step %c1 {
        scf.if %take {
          scf.if %other {
            pto.tabs ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%out : !pto.tile_buf<vec, 16x16xf16>)
          } else {
            pto.tabs ins(%a : !pto.tile_buf<vec, 16x16xf16>) outs(%out : !pto.tile_buf<vec, 16x16xf16>)
          }
        }
      }
      pto.tload ins(%src : !pto.partition_tensor_view<16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
    }
    return
  }
}
