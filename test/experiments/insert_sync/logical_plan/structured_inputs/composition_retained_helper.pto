module attributes {pto.target_arch = "a3"} {
  func.func @test(%gm: !pto.partition_tensor_view<16x16xf16>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %addr = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %addr : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%gm : !pto.partition_tensor_view<16x16xf16>)
      outs(%tile : !pto.tile_buf<vec, 16x16xf16>)
    func.call @read_tile(%tile) : (!pto.tile_buf<vec, 16x16xf16>) -> ()
    pto.tload ins(%gm : !pto.partition_tensor_view<16x16xf16>)
      outs(%tile : !pto.tile_buf<vec, 16x16xf16>)
    return
  }
  func.func private @read_tile(%tile: !pto.tile_buf<vec, 16x16xf16>)
      attributes {pto.ptodsl.subkernel_helper = "simd", pto.tileop.effects = ["read"]} {
    func.call @leaf(%tile) : (!pto.tile_buf<vec, 16x16xf16>) -> ()
    return
  }
  func.func private @leaf(%tile: !pto.tile_buf<vec, 16x16xf16>)
      attributes {pto.ptodsl.subkernel_helper = "simd", pto.tileop.effects = ["read"]} {
    return
  }
}
