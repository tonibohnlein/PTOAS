module attributes {pto.target_arch = "a3"} {
  func.func @composition_tput_macro(
      %dst_ptr: !pto.ptr<i32>, %src_ptr: !pto.ptr<i32>,
      %next_ptr: !pto.ptr<i32>, %old_ptr: !pto.ptr<i32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %v0 = arith.constant 0 : i32
    %dst_view = pto.make_tensor_view %dst_ptr, shape = [%c1, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xi32>
    %src_view = pto.make_tensor_view %src_ptr, shape = [%c1, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xi32>
    %next_view = pto.make_tensor_view %next_ptr, shape = [%c1, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xi32>
    %old_view = pto.make_tensor_view %old_ptr, shape = [%c1, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xi32>
    %dst = pto.partition_view %dst_view, offsets = [%c0, %c0], sizes = [%c1, %c32] : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<1x32xi32>
    %src = pto.partition_view %src_view, offsets = [%c0, %c0], sizes = [%c1, %c32] : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<1x32xi32>
    %next = pto.partition_view %next_view, offsets = [%c0, %c0], sizes = [%c1, %c32] : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<1x32xi32>
    %old = pto.partition_view %old_view, offsets = [%c0, %c0], sizes = [%c1, %c32] : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<1x32xi32>
    %ping = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pong = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tci ins(%v0 : i32) outs(%ping : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tstore ins(%ping : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%old : !pto.partition_tensor_view<1x32xi32>)
    pto.comm.tput(%dst, %src, buf(%ping, %pong) : !pto.partition_tensor_view<1x32xi32>, !pto.partition_tensor_view<1x32xi32>, !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {atomicType = #pto<atomic_type atomic_none>}
    pto.tload ins(%next : !pto.partition_tensor_view<1x32xi32>) outs(%ping : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}
