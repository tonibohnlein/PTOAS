// Shared operand readiness and output release in one unconditional word.
// Runtime/nonzero bounds exercise first, recurring and final participation.
module attributes {pto.target_arch = "a3"} {
  func.func @deferred(%src: !pto.partition_tensor_view<16x16xf16>,
                      %dst: !pto.partition_tensor_view<16x16xf16>,
                      %lower: index, %upper: index)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c1 = arith.constant 1 : index
    %a0 = arith.constant 0 : i64
    %a1 = arith.constant 512 : i64
    %a2 = arith.constant 1024 : i64
    %a = pto.alloc_tile addr = %a0 : !pto.tile_buf<vec, 16x16xf16>
    %b = pto.alloc_tile addr = %a1 : !pto.tile_buf<vec, 16x16xf16>
    %c = pto.alloc_tile addr = %a2 : !pto.tile_buf<vec, 16x16xf16>
    scf.for %iv = %lower to %upper step %c1 {
      pto.tload ins(%src : !pto.partition_tensor_view<16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
      pto.tload ins(%src : !pto.partition_tensor_view<16x16xf16>) outs(%b : !pto.tile_buf<vec, 16x16xf16>)
      pto.tadd ins(%a, %b : !pto.tile_buf<vec, 16x16xf16>, !pto.tile_buf<vec, 16x16xf16>) outs(%c : !pto.tile_buf<vec, 16x16xf16>)
      pto.tstore ins(%c : !pto.tile_buf<vec, 16x16xf16>) outs(%dst : !pto.partition_tensor_view<16x16xf16>)
    }
    return
  }
}
