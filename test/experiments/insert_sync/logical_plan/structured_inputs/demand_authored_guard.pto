// An existing conditional protocol is not compiler-generated entry precision.
module attributes {pto.target_arch = "a3"} {
  func.func @authored(%src: !pto.partition_tensor_view<16x16xf16>, %take: i1)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %address = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %address : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%src : !pto.partition_tensor_view<16x16xf16>) outs(%tile : !pto.tile_buf<vec, 16x16xf16>)
    scf.if %take {
      pto.set_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID1>]
      pto.wait_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID1>]
      pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID1>]
      pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID1>]
    }
    return
  }
}
