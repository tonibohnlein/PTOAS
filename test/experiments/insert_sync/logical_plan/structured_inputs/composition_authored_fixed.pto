module attributes {pto.target_arch = "a3"} {
  func.func @composition_authored_fixed(%buffer: !pto.ptr<i32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %zero = arith.constant 0 : i64
    %value = arith.constant 7 : i32
    %tile = pto.alloc_tile addr = %zero : !pto.tile_buf<vec, 1x16xi32>
    %view = pto.make_tensor_view %buffer, shape = [%c1, %c16],
        strides = [%c16, %c1] : !pto.tensor_view<?x?xi32>
    %part = pto.partition_view %view, offsets = [%c0, %c0],
        sizes = [%c1, %c16]
        : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<1x16xi32>

    pto.tload ins(%part : !pto.partition_tensor_view<1x16xi32>)
        outs(%tile : !pto.tile_buf<vec, 1x16xi32>)
    // The first overwrite requires a generated MTE2 barrier. A reconstruction
    // mutation moves it beside the authored barrier below and checks that the
    // two mechanisms cannot become one generated packet run.
    pto.tload ins(%part : !pto.partition_tensor_view<1x16xi32>)
        outs(%tile : !pto.tile_buf<vec, 1x16xi32>)
    pto.barrier <PIPE_MTE2> {pto.test_authored_fixed}
    pto.tload ins(%part : !pto.partition_tensor_view<1x16xi32>)
        outs(%tile : !pto.tile_buf<vec, 1x16xi32>)

    pto.store_scalar %value, %buffer[%c0] : !pto.ptr<i32>, i32
    pto.cmo.cacheinvalid all #pto.address_space<gm>
    pto.fence.barrier_all #pto.fence_scope<gm>
    pto.tload ins(%part : !pto.partition_tensor_view<1x16xi32>)
        outs(%tile : !pto.tile_buf<vec, 1x16xi32>)

    // This fence deliberately lacks a preceding clean. The composer must add
    // its own clean/fence visibility recipe for the following vector read;
    // reconstruction must not pair that generated clean with this authored
    // fence.
    pto.store_scalar %value, %buffer[%c0] : !pto.ptr<i32>, i32
    pto.fence.barrier_all #pto.fence_scope<gm>
    pto.tload ins(%part : !pto.partition_tensor_view<1x16xi32>)
        outs(%tile : !pto.tile_buf<vec, 1x16xi32>)
    return
  }
}
