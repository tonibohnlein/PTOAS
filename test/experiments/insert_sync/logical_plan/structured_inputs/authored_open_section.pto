module attributes {pto.target_arch = "a3"} {
  func.func @authored_open_section(%src: !pto.ptr<f16>, %dst: !pto.ptr<f16>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %ia = arith.constant 0 : i64
    %oa = arith.constant 512 : i64
    %source = pto.make_tensor_view %src, shape = [%c16, %c16], strides = [%c16, %c1]
      : !pto.tensor_view<?x?xf16>
    %target = pto.make_tensor_view %dst, shape = [%c16, %c16], strides = [%c16, %c1]
      : !pto.tensor_view<?x?xf16>
    %input = pto.alloc_tile addr = %ia : !pto.tile_buf<vec, 16x16xf16>
    %output = pto.alloc_tile addr = %oa : !pto.tile_buf<vec, 16x16xf16>
    %source_part = pto.partition_view %source, offsets = [%c0, %c0], sizes = [%c16, %c16]
      : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x16xf16>
    %target_part = pto.partition_view %target, offsets = [%c0, %c0], sizes = [%c16, %c16]
      : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x16xf16>
    pto.set_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID1>]
    pto.section.vector {
      pto.wait_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID1>]
      pto.tload ins(%source_part : !pto.partition_tensor_view<16x16xf16>)
        outs(%input : !pto.tile_buf<vec, 16x16xf16>)
      pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID1>]
      pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID1>]
      pto.tabs ins(%input : !pto.tile_buf<vec, 16x16xf16>)
        outs(%output : !pto.tile_buf<vec, 16x16xf16>)
      pto.set_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID1>]
      pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
      pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
      pto.set_flag[<PIPE_MTE3>, <PIPE_V>, <EVENT_ID0>]
      pto.wait_flag[<PIPE_MTE3>, <PIPE_V>, <EVENT_ID0>]
      pto.tstore ins(%output : !pto.tile_buf<vec, 16x16xf16>)
        outs(%target_part : !pto.partition_tensor_view<16x16xf16>)
      pto.barrier <PIPE_ALL>
    }
    pto.wait_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID1>]
    pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID1>]
    pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID1>]
    return
  }
}
