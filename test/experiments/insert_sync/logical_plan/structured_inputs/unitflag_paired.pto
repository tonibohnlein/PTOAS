// Exact authored A2/A3 UnitFlag ownership pair.  The caller supplies writable
// ownership for ACC [0,1024) at entry; every loop visit returns it writable.
module attributes {pto.target_arch = "a3"} {
  func.func @unitflag_paired(%out: !pto.ptr<f32>, %trips: index)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>,
                  pto.unitflag_entry_writable = array<i64: 0, 1024>} {
    %z = arith.constant 0 : index
    %one = arith.constant 1 : index
    %n = arith.constant 16 : index
    %addr = arith.constant 0 : i64
    %addr512 = arith.constant 512 : i64
    %addr1024 = arith.constant 1024 : i64
    %view = pto.make_tensor_view %out, shape = [%n, %n], strides = [%n, %one]
        : !pto.tensor_view<?x?xf32>
    %part = pto.partition_view %view, offsets = [%z, %z], sizes = [%n, %n]
        : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x16xf32>
    %lhs_src = pto.alloc_tile addr = %addr
        : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %rhs_src = pto.alloc_tile addr = %addr512
        : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %post = pto.alloc_tile addr = %addr1024
        : !pto.tile_buf<loc=mat, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %lhs = pto.alloc_tile addr = %addr
        : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=row_major, fractal=512, pad=0>
    %rhs = pto.alloc_tile addr = %addr
        : !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=col_major, fractal=512, pad=0>
    %acc = pto.alloc_tile addr = %addr
        : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=1024, pad=0>
    scf.for %iv = %z to %trips step %one {
      pto.textract ins(%lhs_src, %z, %z : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>, index, index) outs(%lhs : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=row_major, fractal=512, pad=0>)
      pto.textract ins(%rhs_src, %z, %z : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>, index, index) outs(%rhs : !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      pto.tmatmul ins(%lhs, %rhs : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=row_major, fractal=512, pad=0>, !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=col_major, fractal=512, pad=0>) outs(%acc : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=1024, pad=0>) {accPhase = #pto<acc_phase final>}
      pto.tstore ins(%acc : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=1024, pad=0>) outs(%part : !pto.partition_tensor_view<16x16xf32>) {stPhase = #pto<st_phase final>}
    }
    pto.tload ins(%part : !pto.partition_tensor_view<16x16xf32>) outs(%post : !pto.tile_buf<loc=mat, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    return
  }
}
