      pto.tsort32 ins(%src1_1, %idx, %sorttmp1 : !pto.tile_buf<vec, 1x256xf32, valid=1x128>, !pto.tile_buf<vec, 1x128xui32>, !pto.tile_buf<vec, 1x256xf32, valid=1x128>) outs(%sort1_1 : !pto.tile_buf<vec, 1x256xf32>)
      pto.tmrgsort ins(%sort1_0, %c64_i32 : !pto.tile_buf<vec, 1x256xf32>, i32) outs(%tmp1 : !pto.tile_buf<vec, 1x256xf32>)
