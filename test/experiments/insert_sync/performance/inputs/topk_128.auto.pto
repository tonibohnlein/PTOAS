      pto.tgather ins(%merge0_0_bits, {maskPattern = #pto.mask_pattern<P1010>} : !pto.tile_buf<vec, 1x256xui32>, "row") outs(%index0_0 : !pto.tile_buf<vec, 1x128xui32>)
