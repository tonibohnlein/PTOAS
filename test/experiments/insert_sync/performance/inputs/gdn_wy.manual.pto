      pto.set_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID1>]
      pto.wait_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID1>]
      pto.tmatmul ins(%left, %right : !pto.tile_buf<left, 128x128xf16, blayout=row_major, slayout=row_major, valid=128x128, pad=1>, !pto.tile_buf<right, 128x128xf16, blayout=row_major, slayout=col_major, valid=128x128, pad=1>) outs(%accu : !pto.tile_buf<acc, 128x128xf32, blayout=col_major, slayout=row_major, fractal=1024>)
      pto.set_flag[<PIPE_MTE1>, <PIPE_MTE2>, <EVENT_ID1>]
      pto.wait_flag[<PIPE_MTE1>, <PIPE_MTE2>, <EVENT_ID1>]
      pto.set_flag[<PIPE_M>, <PIPE_FIX>, <EVENT_ID1>]
      pto.wait_flag[<PIPE_M>, <PIPE_FIX>, <EVENT_ID1>]
      scf.if %tail {
        %accu_tail = pto.alloc_tile addr = %c0_i64 : !pto.tile_buf<acc, 128x128xf32, blayout=col_major, slayout=row_major, fractal=1024, valid=64x128>
        %u_tail_part = pto.partition_view %uview, offsets = [%base, %c0_index], sizes = [%c64_index, %c128_index] : !pto.tensor_view<2048x128xf16> -> !pto.partition_tensor_view<64x128xf16>
        pto.tstore ins(%accu_tail : !pto.tile_buf<acc, 128x128xf32, blayout=col_major, slayout=row_major, fractal=1024, valid=64x128>) outs(%u_tail_part : !pto.partition_tensor_view<64x128xf16>)
      } else {
        %u_part = pto.partition_view %uview, offsets = [%base, %c0_index], sizes = [%c128_index, %c128_index] : !pto.tensor_view<2048x128xf16> -> !pto.partition_tensor_view<128x128xf16>
        pto.tstore ins(%accu : !pto.tile_buf<acc, 128x128xf32, blayout=col_major, slayout=row_major, fractal=1024>) outs(%u_part : !pto.partition_tensor_view<128x128xf16>)
      }
      pto.sync.set <PIPE_FIX>, 3 {ffts_mode = 2 : i32}
      pto.sync.wait <PIPE_MTE2>, 1 {ffts_mode = 2 : i32}
      %ws1_part = pto.partition_view %ws1view, offsets = [%c0_index, %c0_index], sizes = [%c128_index, %c128_index] : !pto.tensor_view<128x128xf16> -> !pto.partition_tensor_view<128x128xf16>
      pto.tload ins(%ws1_part : !pto.partition_tensor_view<128x128xf16>) outs(%other : !pto.tile_buf<mat, 128x128xf16, blayout=col_major, slayout=row_major, valid=128x128, pad=1>)
      pto.set_flag[<PIPE_FIX>, <PIPE_M>, <EVENT_ID0>]
      pto.wait_flag[<PIPE_FIX>, <PIPE_M>, <EVENT_ID0>]
      pto.set_flag[<PIPE_MTE2>, <PIPE_MTE1>, <EVENT_ID1>]
      pto.wait_flag[<PIPE_MTE2>, <PIPE_MTE1>, <EVENT_ID1>]
      pto.set_flag[<PIPE_M>, <PIPE_MTE1>, <EVENT_ID1>]
      pto.wait_flag[<PIPE_M>, <PIPE_MTE1>, <EVENT_ID1>]
      pto.textract ins(%other, %c0_index, %c0_index : !pto.tile_buf<mat, 128x128xf16, blayout=col_major, slayout=row_major, valid=128x128, pad=1>, index, index) outs(%left : !pto.tile_buf<left, 128x128xf16, blayout=row_major, slayout=row_major, valid=128x128, pad=1>)
      pto.textract ins(%k1, %c0_index, %c0_index : !pto.tile_buf<mat, 128x128xf16, blayout=col_major, slayout=row_major, valid=128x128, pad=1>, index, index) outs(%right : !pto.tile_buf<right, 128x128xf16, blayout=row_major, slayout=col_major, valid=128x128, pad=1>)
      pto.set_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID1>]
      pto.wait_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID1>]
      pto.tmatmul ins(%left, %right : !pto.tile_buf<left, 128x128xf16, blayout=row_major, slayout=row_major, valid=128x128, pad=1>, !pto.tile_buf<right, 128x128xf16, blayout=row_major, slayout=col_major, valid=128x128, pad=1>) outs(%accw : !pto.tile_buf<acc, 128x128xf32, blayout=col_major, slayout=row_major, fractal=1024>)
      pto.set_flag[<PIPE_MTE1>, <PIPE_MTE2>, <EVENT_ID1>]
      pto.wait_flag[<PIPE_MTE1>, <PIPE_MTE2>, <EVENT_ID1>]
      pto.set_flag[<PIPE_M>, <PIPE_FIX>, <EVENT_ID1>]
      pto.wait_flag[<PIPE_M>, <PIPE_FIX>, <EVENT_ID1>]
      scf.if %tail {
        %accw_tail = pto.alloc_tile addr = %c65536_i64 : !pto.tile_buf<acc, 128x128xf32, blayout=col_major, slayout=row_major, fractal=1024, valid=64x128>
        %w_tail_part = pto.partition_view %wview, offsets = [%base, %c0_index], sizes = [%c64_index, %c128_index] : !pto.tensor_view<2048x128xf16> -> !pto.partition_tensor_view<64x128xf16>
        pto.tstore ins(%accw_tail : !pto.tile_buf<acc, 128x128xf32, blayout=col_major, slayout=row_major, fractal=1024, valid=64x128>) outs(%w_tail_part : !pto.partition_tensor_view<64x128xf16>)
      } else {
        %w_part = pto.partition_view %wview, offsets = [%base, %c0_index], sizes = [%c128_index, %c128_index] : !pto.tensor_view<2048x128xf16> -> !pto.partition_tensor_view<128x128xf16>
        pto.tstore ins(%accw : !pto.tile_buf<acc, 128x128xf32, blayout=col_major, slayout=row_major, fractal=1024>) outs(%w_part : !pto.partition_tensor_view<128x128xf16>)
      }
      pto.sync.set <PIPE_FIX>, 4 {ffts_mode = 2 : i32}
    }
    return
  }
}
