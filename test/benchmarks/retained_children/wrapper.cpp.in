#include ARM_SOURCE
#include "acl/acl.h"
__global__ AICORE void run_retained(__gm__ float* a, __gm__ float* b, __gm__ float* out) {
    retained_inputs(a, b, out);
}
void LaunchRetained(void* a, void* b, void* out, void* stream) {
    run_retained<<<1, nullptr, stream>>>((__gm__ float*)a, (__gm__ float*)b, (__gm__ float*)out);
}
int RetainedOuter() { return @OUTER@; }
int RetainedReaders() { return @READERS@; }
